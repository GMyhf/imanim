[
 {
  "id": "title",
  "wav": "audio/title-876f6e7750b1.wav",
  "seconds": 17.256,
  "cues": [
   {
    "start": 0.1,
    "end": 4.325,
    "text": "你关注我，我也关注你，我们就能互相到达。"
   },
   {
    "start": 4.275,
    "end": 12.525,
    "text": "在一张有向图里，把互相能到达的点圈在一起，整张图就分成几块，每一块叫一个强连通分量。"
   },
   {
    "start": 12.525,
    "end": 17.2,
    "text": "这一集，用两遍深度优先搜索把它们找出来。"
   }
  ]
 },
 {
  "id": "graph",
  "wav": "audio/graph-a9e51904249f.wav",
  "seconds": 23.208,
  "cues": [
   {
    "start": 0.1,
    "end": 3.4625,
    "text": "这张图有八个点、十二条边。"
   },
   {
    "start": 3.4125,
    "end": 12.2125,
    "text": "零到一，一到二，二到三，三又回到零，四个点绕成一个环，任意两个都能互相到达。"
   },
   {
    "start": 12.2125,
    "end": 15.775,
    "text": "四和五互相指，六和七也互相指。"
   },
   {
    "start": 15.775,
    "end": 20.15,
    "text": "一到四有边，可是四回不到一，它们不在同一块。"
   },
   {
    "start": 20.15,
    "end": 23.1375,
    "text": "整张图恰好分成三块。"
   }
  ]
 },
 {
  "id": "condense",
  "wav": "audio/condense-257699cdcce8.wav",
  "seconds": 18.816,
  "cues": [
   {
    "start": 0.1,
    "end": 2.0625,
    "text": "把每一块缩成一个点。"
   },
   {
    "start": 2.0125,
    "end": 8.9875,
    "text": "块和块之间的边一定是单向的：要是两块之间来回都有路，它们本该合成一块。"
   },
   {
    "start": 8.9875,
    "end": 12.625,
    "text": "所以缩点以后，一定是一张有向无环图。"
   },
   {
    "start": 12.625,
    "end": 18.75,
    "text": "蓝色这块是源头，没有边进来；紫色这块是终点，没有边出去。"
   }
  ]
 },
 {
  "id": "dfs1",
  "wav": "audio/dfs1-1373afc9b957.wav",
  "seconds": 43.824,
  "cues": [
   {
    "start": 0.1,
    "end": 3.5,
    "text": "第一遍深度优先搜索，在原图上走。"
   },
   {
    "start": 3.45,
    "end": 12.5375,
    "text": "进入一个点，记下发现时间，它变成灰色；出边都处理完，记下结束时间，它变成黑色，压进栈里。"
   },
   {
    "start": 12.5375,
    "end": 14.9875,
    "text": "从零出发，一路走到三。"
   },
   {
    "start": 14.9875,
    "end": 19.7375,
    "text": "三到零，零还是灰色，这是回边，说明有环。"
   },
   {
    "start": 19.7375,
    "end": 24.1375,
    "text": "三到六，六到七，七到五，五到四。"
   },
   {
    "start": 24.1375,
    "end": 26.5875,
    "text": "四到五，又是回边。"
   },
   {
    "start": 26.5875,
    "end": 33.8125,
    "text": "四最先结束，然后是五；七到六也是回边，接着七、六、三结束。"
   },
   {
    "start": 33.8125,
    "end": 37.0,
    "text": "二到五，五已经黑了，不用再走。"
   },
   {
    "start": 37.0,
    "end": 43.775,
    "text": "最后二、一、零依次结束，零的结束时间是十六，压在栈顶。"
   }
  ]
 },
 {
  "id": "finish",
  "wav": "audio/finish-f81ae701d8b3.wav",
  "seconds": 22.152,
  "cues": [
   {
    "start": 0.1,
    "end": 6.2625,
    "text": "看每一块里最大的结束时间：蓝色十六，黄色十二，紫色十。"
   },
   {
    "start": 6.2125,
    "end": 9.2,
    "text": "顺着缩点图的边，一路变小。"
   },
   {
    "start": 9.2,
    "end": 17.8375,
    "text": "因为只要有边从甲块指向乙块，乙块里的点要么在甲块的递归里先走完，要么更早就结束了。"
   },
   {
    "start": 17.8375,
    "end": 22.1,
    "text": "所以栈顶的零，一定落在源头那块。"
   }
  ]
 },
 {
  "id": "transpose",
  "wav": "audio/transpose-461f83ca6bb2.wav",
  "seconds": 14.712,
  "cues": [
   {
    "start": 0.1,
    "end": 2.2,
    "text": "现在把所有边反过来。"
   },
   {
    "start": 2.15,
    "end": 9.3875,
    "text": "块的内部，绕环的方向反了，但仍然互相能到达；块和块之间的边全部掉头。"
   },
   {
    "start": 9.3875,
    "end": 14.65,
    "text": "原来的源头变成了终点，从它出发，走不出自己这一块。"
   }
  ]
 },
 {
  "id": "dfs2",
  "wav": "audio/dfs2-06781980db81.wav",
  "seconds": 26.04,
  "cues": [
   {
    "start": 0.1,
    "end": 4.8125,
    "text": "第二遍，在反过来的图上，按栈从顶到底取起点。"
   },
   {
    "start": 4.7625,
    "end": 10.6875,
    "text": "弹出零，走到三、二、一，再也走不出去，这是第一块。"
   },
   {
    "start": 10.6875,
    "end": 14.975,
    "text": "一、二、三已经访问过，跳过。"
   },
   {
    "start": 14.975,
    "end": 19.9125,
    "text": "弹出六，走到七，三已经访问过，这是第二块。"
   },
   {
    "start": 19.9125,
    "end": 22.9375,
    "text": "弹出五，走到四，第三块。"
   },
   {
    "start": 22.9375,
    "end": 25.975,
    "text": "栈空了，三块全部找到。"
   }
  ]
 },
 {
  "id": "code",
  "wav": "audio/code-0ecb4b6bfbcb.wav",
  "seconds": 16.584,
  "cues": [
   {
    "start": 0.1,
    "end": 3.2375,
    "text": "代码就是两个几乎一样的递归函数。"
   },
   {
    "start": 3.1875,
    "end": 10.1875,
    "text": "第一个在原图上走，结束时压栈；第二个在反图上走，把走到的点收进当前这一块。"
   },
   {
    "start": 10.1875,
    "end": 16.525,
    "text": "每个点、每条边都只处理常数次，复杂度是点数加边数。"
   }
  ]
 },
 {
  "id": "cows",
  "wav": "audio/cows-2e7994c580fb.wav",
  "seconds": 24.624,
  "cues": [
   {
    "start": 0.1,
    "end": 2.675,
    "text": "应用：受欢迎的奶牛。"
   },
   {
    "start": 2.625,
    "end": 7.8625,
    "text": "甲认为乙受欢迎，就画一条甲到乙的边，受欢迎可以传递。"
   },
   {
    "start": 7.8625,
    "end": 11.3375,
    "text": "问有几头牛被其他所有牛认为受欢迎。"
   },
   {
    "start": 11.3375,
    "end": 18.0125,
    "text": "缩点以后，如果只有一块没有出边，所有牛最后都流向它，答案就是这块的大小。"
   },
   {
    "start": 18.0125,
    "end": 24.575,
    "text": "样例里一和二是一块，指向三，三是唯一的终点，答案是一。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-e0d3201e3a66.wav",
  "seconds": 13.728,
  "cues": [
   {
    "start": 0.1,
    "end": 3.5375,
    "text": "强连通分量，两遍深度优先搜索。"
   },
   {
    "start": 3.4875,
    "end": 13.675,
    "text": "第一遍记结束顺序，结束最晚的点在源头那块；把图反过来，源头变成终点，第二遍每次都被困在一块里。"
   }
  ]
 }
]