[
 {
  "id": "title",
  "wav": "audio/title-3e845e13df19.wav",
  "seconds": 21.912,
  "cues": [
   {
    "start": 0.1,
    "end": 9.0125,
    "text": "在一大段文字里找一个词，是编辑器每天都在做的事；在三十亿个碱基里找一段基因，是生物信息学每天都在做的事。"
   },
   {
    "start": 8.9625,
    "end": 12.7875,
    "text": "最直接的办法，是一个起点一个起点地试。"
   },
   {
    "start": 12.7875,
    "end": 19.2,
    "text": "而克努特、莫里斯和普拉特发现，目标串上的指针其实一步都不用后退。"
   },
   {
    "start": 19.2,
    "end": 21.8625,
    "text": "这就是 KMP 算法。"
   }
  ]
 },
 {
  "id": "naive",
  "wav": "audio/naive-89fb2bd709b2.wav",
  "seconds": 29.664,
  "cues": [
   {
    "start": 0.1,
    "end": 2.0,
    "text": "先看朴素匹配。"
   },
   {
    "start": 1.95,
    "end": 7.3,
    "text": "目标串是 a b a b a b d，模式是 a b a b d。"
   },
   {
    "start": 7.3,
    "end": 12.8625,
    "text": "第一趟从零号位开始，前四个字符都相等，第五个字符失配。"
   },
   {
    "start": 12.8625,
    "end": 19.2,
    "text": "朴素算法把模式右移一位，目标指针从四号退回一号，从头再比。"
   },
   {
    "start": 19.2,
    "end": 24.95,
    "text": "第二趟一上来就失配，再右移一位；第三趟才配上，起点是二号。"
   },
   {
    "start": 24.95,
    "end": 29.6,
    "text": "一共比较了十一次，有好几个字符被比了不止一遍。"
   }
  ]
 },
 {
  "id": "waste",
  "wav": "audio/waste-6afe55910f8b.wav",
  "seconds": 29.4,
  "cues": [
   {
    "start": 0.1,
    "end": 1.75,
    "text": "浪费在哪里？"
   },
   {
    "start": 1.7,
    "end": 7.0375,
    "text": "失配之前，我们已经知道目标里这四个字符就是 a b a b。"
   },
   {
    "start": 7.0375,
    "end": 17.4375,
    "text": "它的真前缀有 a、a b、a b a，真后缀有 b、a b、b a b，最长的一对相同的是 a b，长度为二。"
   },
   {
    "start": 17.4375,
    "end": 24.2375,
    "text": "所以模式可以一次右移四减二，也就是两位，让开头的 a b 对准末尾的 a b。"
   },
   {
    "start": 24.2375,
    "end": 29.3375,
    "text": "这两个字符不用再比，直接从模式的二号位接着比。"
   }
  ]
 },
 {
  "id": "lps",
  "wav": "audio/lps-6e5598fc74cd.wav",
  "seconds": 23.688,
  "cues": [
   {
    "start": 0.1,
    "end": 7.4625,
    "text": "把这件事对模式的每一个前缀都提前算好，就得到一张表，叫最长相等前后缀表。"
   },
   {
    "start": 7.4125,
    "end": 15.3,
    "text": "表里第 i 格，是模式前 i 加一个字符里，相等的真前缀和真后缀最长有多长。"
   },
   {
    "start": 15.3,
    "end": 18.275,
    "text": "真，就是不能取整个串本身。"
   },
   {
    "start": 18.275,
    "end": 23.6375,
    "text": "这张表只依赖模式，和目标串无关，算一次就能反复用。"
   }
  ]
 },
 {
  "id": "build",
  "wav": "audio/build-ad29bb75ce12.wav",
  "seconds": 31.2,
  "cues": [
   {
    "start": 0.1,
    "end": 4.275,
    "text": "以讲义里的模式 A B A B C A B A B 为例。"
   },
   {
    "start": 4.225,
    "end": 8.2,
    "text": "求这张表，本身就是模式在跟自己匹配。"
   },
   {
    "start": 8.2,
    "end": 13.0125,
    "text": "下面这一行是模式的副本，长度指针指着它正在比的位置。"
   },
   {
    "start": 13.0125,
    "end": 20.3,
    "text": "下一个字符相等，长度加一；不相等，就退到表里前一格记下的长度，再试。"
   },
   {
    "start": 20.3,
    "end": 23.7875,
    "text": "到了 C，退到零也配不上，填零。"
   },
   {
    "start": 23.7875,
    "end": 28.475,
    "text": "之后 A B A B 又一路长上去，最后一格是四。"
   },
   {
    "start": 28.475,
    "end": 31.15,
    "text": "整张表只扫了一遍模式。"
   }
  ]
 },
 {
  "id": "search",
  "wav": "audio/search-179721eeac97.wav",
  "seconds": 23.712,
  "cues": [
   {
    "start": 0.1,
    "end": 3.125,
    "text": "回到开头的例子，用表来匹配。"
   },
   {
    "start": 3.075,
    "end": 5.55,
    "text": "目标指针 i 只往前走。"
   },
   {
    "start": 5.55,
    "end": 15.2125,
    "text": "前四个字符相等，模式指针 j 走到四号；第五个字符失配，j 退到表里三号格的值，也就是二，而 i 不动。"
   },
   {
    "start": 15.2125,
    "end": 19.3125,
    "text": "接着比，一路相等，配上了，起点是二号。"
   },
   {
    "start": 19.3125,
    "end": 23.65,
    "text": "这次只比较了八次，目标指针一次都没有后退。"
   }
  ]
 },
 {
  "id": "all",
  "wav": "audio/all-e780e212e827.wav",
  "seconds": 19.776,
  "cues": [
   {
    "start": 0.1,
    "end": 5.875,
    "text": "要找出全部出现位置，配上之后也按表回退，接着往下找。"
   },
   {
    "start": 5.825,
    "end": 10.8375,
    "text": "讲义里这一对串，目标二十七个字符，模式九个字符。"
   },
   {
    "start": 10.8375,
    "end": 19.7125,
    "text": "KMP 找到四号和十三号两处，一共比较三十三次；朴素算法每个起点都从头比，要比五十九次。"
   }
  ]
 },
 {
  "id": "linear",
  "wav": "audio/linear-20709d53112d.wav",
  "seconds": 27.216,
  "cues": [
   {
    "start": 0.1,
    "end": 1.8625,
    "text": "为什么是线性的？"
   },
   {
    "start": 1.8125,
    "end": 11.975,
    "text": "把两个指针画出来：目标指针 i 是一条只升不降的台阶；模式指针 j 涨涨落落，但它每退一步，之前一定先涨过一步。"
   },
   {
    "start": 11.975,
    "end": 15.8625,
    "text": "所以比较次数不超过目标长度的两倍。"
   },
   {
    "start": 15.8625,
    "end": 23.175,
    "text": "最坏的例子，在二十个 a 里找四个 a 加一个 b：朴素要比八十次，KMP 只要三十六次。"
   },
   {
    "start": 23.175,
    "end": 27.15,
    "text": "总代价是目标长度加模式长度。"
   }
  ]
 },
 {
  "id": "period",
  "wav": "audio/period-81674dfdb955.wav",
  "seconds": 29.568,
  "cues": [
   {
    "start": 0.1,
    "end": 5.1875,
    "text": "表的最后一格还藏着一个答案：字符串的最小循环节。"
   },
   {
    "start": 5.1375,
    "end": 9.8875,
    "text": "a b c a b c a b c 长九，最后一格是六。"
   },
   {
    "start": 9.8875,
    "end": 19.0625,
    "text": "把串错开九减六，也就是三位，重叠部分完全相同；三能整除九，所以它就是 a b c 重复三次。"
   },
   {
    "start": 19.0625,
    "end": 29.5,
    "text": "再看 a b a b a，五减三等于二，错开两位同样对得上，但二不整除五，它有周期二，却不是某个串的整数次重复。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-cadbecd0800b.wav",
  "seconds": 24.168,
  "cues": [
   {
    "start": 0.1,
    "end": 1.4875,
    "text": "回顾一下。"
   },
   {
    "start": 1.4375,
    "end": 8.05,
    "text": "朴素匹配一失配，目标指针就后退，最坏要比目标长度乘模式长度次。"
   },
   {
    "start": 8.05,
    "end": 16.025,
    "text": "KMP 先花模式长度的时间算出这张表，失配时只移动模式指针，目标指针只增不减。"
   },
   {
    "start": 16.025,
    "end": 24.1,
    "text": "讲义里的 next 数组，就是这张表整体右移一格，再做一步优化，失配后的落点是等价的。"
   }
  ]
 }
]