[
 {
  "id": "title",
  "wav": "audio/title-87098841c762.wav",
  "seconds": 14.52,
  "cues": [
   {
    "start": 0.1,
    "end": 5.75,
    "text": "在一大段文字里找一个词，最直接的办法是一个起点一个起点地试。"
   },
   {
    "start": 5.7,
    "end": 11.7875,
    "text": "克努特、莫里斯和普拉特发现，目标串上的指针一步都不用后退。"
   },
   {
    "start": 11.7875,
    "end": 14.45,
    "text": "这就是 KMP 算法。"
   }
  ]
 },
 {
  "id": "naive",
  "wav": "audio/naive-df3cb93ddc5b.wav",
  "seconds": 26.208,
  "cues": [
   {
    "start": 0.1,
    "end": 2.0,
    "text": "先看朴素匹配。"
   },
   {
    "start": 1.95,
    "end": 7.3,
    "text": "目标串是 a b a b a b d，模式是 a b a b d。"
   },
   {
    "start": 7.3,
    "end": 10.9125,
    "text": "第一趟前四个字符都相等，第五个失配。"
   },
   {
    "start": 10.9125,
    "end": 17.25,
    "text": "朴素算法把模式右移一位，目标指针从四号退回一号，从头再比。"
   },
   {
    "start": 17.25,
    "end": 21.8625,
    "text": "第二趟一上来就失配；第三趟才配上，起点是二号。"
   },
   {
    "start": 21.8625,
    "end": 26.15,
    "text": "一共比较了十一次，不少字符被比了好几遍。"
   }
  ]
 },
 {
  "id": "waste",
  "wav": "audio/waste-89033d065980.wav",
  "seconds": 26.4,
  "cues": [
   {
    "start": 0.1,
    "end": 1.75,
    "text": "浪费在哪里？"
   },
   {
    "start": 1.7,
    "end": 6.6875,
    "text": "失配之前，我们已经知道这四个字符是 a b a b。"
   },
   {
    "start": 6.6875,
    "end": 17.0875,
    "text": "它的真前缀有 a、a b、a b a，真后缀有 b、a b、b a b，最长的一对相同的是 a b，长度为二。"
   },
   {
    "start": 17.0875,
    "end": 21.2375,
    "text": "所以模式可以一次右移四减二，也就是两位。"
   },
   {
    "start": 21.2375,
    "end": 26.3375,
    "text": "这两个字符不用再比，直接从模式的二号位接着比。"
   }
  ]
 },
 {
  "id": "lps",
  "wav": "audio/lps-4aca96708c4b.wav",
  "seconds": 19.92,
  "cues": [
   {
    "start": 0.1,
    "end": 6.075,
    "text": "把这件事对每个前缀都提前算好，就得到最长相等前后缀表。"
   },
   {
    "start": 6.025,
    "end": 13.2625,
    "text": "表里第 i 格，是前 i 加一个字符里，相等的真前缀和真后缀最长有多长。"
   },
   {
    "start": 13.2625,
    "end": 16.2375,
    "text": "真，就是不能取整个串本身。"
   },
   {
    "start": 16.2375,
    "end": 19.8625,
    "text": "这张表只依赖模式，算一次反复用。"
   }
  ]
 },
 {
  "id": "build",
  "wav": "audio/build-3ccaf2efe8e7.wav",
  "seconds": 28.008,
  "cues": [
   {
    "start": 0.1,
    "end": 4.275,
    "text": "以讲义里的模式 A B A B C A B A B 为例。"
   },
   {
    "start": 4.225,
    "end": 7.1625,
    "text": "求表本身就是模式跟自己匹配。"
   },
   {
    "start": 7.1625,
    "end": 9.8,
    "text": "下面这一行是模式的副本。"
   },
   {
    "start": 9.8,
    "end": 17.0875,
    "text": "下一个字符相等，长度加一；不相等，就退到表里前一格记下的长度，再试。"
   },
   {
    "start": 17.0875,
    "end": 20.575,
    "text": "到了 C，退到零也配不上，填零。"
   },
   {
    "start": 20.575,
    "end": 25.2625,
    "text": "之后 A B A B 又一路长上去，最后一格是四。"
   },
   {
    "start": 25.2625,
    "end": 27.9375,
    "text": "整张表只扫了一遍模式。"
   }
  ]
 },
 {
  "id": "search",
  "wav": "audio/search-654c52c5238f.wav",
  "seconds": 21.096,
  "cues": [
   {
    "start": 0.1,
    "end": 1.8875,
    "text": "回到开头的例子。"
   },
   {
    "start": 1.8375,
    "end": 4.375,
    "text": "目标指针 i 只往前走。"
   },
   {
    "start": 4.375,
    "end": 13.6,
    "text": "前四个字符相等，模式指针 j 走到四号；第五个字符失配，j 退到表里三号格的值，也就是二，而 i 不动。"
   },
   {
    "start": 13.6,
    "end": 16.6875,
    "text": "接着比，一路相等，配上了。"
   },
   {
    "start": 16.6875,
    "end": 21.025,
    "text": "这次只比较了八次，目标指针一次都没有后退。"
   }
  ]
 },
 {
  "id": "all",
  "wav": "audio/all-7ff92da026b3.wav",
  "seconds": 19.392,
  "cues": [
   {
    "start": 0.1,
    "end": 5.0625,
    "text": "要找全部位置，配上之后也按表回退，接着找。"
   },
   {
    "start": 5.0125,
    "end": 10.025,
    "text": "讲义里这一对串，目标二十七个字符，模式九个字符。"
   },
   {
    "start": 10.025,
    "end": 19.325,
    "text": "朴素算法每个起点都从头比，要比五十九次；KMP 找到四号和十三号两处，一共只比较三十三次。"
   }
  ]
 },
 {
  "id": "linear",
  "wav": "audio/linear-d357467eb8fb.wav",
  "seconds": 24.528,
  "cues": [
   {
    "start": 0.1,
    "end": 1.8625,
    "text": "为什么是线性的？"
   },
   {
    "start": 1.8125,
    "end": 9.2875,
    "text": "目标指针 i 只升不降；模式指针 j 涨涨落落，但每退一步，之前一定先涨过一步。"
   },
   {
    "start": 9.2875,
    "end": 13.175,
    "text": "所以比较次数不超过目标长度的两倍。"
   },
   {
    "start": 13.175,
    "end": 20.4875,
    "text": "最坏的例子，在二十个 a 里找四个 a 加一个 b：朴素要比八十次，KMP 只要三十六次。"
   },
   {
    "start": 20.4875,
    "end": 24.4625,
    "text": "总代价是目标长度加模式长度。"
   }
  ]
 },
 {
  "id": "period",
  "wav": "audio/period-3703f9b02259.wav",
  "seconds": 25.656,
  "cues": [
   {
    "start": 0.1,
    "end": 3.6,
    "text": "表的最后一格还能求最小循环节。"
   },
   {
    "start": 3.55,
    "end": 8.3,
    "text": "a b c a b c a b c 长九，最后一格是六。"
   },
   {
    "start": 8.3,
    "end": 17.475,
    "text": "把串错开九减六，也就是三位，重叠部分完全相同；三能整除九，所以它就是 a b c 重复三次。"
   },
   {
    "start": 17.475,
    "end": 25.5875,
    "text": "再看 a b a b a，五减三等于二，但二不整除五，它有周期二，却不是整数次重复。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-dba5def79895.wav",
  "seconds": 20.496,
  "cues": [
   {
    "start": 0.1,
    "end": 1.4875,
    "text": "回顾一下。"
   },
   {
    "start": 1.4375,
    "end": 8.05,
    "text": "朴素匹配一失配，目标指针就后退，最坏要比目标长度乘模式长度次。"
   },
   {
    "start": 8.05,
    "end": 13.625,
    "text": "KMP 先花模式长度的时间建表，之后目标指针只增不减。"
   },
   {
    "start": 13.625,
    "end": 20.4375,
    "text": "讲义里的 next 数组，就是这张表整体右移一格再做一步优化，落点等价。"
   }
  ]
 }
]