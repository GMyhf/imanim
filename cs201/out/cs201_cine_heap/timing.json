[
 {
  "id": "title",
  "wav": "audio/title-48310ed1dd7a.wav",
  "seconds": 15.864,
  "cues": [
   {
    "start": 0.1,
    "end": 3.7,
    "text": "有一类问题总在问：现在最小的是哪个？"
   },
   {
    "start": 3.65,
    "end": 7.1125,
    "text": "每次都把所有数排一遍序，太贵了。"
   },
   {
    "start": 7.1125,
    "end": 11.4375,
    "text": "堆的回答是：让最小的永远待在最上面。"
   },
   {
    "start": 11.4375,
    "end": 15.8,
    "text": "而这棵树，其实就藏在一个普普通通的数组里。"
   }
  ]
 },
 {
  "id": "array",
  "wav": "audio/array-99a273b9fa14.wav",
  "seconds": 23.616,
  "cues": [
   {
    "start": 0.1,
    "end": 8.4125,
    "text": "把数组按层、从左往右排成一棵完全二叉树：除了最后一层，每层都排满，最后一层靠左。"
   },
   {
    "start": 8.3625,
    "end": 15.6375,
    "text": "下标 i 的左孩子是二 i 加一，右孩子是二 i 加二，父亲是 i 减一再整除二。"
   },
   {
    "start": 15.6375,
    "end": 21.1875,
    "text": "比如下标一的十四，孩子在下标三和下标四，父亲在下标零。"
   },
   {
    "start": 21.1875,
    "end": 23.5625,
    "text": "一根指针都不用。"
   }
  ]
 },
 {
  "id": "order",
  "wav": "audio/order-8ba28f731a32.wav",
  "seconds": 18.408,
  "cues": [
   {
    "start": 0.1,
    "end": 4.575,
    "text": "最小堆只要求一件事：每个父亲都不大于它的孩子。"
   },
   {
    "start": 4.525,
    "end": 7.9625,
    "text": "所以根一定是最小的，十二。"
   },
   {
    "start": 7.9625,
    "end": 14.325,
    "text": "但兄弟之间没有任何约定，左边子树里的十九，反而比右边子树里的十七大。"
   },
   {
    "start": 14.325,
    "end": 18.35,
    "text": "堆只是局部有序，这正是它便宜的原因。"
   }
  ]
 },
 {
  "id": "insert",
  "wav": "audio/insert-5e2748002179.wav",
  "seconds": 23.904,
  "cues": [
   {
    "start": 0.1,
    "end": 1.675,
    "text": "插入十三。"
   },
   {
    "start": 1.625,
    "end": 6.7875,
    "text": "先放在数组末尾，也就是最后一层的下一个空位，下标十。"
   },
   {
    "start": 6.7875,
    "end": 9.4125,
    "text": "它比父亲二十小，交换。"
   },
   {
    "start": 9.4125,
    "end": 12.625,
    "text": "又比新的父亲十四小，再交换。"
   },
   {
    "start": 12.625,
    "end": 16.425,
    "text": "父亲成了根十二，十二比十三小，停。"
   },
   {
    "start": 16.425,
    "end": 18.1625,
    "text": "只交换了两次。"
   },
   {
    "start": 18.1625,
    "end": 23.8375,
    "text": "一路最多爬到根，所以插入的代价不超过树高，也就是 log n。"
   }
  ]
 },
 {
  "id": "remove",
  "wav": "audio/remove-349e6a76231c.wav",
  "seconds": 27.768,
  "cues": [
   {
    "start": 0.1,
    "end": 2.9,
    "text": "取走最小的，堆顶十二。"
   },
   {
    "start": 2.85,
    "end": 5.2,
    "text": "空出来的根拿谁来补？"
   },
   {
    "start": 5.2,
    "end": 12.325,
    "text": "拿最后一个元素二十，因为只有拿掉最后一个位置，剩下的才仍然是完全二叉树。"
   },
   {
    "start": 12.325,
    "end": 17.5375,
    "text": "二十往下沉：两个孩子十三和十五，和较小的十三交换。"
   },
   {
    "start": 17.5375,
    "end": 23.075,
    "text": "必须换较小的那个，要是换成十五，十五就压在十三头上了。"
   },
   {
    "start": 23.075,
    "end": 27.7,
    "text": "再和孩子十四交换，下面只剩二十六，停。"
   }
  ]
 },
 {
  "id": "build",
  "wav": "audio/build-25b89e31019c.wav",
  "seconds": 26.712,
  "cues": [
   {
    "start": 0.1,
    "end": 3.15,
    "text": "一组乱序的数，怎样变成堆？"
   },
   {
    "start": 3.1,
    "end": 8.6625,
    "text": "从最后一个非叶结点开始，倒着往前，每个结点做一次下沉。"
   },
   {
    "start": 8.6625,
    "end": 13.4,
    "text": "八个数，从下标三的六十五开始，和四十五交换。"
   },
   {
    "start": 13.4,
    "end": 16.2,
    "text": "下标二的三十五，和三交换。"
   },
   {
    "start": 16.2,
    "end": 18.3875,
    "text": "下标一的八，不用动。"
   },
   {
    "start": 18.3875,
    "end": 22.1875,
    "text": "最后是根上的十九，先换三，再换七。"
   },
   {
    "start": 22.1875,
    "end": 26.6625,
    "text": "叶子本身就是堆，后一半结点一次都不用碰。"
   }
  ]
 },
 {
  "id": "cost",
  "wav": "audio/cost-820742e5297b.wav",
  "seconds": 27.96,
  "cues": [
   {
    "start": 0.1,
    "end": 2.4375,
    "text": "这样建堆要多少步？"
   },
   {
    "start": 2.3875,
    "end": 6.0875,
    "text": "粗看是一半的结点，每个下沉 log n 层。"
   },
   {
    "start": 6.0875,
    "end": 10.1125,
    "text": "细算一下，把它放大成每层排满的十五个结点。"
   },
   {
    "start": 10.1125,
    "end": 13.5625,
    "text": "下沉的距离是离最底层还有多远。"
   },
   {
    "start": 13.5625,
    "end": 23.675,
    "text": "根只有一个，最多沉三层；第二层两个，各沉两层；第三层四个，各沉一层；最底层八个，一步都不用沉。"
   },
   {
    "start": 23.675,
    "end": 27.9,
    "text": "加起来是三加四加四加零，十一。"
   }
  ]
 },
 {
  "id": "compare",
  "wav": "audio/compare-0257e822d158.wav",
  "seconds": 22.584,
  "cues": [
   {
    "start": 0.1,
    "end": 2.0625,
    "text": "换成一个一个插入呢？"
   },
   {
    "start": 2.0125,
    "end": 10.275,
    "text": "上浮的距离是离根有多远，最底层八个结点各要浮三层，光这一层就是二十四，总共三十四。"
   },
   {
    "start": 10.275,
    "end": 16.325,
    "text": "同一个事实，多数结点在底层，对下沉是好事，对上浮是坏事。"
   },
   {
    "start": 16.325,
    "end": 22.525,
    "text": "一般地，下沉的总代价小于二 n，所以建堆是线性时间。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-89c3ac1a88f7.wav",
  "seconds": 18.192,
  "cues": [
   {
    "start": 0.1,
    "end": 8.475,
    "text": "堆就是一个优先队列：看堆顶是常数时间，插入和取最小都是 log n，建堆只要线性时间。"
   },
   {
    "start": 8.425,
    "end": 12.4625,
    "text": "堆排序，就是建好堆以后反复取走堆顶。"
   },
   {
    "start": 12.4625,
    "end": 18.125,
    "text": "下一个故事里，每一步都要取出最小的两个数，用的正是堆。"
   }
  ]
 }
]