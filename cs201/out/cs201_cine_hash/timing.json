[
 {
  "id": "title",
  "wav": "audio/title-021267837baf.wav",
  "seconds": 18.648,
  "cues": [
   {
    "start": 0.1,
    "end": 7.325,
    "text": "顺序查找、二分查找，靠的都是关键字之间的比较，表越长，比得越多。"
   },
   {
    "start": 7.275,
    "end": 13.8875,
    "text": "散列换了个思路：不比较，直接用一个函数把关键字算成地址，一步到位。"
   },
   {
    "start": 13.8875,
    "end": 18.5875,
    "text": "这个函数叫散列函数，这个数组叫散列表。"
   }
  ]
 },
 {
  "id": "modfn",
  "wav": "audio/modfn-b79dc8bd9652.wav",
  "seconds": 22.896,
  "cues": [
   {
    "start": 0.1,
    "end": 5.775,
    "text": "最常用的是除留余数法：地址等于关键字除以表长的余数。"
   },
   {
    "start": 5.725,
    "end": 8.1,
    "text": "讲义里表长是十一。"
   },
   {
    "start": 8.1,
    "end": 18.6,
    "text": "五十四除以十一余十，放进十号槽；二十六放四号，九十三放五号，十七放六号，七十七放零号，三十一放九号。"
   },
   {
    "start": 18.6,
    "end": 22.825,
    "text": "这六个关键字各占一个槽，互不相干。"
   }
  ]
 },
 {
  "id": "collide",
  "wav": "audio/collide-88ac35fb11e2.wav",
  "seconds": 30.864,
  "cues": [
   {
    "start": 0.1,
    "end": 5.5875,
    "text": "接下来是四十四，除以十一余零，可零号槽已经被七十七占了。"
   },
   {
    "start": 5.5375,
    "end": 9.875,
    "text": "两个不同的关键字算出同一个地址，这叫冲突。"
   },
   {
    "start": 9.875,
    "end": 15.575,
    "text": "线性探测的办法很朴素：往后挪一格，一号槽空着，放进去。"
   },
   {
    "start": 15.575,
    "end": 20.5625,
    "text": "五十五也余零，零号、一号都满了，挪到二号。"
   },
   {
    "start": 20.5625,
    "end": 30.8,
    "text": "二十余九，从九号开始，经过十号，绕回零号、一号、二号，一直挪到三号才找到空位，看了六个槽。"
   }
  ]
 },
 {
  "id": "cluster",
  "wav": "audio/cluster-e56d7a315631.wav",
  "seconds": 25.224,
  "cues": [
   {
    "start": 0.1,
    "end": 6.5375,
    "text": "现在从九号到六号，连续九个槽首尾相接，挤成了一整块，这叫聚集。"
   },
   {
    "start": 6.4875,
    "end": 20.475,
    "text": "下一个关键字，只要基地址落在这一块里，或者正好是七，最后都会落进七号槽，概率是十一分之十；而八号槽只有基地址恰好是八才轮得到，概率是十一分之一。"
   },
   {
    "start": 20.475,
    "end": 25.175,
    "text": "块越大越容易再变大，小聚集会连成大聚集。"
   }
  ]
 },
 {
  "id": "lookup",
  "wav": "audio/lookup-b93d5099cdc9.wav",
  "seconds": 22.416,
  "cues": [
   {
    "start": 0.1,
    "end": 2.4875,
    "text": "查找走的是同一条路。"
   },
   {
    "start": 2.4375,
    "end": 7.5,
    "text": "找二十，从九号开始比，一路比到三号，比较了六次。"
   },
   {
    "start": 7.5,
    "end": 16.425,
    "text": "找九十九，余数是零，从零号一路比到六号，比了七次都不是，碰到空着的七号槽，才能断定它不在表里。"
   },
   {
    "start": 16.425,
    "end": 22.35,
    "text": "表里九个元素、十一个槽，装填因子是十一分之九，已经很满了。"
   }
  ]
 },
 {
  "id": "quad",
  "wav": "audio/quad-807940e46dd5.wav",
  "seconds": 30.192,
  "cues": [
   {
    "start": 0.1,
    "end": 8.2,
    "text": "二次探测换一种挪法：冲突时依次试加一、减一、加四、减四，左右来回跳。"
   },
   {
    "start": 8.15,
    "end": 15.3625,
    "text": "讲义练习里，表长十一，依次插入二十四、十三、三十五、十五、十四。"
   },
   {
    "start": 15.3625,
    "end": 25.475,
    "text": "用线性探测，它们挤成二号到六号连续的一整块；用二次探测，三十五跳到一号，十四跳到七号，块被打散了。"
   },
   {
    "start": 25.475,
    "end": 30.1375,
    "text": "基地址不同的关键字，不再争抢同一串后继位置。"
   }
  ]
 },
 {
  "id": "chain",
  "wav": "audio/chain-249b98e165a6.wav",
  "seconds": 23.736,
  "cues": [
   {
    "start": 0.1,
    "end": 8.25,
    "text": "另一条路是拉链法：每个槽挂一条链表，地址相同的关键字都串在这条链上，不去占别人的位置。"
   },
   {
    "start": 8.2,
    "end": 17.8,
    "text": "讲义例题表长十三，十二个关键字里，十四、一、二十七、七十九都余一，挂成一条长度为四的链。"
   },
   {
    "start": 17.8,
    "end": 23.6875,
    "text": "拉链法没有聚集，删除也方便，装填因子甚至可以超过一。"
   }
  ]
 },
 {
  "id": "load",
  "wav": "audio/load-29f749d4476e.wav",
  "seconds": 28.776,
  "cues": [
   {
    "start": 0.1,
    "end": 6.05,
    "text": "装填因子，就是元素个数除以表长，它决定了平均要比几次。"
   },
   {
    "start": 6.0,
    "end": 17.8,
    "text": "线性探测成功查找的平均比较次数，装填因子零点五时是一点五次，零点八时变成三次，零点九时是五点五次，越靠近一，曲线越陡。"
   },
   {
    "start": 17.8,
    "end": 20.425,
    "text": "拉链法只是缓缓上升。"
   },
   {
    "start": 20.425,
    "end": 28.725,
    "text": "所以实际系统在装填因子超过阈值时就扩表，按新表长把所有关键字重新散列一遍。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-485985014dfb.wav",
  "seconds": 23.16,
  "cues": [
   {
    "start": 0.1,
    "end": 1.4875,
    "text": "回顾一下。"
   },
   {
    "start": 1.4375,
    "end": 9.925,
    "text": "散列用函数把关键字直接算成地址，平均比较次数只和装填因子有关，和表里有多少元素无关。"
   },
   {
    "start": 9.925,
    "end": 19.5,
    "text": "冲突躲不开：线性探测简单，但会聚集；二次探测左右跳，打散聚集；拉链法把同义词串成链。"
   },
   {
    "start": 19.5,
    "end": 23.1,
    "text": "装填因子一大，就扩表重新散列。"
   }
  ]
 }
]