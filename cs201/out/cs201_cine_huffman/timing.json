[
 {
  "id": "title",
  "wav": "audio/title-76f52062bec4.wav",
  "seconds": 17.208,
  "cues": [
   {
    "start": 0.1,
    "end": 8.2375,
    "text": "一段电文，a、b、b、a、a、a、d、c，一共四种字符。"
   },
   {
    "start": 8.1875,
    "end": 11.8375,
    "text": "如果每个字符都用两位，一共十六位。"
   },
   {
    "start": 11.8375,
    "end": 13.5375,
    "text": "能不能更短？"
   },
   {
    "start": 13.5375,
    "end": 17.1375,
    "text": "出现得多的字符，就给它更短的码。"
   }
  ]
 },
 {
  "id": "prefix",
  "wav": "audio/prefix-ba3cbba50ebd.wav",
  "seconds": 26.568,
  "cues": [
   {
    "start": 0.1,
    "end": 5.9,
    "text": "试试 a 用零，b 用一，c 用零一，d 用一零。"
   },
   {
    "start": 5.85,
    "end": 14.3125,
    "text": "电文确实变短了，却没法译码：收到零一一，可以读成 a、b、b，也可以读成 c、b。"
   },
   {
    "start": 14.3125,
    "end": 21.575,
    "text": "毛病出在前缀上，零是零一的前缀，读到零的时候，不知道该停下还是接着读。"
   },
   {
    "start": 21.575,
    "end": 26.5,
    "text": "所以要求任何一个编码，都不能是另一个编码的前缀。"
   }
  ]
 },
 {
  "id": "wpl",
  "wav": "audio/wpl-672237c2258d.wav",
  "seconds": 23.64,
  "cues": [
   {
    "start": 0.1,
    "end": 5.5,
    "text": "编码可以画成一棵树：字符放在叶子上，码长就是叶子的深度。"
   },
   {
    "start": 5.45,
    "end": 9.425,
    "text": "权乘深度再求和，叫带权路径长度。"
   },
   {
    "start": 9.425,
    "end": 19.225,
    "text": "同样四个权，六、二、三、四，树的形状不同，结果也不同：三十、三十一、二十九。"
   },
   {
    "start": 19.225,
    "end": 23.5875,
    "text": "权大的叶子离根越近，总长就越小。"
   }
  ]
 },
 {
  "id": "build1",
  "wav": "audio/build1-741b143c8859.wav",
  "seconds": 23.832,
  "cues": [
   {
    "start": 0.1,
    "end": 8.025,
    "text": "哈夫曼的做法只有一句话：每次取出权最小的两棵树，合并成一棵，新根的权是两者之和。"
   },
   {
    "start": 7.975,
    "end": 15.3,
    "text": "七个字符，频率是十五、二、六、五、二十、十、十八。"
   },
   {
    "start": 15.3,
    "end": 18.0375,
    "text": "最小的是二和五，合成七。"
   },
   {
    "start": 18.0375,
    "end": 23.775,
    "text": "接着六和七合成十三，十和十三合成二十三。"
   }
  ]
 },
 {
  "id": "build2",
  "wav": "audio/build2-8596f390d68f.wav",
  "seconds": 17.856,
  "cues": [
   {
    "start": 0.1,
    "end": 10.3125,
    "text": "再是十五和十八合成三十三，二十和二十三合成四十三，最后三十三和四十三合成七十六，整棵树长成了。"
   },
   {
    "start": 10.2625,
    "end": 17.7875,
    "text": "每一轮都要取最小的两个，用最小堆，一轮只要 log n，全部合并完是 n log n。"
   }
  ]
 },
 {
  "id": "code",
  "wav": "audio/code-4ae979b52521.wav",
  "seconds": 14.688,
  "cues": [
   {
    "start": 0.1,
    "end": 3.175,
    "text": "左边的边标零，右边的边标一。"
   },
   {
    "start": 3.125,
    "end": 7.7,
    "text": "从根走到叶子，一路读下来就是这个字符的编码。"
   },
   {
    "start": 7.7,
    "end": 14.6375,
    "text": "出现最多的 e、g、a 只要两位，出现最少的 b 和 d 要五位。"
   }
  ]
 },
 {
  "id": "total",
  "wav": "audio/total-81994081b12c.wav",
  "seconds": 25.296,
  "cues": [
   {
    "start": 0.1,
    "end": 4.8,
    "text": "总长是每个字符的频率乘码长，加起来一百九十五位。"
   },
   {
    "start": 4.75,
    "end": 9.8625,
    "text": "七个字符用等长编码，每个要三位，一共二百二十八位。"
   },
   {
    "start": 9.8625,
    "end": 19.225,
    "text": "再把所有内部结点的权加起来，七、十三、二十三、三十三、四十三、七十六，也是一百九十五。"
   },
   {
    "start": 19.225,
    "end": 25.2375,
    "text": "这不是巧合，每个叶子的权，在它的每个祖先里各被加了一次。"
   }
  ]
 },
 {
  "id": "decode",
  "wav": "audio/decode-0539b34d2cf7.wav",
  "seconds": 21.696,
  "cues": [
   {
    "start": 0.1,
    "end": 1.9125,
    "text": "为什么不会有歧义？"
   },
   {
    "start": 1.8625,
    "end": 10.05,
    "text": "字符只住在叶子上，一个叶子不可能在另一个叶子的路上，所以没有哪个编码是别人的前缀。"
   },
   {
    "start": 10.05,
    "end": 17.25,
    "text": "译码就用同一棵树：读零走左，读一走右，走到叶子吐出一个字符，再回到根。"
   },
   {
    "start": 17.25,
    "end": 21.6375,
    "text": "这串比特译出来是 c、a、f、e。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-8e8dc380d945.wav",
  "seconds": 23.4,
  "cues": [
   {
    "start": 0.1,
    "end": 11.7125,
    "text": "回到开头的电文：a 用零，b 用一零，c 和 d 用三位，一共十四位，比十六位短，十四正好是这棵树的带权路径长度。"
   },
   {
    "start": 11.6625,
    "end": 19.7,
    "text": "但如果八个字符的频率完全相同，建出来的就是一棵满树，每个字符三位，一位也省不下。"
   },
   {
    "start": 19.7,
    "end": 23.3375,
    "text": "压缩的收益，全部来自频率的不均匀。"
   }
  ]
 }
]