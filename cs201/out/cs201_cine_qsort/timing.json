[
 {
  "id": "title",
  "wav": "audio/title-ce469dfe8fe5.wav",
  "seconds": 15.912,
  "cues": [
   {
    "start": 0.1,
    "end": 2.65,
    "text": "二十二个数，乱序排着。"
   },
   {
    "start": 2.6,
    "end": 8.5,
    "text": "快速排序挑一个数当基准，比它小的赶到左边，比它大的赶到右边。"
   },
   {
    "start": 8.5,
    "end": 11.4375,
    "text": "基准一落地，就再也不用动了。"
   },
   {
    "start": 11.4375,
    "end": 15.8625,
    "text": "左右两段再这样分下去，直到每个数都落了地。"
   }
  ]
 },
 {
  "id": "idea",
  "wav": "audio/idea-546ac8d57134.wav",
  "seconds": 23.328,
  "cues": [
   {
    "start": 0.1,
    "end": 1.5125,
    "text": "看九个数。"
   },
   {
    "start": 1.4625,
    "end": 3.6,
    "text": "取第一个数五当基准。"
   },
   {
    "start": 3.6,
    "end": 12.65,
    "text": "比五小的一、二、三、四，应该去左边；比五大的六、七、八、九，应该去右边。"
   },
   {
    "start": 12.65,
    "end": 19.0,
    "text": "分完之后，五正好站在第五个位置，这就是它排好以后的最终位置。"
   },
   {
    "start": 19.0,
    "end": 23.275,
    "text": "接下来对左右两段分别递归，不需要再合并。"
   }
  ]
 },
 {
  "id": "partition",
  "wav": "audio/partition-c7fa42392173.wav",
  "seconds": 31.752,
  "cues": [
   {
    "start": 0.1,
    "end": 1.475,
    "text": "怎么原地分？"
   },
   {
    "start": 1.425,
    "end": 4.325,
    "text": "讲义用成对交换的写法。"
   },
   {
    "start": 4.325,
    "end": 11.225,
    "text": "左指针从左往右，找第一个比基准大的；右指针从右往左，找第一个比基准小的。"
   },
   {
    "start": 11.225,
    "end": 15.7375,
    "text": "左指针停在九，右指针停在四，两者交换。"
   },
   {
    "start": 15.7375,
    "end": 20.6375,
    "text": "继续走，左指针停在七，右指针停在三，再交换。"
   },
   {
    "start": 20.6375,
    "end": 27.05,
    "text": "再走，左指针停在八，右指针退到一，两个指针交错了，扫描结束。"
   },
   {
    "start": 27.05,
    "end": 31.7,
    "text": "最后把基准和右指针处的一交换，五归位。"
   }
  ]
 },
 {
  "id": "tree",
  "wav": "audio/tree-55224a7db268.wav",
  "seconds": 19.92,
  "cues": [
   {
    "start": 0.1,
    "end": 4.625,
    "text": "左右两段继续分，每个基准都落在自己的最终位置。"
   },
   {
    "start": 4.575,
    "end": 12.65,
    "text": "把每次的基准画成结点，左段的基准挂在左边，右段的基准挂在右边，就得到一棵二叉搜索树。"
   },
   {
    "start": 12.65,
    "end": 19.85,
    "text": "从左往右读这棵树，正好是排好的顺序；树有多高，快排就要递归多少层。"
   }
  ]
 },
 {
  "id": "cost",
  "wav": "audio/cost-d2f5b16f5f7e.wav",
  "seconds": 15.48,
  "cues": [
   {
    "start": 0.1,
    "end": 1.65,
    "text": "代价有多大？"
   },
   {
    "start": 1.6,
    "end": 5.975,
    "text": "同一层的所有分割，加起来最多把 n 个数各看一遍。"
   },
   {
    "start": 5.975,
    "end": 11.4875,
    "text": "如果每次都恰好对半分，树高是 log n，总共是 n log n。"
   },
   {
    "start": 11.4875,
    "end": 15.4125,
    "text": "随机的输入，平均下来也是 n log n。"
   }
  ]
 },
 {
  "id": "worst",
  "wav": "audio/worst-37c59e88a199.wav",
  "seconds": 23.664,
  "cues": [
   {
    "start": 0.1,
    "end": 2.2125,
    "text": "可要是输入已经有序呢？"
   },
   {
    "start": 2.1625,
    "end": 7.175,
    "text": "首元素是最小的，分完左边是空的，右边只少了一个。"
   },
   {
    "start": 7.175,
    "end": 12.525,
    "text": "九个数，树退化成一条链，九层深，比较了四十四次。"
   },
   {
    "start": 12.525,
    "end": 17.8375,
    "text": "一千个有序的数，要比较大约五十万次，递归一千层。"
   },
   {
    "start": 17.8375,
    "end": 23.6125,
    "text": "Python 默认的递归上限大约就是一千，直接抛出递归错误。"
   }
  ]
 },
 {
  "id": "random",
  "wav": "audio/random-c1482b562bed.wav",
  "seconds": 21.216,
  "cues": [
   {
    "start": 0.1,
    "end": 7.0,
    "text": "办法是随机挑基准：随机选一个位置，先和首元素交换，再照常分割。"
   },
   {
    "start": 6.95,
    "end": 10.675,
    "text": "同样是有序的九个数，树一下子变矮了。"
   },
   {
    "start": 10.675,
    "end": 16.425,
    "text": "一千个有序的数，比较大约一万两千次，递归只有二十五层。"
   },
   {
    "start": 16.425,
    "end": 21.1625,
    "text": "没有哪种输入固定是坏的，坏情况只取决于运气。"
   }
  ]
 },
 {
  "id": "merge",
  "wav": "audio/merge-ba8eaacdf868.wav",
  "seconds": 27.048,
  "cues": [
   {
    "start": 0.1,
    "end": 2.375,
    "text": "和归并排序比一比。"
   },
   {
    "start": 2.325,
    "end": 8.15,
    "text": "归并按位置一刀切开，分得毫不费力，力气全花在最后的合并上。"
   },
   {
    "start": 8.15,
    "end": 16.45,
    "text": "快排正好反过来，力气花在分割上，分完基准就位，两段各自排好就直接连在一起，不用合。"
   },
   {
    "start": 16.45,
    "end": 22.175,
    "text": "所以快排是原地排序，额外空间只是递归栈，平均 log n。"
   },
   {
    "start": 22.175,
    "end": 26.9875,
    "text": "代价是不稳定，相等的元素可能被换乱次序。"
   }
  ]
 },
 {
