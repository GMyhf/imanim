[
 {
  "id": "title",
  "wav": "audio/title-8fcb4d5f16fd.wav",
  "seconds": 18.72,
  "cues": [
   {
    "start": 0.1,
    "end": 8.95,
    "text": "这一支精讲一道例题：滑动窗口最大值，LeetCode 第二百三十九题，OpenJudge 两万六千九百七十八题。"
   },
   {
    "start": 8.9,
    "end": 12.725,
    "text": "机考里单调队列的题，大多从它变化而来。"
   },
   {
    "start": 12.725,
    "end": 18.65,
    "text": "我们按读题、找规律、建模、写代码、算复杂度走一遍。"
   }
  ]
 },
 {
  "id": "read",
  "wav": "audio/read-a0d450cc674b.wav",
  "seconds": 23.088,
  "cues": [
   {
    "start": 0.1,
    "end": 3.175,
    "text": "给一个整数数组和窗口大小 k。"
   },
   {
    "start": 3.125,
    "end": 9.125,
    "text": "窗口从最左边出发，每次右移一格，输出每个窗口里的最大值。"
   },
   {
    "start": 9.125,
    "end": 16.75,
    "text": "样例是一、三、负一、负三、五、三、六、七，k 等于三。"
   },
   {
    "start": 16.75,
    "end": 23.025,
    "text": "答案是三、三、五、五、六、七，一共六个窗口。"
   }
  ]
 },
 {
  "id": "brute",
  "wav": "audio/brute-98cd6a4e0c89.wav",
  "seconds": 20.28,
  "cues": [
   {
    "start": 0.1,
    "end": 5.0625,
    "text": "最直接的办法是每个窗口从头比一遍，比 k 减一次。"
   },
   {
    "start": 5.0125,
    "end": 7.85,
    "text": "样例六个窗口，共比十二次。"
   },
   {
    "start": 7.85,
    "end": 14.4125,
    "text": "可是 n 能到十万，取 k 等于五万，就要比将近二十五亿次，一定超时。"
   },
   {
    "start": 14.4125,
    "end": 20.2125,
    "text": "相邻两个窗口有 k 减一个数是重叠的，却被重新比了一遍。"
   }
  ]
 },
 {
  "id": "observe",
  "wav": "audio/observe-4e6ac568dd65.wav",
  "seconds": 22.752,
  "cues": [
   {
    "start": 0.1,
    "end": 3.775,
    "text": "关键观察：有些数可以永远不再考虑。"
   },
   {
    "start": 3.725,
    "end": 6.8125,
    "text": "三进来时，它左边的一比它小。"
   },
   {
    "start": 6.8125,
    "end": 13.275,
    "text": "一比三先离开窗口，又比三小，一就不可能再当最大值，可以直接扔掉。"
   },
   {
    "start": 13.275,
    "end": 18.2875,
    "text": "换句话说，新来的数会淘汰它前面所有不比它大的数。"
   },
   {
    "start": 18.2875,
    "end": 22.7,
    "text": "留下来的候选人，从左到右一定是递减的。"
   }
  ]
 },
 {
  "id": "model",
  "wav": "audio/model-56b5f681def5.wav",
  "seconds": 21.384,
  "cues": [
   {
    "start": 0.1,
    "end": 4.7625,
    "text": "于是用双端队列存候选人，从队首到队尾递减。"
   },
   {
    "start": 4.7125,
    "end": 8.875,
    "text": "新数进来之前，先从队尾弹掉不比它大的。"
   },
   {
    "start": 8.875,
    "end": 17.4625,
    "text": "队首最大，但可能已经滑出窗口，所以队列里存下标，下标小于等于 i 减 k 就从队首弹出。"
   },
   {
    "start": 17.4625,
    "end": 21.325,
    "text": "剩下的队首，就是当前窗口的最大值。"
   }
  ]
 },
 {
  "id": "run",
  "wav": "audio/run-0f183384f709.wav",
  "seconds": 30.528,
  "cues": [
   {
    "start": 0.1,
    "end": 2.0125,
    "text": "在样例上跑一遍。"
   },
   {
    "start": 1.9625,
    "end": 3.275,
    "text": "一入队。"
   },
   {
    "start": 3.275,
    "end": 5.7,
    "text": "三来了，弹掉一。"
   },
   {
    "start": 5.7,
    "end": 10.175,
    "text": "负一入队，第一个窗口满了，输出队首三。"
   },
   {
    "start": 10.175,
    "end": 12.6875,
    "text": "负三入队，输出三。"
   },
   {
    "start": 12.6875,
    "end": 22.5625,
    "text": "五来了，先看队首：三的下标是一，已经滑出窗口，弹掉；再从队尾弹掉负三和负一，五入队，输出五。"
   },
   {
    "start": 22.5625,
    "end": 24.9625,
    "text": "三入队，输出五。"
   },
   {
    "start": 24.9625,
    "end": 28.2125,
    "text": "六弹掉三和五，七弹掉六。"
   },
   {
    "start": 28.2125,
    "end": 30.4625,
    "text": "结果和样例一致。"
   }
  ]
 },
 {
  "id": "code",
  "wav": "audio/code-3afde26bb94b.wav",
  "seconds": 17.328,
  "cues": [
   {
    "start": 0.1,
    "end": 2.95,
    "text": "代码是一个循环套两个 while。"
   },
   {
    "start": 2.9,
    "end": 10.1,
    "text": "第一个从队首弹出过期的下标，第二个从队尾弹出不比新数大的，然后新下标入队。"
   },
   {
    "start": 10.1,
    "end": 14.1875,
    "text": "i 到了 k 减一以后，每一步输出队首对应的值。"
   },
   {
    "start": 14.1875,
    "end": 17.2625,
    "text": "比较的是值，存的是下标。"
   }
  ]
 },
 {
  "id": "cost",
  "wav": "audio/cost-412c947ce687.wav",
  "seconds": 19.488,
  "cues": [
   {
    "start": 0.1,
    "end": 6.4625,
    "text": "两个 while 套在 for 里，看着像平方，其实每个下标只入队一次，最多出队一次。"
   },
   {
    "start": 6.4125,
    "end": 9.325,
    "text": "样例入队八次，出队七次。"
   },
   {
    "start": 9.325,
    "end": 12.5875,
    "text": "总操作不超过二 n，是线性时间。"
   },
   {
    "start": 12.5875,
    "end": 19.425,
    "text": "n 等于十万，大约二十万次操作，比起暴力的二十五亿次，快了一万倍以上。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-1e51fa4f45b9.wav",
  "seconds": 24.384,
  "cues": [
   {
    "start": 0.1,
    "end": 9.525,
    "text": "回顾：读题找出重复工作，观察到被淘汰的数永不翻身，用存下标的单调队列建模，每个数进出各一次。"
   },
   {
    "start": 9.475,
    "end": 24.325,
    "text": "同类题可以练：窗口最小值，把递减改成递增；讲义上的 Flowerpot，洛谷 P2698；还有单调栈的 OpenJudge 04137 最小新整数和 26977 接雨水。"
   }
  ]
 }
]