[
 {
  "id": "title",
  "wav": "audio/title-2d60cfab5029.wav",
  "seconds": 12.48,
  "cues": [
   {
    "start": 0.1,
    "end": 3.8875,
    "text": "学数据结构之前，得先学程序设计。"
   },
   {
    "start": 3.8375,
    "end": 9.8375,
    "text": "一大堆课，一大堆先修关系，怎样排出一张不会先后颠倒的课表？"
   },
   {
    "start": 9.8375,
    "end": 12.4125,
    "text": "这一集，拓扑排序。"
   }
  ]
 },
 {
  "id": "dag",
  "wav": "audio/dag-5b72cf2411e5.wav",
  "seconds": 25.68,
  "cues": [
   {
    "start": 0.1,
    "end": 4.3625,
    "text": "把每门课画成一个点，先修关系画成一条有向边。"
   },
   {
    "start": 4.3125,
    "end": 10.45,
    "text": "高等数学指向离散数学，意思是先学高数，才能学离散。"
   },
   {
    "start": 10.45,
    "end": 13.25,
    "text": "这里有九门课，十一条边。"
   },
   {
    "start": 13.25,
    "end": 19.7875,
    "text": "我们要把九门课排成一行，让每一条边都从左指向右，这样的一行叫拓扑序。"
   },
   {
    "start": 19.7875,
    "end": 25.6125,
    "text": "能排出来的前提是图里没有环，这种图叫有向无环图。"
   }
  ]
 },
 {
  "id": "indeg",
  "wav": "audio/indeg-779cf9e2b6bc.wav",
  "seconds": 15.6,
  "cues": [
   {
    "start": 0.1,
    "end": 1.9125,
    "text": "从哪门课开始？"
   },
   {
    "start": 1.8625,
    "end": 5.175,
    "text": "看入度，也就是有几条边指向它。"
   },
   {
    "start": 5.175,
    "end": 10.9875,
    "text": "高等数学和程序设计，入度都是零，没有先修课，可以直接学。"
   },
   {
    "start": 10.9875,
    "end": 15.5375,
    "text": "离散数学入度是二，要等两门先修课都学完。"
   }
  ]
 },
 {
  "id": "code",
  "wav": "audio/code-ea8db41941d9.wav",
  "seconds": 20.448,
  "cues": [
   {
    "start": 0.1,
    "end": 2.7125,
    "text": "卡恩算法只做两件事。"
   },
   {
    "start": 2.6625,
    "end": 6.6375,
    "text": "先数出每个点的入度，把入度为零的放进队列。"
   },
   {
    "start": 6.6375,
    "end": 13.2875,
    "text": "然后反复出队：把它输出，再删掉它发出的边，也就是让每个后继的入度减一。"
   },
   {
    "start": 13.2875,
    "end": 16.5,
    "text": "哪个后继减到零，就轮到它入队。"
   },
   {
    "start": 16.5,
    "end": 20.3875,
    "text": "最后输出不足全部点数，说明有环。"
   }
  ]
 },
 {
  "id": "run",
  "wav": "audio/run-fe1df1310f8a.wav",
  "seconds": 36.12,
  "cues": [
   {
    "start": 0.1,
    "end": 1.5625,
    "text": "跟着跑一遍。"
   },
   {
    "start": 1.5125,
    "end": 6.8,
    "text": "高数出队，离散从二降到一，普通物理降到零，入队。"
   },
   {
    "start": 6.8,
    "end": 14.8375,
    "text": "程序设计出队，离散降到零，数据结构降到一，算法语言降到零，两门一起入队。"
   },
   {
    "start": 14.8375,
    "end": 17.65,
    "text": "物理出队，计算机原理入队。"
   },
   {
    "start": 17.65,
    "end": 20.5,
    "text": "离散出队，数据结构入队。"
   },
   {
    "start": 20.5,
    "end": 23.625,
    "text": "算法语言出队，编译降到一。"
   },
   {
    "start": 23.625,
    "end": 27.075,
    "text": "计算机原理出队，操作系统降到一。"
   },
   {
    "start": 27.075,
    "end": 30.8625,
    "text": "数据结构出队，最后两门同时降到零。"
   },
   {
    "start": 30.8625,
    "end": 36.05,
    "text": "编译、操作系统依次出队，九门课全部输出。"
   }
  ]
 },
 {
  "id": "line",
  "wav": "audio/line-0448fc7b298c.wav",
  "seconds": 16.32,
  "cues": [
   {
    "start": 0.1,
    "end": 2.275,
    "text": "把输出顺序摆成一行。"
   },
   {
    "start": 2.225,
    "end": 8.0375,
    "text": "十一条边，全部从左指向右，没有一门课排在它的先修课前面。"
   },
   {
    "start": 8.0375,
    "end": 11.925,
    "text": "讲义图注给的两个序列，和这一行都不一样。"
   },
   {
    "start": 11.925,
    "end": 16.25,
    "text": "拓扑序并不唯一，只要每条边都朝右就行。"
   }
  ]
 },
 {
  "id": "cycle",
  "wav": "audio/cycle-29b16ecdb0da.wav",
  "seconds": 26.352,
  "cues": [
   {
    "start": 0.1,
    "end": 2.325,
    "text": "如果有一条边指回去呢？"
   },
   {
    "start": 2.275,
    "end": 6.4125,
    "text": "比如让操作系统反过来成了高数的先修课。"
   },
   {
    "start": 6.4125,
    "end": 12.2,
    "text": "高数的入度变成一，开局只有程序设计能出队，接着是算法语言。"
   },
   {
    "start": 12.2,
    "end": 13.9,
    "text": "然后队列就空了。"
   },
   {
    "start": 13.9,
    "end": 20.675,
    "text": "剩下七门课，入度永远降不到零：它们要么在环上互相等，要么在等环上的课。"
   },
   {
    "start": 20.675,
    "end": 26.2875,
    "text": "输出不足九个，就说明有环，拓扑排序顺手把环也判了。"
   }
  ]
 },
 {
  "id": "dfs",
  "wav": "audio/dfs-3708029a0126.wav",
  "seconds": 31.512,
  "cues": [
   {
    "start": 0.1,
    "end": 5.7,
    "text": "第二种做法，用深度优先搜索，记下每个点结束访问的顺序。"
   },
   {
    "start": 5.65,
    "end": 10.65,
    "text": "从高数出发，一路走到离散、数据结构、编译。"
   },
   {
    "start": 10.65,
    "end": 17.95,
    "text": "编译没有后继，第一个结束；操作系统第二个结束；接着数据结构、离散也结束了。"
   },
   {
    "start": 17.95,
    "end": 23.4,
    "text": "再走物理这条线，计算机原理、物理、高数依次结束。"
   },
   {
    "start": 23.4,
    "end": 27.7,
    "text": "最后从程序设计出发，只剩算法语言没去过。"
   },
   {
    "start": 27.7,
    "end": 31.45,
    "text": "把结束顺序倒过来，就是另一个拓扑序。"
   }
  ]
 },
 {
  "id": "why",
  "wav": "audio/why-b89febba5917.wav",
  "seconds": 24.696,
  "cues": [
   {
    "start": 0.1,
    "end": 2.25,
    "text": "为什么倒过来就对？"
   },
   {
    "start": 2.2,
    "end": 5.325,
    "text": "任取一条边，从起点指向终点。"
   },
   {
    "start": 5.325,
    "end": 12.1875,
    "text": "检查这条边时，终点要么还没访问，就会在起点的递归里先结束；要么早已结束。"
   },
   {
    "start": 12.1875,
    "end": 18.9125,
    "text": "终点不可能是灰色，灰色表示还在递归栈上，撞上它就说明有环。"
   },
   {
    "start": 18.9125,
    "end": 24.625,
    "text": "所以终点总比起点先结束，倒过来，起点就排在前面。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-e5da153ae4a6.wav",
  "seconds": 15.312,
  "cues": [
   {
    "start": 0.1,
    "end": 5.5,
    "text": "两种做法，用邻接表存图，复杂度都是点数加边数。"
   },
   {
    "start": 5.45,
    "end": 10.1625,
    "text": "卡恩算法：入度为零就出队，输出不够就有环。"
   },
   {
    "start": 10.1625,
    "end": 15.2625,
    "text": "深度优先：结束顺序倒过来，撞上灰点就有环。"
   }
  ]
 }
]