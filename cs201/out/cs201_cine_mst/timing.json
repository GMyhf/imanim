[
 {
  "id": "title",
  "wav": "audio/title-627de5cc54ae.wav",
  "seconds": 13.968,
  "cues": [
   {
    "start": 0.1,
    "end": 4.5,
    "text": "七个城市之间要铺光纤，每条线路都有造价。"
   },
   {
    "start": 4.45,
    "end": 8.6375,
    "text": "七个点，至少要六条线才能全部连通。"
   },
   {
    "start": 8.6375,
    "end": 11.55,
    "text": "挑哪六条，加起来最便宜？"
   },
   {
    "start": 11.55,
    "end": 13.9125,
    "text": "这就是最小生成树。"
   }
  ]
 },
 {
  "id": "problem",
  "wav": "audio/problem-78e21fd9aa66.wav",
  "seconds": 16.104,
  "cues": [
   {
    "start": 0.1,
    "end": 5.3625,
    "text": "生成树要包含所有顶点，不能有环，恰好有 n 减一条边。"
   },
   {
    "start": 5.3125,
    "end": 8.4625,
    "text": "随手连一棵，总造价是六十。"
   },
   {
    "start": 8.4625,
    "end": 12.3375,
    "text": "同一张图上，最便宜的那棵只要三十八。"
   },
   {
    "start": 12.3375,
    "end": 14.0625,
    "text": "怎么一步步找到它？"
   },
   {
    "start": 14.0625,
    "end": 16.05,
    "text": "靠一条性质。"
   }
  ]
 },
 {
  "id": "cut",
  "wav": "audio/cut-4f24e545c665.wav",
  "seconds": 27.192,
  "cues": [
   {
    "start": 0.1,
    "end": 2.475,
    "text": "把顶点任意分成两堆。"
   },
   {
    "start": 2.425,
    "end": 8.4,
    "text": "横跨两堆的边里，最轻的那一条，一定可以放进某棵最小生成树。"
   },
   {
    "start": 8.4,
    "end": 9.5625,
    "text": "为什么？"
   },
   {
    "start": 9.5625,
    "end": 12.7125,
    "text": "假设某棵最小生成树不含它。"
   },
   {
    "start": 12.7125,
    "end": 15.775,
    "text": "把它加进去，必然形成一个环。"
   },
   {
    "start": 15.775,
    "end": 22.075,
    "text": "这个环从一堆走到另一堆，还得走回来，所以环上另有一条跨界的边。"
   },
   {
    "start": 22.075,
    "end": 27.1375,
    "text": "删掉那一条，仍是一棵生成树，总权不会变大。"
   }
  ]
 },
 {
  "id": "prim",
  "wav": "audio/prim-d7f41419e691.wav",
  "seconds": 32.496,
  "cues": [
   {
    "start": 0.1,
    "end": 4.4,
    "text": "普里姆算法从零号点出发，始终只长一棵树。"
   },
   {
    "start": 4.35,
    "end": 9.9875,
    "text": "每一步，看所有一头在树里、一头在树外的边，挑最轻的那条。"
   },
   {
    "start": 9.9875,
    "end": 13.1,
    "text": "先取权为一的边，并入四号点。"
   },
   {
    "start": 13.1,
    "end": 17.85,
    "text": "这时跨界的边只有二十和十五，只能取十五。"
   },
   {
    "start": 17.85,
    "end": 20.625,
    "text": "接着取十，并入六号点。"
   },
   {
    "start": 20.625,
    "end": 23.325,
    "text": "然后取二，并入二号点。"
   },
   {
    "start": 23.325,
    "end": 25.85,
    "text": "再取六，并入一号点。"
   },
   {
    "start": 25.85,
    "end": 28.7,
    "text": "最后取四，三号点也进来了。"
   },
   {
    "start": 28.7,
    "end": 32.4375,
    "text": "六步，六条边，总权三十八。"
   }
  ]
 },
 {
  "id": "code",
  "wav": "audio/code-a1100b07c0d2.wav",
  "seconds": 25.224,
  "cues": [
   {
    "start": 0.1,
    "end": 6.1875,
    "text": "代码里，距离数组记着每个树外的点离当前这棵树最近的那条边。"
   },
   {
    "start": 6.1375,
    "end": 9.7375,
    "text": "每并入一个点，就拿它的边去更新别的点。"
   },
   {
    "start": 9.7375,
    "end": 19.8125,
    "text": "这和迪杰斯特拉几乎一模一样，只差一处：迪杰斯特拉比的是从源点累积的整条路径，普里姆比的只是一条边的权。"
   },
   {
    "start": 19.8125,
    "end": 25.1625,
    "text": "用邻接矩阵，复杂度是 n 平方，适合稠密图。"
   }
  ]
 },
 {
  "id": "kruskal",
  "wav": "audio/kruskal-50f20a78d39d.wav",
  "seconds": 40.056,
  "cues": [
   {
    "start": 0.1,
    "end": 5.075,
    "text": "克鲁斯卡尔算法换个方向，不从点出发，而是从边出发。"
   },
   {
    "start": 5.025,
    "end": 9.3,
    "text": "把九条边按权从小到大排好，逐条看。"
   },
   {
    "start": 9.3,
    "end": 15.875,
    "text": "会不会成环，就是问两个端点是不是已经在同一棵树里，这正是并查集的用处。"
   },
   {
    "start": 15.875,
    "end": 22.1,
    "text": "一、二、四、六，都连着两棵不同的树，全部收下。"
   },
   {
    "start": 22.1,
    "end": 28.1625,
    "text": "八，三号点和六号点已经连通，加进去就成环，舍去。"
   },
   {
    "start": 28.1625,
    "end": 30.125,
    "text": "十，收下。"
   },
   {
    "start": 30.125,
    "end": 33.3,
    "text": "十二，又成环，舍去。"
   },
   {
    "start": 33.3,
    "end": 36.9625,
    "text": "十五，收下，六条边到齐。"
   },
   {
    "start": 36.9625,
    "end": 39.9875,
    "text": "最后的二十，同样成环。"
   }
  ]
 },
 {
  "id": "same",
  "wav": "audio/same-8d80a1bafd6f.wav",
  "seconds": 25.824,
  "cues": [
   {
    "start": 0.1,
    "end": 7.925,
    "text": "两种算法，选出的六条边完全相同，总权都是三十八，只是加入的次序不同。"
   },
   {
    "start": 7.875,
    "end": 14.0125,
    "text": "普里姆的中间过程始终是一棵树，克鲁斯卡尔的中间过程是一片森林。"
   },
   {
    "start": 14.0125,
    "end": 19.2375,
    "text": "有等权的边时，边集可能不同，但总权一定相同。"
   },
   {
    "start": 19.2375,
    "end": 25.7625,
    "text": "普里姆适合稠密图，克鲁斯卡尔主要花在给边排序上，适合稀疏图。"
   }
  ]
 },
 {
  "id": "spt",
  "wav": "audio/spt-1e2170d3954b.wav",
  "seconds": 31.608,
  "cues": [
   {
    "start": 0.1,
    "end": 2.075,
    "text": "最后一个常见误会。"
   },
   {
    "start": 2.025,
    "end": 7.9,
    "text": "迪杰斯特拉也会给出一棵树，每个点连向它的前驱，但那是最短路树。"
   },
   {
    "start": 7.9,
    "end": 13.475,
    "text": "三个点，A 到 B 是二，B 到 C 是二，A 到 C 是三。"
   },
   {
    "start": 13.475,
    "end": 21.675,
    "text": "从 A 出发，到 C 直达是三，比绕道的四近，所以最短路树选 AB 和 AC，总权五。"
   },
   {
    "start": 21.675,
    "end": 26.0,
    "text": "最小生成树选 AB 和 BC，总权只有四。"
   },
   {
    "start": 26.0,
    "end": 31.55,
    "text": "一个让每个点离源点最近，一个让总造价最小，目标不同。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-0d3bad8e3aa6.wav",
  "seconds": 13.512,
  "cues": [
   {
    "start": 0.1,
    "end": 3.575,
    "text": "切分性质，是两种贪心共同的依据。"
   },
   {
    "start": 3.525,
    "end": 10.1625,
    "text": "普里姆从点出发长一棵树，克鲁斯卡尔从边出发合并森林，用并查集判环。"
   },
   {
    "start": 10.1625,
    "end": 13.45,
    "text": "走的路不同，总权一定相同。"
   }
  ]
 }
]