[
 {
  "id": "title",
  "wav": "audio/title-62b5ab05b940.wav",
  "seconds": 22.536,
  "cues": [
   {
    "start": 0.1,
    "end": 4.975,
    "text": "在数组中间插入一个数，后面的元素都得往后挪一格。"
   },
   {
    "start": 4.925,
    "end": 11.8875,
    "text": "链表不挪数据，只改链接：站在前驱结点上，改两根指针，插入就完成了。"
   },
   {
    "start": 11.8875,
    "end": 16.425,
    "text": "不过链表的快有个前提，就是你已经拿到了前驱结点。"
   },
   {
    "start": 16.425,
    "end": 22.4875,
    "text": "今天看三种指针技巧：哨兵、三指针反转、快慢指针。"
   }
  ]
 },
 {
  "id": "merge",
  "wav": "audio/merge-b4d6255ae767.wav",
  "seconds": 35.88,
  "cues": [
   {
    "start": 0.1,
    "end": 2.675,
    "text": "先看合并两个有序链表。"
   },
   {
    "start": 2.625,
    "end": 5.775,
    "text": "一条是一二四，一条是一三四。"
   },
   {
    "start": 5.775,
    "end": 9.975,
    "text": "造一个不存数据的哨兵结点，尾指针先指着它。"
   },
   {
    "start": 9.975,
    "end": 17.45,
    "text": "每次比较两条链的当前结点，小的接到尾巴后面，相等时先取第一条，保证稳定。"
   },
   {
    "start": 17.45,
    "end": 24.45,
    "text": "有了哨兵，第一次接结点和以后每一次是同一句代码，不用特判结果是不是空表。"
   },
   {
    "start": 24.45,
    "end": 27.7125,
    "text": "第一条走完时，第二条还剩一个四。"
   },
   {
    "start": 27.7125,
    "end": 32.7,
    "text": "数组要逐个拷过去，链表只改一根指针，整段挂上。"
   },
   {
    "start": 32.7,
    "end": 35.8125,
    "text": "最后返回哨兵的下一个结点。"
   }
  ]
 },
 {
  "id": "reverse",
  "wav": "audio/reverse-e1ecd22d0b33.wav",
  "seconds": 20.808,
  "cues": [
   {
    "start": 0.1,
    "end": 2.625,
    "text": "第二个模板，反转链表。"
   },
   {
    "start": 2.575,
    "end": 8.325,
    "text": "反转的本质，是把每个结点的后继指针掉个头，改成指向前驱。"
   },
   {
    "start": 8.325,
    "end": 12.4875,
    "text": "单链表走不回去，所以要自己背着一个前驱指针。"
   },
   {
    "start": 12.4875,
    "end": 20.7375,
    "text": "每一轮四个动作，顺序不能乱：先存后继，再掉头，然后前驱前进，当前前进。"
   }
  ]
 },
 {
  "id": "revrun",
  "wav": "audio/revrun-50ae949700f0.wav",
  "seconds": 18.408,
  "cues": [
   {
    "start": 0.1,
    "end": 2.3875,
    "text": "拿一二三四五跑一遍。"
   },
   {
    "start": 2.3375,
    "end": 4.6,
    "text": "每一轮只改一根箭头。"
   },
   {
    "start": 4.6,
    "end": 6.7875,
    "text": "第一步为什么不能省？"
   },
   {
    "start": 6.7875,
    "end": 13.05,
    "text": "一旦先掉了头，原来的后继地址就再也找不回来，后面整条链都丢了。"
   },
   {
    "start": 13.05,
    "end": 18.3375,
    "text": "当前指针走到空，前驱停在五上，五就是新的表头。"
   }
  ]
 },
 {
  "id": "middle",
  "wav": "audio/middle-388abe2f9552.wav",
  "seconds": 23.832,
  "cues": [
   {
    "start": 0.1,
    "end": 2.7125,
    "text": "第三个模板，快慢指针。"
   },
   {
    "start": 2.6625,
    "end": 9.5375,
    "text": "慢指针一次走一步，快指针一次走两步，快指针走到头时，慢指针正好走了一半。"
   },
   {
    "start": 9.5375,
    "end": 17.875,
    "text": "五个结点时，慢指针停在第三个，正中间；六个结点时，停在第四个，也就是后半段的第一个。"
   },
   {
    "start": 17.875,
    "end": 23.775,
    "text": "记一个式子就够了：慢指针停在第 n 除以二下取整再加一个。"
   }
  ]
 },
 {
  "id": "cycle",
  "wav": "audio/cycle-2179af534343.wav",
  "seconds": 22.464,
  "cues": [
   {
    "start": 0.1,
    "end": 6.275,
    "text": "如果尾结点接回了中间，链表就成了一个环，一直往前走永远停不下来。"
   },
   {
    "start": 6.225,
    "end": 15.05,
    "text": "快慢指针照样能用：两个都进了环以后，快指针每走一步，就比慢指针多追近一格，所以一定会追上。"
   },
   {
    "start": 15.05,
    "end": 22.4,
    "text": "这个例子有十个结点，环外三个，环长七，慢指针走到第七步，两个指针相遇。"
   }
  ]
 },
 {
  "id": "entry",
  "wav": "audio/entry-845c8a04f424.wav",
  "seconds": 29.592,
  "cues": [
   {
    "start": 0.1,
    "end": 1.975,
    "text": "环的入口在哪？"
   },
   {
    "start": 1.925,
    "end": 9.0375,
    "text": "相遇时，慢指针走了环外长度，再加上入口到相遇点这一段；快指针走了它的两倍。"
   },
   {
    "start": 9.0375,
    "end": 12.4875,
    "text": "多走的那一份，正好是绕环的整数圈。"
   },
   {
    "start": 12.4875,
    "end": 17.7,
    "text": "所以从相遇点再走环外长度那么多步，一定回到入口。"
   },
   {
    "start": 17.7,
    "end": 24.325,
    "text": "于是让一个指针回到表头，两个指针都一步一步走，再次相遇的地方就是环入口。"
   },
   {
    "start": 24.325,
    "end": 29.525,
    "text": "这里环外长度是三，走三步，正好在第四个结点碰头。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-9ff3c22d5a90.wav",
  "seconds": 23.976,
  "cues": [
   {
    "start": 0.1,
    "end": 16.175,
    "text": "五个模板：哨兵省掉表头的分支；三指针反转，记住先存后继；快慢指针找中点、判环、找入口；还有相交链表的换道双指针，证明和找环入口是同一套，给两个指针的路程列方程。"
   },
   {
    "start": 16.125,
    "end": 23.925,
    "text": "链表题的错误，大多出在零个、一个、两个结点的情形，动手之前先在纸上画一画。"
   }
  ]
 }
]