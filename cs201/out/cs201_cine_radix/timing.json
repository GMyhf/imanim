[
 {
  "id": "title",
  "wav": "audio/title-06df4f70e125.wav",
  "seconds": 16.464,
  "cues": [
   {
    "start": 0.1,
    "end": 2.0625,
    "text": "排序最快能有多快？"
   },
   {
    "start": 2.0125,
    "end": 5.9,
    "text": "归并排序、堆排序都要 n log n 次比较。"
   },
   {
    "start": 5.9,
    "end": 9.7125,
    "text": "想再快，只有一条路：干脆不比较。"
   },
   {
    "start": 9.7125,
    "end": 16.4125,
    "text": "这一集讲分配排序，不问两个数谁大，而是直接算出每个数该去哪儿。"
   }
  ]
 },
 {
  "id": "bound",
  "wav": "audio/bound-116b9039a2f2.wav",
  "seconds": 27.024,
  "cues": [
   {
    "start": 0.1,
    "end": 3.675,
    "text": "先看比较排序为什么快不过 n log n。"
   },
   {
    "start": 3.625,
    "end": 10.55,
    "text": "把每次比较画成一个分叉，三个数有六种排列，这棵判定树就得有六片叶子。"
   },
   {
    "start": 10.55,
    "end": 16.425,
    "text": "高为二的二叉树最多四片叶子，不够，所以最坏至少比三次。"
   },
   {
    "start": 16.425,
    "end": 21.0625,
    "text": "八个数有四万零三百二十种排列，至少要比十六次。"
   },
   {
    "start": 21.0625,
    "end": 26.975,
    "text": "一般地，树高至少是 n 的阶乘取对数，也就是 n log n 的量级。"
   }
  ]
 },
 {
  "id": "count",
  "wav": "audio/count-b6f107b260ab.wav",
  "seconds": 24.696,
  "cues": [
   {
    "start": 0.1,
    "end": 3.6625,
    "text": "要绕开这个下界，就得利用数值本身。"
   },
   {
    "start": 3.6125,
    "end": 13.8875,
    "text": "计数排序：这二十二个数都在一到二十之间，开二十个格子，扫一遍，每个数往自己的格子里记一笔，四和十各记了两笔。"
   },
   {
    "start": 13.8875,
    "end": 17.675,
    "text": "再从左往右按格子写回去，就排好了。"
   },
   {
    "start": 17.675,
    "end": 19.4125,
    "text": "没有任何比较。"
   },
   {
    "start": 19.4125,
    "end": 24.6375,
    "text": "代价是格子数等于取值范围，范围太大就开不起。"
   }
  ]
 },
 {
  "id": "stable",
  "wav": "audio/stable-0107c6a07d39.wav",
  "seconds": 29.976,
  "cues": [
   {
    "start": 0.1,
    "end": 4.55,
    "text": "如果排的是带名字的记录，就得把记录本身搬过去。"
   },
   {
    "start": 4.5,
    "end": 8.95,
    "text": "四条记录，键是三、一、三、一。"
   },
   {
    "start": 8.95,
    "end": 16.7625,
    "text": "先计数，再求前缀和，每个格子变成键不超过它的记录个数，也就是这个键的结束位置。"
   },
   {
    "start": 16.7625,
    "end": 24.7125,
    "text": "然后从后往前放：d 放到一号位，c 放到三号位，b 放到零号位，a 放到二号位。"
   },
   {
    "start": 24.7125,
    "end": 29.9125,
    "text": "键相同的记录，先后次序都没变，这就叫稳定。"
   }
  ]
 },
 {
  "id": "lsd",
  "wav": "audio/lsd-6fcea3daae37.wav",
  "seconds": 20.16,
  "cues": [
   {
    "start": 0.1,
    "end": 1.7875,
    "text": "值域太大怎么办？"
   },
   {
    "start": 1.7375,
    "end": 5.2125,
    "text": "把数按位拆开，每一位只有十种可能。"
   },
   {
    "start": 5.2125,
    "end": 13.75,
    "text": "基数排序从个位开始：按个位把八个数分进十个桶，再按桶号收集；然后按十位，再按百位。"
   },
   {
    "start": 13.75,
    "end": 16.175,
    "text": "三趟之后，全部排好。"
   },
   {
    "start": 16.175,
    "end": 20.1,
    "text": "每一趟都不比较大小，只看那一位是几。"
   }
  ]
 },
 {
  "id": "why",
  "wav": "audio/why-6b56cfed2618.wav",
  "seconds": 27.384,
  "cues": [
   {
    "start": 0.1,
    "end": 3.1375,
    "text": "关键在于，每一趟都必须稳定。"
   },
   {
    "start": 3.0875,
    "end": 14.525,
    "text": "按百位分桶时，二、二十四、四十五、六十六、七十五、九十都落进零号桶，它们的先后次序是前两趟排出来的。"
   },
   {
    "start": 14.525,
    "end": 22.6,
    "text": "如果桶是后进先出，这一趟就把它们整个倒过来，变成九十、七十五，一直到二，全乱了。"
   },
   {
    "start": 22.6,
    "end": 27.325,
    "text": "稳定性不是锦上添花，是基数排序成立的前提。"
   }
  ]
 },
 {
  "id": "cost",
  "wav": "audio/cost-b84d527eefd7.wav",
  "seconds": 28.68,
  "cues": [
   {
    "start": 0.1,
    "end": 1.725,
    "text": "代价是多少？"
   },
   {
    "start": 1.675,
    "end": 8.125,
    "text": "每一趟分配 n 个数、收集 b 个桶，一共 d 趟，就是 d 乘以 n 加 b 的和。"
   },
   {
    "start": 8.125,
    "end": 12.3,
    "text": "八个数、三位、十个桶，是五十四步。"
   },
   {
    "start": 12.3,
    "end": 14.05,
    "text": "它真是线性的吗？"
   },
   {
    "start": 14.05,
    "end": 21.2875,
    "text": "n 个互不相同的数，位数至少是以 b 为底 n 的对数，理论上还是 n log n 的量级。"
   },
   {
    "start": 21.2875,
    "end": 28.6125,
    "text": "实际中快，是因为三十二位整数按字节拆，只要四趟，每趟二百五十六个桶。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-ba97b2dd93dc.wav",
  "seconds": 13.392,
  "cues": [
   {
    "start": 0.1,
    "end": 9.525,
    "text": "总结一下：比较排序最坏逃不开 n log n；计数排序靠值域小，基数排序靠逐位分配，而且每一趟都稳定。"
   },
   {
    "start": 9.475,
    "end": 13.3375,
    "text": "不比较，换来的是对数据的要求。"
   }
  ]
 }
]