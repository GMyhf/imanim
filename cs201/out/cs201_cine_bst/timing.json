[
 {
  "id": "title",
  "wav": "audio/title-d0e7b030f49a.wav",
  "seconds": 16.512,
  "cues": [
   {
    "start": 0.1,
    "end": 2.4125,
    "text": "在一堆数里找一个数。"
   },
   {
    "start": 2.3625,
    "end": 9.2875,
    "text": "无序的表插入快、查找慢；有序的表能二分查找，可插入一个数要挪动一大片。"
   },
   {
    "start": 9.2875,
    "end": 16.45,
    "text": "二叉搜索树想两头都要：每个结点，左子树都比它小，右子树都比它大。"
   }
  ]
 },
 {
  "id": "build",
  "wav": "audio/build-db30f629147b.wav",
  "seconds": 20.688,
  "cues": [
   {
    "start": 0.1,
    "end": 6.95,
    "text": "从空树开始，依次插入五十、十九、三十五、五十五，一直到九十二。"
   },
   {
    "start": 6.9,
    "end": 13.2625,
    "text": "每个新数从根往下比：小就往左，大就往右，走到空位就挂上去。"
   },
   {
    "start": 13.2625,
    "end": 17.375,
    "text": "插入不用挪动任何结点，只改一根空指针。"
   },
   {
    "start": 17.375,
    "end": 20.6375,
    "text": "十一个数插完，就是这棵树。"
   }
  ]
 },
 {
  "id": "search",
  "wav": "audio/search-da2d450258c1.wav",
  "seconds": 21.36,
  "cues": [
   {
    "start": 0.1,
    "end": 2.4875,
    "text": "查找走的是同一条路。"
   },
   {
    "start": 2.4375,
    "end": 11.7625,
    "text": "找五十三：比五十大，往右；比五十五小，往左；比五十二大，往右，找到了，一共比了四次。"
   },
   {
    "start": 11.7625,
    "end": 14.825,
    "text": "每比一次，就扔掉一整棵子树。"
   },
   {
    "start": 14.825,
    "end": 21.3,
    "text": "再找六十：一路走到八十八的左边，是空的，说明六十不在树里。"
   }
  ]
 },
 {
  "id": "inorder",
  "wav": "audio/inorder-2643b84434d6.wav",
  "seconds": 14.376,
  "cues": [
   {
    "start": 0.1,
    "end": 5.5125,
    "text": "左小右大还有一个直接的推论：中序周游得到的正好是升序。"
   },
   {
    "start": 5.4625,
    "end": 14.3125,
    "text": "把每个结点竖直落到地面上，从左往右读：五、十九、二十、三十五，一直到一百。"
   }
  ]
 },
 {
  "id": "del1",
  "wav": "audio/del1-88f6ba7a2dd0.wav",
  "seconds": 14.088,
  "cues": [
   {
    "start": 0.1,
    "end": 3.925,
    "text": "删除要麻烦一些，因为树上不能留下空位。"
   },
   {
    "start": 3.875,
    "end": 7.4875,
    "text": "删一个叶子，比如五，直接摘掉。"
   },
   {
    "start": 7.4875,
    "end": 14.0375,
    "text": "删一个没有左孩子的结点，比如五十二，让它的右孩子五十三顶上来就行。"
   }
  ]
 },
 {
  "id": "del2",
  "wav": "audio/del2-aecaba7384d6.wav",
  "seconds": 28.032,
  "cues": [
   {
    "start": 0.1,
    "end": 4.375,
    "text": "最难的是左右孩子都有的结点，比如根五十。"
   },
   {
    "start": 4.325,
    "end": 11.625,
    "text": "讲义的做法是找中序前驱：从左孩子出发，一路往右走到底，这里是三十五。"
   },
   {
    "start": 11.625,
    "end": 18.675,
    "text": "它比左子树其余的都大，比右子树全都小，顶上来以后，左小右大照样成立。"
   },
   {
    "start": 18.675,
    "end": 24.65,
    "text": "注意三十五自己还有一个左孩子二十，要先把它接到三十五原来的位置上。"
   },
   {
    "start": 24.65,
    "end": 27.975,
    "text": "漏了这一步，树上就会出现环。"
   }
  ]
 },
 {
  "id": "chain",
  "wav": "audio/chain-b49241d60b5e.wav",
  "seconds": 14.928,
  "cues": [
   {
    "start": 0.1,
    "end": 3.925,
    "text": "可是二叉搜索树快不快，取决于它的形状。"
   },
   {
    "start": 3.875,
    "end": 12.1125,
    "text": "把一到七按顺序插进去，每个新数都比前面的大，一路往右挂，树退化成一条链，足足七层。"
   },
   {
    "start": 12.1125,
    "end": 14.8625,
    "text": "查找又变回了一个一个地比。"
   }
  ]
 },
 {
  "id": "avl",
  "wav": "audio/avl-5c5a400a4da7.wav",
  "seconds": 27.528,
  "cues": [
   {
    "start": 0.1,
    "end": 7.8375,
    "text": "平衡二叉树，也叫 AVL 树，给每个结点记一个平衡因子：左子树高度减去右子树高度。"
   },
   {
    "start": 7.7875,
    "end": 12.825,
    "text": "只要有结点的平衡因子变成二或者负二，就旋转。"
   },
   {
    "start": 12.825,
    "end": 20.05,
    "text": "还是依次插入一到七：插入三时，一的平衡因子是负二，绕一左旋，二升上来。"
   },
   {
    "start": 20.05,
    "end": 27.475,
    "text": "之后每次失衡就转一下，一共转了四次，七个数插完，是一棵只有三层的满二叉树。"
   }
  ]
 },
 {
  "id": "lr",
  "wav": "audio/lr-2cfdaa884f01.wav",
  "seconds": 16.104,
  "cues": [
   {
    "start": 0.1,
    "end": 2.825,
    "text": "失衡还有一种拐弯的形状。"
   },
   {
    "start": 2.775,
    "end": 9.225,
    "text": "依次插入五、二、三：五的平衡因子是二，它的左孩子二却往右倾。"
   },
   {
    "start": 9.225,
    "end": 16.0375,
    "text": "转一次不够，先绕二左旋，把拐弯拉直，再绕五右旋，三升为根。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-3fe8364fffa2.wav",
  "seconds": 17.088,
  "cues": [
   {
    "start": 0.1,
    "end": 4.675,
    "text": "查找、插入、删除，代价都等于树高。"
   },
   {
    "start": 4.625,
    "end": 11.1875,
    "text": "随手插，树可能退化成一条链；平衡树用旋转，把树高压在对数级别。"
   },
   {
    "start": 11.1875,
    "end": 17.0375,
    "text": "左小右大，再加一点平衡，就是动态有序数据最常用的骨架。"
   }
  ]
 }
]