[
 {
  "id": "title",
  "wav": "audio/title-ede445a44a44.wav",
  "seconds": 15.096,
  "cues": [
   {
    "start": 0.1,
    "end": 5.35,
    "text": "迪杰斯特拉算法回答的是：从一个点出发，到其他点最近多远。"
   },
   {
    "start": 5.3,
    "end": 9.075,
    "text": "可如果要知道任意两个点之间的最短距离呢？"
   },
   {
    "start": 9.075,
    "end": 15.025,
    "text": "这一集，弗洛伊德算法，三重循环，一次算出所有点对。"
   }
  ]
 },
 {
  "id": "problem",
  "wav": "audio/problem-fd475cf649fc.wav",
  "seconds": 24.36,
  "cues": [
   {
    "start": 0.1,
    "end": 2.9625,
    "text": "第一周的例子：股市的传言。"
   },
   {
    "start": 2.9125,
    "end": 9.425,
    "text": "五个经纪人，箭头表示谁能把消息直接传给谁，数字是要花的时间。"
   },
   {
    "start": 9.425,
    "end": 14.4125,
    "text": "注意方向：一号传给五号要三，五号传回一号要五。"
   },
   {
    "start": 14.4125,
    "end": 19.7375,
    "text": "问题是，从谁开始散布消息，能让所有人最快都知道？"
   },
   {
    "start": 19.7375,
    "end": 24.3,
    "text": "先得知道任意两个人之间，最短的传播时间。"
   }
  ]
 },
 {
  "id": "matrix",
  "wav": "audio/matrix-1a89057916ad.wav",
  "seconds": 15.576,
  "cues": [
   {
    "start": 0.1,
    "end": 2.2625,
    "text": "把图存成相邻矩阵。"
   },
   {
    "start": 2.2125,
    "end": 6.875,
    "text": "第几行第几列，就是从谁直接传给谁的时间。"
   },
   {
    "start": 6.875,
    "end": 10.2375,
    "text": "对角线是零，自己到自己不花时间。"
   },
   {
    "start": 10.2375,
    "end": 13.4375,
    "text": "没有直接的边，就记成无穷大。"
   },
   {
    "start": 13.4375,
    "end": 15.525,
    "text": "这是算法的输入。"
   }
  ]
 },
 {
  "id": "idea",
  "wav": "audio/idea-8761012cc191.wav",
  "seconds": 19.416,
  "cues": [
   {
    "start": 0.1,
    "end": 5.025,
    "text": "弗洛伊德的想法是动态规划：一次只多放开一个中转点。"
   },
   {
    "start": 4.975,
    "end": 11.8875,
    "text": "从甲到乙，原来的路，和先到中转点、再从中转点到乙，哪个短就留哪个。"
   },
   {
    "start": 11.8875,
    "end": 19.3625,
    "text": "放开第几个中转点之后，矩阵里每一格，就是只允许经过前面这几个点时的最短距离。"
   }
  ]
 },
 {
  "id": "code",
  "wav": "audio/code-d998019bc4fc.wav",
  "seconds": 12.72,
  "cues": [
   {
    "start": 0.1,
    "end": 2.275,
    "text": "代码就是三重循环。"
   },
   {
    "start": 2.225,
    "end": 6.5,
    "text": "最外层枚举中转点，里面两层枚举起点和终点。"
   },
   {
    "start": 6.5,
    "end": 12.65,
    "text": "两段都能走通，就比较原来的距离和绕道的距离，留下小的那个。"
   }
  ]
 },
 {
  "id": "run",
  "wav": "audio/run-269263864afb.wav",
  "seconds": 29.4,
  "cues": [
   {
    "start": 0.1,
    "end": 1.5625,
    "text": "跟着跑一遍。"
   },
   {
    "start": 1.5125,
    "end": 8.6,
    "text": "放开一号当中转点：五号到四号原来是无穷，绕道一号，五加四等于九。"
   },
   {
    "start": 8.6,
    "end": 12.9,
    "text": "放开二号、三号、四号，没有一格变小。"
   },
   {
    "start": 12.9,
    "end": 20.7625,
    "text": "最后放开五号：二号到一号，八加五，十三；二号到四号，八加九，十七。"
   },
   {
    "start": 20.7625,
    "end": 24.6,
    "text": "这个九，正是第一轮刚算出的五号到四号。"
   },
   {
    "start": 24.6,
    "end": 29.35,
    "text": "前面的结果，被后面接着用，这就是动态规划。"
   }
  ]
 },
 {
  "id": "order",
  "wav": "audio/order-c4eecf31c07f.wav",
  "seconds": 25.512,
  "cues": [
   {
    "start": 0.1,
    "end": 3.3375,
    "text": "所以中转点必须放在最外层。"
   },
   {
    "start": 3.2875,
    "end": 8.9875,
    "text": "看一个小例子：零到二、二到三、三到一，每条边长一。"
   },
   {
    "start": 8.9875,
    "end": 17.475,
    "text": "如果把中转点放到最内层，先算零到一的时候，零到三、二到一都还是无穷，结果就停在无穷。"
   },
   {
    "start": 17.475,
    "end": 19.7875,
    "text": "可真正的答案是三。"
   },
   {
    "start": 19.7875,
    "end": 25.4625,
    "text": "中转点在外层，才能保证拿来用的每一格，都已经是上一轮的定稿。"
   }
  ]
 },
 {
  "id": "answer",
  "wav": "audio/answer-4a78b98c1854.wav",
  "seconds": 23.496,
  "cues": [
   {
    "start": 0.1,
    "end": 1.65,
    "text": "回到传言。"
   },
   {
    "start": 1.6,
    "end": 7.9125,
    "text": "对每个起点，看它这一行里最大的那个数，那是最后一个人收到消息的时间。"
   },
   {
    "start": 7.9125,
    "end": 14.0625,
    "text": "一号、二号、四号、五号这几行都有无穷，总有人收不到。"
   },
   {
    "start": 14.0625,
    "end": 18.425,
    "text": "只有三号这一行全是有限值，最大是十。"
   },
   {
    "start": 18.425,
    "end": 23.4375,
    "text": "答案是三号经纪人，十个时间单位，所有人都知道。"
   }
  ]
 },
 {
  "id": "compare",
  "wav": "audio/compare-96a69595ca16.wav",
  "seconds": 14.088,
  "cues": [
   {
    "start": 0.1,
    "end": 2.775,
    "text": "复杂度是点数的三次方。"
   },
   {
    "start": 2.725,
    "end": 10.0625,
    "text": "对每个点各跑一次迪杰斯特拉，也能做到同样的数量级，但弗洛伊德只要三行循环。"
   },
   {
    "start": 10.0625,
    "end": 14.025,
    "text": "边权有负数也能用，只要图里没有负环。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-0304b7732f32.wav",
  "seconds": 9.816,
  "cues": [
   {
    "start": 0.1,
    "end": 3.75,
    "text": "一次放开一个中转点，留下更短的那条路。"
   },
   {
    "start": 3.7,
    "end": 9.75,
    "text": "中转点在最外层，三重循环，所有点对的最短距离都有了。"
   }
  ]
 }
]