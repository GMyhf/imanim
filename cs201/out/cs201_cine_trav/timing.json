[
 {
  "id": "title",
  "wav": "audio/title-04bd04616ac5.wav",
  "seconds": 13.704,
  "cues": [
   {
    "start": 0.1,
    "end": 6.5875,
    "text": "一棵树到处是分叉，可输出、存储、比较，往往只能一个接一个地来。"
   },
   {
    "start": 6.5375,
    "end": 13.6375,
    "text": "周游，就是给树上的结点排一个先后，每个结点恰好访问一次，把一棵树摊成一行。"
   }
  ]
 },
 {
  "id": "three",
  "wav": "audio/three-0b48a51e40fe.wav",
  "seconds": 17.256,
  "cues": [
   {
    "start": 0.1,
    "end": 5.075,
    "text": "二叉树只有三样东西：根、左子树、右子树。"
   },
   {
    "start": 5.025,
    "end": 10.3875,
    "text": "三样东西有六种排法，约定先左后右，就剩下三种。"
   },
   {
    "start": 10.3875,
    "end": 17.2,
    "text": "根在最前，叫前序；根在中间，叫中序；根在最后，叫后序。"
   }
  ]
 },
 {
  "id": "contour",
  "wav": "audio/contour-e4a551f6d37e.wav",
  "seconds": 25.416,
  "cues": [
   {
    "start": 0.1,
    "end": 1.7125,
    "text": "换个角度看。"
   },
   {
    "start": 1.6625,
    "end": 6.975,
    "text": "让一个点贴着树的轮廓，从根的左边出发，绕整棵树走一圈。"
   },
   {
    "start": 6.975,
    "end": 13.125,
    "text": "每个结点它都会经过三次：从左边下来，从底下穿过，从右边上去。"
   },
   {
    "start": 13.125,
    "end": 20.6,
    "text": "第一次经过时记下，得到前序；第二次记下，得到中序；第三次记下，得到后序。"
   },
   {
    "start": 20.6,
    "end": 25.35,
    "text": "三种周游走的是同一条路，只是记录的时机不同。"
   }
  ]
 },
 {
  "id": "flatten",
  "wav": "audio/flatten-a6bbdccc277e.wav",
  "seconds": 15.456,
  "cues": [
   {
    "start": 0.1,
    "end": 2.7125,
    "text": "中序还有一个直观的看法。"
   },
   {
    "start": 2.6625,
    "end": 9.275,
    "text": "把每个结点竖直地落到地面上，从左往右读，读出来的恰好就是中序。"
   },
   {
    "start": 9.275,
    "end": 15.4,
    "text": "左子树整个在根的左边，右子树整个在根的右边，这正是中序的定义。"
   }
  ]
 },
 {
  "id": "code",
  "wav": "audio/code-ac5cc58442f5.wav",
  "seconds": 23.952,
  "cues": [
   {
    "start": 0.1,
    "end": 8.4625,
    "text": "写成代码，三个函数长得一模一样：遇到空就返回，否则访问根，走进左子树，走进右子树。"
   },
   {
    "start": 8.4125,
    "end": 11.7,
    "text": "唯一的差别，是访问那一行放在哪里。"
   },
   {
    "start": 11.7,
    "end": 16.5875,
    "text": "访问和走进去是两件事，分清楚了，序列就不会写错。"
   },
   {
    "start": 16.5875,
    "end": 23.9,
    "text": "每个结点进出各一次，时间和结点数成正比；递归用的栈，深度等于树高。"
   }
  ]
 },
 {
  "id": "expr",
  "wav": "audio/expr-585fb3e47f58.wav",
  "seconds": 20.592,
  "cues": [
   {
    "start": 0.1,
    "end": 2.3875,
    "text": "三种次序各有用处。"
   },
   {
    "start": 2.3375,
    "end": 9.725,
    "text": "把表达式 A 加 B 乘以括号 C 加 D 画成树，运算符在内部结点，运算对象在叶子。"
   },
   {
    "start": 9.725,
    "end": 15.575,
    "text": "前序得到前缀式，后序得到后缀式，正是栈求值吃进去的那种。"
   },
   {
    "start": 15.575,
    "end": 20.5375,
    "text": "中序看着像原式，可括号丢了，照着算就错了。"
   }
  ]
 },
 {
  "id": "level",
  "wav": "audio/level-81c6449b71e7.wav",
  "seconds": 23.088,
  "cues": [
   {
    "start": 0.1,
    "end": 5.2875,
    "text": "还有第四种：一层一层、从左往右，叫层次周游。"
   },
   {
    "start": 5.2375,
    "end": 10.0,
    "text": "递归天生往深处钻，横着跳不过去，要靠队列。"
   },
   {
    "start": 10.0,
    "end": 16.075,
    "text": "根先入队；每次出队一个，访问它，再把它的左右孩子依次入队。"
   },
   {
    "start": 16.075,
    "end": 23.025,
    "text": "上层总比下层先入队，队列又先进先出，出队的次序就是逐层从左到右。"
   }
  ]
 },
 {
  "id": "rebuild",
  "wav": "audio/rebuild-363a89d28f00.wav",
  "seconds": 26.568,
  "cues": [
   {
    "start": 0.1,
    "end": 4.0,
    "text": "反过来，给出序列，能把树建回来吗？"
   },
   {
    "start": 3.95,
    "end": 6.0125,
    "text": "中序加后序就够了。"
   },
   {
    "start": 6.0125,
    "end": 9.6375,
    "text": "后序的最后一个一定是根，这里是 A。"
   },
   {
    "start": 9.6375,
    "end": 15.475,
    "text": "在中序里找到 A，左边四个结点是左子树，右边四个是右子树。"
   },
   {
    "start": 15.475,
    "end": 20.7125,
    "text": "左子树有四个，后序的前四个就归它，接下来四个归右子树。"
   },
   {
    "start": 20.7125,
    "end": 26.5,
    "text": "对两段各做一遍同样的事，直到区间为空，整棵树就长回来了。"
   }
  ]
 },
 {
  "id": "unique",
  "wav": "audio/unique-e8cfa74d1468.wav",
  "seconds": 17.88,
  "cues": [
   {
    "start": 0.1,
    "end": 6.4875,
    "text": "只给一个序列不行：前序 A B C，可以是一条往左的链，也可以是一条往右的链。"
   },
   {
    "start": 6.4375,
    "end": 14.3375,
    "text": "前序加后序也不行：前序 A B，后序 B A，分不清 B 是左孩子还是右孩子。"
   },
   {
    "start": 14.3375,
    "end": 17.8125,
    "text": "必须有中序，才能把左右切开。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-da043e508c27.wav",
  "seconds": 19.632,
  "cues": [
   {
    "start": 0.1,
    "end": 1.9375,
    "text": "最后比一比代价。"
   },
   {
    "start": 1.8875,
    "end": 9.525,
    "text": "深度优先靠栈，栈的深度是树高；层次周游靠队列，队列最长时装着最宽的一层。"
   },
   {
    "start": 9.525,
    "end": 19.575,
    "text": "前序、中序、后序，是同一圈轮廓上的三个记录时机；中序再配上前序或后序，就能唯一确定一棵树。"
   }
  ]
 }
]