[
 {
  "id": "title",
  "wav": "audio/title-ce84dd656dbe.wav",
  "seconds": 21.048,
  "cues": [
   {
    "start": 0.1,
    "end": 3.225,
    "text": "二叉树的每个结点只有两个指针。"
   },
   {
    "start": 3.175,
    "end": 9.9125,
    "text": "可一般的树，一个结点可能有三个、五个孩子，个数不固定，该怎么存？"
   },
   {
    "start": 9.9125,
    "end": 16.0,
    "text": "讲义的办法是只留两个指针：一个指向第一个孩子，一个指向下一个兄弟。"
   },
   {
    "start": 16.0,
    "end": 20.9875,
    "text": "这样一来，任何一片森林，都能变成一棵二叉树。"
   }
  ]
 },
 {
  "id": "forest",
  "wav": "audio/forest-4b9f423d1d81.wav",
  "seconds": 18.6,
  "cues": [
   {
    "start": 0.1,
    "end": 2.775,
    "text": "看讲义图六点五这片森林。"
   },
   {
    "start": 2.725,
    "end": 10.2625,
    "text": "第一棵树的根是 A，A 有三个孩子 B、C、D，C 下面还有 E 和 F。"
   },
   {
    "start": 10.2625,
    "end": 15.275,
    "text": "第二棵树的根是 G，孩子是 H 和 I，H 下面有 J。"
   },
   {
    "start": 15.275,
    "end": 18.55,
    "text": "森林就是若干棵互不相交的树。"
   }
  ]
 },
 {
  "id": "connect",
  "wav": "audio/connect-109f7596956b.wav",
  "seconds": 15.912,
  "cues": [
   {
    "start": 0.1,
    "end": 1.75,
    "text": "转换分三步。"
   },
   {
    "start": 1.7,
    "end": 6.575,
    "text": "第一步，连线：把同一个父结点的兄弟用线连起来。"
   },
   {
    "start": 6.575,
    "end": 11.45,
    "text": "B 连 C，C 连 D，E 连 F，H 连 I。"
   },
   {
    "start": 11.45,
    "end": 15.8625,
    "text": "两棵树的根 A 和 G 也算兄弟，同样连上。"
   }
  ]
 },
 {
  "id": "cut",
  "wav": "audio/cut-bb0aa6c33913.wav",
  "seconds": 14.256,
  "cues": [
   {
    "start": 0.1,
    "end": 7.675,
    "text": "第二步，切线：每个结点只保留通往第一个孩子的那条线，其余的父子线全部剪掉。"
   },
   {
    "start": 7.625,
    "end": 14.1875,
    "text": "A 到 C、A 到 D 剪掉，C 到 F 剪掉，G 到 I 也剪掉。"
   }
  ]
 },
 {
  "id": "rotate",
  "wav": "audio/rotate-9e2827f6616f.wav",
  "seconds": 19.248,
  "cues": [
   {
    "start": 0.1,
    "end": 6.3625,
    "text": "第三步，旋转：以 A 为轴，顺时针转四十五度，再整理一下。"
   },
   {
    "start": 6.3125,
    "end": 11.0375,
    "text": "原来竖着的线成了左枝，横着的兄弟线成了右枝。"
   },
   {
    "start": 11.0375,
    "end": 14.5375,
    "text": "左枝是父子关系，右枝是兄弟关系。"
   },
   {
    "start": 14.5375,
    "end": 19.2,
    "text": "根的右链 A、G，正好是森林里每棵树的根。"
   }
  ]
 },
 {
  "id": "pre",
  "wav": "audio/pre-1664b022b286.wav",
  "seconds": 12.0,
  "cues": [
   {
    "start": 0.1,
    "end": 3.1,
    "text": "这个对应连周游次序都保住了。"
   },
   {
    "start": 3.05,
    "end": 7.875,
    "text": "森林的先根次序：A B C E F D G H J I。"
   },
   {
    "start": 7.875,
    "end": 11.9375,
    "text": "把二叉树按前序走一遍，一个字母都不差。"
   }
  ]
 },
 {
  "id": "post",
  "wav": "audio/post-fd18629a0674.wav",
  "seconds": 20.736,
  "cues": [
   {
    "start": 0.1,
    "end": 6.6375,
    "text": "森林的后根次序：B E F C D A J H I G，恰好等于二叉树的中序。"
   },
   {
    "start": 6.5875,
    "end": 13.6,
    "text": "道理就藏在转换里：第一棵树的子树变成了左子树，其余的树变成了右子树。"
   },
   {
    "start": 13.6,
    "end": 20.675,
    "text": "后根是先走孩子、再访问根、再走后面的树，正对应中序的左、根、右。"
   }
  ]
 },
 {
  "id": "level",
  "wav": "audio/level-404eb14cb4a8.wav",
  "seconds": 17.64,
  "cues": [
   {
    "start": 0.1,
    "end": 11.675,
    "text": "层次次序却对不上：森林一层一层读，是 A G B C D H I E F J；二叉树一层一层读，是 A B G C H 开头。"
   },
   {
    "start": 11.625,
    "end": 17.575,
    "text": "一般树也没有中序，孩子多于两个，根就没法排在正中间。"
   }
  ]
 },
 {
  "id": "degree",
  "wav": "audio/degree-26c79cfee61b.wav",
  "seconds": 20.568,
  "cues": [
   {
    "start": 0.1,
    "end": 2.8125,
    "text": "存树还可以完全不用指针。"
   },
   {
    "start": 2.7625,
    "end": 15.475,
    "text": "把后根次序和每个结点的度数一起记下来，从左往右扫：度为零，就压进栈；度为 k，就从栈顶弹出 k 棵子树当它的孩子，再把新树压回去。"
   },
   {
    "start": 15.475,
    "end": 20.5125,
    "text": "扫完，栈里剩下 A 和 G 两棵树，森林原样回来了。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-a1f28a4498f0.wav",
  "seconds": 11.736,
  "cues": [
   {
    "start": 0.1,
    "end": 5.425,
    "text": "左孩子，右兄弟：任意多叉的森林都能压成一棵二叉树。"
   },
   {
    "start": 5.375,
    "end": 11.675,
    "text": "先根对前序，后根对中序，二叉树上的算法，全都能搬过来用。"
   }
  ]
 }
]