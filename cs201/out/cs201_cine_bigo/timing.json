[
 {
  "id": "title",
  "wav": "audio/title-39c87a2bc009.wav",
  "seconds": 15.12,
  "cues": [
   {
    "start": 0.1,
    "end": 4.7,
    "text": "同一个问题：把数组每一段前缀的和都打印出来。"
   },
   {
    "start": 4.65,
    "end": 11.3625,
    "text": "讲义给的写法是，每一段都从头加一遍；另一种写法是接着上一段往下加。"
   },
   {
    "start": 11.3625,
    "end": 15.0625,
    "text": "两份代码输出完全一样，哪一个更快？"
   }
  ]
 },
 {
  "id": "count",
  "wav": "audio/count-4e8a16b93732.wav",
  "seconds": 19.296,
  "cues": [
   {
    "start": 0.1,
    "end": 1.675,
    "text": "不能拿秒来比。"
   },
   {
    "start": 1.625,
    "end": 7.1625,
    "text": "同一个程序，换台机器、换种语言，秒数能差几十倍。"
   },
   {
    "start": 7.1625,
    "end": 10.0625,
    "text": "我们数基本操作，这里数赋值。"
   },
   {
    "start": 10.0625,
    "end": 19.2375,
    "text": "从头加的写法，赋值次数是一加三倍的 n，再加 n 乘以 n 减一；接着加的写法，是二加二倍的 n。"
   }
  ]
 },
 {
  "id": "curves",
  "wav": "audio/curves-b79dc211bfcc.wav",
  "seconds": 15.696,
  "cues": [
   {
    "start": 0.1,
    "end": 2.175,
    "text": "把真实的计数画出来。"
   },
   {
    "start": 2.125,
    "end": 6.6125,
    "text": "n 等于十，一个是一百二十一次，一个是二十二次。"
   },
   {
    "start": 6.6125,
    "end": 12.3625,
    "text": "n 等于一千，一个是一百万两千零一次，另一个只有两千零二次。"
   },
   {
    "start": 12.3625,
    "end": 15.6375,
    "text": "差的不是倍数，是量级。"
   }
  ]
 },
 {
  "id": "lower",
  "wav": "audio/lower-456389a7fce6.wav",
  "seconds": 26.304,
  "cues": [
   {
    "start": 0.1,
    "end": 2.2875,
    "text": "为什么只看最高次项？"
   },
   {
    "start": 2.2375,
    "end": 8.2375,
    "text": "看这个函数：n 平方，加一百倍的 n，加 n 的对数，再加一千。"
   },
   {
    "start": 8.2375,
    "end": 21.6875,
    "text": "n 等于一，常数一千占了九成；n 等于十，一百倍的 n 和一千打平；n 等于一百，n 平方追上一百倍的 n；到了一千，n 平方占九成以上。"
   },
   {
    "start": 21.6875,
    "end": 26.2375,
    "text": "n 越大，低阶项和常数越无关紧要。"
   }
  ]
 },
 {
  "id": "bigo",
  "wav": "audio/bigo-ae18935c715f.wav",
  "seconds": 16.032,
  "cues": [
   {
    "start": 0.1,
    "end": 7.35,
    "text": "大 O 说的是上界：存在常数 c 和起点 N，从 N 往后，f 始终压在 c 倍的 g 下面。"
   },
   {
    "start": 7.3,
    "end": 11.55,
    "text": "前面一小段怎么乱都不管，只看足够大以后。"
   },
   {
    "start": 11.55,
    "end": 15.975,
    "text": "把不等号反过来，就是下界，叫大欧米伽。"
   }
  ]
 },
 {
  "id": "theta",
  "wav": "audio/theta-68c0606453f9.wav",
  "seconds": 22.896,
  "cues": [
   {
    "start": 0.1,
    "end": 3.9125,
    "text": "上下界是同一个函数，就记作大西塔。"
   },
   {
    "start": 3.8625,
    "end": 8.55,
    "text": "讲义的例子：一百 n 平方，加五 n，加五百。"
   },
   {
    "start": 8.55,
    "end": 14.55,
    "text": "n 大于十以后，它始终夹在一百 n 平方和一百零五 n 平方之间。"
   },
   {
    "start": 14.55,
    "end": 20.0625,
    "text": "把它除以 n 平方画出来，曲线落进这条窄带，越来越贴近一百。"
   },
   {
    "start": 20.0625,
    "end": 22.825,
    "text": "所以它是 n 平方阶的。"
   }
  ]
 },
 {
  "id": "nest",
  "wav": "audio/nest-feb38e5850a4.wav",
  "seconds": 18.048,
  "cues": [
   {
    "start": 0.1,
    "end": 2.9625,
    "text": "嵌套循环就一定是平方吗？"
   },
   {
    "start": 2.9125,
    "end": 4.0625,
    "text": "不一定。"
   },
   {
    "start": 4.0625,
    "end": 10.9625,
    "text": "讲义第三段代码，对每个位置只加它和前面一共五个数，内层永远跑四次。"
   },
   {
    "start": 10.9625,
    "end": 18.0,
    "text": "n 等于十，总共六十七次赋值；每多一个数，只多十一次，还是线性。"
   }
  ]
 },
 {
  "id": "cases",
  "wav": "audio/cases-793c8d5d3c96.wav",
  "seconds": 23.592,
  "cues": [
   {
    "start": 0.1,
    "end": 3.6625,
    "text": "规模一样，输入不同，代价也不同。"
   },
   {
    "start": 3.6125,
    "end": 15.275,
    "text": "顺序找一个数：它排在第一个，比一次就够，这是最好；排在最后，要比 n 次，这是最坏；每个位置机会均等，平均是 n 加一除以二。"
   },
   {
    "start": 15.275,
    "end": 23.5375,
    "text": "要是它一半机会在第一个，四分之一在第二个，平均只要一加八分之 n 加三，一千个数时快了将近四倍。"
   }
  ]
 },
 {
  "id": "growth",
  "wav": "audio/growth-545c29ecdf5e.wav",
  "seconds": 15.312,
  "cues": [
   {
    "start": 0.1,
    "end": 2.3625,
    "text": "增长率差一级有多大？"
   },
   {
    "start": 2.3125,
    "end": 15.2625,
    "text": "每步一微秒，n 取一千：线性是一毫秒，平方是一秒，立方是一千秒，十六分多钟；指数级的二的 n 次方，大约要三乘十的二百八十七次方年。"
   }
  ]
 },
 {
  "id": "tradeoff",
  "wav": "audio/tradeoff-80616c761238.wav",
  "seconds": 17.808,
  "cues": [
   {
    "start": 0.1,
    "end": 2.2125,
    "text": "空间也能换时间。"
   },
   {
    "start": 2.1625,
    "end": 12.35,
    "text": "在一千家公司的黄页里找电话，逐个比名字，平均要比五百多次；加一张散列索引，多占一千个格子，每次只要算一次散列。"
   },
   {
    "start": 12.35,
    "end": 15.5625,
    "text": "反过来，也可以多花时间来省空间。"
   },
   {
    "start": 15.5625,
    "end": 17.75,
    "text": "没有免费的加速。"
   }
  ]
 }
]