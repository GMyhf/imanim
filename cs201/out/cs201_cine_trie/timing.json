[
 {
  "id": "title",
  "wav": "audio/title-4a1ace6399ad.wav",
  "seconds": 20.328,
  "cues": [
   {
    "start": 0.1,
    "end": 6.2625,
    "text": "在搜索框里敲下 a、n 两个字母，下面立刻弹出 and 和 ant。"
   },
   {
    "start": 6.2125,
    "end": 14.675,
    "text": "要回答以 an 开头的有哪些词，散列表帮不上忙，它只认完整的关键字，只能把所有单词挨个看一遍。"
   },
   {
    "start": 14.675,
    "end": 20.2625,
    "text": "这一集讲专门干这件事的结构：字典树，也叫前缀树。"
   }
  ]
 },
 {
  "id": "build",
  "wav": "audio/build-758e6618055c.wav",
  "seconds": 22.152,
  "cues": [
   {
    "start": 0.1,
    "end": 7.0875,
    "text": "把讲义里的六个单词依次插进去：and、ant、do、geek、dad、ball。"
   },
   {
    "start": 7.0375,
    "end": 12.25,
    "text": "插入就是从根出发，一个字母走一步，路上没有的结点就新建。"
   },
   {
    "start": 12.25,
    "end": 16.4625,
    "text": "插 ant 时，a 和 n 已经有了，只新建一个 t。"
   },
   {
    "start": 16.4625,
    "end": 19.5625,
    "text": "插 dad 时，开头的 d 也能共用。"
   },
   {
    "start": 19.5625,
    "end": 22.1,
    "text": "公共前缀只存一份。"
   }
  ]
 },
 {
  "id": "mark",
  "wav": "audio/mark-a613e10c7aa6.wav",
  "seconds": 18.288,
  "cues": [
   {
    "start": 0.1,
    "end": 6.4875,
    "text": "可是，从根走一个 a、再走一个 n，这条路也走得通，它算不算一个单词？"
   },
   {
    "start": 6.4375,
    "end": 12.0,
    "text": "所以每个结点还要记一个数，表示有几个单词恰好在这里结束。"
   },
   {
    "start": 12.0,
    "end": 18.2375,
    "text": "讲义用的是计数而不是真假标记，同一个词插两次，计数就是二。"
   }
  ]
 },
 {
  "id": "search",
  "wav": "audio/search-cddd1313f295.wav",
  "seconds": 19.656,
  "cues": [
   {
    "start": 0.1,
    "end": 2.4875,
    "text": "查找走的是同一条路。"
   },
   {
    "start": 2.4375,
    "end": 7.5625,
    "text": "查 do：d、o，两步走到，计数是一，找到了。"
   },
   {
    "start": 7.5625,
    "end": 12.925,
    "text": "查 bat：b、a 都在，可 a 下面没有 t，当场失败。"
   },
   {
    "start": 12.925,
    "end": 19.5875,
    "text": "查 an：路走得通，但 n 的计数是零，所以它不是单词，只是一个前缀。"
   }
  ]
 },
 {
  "id": "cost",
  "wav": "audio/cost-9ae2cdb43bfe.wav",
  "seconds": 15.696,
  "cues": [
   {
    "start": 0.1,
    "end": 4.8,
    "text": "注意查找的步数：查一个词，最多走它的长度那么多步。"
   },
   {
    "start": 4.75,
    "end": 11.3125,
    "text": "词典里存六个词，查 ant 走三步；存六百个、六万个词，还是三步。"
   },
   {
    "start": 11.3125,
    "end": 15.625,
    "text": "代价只和单词长度有关，和词典大小无关。"
   }
  ]
 },
 {
  "id": "prefix",
  "wav": "audio/prefix-add835fac361.wav",
  "seconds": 19.656,
  "cues": [
   {
    "start": 0.1,
    "end": 3.075,
    "text": "前缀查询才是它的拿手戏。"
   },
   {
    "start": 3.025,
    "end": 10.8625,
    "text": "先沿着 a、n 走到前缀的终点，这下面的每个单词都以 an 开头：and 和 ant。"
   },
   {
    "start": 10.8625,
    "end": 16.075,
    "text": "孩子按字母顺序深度优先往下走，得到的天然就是字典序。"
   },
   {
    "start": 16.075,
    "end": 19.6,
    "text": "前缀 d 下面，是 dad 和 do。"
   }
  ]
 },
 {
  "id": "memory",
  "wav": "audio/memory-5efce7c27140.wav",
  "seconds": 18.504,
  "cues": [
   {
    "start": 0.1,
    "end": 1.9875,
    "text": "代价在空间上。"
   },
   {
    "start": 1.9375,
    "end": 7.7125,
    "text": "讲义的每个结点都开一个二十六格的数组，根结点只用了其中四格。"
   },
   {
    "start": 7.7125,
    "end": 12.5125,
    "text": "整棵树十七个结点，四百四十二格里只用了十六格。"
   },
   {
    "start": 12.5125,
    "end": 18.4375,
    "text": "字母稀疏的时候，可以把数组换成字典，只存真正出现的孩子。"
   }
  ]
 },
 {
  "id": "delete",
  "wav": "audio/delete-92a24d7f7b1d.wav",
  "seconds": 18.816,
  "cues": [
   {
    "start": 0.1,
    "end": 2.625,
    "text": "删除要从下往上收拾。"
   },
   {
    "start": 2.575,
    "end": 13.975,
    "text": "删 geek：先把 k 的计数减成零，k 没有孩子，拆掉；回到上一层，e 也成了既不是结尾、又没有孩子的空结点，接着拆，一直拆到根。"
   },
   {
    "start": 13.975,
    "end": 18.75,
    "text": "删 ant 就只拆一个 t，因为 n 下面还挂着 and。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-7fdebb7a41b7.wav",
  "seconds": 14.712,
  "cues": [
   {
    "start": 0.1,
    "end": 11.475,
    "text": "字典树把单词拆成字母，一个字母一层：公共前缀只存一份，插入和查找的步数等于单词长度，前缀查询和按字典序输出都顺手。"
   },
   {
    "start": 11.425,
    "end": 14.65,
    "text": "代价是每个结点那一排指针。"
   }
  ]
 }
]