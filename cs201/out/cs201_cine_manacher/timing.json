[
 {
  "id": "title",
  "wav": "audio/title-26bb5d485c4d.wav",
  "seconds": 18.144,
  "cues": [
   {
    "start": 0.1,
    "end": 3.8625,
    "text": "给一个字符串，找出最长的回文子串。"
   },
   {
    "start": 3.8125,
    "end": 9.3,
    "text": "比如 b a b a d，答案是 b a b，或者 a b a。"
   },
   {
    "start": 9.3,
    "end": 13.4625,
    "text": "挨个当中心往两边扩，最坏要平方时间。"
   },
   {
    "start": 13.4625,
    "end": 18.075,
    "text": "马拉车算法只要线性时间，秘诀是照镜子。"
   }
  ]
 },
 {
  "id": "expand",
  "wav": "audio/expand-bf7df8b8b1eb.wav",
  "seconds": 22.968,
  "cues": [
   {
    "start": 0.1,
    "end": 8.0,
    "text": "先看中心扩展：每个字符，以及每两个字符之间的空隙，都可能是中心，一共二 n 减一个。"
   },
   {
    "start": 7.95,
    "end": 11.9,
    "text": "从中心出发，两边相等就继续往外。"
   },
   {
    "start": 11.9,
    "end": 16.225,
    "text": "最怕全是同一个字母的串，每个中心都扩到头。"
   },
   {
    "start": 16.225,
    "end": 22.9,
    "text": "十个 a 要比五十五次，八十个 a 要比三千二百四十次，是平方级的增长。"
   }
  ]
 },
 {
  "id": "sharp",
  "wav": "audio/sharp-ecc69713fad2.wav",
  "seconds": 22.224,
  "cues": [
   {
    "start": 0.1,
    "end": 4.5875,
    "text": "第一步改造：在字符之间和两头都插一个井号。"
   },
   {
    "start": 4.5375,
    "end": 10.5625,
    "text": "a b b a 变成九个字符，偶数长度的回文，中心落在井号上。"
   },
   {
    "start": 10.5625,
    "end": 14.7375,
    "text": "这样所有回文都是奇数长度，只剩一种中心。"
   },
   {
    "start": 14.7375,
    "end": 22.175,
    "text": "以下标 i 为中心的回文半径记作 p，p 减一，正好是原串里回文的长度。"
   }
  ]
 },
 {
  "id": "mirror",
  "wav": "audio/mirror-19aeb0750b22.wav",
  "seconds": 25.152,
  "cues": [
   {
    "start": 0.1,
    "end": 6.1125,
    "text": "主例是 a b a c a b a c a b，插井号后二十一格。"
   },
   {
    "start": 6.0625,
    "end": 7.975,
    "text": "从左往右算 p。"
   },
   {
    "start": 7.975,
    "end": 12.2,
    "text": "算到下标七的 c，回文一直扩到下标十四。"
   },
   {
    "start": 12.2,
    "end": 17.1125,
    "text": "记下这个最右边界 R 等于十四，中心 C 等于七。"
   },
   {
    "start": 17.1125,
    "end": 25.0875,
    "text": "之后的下标 i 只要在 R 以内，就有一个关于 C 对称的镜像，二 C 减 i，它的 p 早就算好了。"
   }
  ]
 },
 {
  "id": "inside",
  "wav": "audio/inside-8009a3fcd423.wav",
  "seconds": 17.352,
  "cues": [
   {
    "start": 0.1,
    "end": 5.2875,
    "text": "第一种情况：镜像的回文完整地落在大回文里面。"
   },
   {
    "start": 5.2375,
    "end": 9.325,
    "text": "比如下标九，镜像是下标五，半径二。"
   },
   {
    "start": 9.325,
    "end": 17.3,
    "text": "大回文左右对称，所以下标九的半径也是二，直接抄过来，只比一次，确认扩不动。"
   }
  ]
 },
 {
  "id": "edge",
  "wav": "audio/edge-cb01f307af86.wav",
  "seconds": 22.392,
  "cues": [
   {
    "start": 0.1,
    "end": 4.7375,
    "text": "第二种情况：镜像的回文碰到了大回文的左边界。"
   },
   {
    "start": 4.6875,
    "end": 12.3875,
    "text": "下标十一，镜像是下标三，半径四，可是到 R 只剩三格，镜子外面的部分不能保证。"
   },
   {
    "start": 12.3875,
    "end": 17.0625,
    "text": "所以先取三，再从边界开始老老实实往外比。"
   },
   {
    "start": 17.0625,
    "end": 22.325,
    "text": "这一下扩到了串尾，半径十，R 从十四推到二十。"
   }
  ]
 },
 {
  "id": "run",
  "wav": "audio/run-2406f3722fc9.wav",
  "seconds": 18.0,
  "cues": [
   {
    "start": 0.1,
    "end": 5.7,
    "text": "第三种情况：i 在 R 外面，没有镜子可照，只能从一开始扩。"
   },
   {
    "start": 5.65,
    "end": 9.825,
    "text": "把整串跑一遍，R 只往右走，从不回头。"
   },
   {
    "start": 9.825,
    "end": 17.95,
    "text": "最长回文的中心在下标十一，半径十，对应原串的 b a c a b a c a b，长度九。"
   }
  ]
 },
 {
  "id": "linear",
  "wav": "audio/linear-ce72b602c6c8.wav",
  "seconds": 25.416,
  "cues": [
   {
    "start": 0.1,
    "end": 1.8625,
    "text": "为什么是线性的？"
   },
   {
    "start": 1.8125,
    "end": 12.65,
    "text": "失败的比较，每个下标最多一次；成功的比较都在 R 的边上或外面，往外每成功一次，R 就推远一格，而 R 最多推到末尾。"
   },
   {
    "start": 12.65,
    "end": 18.975,
    "text": "讲义的代码初值少取了一格，碰到边界会多复核一次，也是每个下标最多一次。"
   },
   {
    "start": 18.975,
    "end": 25.3625,
    "text": "八十个 a，中心扩展比三千二百四十次，马拉车只要三百一十六次。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-073e1892c2aa.wav",
  "seconds": 16.032,
  "cues": [
   {
    "start": 0.1,
    "end": 5.4625,
    "text": "马拉车和 KMP 是一个思路：利用比过的信息，不做重复劳动。"
   },
   {
    "start": 5.4125,
    "end": 9.375,
    "text": "KMP 照的是前后缀，马拉车照的是镜子。"
   },
   {
    "start": 9.375,
    "end": 15.9625,
    "text": "在 R 里面就少干活；要突破 R，就老老实实比，顺手把 R 往右推。"
   }
  ]
 }
]