[
 {
  "id": "title",
  "wav": "audio/title-98ffb0d5735c.wav",
  "seconds": 15.84,
  "cues": [
   {
    "start": 0.1,
    "end": 2.8625,
    "text": "一个工程由许多活动组成。"
   },
   {
    "start": 2.8125,
    "end": 7.15,
    "text": "有的活动能同时进行，有的必须等别的做完才能开始。"
   },
   {
    "start": 7.15,
    "end": 9.5,
    "text": "整个工程最少要多久？"
   },
   {
    "start": 9.5,
    "end": 12.9375,
    "text": "哪些活动一拖延，整个工期就跟着拖？"
   },
   {
    "start": 12.9375,
    "end": 15.775,
    "text": "这一集，关键路径。"
   }
  ]
 },
 {
  "id": "net",
  "wav": "audio/net-4a4fc8755657.wav",
  "seconds": 17.304,
  "cues": [
   {
    "start": 0.1,
    "end": 2.1375,
    "text": "把工程画成一张图。"
   },
   {
    "start": 2.0875,
    "end": 10.2625,
    "text": "边是活动，边上的数字是它要干几天；点是事件，表示进入它的活动全都干完的那一刻。"
   },
   {
    "start": 10.2625,
    "end": 12.9625,
    "text": "零是开工，五是完工。"
   },
   {
    "start": 12.9625,
    "end": 17.2375,
    "text": "这种用边表示活动的网，必须是有向无环图。"
   }
  ]
 },
 {
  "id": "longest",
  "wav": "audio/longest-e4411ca00b41.wav",
  "seconds": 19.08,
  "cues": [
   {
    "start": 0.1,
    "end": 2.9625,
    "text": "从开工到完工有四条路。"
   },
   {
    "start": 2.9125,
    "end": 10.6,
    "text": "零一三五，七天；零一四五，也是七天；零二三五，八天；零二五，三天。"
   },
   {
    "start": 10.6,
    "end": 15.5625,
    "text": "所有活动都要干完，最长的那条决定工期：最少八天。"
   },
   {
    "start": 15.5625,
    "end": 19.0125,
    "text": "最长的这条路，叫关键路径。"
   }
  ]
 },
 {
  "id": "ve",
  "wav": "audio/ve-a588f342d740.wav",
  "seconds": 30.528,
  "cues": [
   {
    "start": 0.1,
    "end": 2.7,
    "text": "不枚举路径，怎么求？"
   },
   {
    "start": 2.65,
    "end": 7.3,
    "text": "按拓扑序往后推，算每个事件最早什么时候发生。"
   },
   {
    "start": 7.3,
    "end": 8.975,
    "text": "零是第零天。"
   },
   {
    "start": 8.975,
    "end": 12.4,
    "text": "一最早第三天，二最早第二天。"
   },
   {
    "start": 12.4,
    "end": 20.95,
    "text": "事件三有两个活动进来，要等两个都干完：一那边是第五天，二那边是第六天，取最大，第六天。"
   },
   {
    "start": 20.95,
    "end": 22.8125,
    "text": "四是第六天。"
   },
   {
    "start": 22.8125,
    "end": 30.475,
    "text": "事件五有三个活动进来，依次更新成三、七、八，取最大，八，这就是工期。"
   }
  ]
 },
 {
  "id": "vl",
  "wav": "audio/vl-71f36478b714.wav",
  "seconds": 27.48,
  "cues": [
   {
    "start": 0.1,
    "end": 5.6,
    "text": "再倒着推，算每个事件最迟什么时候发生，才不耽误完工。"
   },
   {
    "start": 5.55,
    "end": 7.3125,
    "text": "五是第八天。"
   },
   {
    "start": 7.3125,
    "end": 11.275,
    "text": "三最迟第六天，四最迟第七天。"
   },
   {
    "start": 11.275,
    "end": 19.9375,
    "text": "二有两个活动出去：去三要四天，六减四是二；去五要一天，八减一是七；取最小，第二天。"
   },
   {
    "start": 19.9375,
    "end": 23.55,
    "text": "一最迟第四天，零最迟第零天。"
   },
   {
    "start": 23.55,
    "end": 27.4125,
    "text": "取最小，是因为不能耽误任何一个后继。"
   }
  ]
 },
 {
  "id": "slack",
  "wav": "audio/slack-30729bc069b9.wav",
  "seconds": 23.04,
  "cues": [
   {
    "start": 0.1,
    "end": 7.6875,
    "text": "每个活动，最早开工看起点的最早时间，最迟开工看终点的最迟时间减去它要干的天数。"
   },
   {
    "start": 7.6375,
    "end": 10.4125,
    "text": "两者之差叫机动时间。"
   },
   {
    "start": 10.4125,
    "end": 18.775,
    "text": "零到二、二到三、三到五，机动时间都是零，一天也拖不得，它们连成的就是关键路径。"
   },
   {
    "start": 18.775,
    "end": 22.9875,
    "text": "二到五能拖五天，其余的都只能拖一天。"
   }
  ]
 },
 {
  "id": "share",
  "wav": "audio/share-1a33cefde8cf.wav",
  "seconds": 11.016,
  "cues": [
   {
    "start": 0.1,
    "end": 3.5875,
    "text": "注意，机动时间是一条路上共用的。"
   },
   {
    "start": 3.5375,
    "end": 10.9625,
    "text": "把零到一拖一天，工期还是八天，可是一后面的两个活动，机动时间也被吃掉了，变成零。"
   }
  ]
 },
 {
  "id": "shorten",
  "wav": "audio/shorten-21e4f68dd9ab.wav",
  "seconds": 18.432,
  "cues": [
   {
    "start": 0.1,
    "end": 3.925,
    "text": "想缩短工期，就得在关键活动上下功夫。"
   },
   {
    "start": 3.875,
    "end": 9.5625,
    "text": "把一到四从三天缩到一天，它不在关键路径上，工期还是八。"
   },
   {
    "start": 9.5625,
    "end": 18.375,
    "text": "把关键活动二到三从四天缩到两天，工期却只降到七：原来七天的那两条路，成了新的关键路径。"
   }
  ]
 },
 {
  "id": "code",
  "wav": "audio/code-85acd073ebf2.wav",
  "seconds": 15.096,
  "cues": [
   {
    "start": 0.1,
    "end": 2.4875,
    "text": "讲义的代码就是三段。"
   },
   {
    "start": 2.4375,
    "end": 12.3875,
    "text": "正着按拓扑序走，最早时间取最大；倒着再走一遍，最迟时间取最小；最后挑出最早和最迟开工相等的活动。"
   },
   {
    "start": 12.3875,
    "end": 15.025,
    "text": "两遍都是点数加边数。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-3d4092b99dae.wav",
  "seconds": 10.776,
  "cues": [
   {
    "start": 0.1,
    "end": 3.2375,
    "text": "关键路径，就是最长的那条路。"
   },
   {
    "start": 3.1875,
    "end": 10.725,
    "text": "正着推，取最大；倒着推，取最小；机动时间为零的活动，一天也拖不得。"
   }
  ]
 }
]