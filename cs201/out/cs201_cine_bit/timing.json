[
 {
  "id": "title",
  "wav": "audio/title-56b7b7ee0c7c.wav",
  "seconds": 14.712,
  "cues": [
   {
    "start": 0.1,
    "end": 1.9125,
    "text": "一排十六个数。"
   },
   {
    "start": 1.8625,
    "end": 5.975,
    "text": "有人不停地问：前十四个数加起来是多少？"
   },
   {
    "start": 5.975,
    "end": 9.7375,
    "text": "时不时还要改掉其中一个数，改完接着问。"
   },
   {
    "start": 9.7375,
    "end": 14.6625,
    "text": "这一集讲一种把两件事都做快的结构：树状数组。"
   }
  ]
 },
 {
  "id": "dilemma",
  "wav": "audio/dilemma-2259f83db477.wav",
  "seconds": 21.552,
  "cues": [
   {
    "start": 0.1,
    "end": 2.7375,
    "text": "最直接的办法是原样存着。"
   },
   {
    "start": 2.6875,
    "end": 9.4375,
    "text": "改一个数，一步就够；可要问前十四个数的和，得从头加过去，走十四步。"
   },
   {
    "start": 9.4375,
    "end": 18.3625,
    "text": "反过来，提前算好前缀和，查询一步就出结果；可第三个数变了，十四个前缀和全都要跟着改。"
   },
   {
    "start": 18.3625,
    "end": 21.4875,
    "text": "我们想要两头都只花对数时间。"
   }
  ]
 },
 {
  "id": "lowbit",
  "wav": "audio/lowbit-fcf6838a6464.wav",
  "seconds": 23.136,
  "cues": [
   {
    "start": 0.1,
    "end": 2.025,
    "text": "钥匙藏在二进制里。"
   },
   {
    "start": 1.975,
    "end": 5.325,
    "text": "十二写成二进制，是一一零零。"
   },
   {
    "start": 5.325,
    "end": 8.575,
    "text": "负十二是按位取反、再加一。"
   },
   {
    "start": 8.575,
    "end": 15.05,
    "text": "十二和负十二按位与，只剩一个一，正是十二最低位的那个一，值是四。"
   },
   {
    "start": 15.05,
    "end": 17.9625,
    "text": "代码里就写作 x 与负 x。"
   },
   {
    "start": 17.9625,
    "end": 23.075,
    "text": "同样，六最低位的一是二，七是一，八是八。"
   }
  ]
 },
 {
  "id": "cover",
  "wav": "audio/cover-4209a55760af.wav",
  "seconds": 18.432,
  "cues": [
   {
    "start": 0.1,
    "end": 7.8,
    "text": "树状数组的第 i 格，不存前 i 个数的和，只存以 i 结尾、长度等于 i 最低位的一的那一段。"
   },
   {
    "start": 7.75,
    "end": 14.7875,
    "text": "奇数只管自己；二管两个数，四管四个，八管八个，十六管全部十六个。"
   },
   {
    "start": 14.7875,
    "end": 18.3625,
    "text": "这些段一层层叠起来，就是一棵树。"
   }
  ]
 },
 {
  "id": "query",
  "wav": "audio/query-37091201c255.wav",
  "seconds": 30.48,
  "cues": [
   {
    "start": 0.1,
    "end": 2.375,
    "text": "现在问前十四个数的和。"
   },
   {
    "start": 2.325,
    "end": 7.075,
    "text": "十四是一一一零，第十四格管十三和十四两个数。"
   },
   {
    "start": 7.075,
    "end": 12.4125,
    "text": "十四减去最低位的二，跳到十二；第十二格管九到十二。"
   },
   {
    "start": 12.4125,
    "end": 16.2125,
    "text": "再减四，跳到八；第八格管一到八。"
   },
   {
    "start": 16.2125,
    "end": 18.675,
    "text": "再减八就到零，停下。"
   },
   {
    "start": 18.675,
    "end": 25.4125,
    "text": "三段拼起来正好是一到十四：二十七加四十二加三十六，等于一百零五。"
   },
   {
    "start": 25.4125,
    "end": 30.425,
    "text": "每跳一步抹掉一个一，十四有三个一，就跳三步。"
   }
  ]
 },
 {
  "id": "update",
  "wav": "audio/update-bf79786e5828.wav",
  "seconds": 26.88,
  "cues": [
   {
    "start": 0.1,
    "end": 2.8375,
    "text": "再看修改：给第六个数加三。"
   },
   {
    "start": 2.7875,
    "end": 9.975,
    "text": "从六出发，加上它最低位的二，到八；八再加八，到十六；再加就出界了。"
   },
   {
    "start": 9.975,
    "end": 17.1125,
    "text": "第六、第八、第十六格，正好是盖住第六个数的全部格子，各加三就改完了。"
   },
   {
    "start": 17.1125,
    "end": 21.7625,
    "text": "加上最低位的一会产生进位，管的段至少翻一倍。"
   },
   {
    "start": 21.7625,
    "end": 26.825,
    "text": "从九出发也一样：九、十、十二、十六。"
   }
  ]
 },
 {
  "id": "cost",
  "wav": "audio/cost-ceea30084bc7.wav",
  "seconds": 23.352,
  "cues": [
   {
    "start": 0.1,
    "end": 6.4125,
    "text": "查询每跳一步，抹掉一个一；修改每跳一步，最低位的一至少左移一位。"
   },
   {
    "start": 6.3625,
    "end": 11.35,
    "text": "两种都不超过二进制位数，一百万个数，最多二十步。"
   },
   {
    "start": 11.35,
    "end": 17.1625,
    "text": "原数组和前缀和总有一头是线性，树状数组两头都是对数。"
   },
   {
    "start": 17.1625,
    "end": 23.2875,
    "text": "注意下标必须从一开始：零与负零还是零，循环会原地打转。"
   }
  ]
 },
 {
  "id": "ants",
  "wav": "audio/ants-b245a2546b4f.wav",
  "seconds": 23.184,
  "cues": [
   {
    "start": 0.1,
    "end": 2.75,
    "text": "看一个应用：蚂蚁越野跑。"
   },
   {
    "start": 2.7,
    "end": 8.9375,
    "text": "五只蚂蚁从前往后站好，速度是一、五、十、七、六。"
   },
   {
    "start": 8.9375,
    "end": 11.6625,
    "text": "一共有多少次后面的追上前面的？"
   },
   {
    "start": 11.6625,
    "end": 15.1125,
    "text": "也就是数有多少对前小后大。"
   },
   {
    "start": 15.1125,
    "end": 23.125,
    "text": "速度可能很大，先离散化：一排第一，五排第二，六第三，七第四，十第五。"
   }
  ]
 },
 {
  "id": "scan",
  "wav": "audio/scan-63bf2450a7bb.wav",
  "seconds": 26.376,
  "cues": [
   {
    "start": 0.1,
    "end": 5.2625,
    "text": "然后从前往后扫，树状数组记录每个名次出现过几只。"
   },
   {
    "start": 5.2125,
    "end": 11.3,
    "text": "轮到速度十，名次五，查前四名有几只：两只，答案加二。"
   },
   {
    "start": 11.3,
    "end": 17.025,
    "text": "轮到七，前三名里有两只；轮到六，前两名里也有两只。"
   },
   {
    "start": 17.025,
    "end": 20.725,
    "text": "零加一加二加二加二，一共七次赶超。"
   },
   {
    "start": 20.725,
    "end": 26.325,
    "text": "每只蚂蚁一次查询、一次修改，总共是 n 乘以对数 n。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-4b851488a547.wav",
  "seconds": 15.024,
  "cues": [
   {
    "start": 0.1,
    "end": 4.35,
    "text": "回头看：最低位的一，决定了每一格管多长。"
   },
   {
    "start": 4.3,
    "end": 8.525,
    "text": "查询往下减，修改往上加，各走对数步。"
   },
   {
    "start": 8.525,
    "end": 14.975,
    "text": "一个数组，加两个不到五行的循环，前缀和就变得又能查、又能改。"
   }
  ]
 }
]