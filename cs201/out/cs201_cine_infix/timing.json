[
 {
  "id": "title",
  "wav": "audio/title-0c78f717f45b.wav",
  "seconds": 27.864,
  "cues": [
   {
    "start": 0.1,
    "end": 5.8875,
    "text": "二十三，加上三十四乘四十五的积，再除以五加六加七的和。"
   },
   {
    "start": 5.8375,
    "end": 11.0875,
    "text": "人一眼就看出先算括号，再算乘除，最后算加减。"
   },
   {
    "start": 11.0875,
    "end": 16.575,
    "text": "可计算机拿到的只是一串字符，它怎么知道谁先算？"
   },
   {
    "start": 16.575,
    "end": 21.3125,
    "text": "办法是先把算式改写成后缀式，再用栈求值。"
   },
   {
    "start": 21.3125,
    "end": 27.8125,
    "text": "改写这一步，叫调度场算法，是迪杰斯特拉在上世纪六十年代提出的。"
   }
  ]
 },
 {
  "id": "yard",
  "wav": "audio/yard-468828c80653.wav",
  "seconds": 18.744,
  "cues": [
   {
    "start": 0.1,
    "end": 3.45,
    "text": "调度场原本是铁路上的编组站。"
   },
   {
    "start": 3.4,
    "end": 10.1,
    "text": "记号一节一节开过来，数字直接开上输出轨道；运算符先拐进侧线等着。"
   },
   {
    "start": 10.1,
    "end": 13.5125,
    "text": "侧线只能从一头进出，它就是一个栈。"
   },
   {
    "start": 13.5125,
    "end": 18.675,
    "text": "运算符什么时候从侧线开出去，由优先级和括号决定。"
   }
  ]
 },
 {
  "id": "rules",
  "wav": "audio/rules-e4742f1e1d6c.wav",
  "seconds": 26.856,
  "cues": [
   {
    "start": 0.1,
    "end": 1.875,
    "text": "规则一共五条。"
   },
   {
    "start": 1.825,
    "end": 4.5,
    "text": "遇到操作数，直接输出。"
   },
   {
    "start": 4.5,
    "end": 7.1125,
    "text": "遇到左括号，入栈。"
   },
   {
    "start": 7.1125,
    "end": 14.0125,
    "text": "遇到右括号，一直弹出并输出，直到碰上左括号，左括号丢掉，不输出。"
   },
   {
    "start": 14.0125,
    "end": 22.875,
    "text": "遇到运算符，只要栈顶不是左括号，而且栈顶的优先级不低于自己，就把栈顶弹出输出，最后把自己压进栈。"
   },
   {
    "start": 22.875,
    "end": 26.7875,
    "text": "扫描结束，把栈里剩下的全部弹出。"
   }
  ]
 },
 {
  "id": "simple",
  "wav": "audio/simple-8e9dd4434f85.wav",
  "seconds": 23.88,
  "cues": [
   {
    "start": 0.1,
    "end": 1.85,
    "text": "先看两个小例子。"
   },
   {
    "start": 1.8,
    "end": 10.475,
    "text": "三加四乘二：乘号来的时候，栈顶是加号，比它低，乘号直接压在上面，结果是三四二乘加。"
   },
   {
    "start": 10.475,
    "end": 19.1,
    "text": "三乘四加二：加号来的时候，栈顶的乘号不低于它，先把乘号弹出去，结果是三四乘二加。"
   },
   {
    "start": 19.1,
    "end": 23.825,
    "text": "所以栈里从下往上，优先级总是越来越高。"
   }
  ]
 },
 {
  "id": "run1",
  "wav": "audio/run1-7de515bb4b2d.wav",
  "seconds": 18.888,
  "cues": [
   {
    "start": 0.1,
    "end": 1.875,
    "text": "回到原书的例子。"
   },
   {
    "start": 1.825,
    "end": 4.825,
    "text": "二十三直接输出，加号入栈。"
   },
   {
    "start": 4.825,
    "end": 9.75,
    "text": "左括号入栈，它像一道墙，把外面的加号挡在下面。"
   },
   {
    "start": 9.75,
    "end": 14.4125,
    "text": "三十四输出，乘号压在左括号上，四十五输出。"
   },
   {
    "start": 14.4125,
    "end": 18.825,
    "text": "右括号来了，把乘号弹出，左括号丢掉。"
   }
  ]
 },
 {
  "id": "run2",
  "wav": "audio/run2-ede88e1846a3.wav",
  "seconds": 24.096,
  "cues": [
   {
    "start": 0.1,
    "end": 4.6875,
    "text": "除号来了，栈顶的加号比它低，除号压上去。"
   },
   {
    "start": 4.6375,
    "end": 9.3625,
    "text": "又一个左括号，五输出，加号入栈，六输出。"
   },
   {
    "start": 9.3625,
    "end": 14.3875,
    "text": "第二个加号来时，栈顶的加号和它同级，先弹出。"
   },
   {
    "start": 14.3875,
    "end": 18.5375,
    "text": "七输出，右括号弹出加号，丢掉左括号。"
   },
   {
    "start": 18.5375,
    "end": 24.0375,
    "text": "扫描结束，依次弹出除号和加号，后缀式就完成了。"
   }
  ]
 },
 {
  "id": "assoc",
  "wav": "audio/assoc-b3a3812233c8.wav",
  "seconds": 22.056,
  "cues": [
   {
    "start": 0.1,
    "end": 3.4625,
    "text": "规则四里不低于这三个字是承重的。"
   },
   {
    "start": 3.4125,
    "end": 5.25,
    "text": "看一减二减三。"
   },
   {
    "start": 5.25,
    "end": 13.0875,
    "text": "按不低于，第二个减号来时先弹出第一个，得到一二减三减，等于负四，这是对的。"
   },
   {
    "start": 13.0875,
    "end": 22.0,
    "text": "如果写成高于，同级不弹，得到一二三减减，算的是一减去二减三的差，等于二，错了。"
   }
  ]
 },
 {
  "id": "eval",
  "wav": "audio/eval-1240c641e3bb.wav",
  "seconds": 27.6,
  "cues": [
   {
    "start": 0.1,
    "end": 6.825,
    "text": "后缀式求值只要两条：遇到数压栈，遇到运算符弹出两个，算完压回。"
   },
   {
    "start": 6.775,
    "end": 13.0875,
    "text": "三十四乘四十五得一千五百三十，五加六得十一，再加七得十八。"
   },
   {
    "start": 13.0875,
    "end": 23.7375,
    "text": "注意除号：先弹出的十八是右操作数，后弹出的一千五百三十才是左操作数，一千五百三十除以十八得八十五。"
   },
   {
    "start": 23.7375,
    "end": 27.55,
    "text": "最后二十三加八十五，得一百零八。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-976b4e379d6b.wav",
  "seconds": 12.672,
  "cues": [
   {
    "start": 0.1,
    "end": 4.275,
    "text": "转换加求值，就是中缀表达式求值的全部。"
   },
   {
    "start": 4.225,
    "end": 12.6125,
    "text": "编译器把算式翻译成机器指令，走的也是这条路：一个栈记住括号和优先级，另一个栈算出结果。"
   }
  ]
 }
]