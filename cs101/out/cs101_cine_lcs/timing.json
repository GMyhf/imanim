[
 {
  "id": "title",
  "wav": "audio/title-00060b650837.wav",
  "seconds": 11.688,
  "cues": [
   {
    "start": 0.1,
    "end": 4.85,
    "text": "给你两个字符串，它们最长的公共子序列有多长？"
   },
   {
    "start": 4.8,
    "end": 8.225,
    "text": "把一个单词改成另一个，最少要改几步？"
   },
   {
    "start": 8.225,
    "end": 11.625,
    "text": "这两个问题，用的是同一张二维表。"
   }
  ]
 },
 {
  "id": "define",
  "wav": "audio/define-c27ed39afd2a.wav",
  "seconds": 16.272,
  "cues": [
   {
    "start": 0.1,
    "end": 3.7625,
    "text": "子序列不要求连续，只要求顺序不变。"
   },
   {
    "start": 3.7125,
    "end": 12.125,
    "text": "状态是 dp i j：第一个串的前 i 个字符，和第二个串的前 j 个字符，最长公共子序列的长度。"
   },
   {
    "start": 12.125,
    "end": 16.2125,
    "text": "边界是第零行和第零列，全是零。"
   }
  ]
 },
 {
  "id": "rule",
  "wav": "audio/rule-46f4ce324499.wav",
  "seconds": 15.72,
  "cues": [
   {
    "start": 0.1,
    "end": 2.925,
    "text": "转移只看两个前缀的末字符。"
   },
   {
    "start": 2.875,
    "end": 5.6875,
    "text": "相同，就从左上角加一。"
   },
   {
    "start": 5.6875,
    "end": 9.1125,
    "text": "不相同，就取上边和左边的较大者。"
   },
   {
    "start": 9.1125,
    "end": 15.6625,
    "text": "左上角是两个串都往前一步，上边是只动第一个串，左边是只动第二个串。"
   }
  ]
 },
 {
  "id": "fill",
  "wav": "audio/fill-30e74a59aa61.wav",
  "seconds": 14.616,
  "cues": [
   {
    "start": 0.1,
    "end": 2.0625,
    "text": "一行一行填下去。"
   },
   {
    "start": 2.0125,
    "end": 7.25,
    "text": "黄色的格子，是末字符相同、从左上角加一的地方。"
   },
   {
    "start": 7.25,
    "end": 11.8375,
    "text": "其余的格子，只是把上边或左边的较大值抄过来。"
   },
   {
    "start": 11.8375,
    "end": 14.5625,
    "text": "右下角就是答案：四。"
   }
  ]
 },
 {
  "id": "back",
  "wav": "audio/back-032e0b9a01fa.wav",
  "seconds": 17.424,
  "cues": [
   {
    "start": 0.1,
    "end": 3.75,
    "text": "从右下角往回走，就能找出这个子序列。"
   },
   {
    "start": 3.7,
    "end": 8.525,
    "text": "末字符相同，就记下这个字符，走向左上角。"
   },
   {
    "start": 8.525,
    "end": 11.4625,
    "text": "不相同，就走向较大的那一边。"
   },
   {
    "start": 11.4625,
    "end": 17.3625,
    "text": "把记下的字符倒着读出来，就是一个长度为四的公共子序列。"
   }
  ]
 },
 {
  "id": "edit",
  "wav": "audio/edit-ce3510044e1d.wav",
  "seconds": 15.912,
  "cues": [
   {
    "start": 0.1,
    "end": 2.5875,
    "text": "换一个问题：编辑距离。"
   },
   {
    "start": 2.5375,
    "end": 8.125,
    "text": "最少几次插入、删除、替换，把 horse 变成 ros？"
   },
   {
    "start": 8.125,
    "end": 15.8625,
    "text": "边界变了：第一列是 i，表示把前 i 个字符删光；第一行是 j，表示全靠插入。"
   }
  ]
 },
 {
  "id": "edfill",
  "wav": "audio/edfill-bb210376f801.wav",
  "seconds": 15.816,
  "cues": [
   {
    "start": 0.1,
    "end": 4.425,
    "text": "末字符相同，直接抄左上角，不用操作。"
   },
   {
    "start": 4.375,
    "end": 9.4125,
    "text": "不相同，就在三种操作里取最便宜的，再加一。"
   },
   {
    "start": 9.4125,
    "end": 13.75,
    "text": "删对应上边，插对应左边，改对应左上角。"
   },
   {
    "start": 13.75,
    "end": 15.7625,
    "text": "右下角是三。"
   }
  ]
 },
 {
  "id": "align",
  "wav": "audio/align-1de11c29224b.wav",
  "seconds": 9.888,
  "cues": [
   {
    "start": 0.1,
    "end": 3.8375,
    "text": "沿着表倒推回去，就是三步具体的操作。"
   },
   {
    "start": 3.7875,
    "end": 5.975,
    "text": "先把 h 改成 r。"
   },
   {
    "start": 5.975,
    "end": 7.775,
    "text": "再删掉一个 r。"
   },
   {
    "start": 7.775,
    "end": 9.8375,
    "text": "最后删掉 e。"
   }
  ]
 },
 {
  "id": "same",
  "wav": "audio/same-3f7760888bca.wav",
  "seconds": 17.28,
  "cues": [
   {
    "start": 0.1,
    "end": 8.0125,
    "text": "两道题是同一个框架：dp i j 定义在两个前缀上，末字符相同和不同，分两种转移。"
   },
   {
    "start": 7.9625,
    "end": 13.3875,
    "text": "掌握了最长公共子序列，编辑距离只是转移式换了个写法。"
   },
   {
    "start": 13.3875,
    "end": 17.225,
