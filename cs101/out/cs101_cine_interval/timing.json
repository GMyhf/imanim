[
 {
  "id": "title",
  "wav": "audio/title-d9f9c3d22628.wav",
  "seconds": 14.76,
  "cues": [
   {
    "start": 0.1,
    "end": 7.8375,
    "text": "会议排期、气球射箭、电视节目表，这些题看起来五花八门，骨子里都是一类：区间问题。"
   },
   {
    "start": 7.7875,
    "end": 11.075,
    "text": "解法几乎都是排好序，再一遍扫过去。"
   },
   {
    "start": 11.075,
    "end": 14.7,
    "text": "全部难点只有一件事：按什么排。"
   }
  ]
 },
 {
  "id": "table",
  "wav": "audio/table-ef5234f9dd68.wav",
  "seconds": 19.68,
  "cues": [
   {
    "start": 0.1,
    "end": 2.7125,
    "text": "经典的区间问题有五类。"
   },
   {
    "start": 2.6625,
    "end": 7.7,
    "text": "合并区间、区间覆盖、区间分组，按左端点排。"
   },
   {
    "start": 7.7,
    "end": 12.4625,
    "text": "选最多的不相交区间、区间选点，按右端点排。"
   },
   {
    "start": 12.4625,
    "end": 19.6125,
    "text": "压成一句话：要多就按右端点排，要合、要盖就按左端点排。"
   }
  ]
 },
 {
  "id": "merge",
  "wav": "audio/merge-fbe36fcb0042.wav",
  "seconds": 23.04,
  "cues": [
   {
    "start": 0.1,
    "end": 2.025,
    "text": "先看合并区间。"
   },
   {
    "start": 1.975,
    "end": 4.95,
    "text": "按左端点排好，一遍扫过去。"
   },
   {
    "start": 4.95,
    "end": 12.7125,
    "text": "当前区间的左端点不超过上一段的右端点，就有交叠，把右端点延长；否则另起一段。"
   },
   {
    "start": 12.7125,
    "end": 15.35,
    "text": "四个区间，合并成三段。"
   },
   {
    "start": 15.35,
    "end": 18.45,
    "text": "注意延长时那个 max 不能省。"
   },
   {
    "start": 18.45,
    "end": 22.9875,
    "text": "一到十、二到三，直接赋值会把十缩成三。"
   }
  ]
 },
 {
  "id": "keep",
  "wav": "audio/keep-ac1b14a4f810.wav",
  "seconds": 18.264,
  "cues": [
   {
    "start": 0.1,
    "end": 6.0625,
    "text": "再看无重叠区间：最少移除几个，等于总数减去最多能保留几个。"
   },
   {
    "start": 6.0125,
    "end": 10.6,
    "text": "按右端点排，记住上一个保留区间在哪里结束。"
   },
   {
    "start": 10.6,
    "end": 14.9875,
    "text": "下一个区间从那之后开始，就保留，否则跳过。"
   },
   {
    "start": 14.9875,
    "end": 18.2125,
    "text": "四个区间保留三个，移除一个。"
   }
  ]
 },
 {
  "id": "why",
  "wav": "audio/why-2b68f58d0daf.wav",
  "seconds": 28.2,
  "cues": [
   {
    "start": 0.1,
    "end": 1.875,
    "text": "为什么按右端点？"
   },
   {
    "start": 1.825,
    "end": 3.5,
    "text": "换别的键试试。"
   },
   {
    "start": 3.5,
    "end": 10.575,
    "text": "按左端点，一到十先被选中，一下子占满了，只能留一个，可明明能留两个。"
   },
   {
    "start": 10.575,
    "end": 16.5125,
    "text": "按长度，最短的四到七卡在中间，两边都放不下，还是只留一个。"
   },
   {
    "start": 16.5125,
    "end": 18.5,
    "text": "按右端点才对。"
   },
   {
    "start": 18.5,
    "end": 28.15,
    "text": "设最优解的第一个区间是 X，右端点最小的是 A，把 X 换成 A，后面能放的只多不少，所以换完不会变差。"
   }
  ]
 },
 {
  "id": "arrows",
  "wav": "audio/arrows-ced4f3cd0339.wav",
  "seconds": 24.528,
  "cues": [
   {
    "start": 0.1,
    "end": 4.375,
    "text": "区间选点：用最少的箭引爆所有气球。"
   },
   {
    "start": 4.325,
    "end": 11.2,
    "text": "还是按右端点排，箭就射在当前气球的右端点；射不到下一个了，再换一支箭。"
   },
   {
    "start": 11.2,
    "end": 13.7375,
    "text": "四个气球，两支箭。"
   },
   {
    "start": 13.7375,
    "end": 16.6,
    "text": "它和上一个算法只差一个字。"
   },
   {
    "start": 16.6,
    "end": 24.4625,
    "text": "这里是大于，端点相接算射得到；上一个是大于等于，端点相接算不重叠。"
   }
  ]
 },
 {
  "id": "groups",
  "wav": "audio/groups-78a91def58bb.wav",
  "seconds": 22.512,
  "cues": [
   {
    "start": 0.1,
    "end": 4.875,
    "text": "最后是区间分组：最少分几组，让组内互不重叠。"
   },
   {
    "start": 4.825,
    "end": 9.6625,
    "text": "按左端点排，用一个小根堆记下各组的结束时间。"
   },
   {
    "start": 9.6625,
    "end": 16.0375,
    "text": "新区间来了，最早结束的那组已经空出来，就接在后面，否则新开一组。"
   },
   {
    "start": 16.0375,
    "end": 18.4125,
    "text": "四个区间，需要三组。"
   },
   {
    "start": 18.4125,
    "end": 22.4625,
    "text": "它正好等于同一时刻最多有几个区间重叠。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-a8c7fbac94a8.wav",
  "seconds": 8.544,
  "cues": [
   {
    "start": 0.1,
    "end": 3.05,
    "text": "按什么排，就是区间题的全部。"
   },
   {
    "start": 3.0,
    "end": 8.475,
    "text": "要多就按右端点，要合、要盖就按左端点。"
   }
  ]
 }
]