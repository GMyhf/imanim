[
 {
  "id": "title",
  "wav": "audio/title-044bc9838bb3.wav",
  "seconds": 15.96,
  "cues": [
   {
    "start": 0.1,
    "end": 4.675,
    "text": "一八八三年，法国数学家卢卡斯发明了一个谜题。"
   },
   {
    "start": 4.625,
    "end": 10.025,
    "text": "传说寺庙里有六十四片金片，由大到小叠在一根针上。"
   },
   {
    "start": 10.025,
    "end": 15.9,
    "text": "僧侣要把它们全部移到另一根针上，移完之时，就是世界末日。"
   }
  ]
 },
 {
  "id": "rules",
  "wav": "audio/rules-af24452160b8.wav",
  "seconds": 12.0,
  "cues": [
   {
    "start": 0.1,
    "end": 6.25,
    "text": "规则只有两条：每次只能移动一片；大的永远不能压在小的上面。"
   },
   {
    "start": 6.2,
    "end": 11.95,
    "text": "任务是把 n 个盘子从 A 柱移到 C 柱，中间可以借助 B 柱。"
   }
  ]
 },
 {
  "id": "idea",
  "wav": "audio/idea-b1f7a157fd94.wav",
  "seconds": 23.688,
  "cues": [
   {
    "start": 0.1,
    "end": 1.925,
    "text": "四个盘子怎么移？"
   },
   {
    "start": 1.875,
    "end": 3.55,
    "text": "先别想细节。"
   },
   {
    "start": 3.55,
    "end": 8.0125,
    "text": "假设你已经会移三个，把上面这三个看成一整块。"
   },
   {
    "start": 8.0125,
    "end": 11.025,
    "text": "第一步，把它们从 A 移到 B。"
   },
   {
    "start": 11.025,
    "end": 14.8875,
    "text": "第二步，把最大的盘子从 A 移到 C。"
   },
   {
    "start": 14.8875,
    "end": 18.65,
    "text": "第三步，再把那三个从 B 移到 C。"
   },
   {
    "start": 18.65,
    "end": 20.3625,
    "text": "至于三个怎么移？"
   },
   {
    "start": 20.3625,
    "end": 23.625,
    "text": "同样的办法，交给更小的问题。"
   }
  ]
 },
 {
  "id": "code",
  "wav": "audio/code-ed9402c6c04b.wav",
  "seconds": 11.592,
  "cues": [
   {
    "start": 0.1,
    "end": 5.4,
    "text": "代码就是这三步，一行一步，再加一个 n 等于零就返回的基例。"
   },
   {
    "start": 5.35,
    "end": 11.525,
    "text": "第一步和第三步，你不需要知道具体怎么移，相信它们已经解决就行。"
   }
  ]
 },
 {
  "id": "run",
  "wav": "audio/run-8fbc1814bc49.wav",
  "seconds": 20.496,
  "cues": [
   {
    "start": 0.1,
    "end": 1.925,
    "text": "跑一遍三个盘子。"
   },
   {
    "start": 1.875,
    "end": 4.275,
    "text": "一号盘，A 到 C。"
   },
   {
    "start": 4.275,
    "end": 6.8,
    "text": "二号盘，A 到 B。"
   },
   {
    "start": 6.8,
    "end": 9.2375,
    "text": "一号盘，C 到 B。"
   },
   {
    "start": 9.2375,
    "end": 11.7375,
    "text": "三号盘，A 到 C。"
   },
   {
    "start": 11.7375,
    "end": 14.0125,
    "text": "一号盘，B 到 A。"
   },
   {
    "start": 14.0125,
    "end": 16.275,
    "text": "二号盘，B 到 C。"
   },
   {
    "start": 16.275,
    "end": 18.675,
    "text": "一号盘，A 到 C。"
   },
   {
    "start": 18.675,
    "end": 20.4375,
    "text": "一共七步。"
   }
  ]
 },
 {
  "id": "tree",
  "wav": "audio/tree-8be2c5459fa1.wav",
  "seconds": 15.696,
  "cues": [
   {
    "start": 0.1,
    "end": 1.9375,
    "text": "把调用画成一棵树。"
   },
   {
    "start": 1.8875,
    "end": 8.725,
    "text": "每次调用有两个孩子，就是三步里的第一步和第三步，所以它是一棵满二叉树。"
   },
   {
    "start": 8.725,
    "end": 15.625,
    "text": "每个节点恰好做一次移动，移动次数就等于节点数：一加二加四，等于七。"
   }
  ]
 },
 {
  "id": "inorder",
  "wav": "audio/inorder-f08acfdc775f.wav",
  "seconds": 17.232,
  "cues": [
   {
    "start": 0.1,
    "end": 6.9875,
    "text": "再看顺序：每个节点都是先处理左子树，再做自己那一次移动，最后处理右子树。"
   },
   {
    "start": 6.9375,
    "end": 12.5625,
    "text": "把整棵树往下压平，从左到右读一遍，正好就是刚才那七步。"
   },
   {
    "start": 12.5625,
    "end": 17.175,
    "text": "这种左、根、右的顺序，叫中序遍历。"
   }
  ]
 },
 {
  "id": "count",
  "wav": "audio/count-491f01b6e30f.wav",
  "seconds": 18.984,
  "cues": [
   {
    "start": 0.1,
    "end": 5.4625,
    "text": "移动次数的递推是：T n 等于二倍的 T n 减一，再加一。"
   },
   {
    "start": 5.4125,
    "end": 8.0125,
    "text": "解出来是二的 n 次方减一。"
   },
   {
    "start": 8.0125,
    "end": 18.9125,
    "text": "一到七个盘子，分别是一、三、七、十五、三十一、六十三、一百二十七：盘子每多一个，步数就翻一倍。"
   }
  ]
 },
 {
  "id": "legend",
  "wav": "audio/legend-16873e14760f.wav",
  "seconds": 15.288,
  "cues": [
   {
    "start": 0.1,
    "end": 7.9,
    "text": "回到传说中的六十四片金片：需要二的六十四次方减一次移动，大约一点八乘十的十九次方。"
   },
   {
    "start": 7.85,
    "end": 11.7125,
    "text": "每秒移动一次，要大约五千八百五十亿年。"
   },
   {
    "start": 11.7125,
    "end": 15.2375,
    "text": "而地球的年龄，大约是四十五亿年。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-c56174f619af.wav",
  "seconds": 15.336,
  "cues": [
   {
    "start": 0.1,
    "end": 10.4,
    "text": "回头看，程序里没有任何数据结构记录每根柱子上有哪些盘子，是调用栈替你记住了每一层要把几个盘子从哪里移到哪里。"
   },
   {
    "start": 10.35,
    "end": 15.275,
    "text": "解汉诺塔，只需要相信：更小的问题已经解决。"
   }
  ]
 }
]