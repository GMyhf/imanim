[
 {
  "id": "title",
  "wav": "audio/title-e3dbdfce5735.wav",
  "seconds": 16.44,
  "cues": [
   {
    "start": 0.1,
    "end": 5.5875,
    "text": "第六周见过一个反例：面额一、三、四，凑出六。"
   },
   {
    "start": 5.5375,
    "end": 9.9,
    "text": "贪心每次拿最大的，给出三枚：四加一加一。"
   },
   {
    "start": 9.9,
    "end": 12.625,
    "text": "最优却是两枚：三加三。"
   },
   {
    "start": 12.625,
    "end": 16.375,
    "text": "贪心失效的地方，动态规划接管。"
   }
  ]
 },
 {
  "id": "premise",
  "wav": "audio/premise-d95f38b08aa3.wav",
  "seconds": 22.632,
  "cues": [
   {
    "start": 0.1,
    "end": 2.65,
    "text": "动态规划有两个前提。"
   },
   {
    "start": 2.6,
    "end": 8.6875,
    "text": "第一，最优子结构：大问题的最优解，由子问题的最优解构成。"
   },
   {
    "start": 8.6875,
    "end": 13.3625,
    "text": "它不成立，转移方程照样写得出来，但答案是错的。"
   },
   {
    "start": 13.3625,
    "end": 18.25,
    "text": "第二，重叠子问题：同一个子问题被反复求解。"
   },
   {
    "start": 18.25,
    "end": 22.575,
    "text": "它不成立不会算错，只是不如直接分治。"
   }
  ]
 },
 {
  "id": "paths",
  "wav": "audio/paths-2441a177524c.wav",
  "seconds": 19.488,
  "cues": [
   {
    "start": 0.1,
    "end": 6.85,
    "text": "数字三角形，从顶走到底，每步只能走左下或者右下，一共八条路径。"
   },
   {
    "start": 6.8,
    "end": 12.025,
    "text": "现在加一条限制：路径和必须是奇数，求最大的那个。"
   },
   {
    "start": 12.025,
    "end": 19.4375,
    "text": "八条路径里，只有一条的和是奇数：六、七、零、四，和为十七。"
   }
  ]
 },
 {
  "id": "naive",
  "wav": "audio/naive-a278193f1e73.wav",
  "seconds": 20.352,
  "cues": [
   {
    "start": 0.1,
    "end": 7.425,
    "text": "最自然的状态是：dp i j 表示走到这个格子的最大路径和，最后在底行里挑一个奇数。"
   },
   {
    "start": 7.375,
    "end": 9.1625,
    "text": "逐行填下来。"
   },
   {
    "start": 9.1625,
    "end": 14.25,
    "text": "底行是二十、二十二、二十四、二十二，全是偶数。"
   },
   {
    "start": 14.25,
    "end": 17.075,
    "text": "程序返回负一，说无解。"
   },
   {
    "start": 17.075,
    "end": 20.3,
    "text": "可我们刚刚数过，答案是十七。"
   }
  ]
 },
 {
  "id": "where",
  "wav": "audio/where-9764df8789e4.wav",
  "seconds": 16.968,
  "cues": [
   {
    "start": 0.1,
    "end": 2.85,
    "text": "错在哪一步，可以精确指出来。"
   },
   {
    "start": 2.8,
    "end": 9.275,
    "text": "走到第四行这个四的时候，上一行的两个候选，十三是奇数，十八是偶数。"
   },
   {
    "start": 9.275,
    "end": 13.5875,
    "text": "朴素状态只留下最大的十八，把十三扔掉了。"
   },
   {
    "start": 13.5875,
    "end": 16.9125,
    "text": "而答案十七，恰好是十三加四。"
   }
  ]
 },
 {
  "id": "property",
  "wav": "audio/property-9f15280bbddc.wav",
  "seconds": 20.712,
  "cues": [
   {
    "start": 0.1,
    "end": 4.425,
    "text": "最优子结构是状态定义的性质，不是题目的性质。"
   },
   {
    "start": 4.375,
    "end": 10.325,
    "text": "子问题的最优解十八，在父问题里不但没用，还挤掉了真正有用的十三。"
   },
   {
    "start": 10.325,
    "end": 16.925,
    "text": "检验的办法是问一句：把子问题的最优解换成次优解，父问题会不会反而更好？"
   },
   {
    "start": 16.925,
    "end": 20.6625,
    "text": "会，就说明状态少了一维。"
   }
  ]
 },
 {
  "id": "fixed",
  "wav": "audio/fixed-e258316af561.wav",
  "seconds": 20.88,
  "cues": [
   {
    "start": 0.1,
    "end": 7.2375,
    "text": "补一维：dp i j p，表示走到这个格子、路径和奇偶为 p 时的最大和。"
   },
   {
    "start": 7.1875,
    "end": 11.0375,
    "text": "每个格子存两个值，一个偶、一个奇。"
   },
   {
    "start": 11.0375,
    "end": 12.825,
    "text": "逐行填下来。"
   },
   {
    "start": 12.825,
    "end": 16.675,
    "text": "第四行这个四，奇数那一栏正好是十七。"
   },
   {
    "start": 16.675,
    "end": 20.8125,
    "text": "底行取奇数那一栏的最大值，答案十七。"
   }
  ]
 },
 {
  "id": "duel",
  "wav": "audio/duel-c99586867503.wav",
  "seconds": 17.256,
  "cues": [
   {
    "start": 0.1,
    "end": 2.1875,
    "text": "怎么确认补一维真的对？"
   },
   {
    "start": 2.1375,
    "end": 4.0875,
    "text": "写一个暴力来对拍。"
   },
   {
    "start": 4.0875,
    "end": 8.9875,
    "text": "暴力枚举十七，朴素动态规划负一，补一维十七。"
   },
   {
    "start": 8.9875,
    "end": 17.1875,
    "text": "再随机生成两千个三角形：补一维的版本和暴力全部一致，朴素版本答错了二百九十八组。"
   }
  ]
 },
 {
  "id": "three",
  "wav": "audio/three-898aec0fcbde.wav",
  "seconds": 16.056,
  "cues": [
   {
    "start": 0.1,
    "end": 4.0125,
    "text": "写任何动态规划，先在纸上写清三行。"
   },
   {
    "start": 3.9625,
    "end": 7.9875,
    "text": "状态：dp 表示什么，要能一句话说清。"
   },
   {
    "start": 7.9875,
    "end": 11.375,
    "text": "转移：它怎么由更小的状态算出来。"
   },
   {
    "start": 11.375,
    "end": 16.0,
    "text": "边界：最小的状态是多少，答案在哪个状态里。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-c08fb3167983.wav",
  "seconds": 13.848,
  "cues": [
   {
    "start": 0.1,
    "end": 6.7875,
    "text": "以后觉得一道题好像没有最优子结构，先问一句：我的状态是不是少了一维？"
   },
   {
    "start": 6.7375,
    "end": 13.7875,
    "text": "常见的那一维有：剩余容量、已用次数、上一步选了什么、当前是第几段。"
   }
  ]
 }
]