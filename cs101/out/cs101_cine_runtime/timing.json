[
 {
  "id": "title",
  "wav": "audio/title-b97b00d81539.wav",
  "seconds": 19.512,
  "cues": [
   {
    "start": 0.1,
    "end": 2.0875,
    "text": "把三百万个数加起来。"
   },
   {
    "start": 2.0375,
    "end": 8.9375,
    "text": "写一个 for 循环，讲义里的典型结果是零点二秒；换成内建的 sum，只要零点零三秒。"
   },
   {
    "start": 8.9375,
    "end": 11.4875,
    "text": "同一件事，差了好几倍。"
   },
   {
    "start": 11.4875,
    "end": 13.625,
    "text": "程序到底是怎么跑起来的？"
   },
   {
    "start": 13.625,
    "end": 19.4625,
    "text": "今天从字节码、存储层次、缓存和缓冲四处找答案。"
   }
  ]
 },
 {
  "id": "compile",
  "wav": "audio/compile-b7deaac92528.wav",
  "seconds": 27.312,
  "cues": [
   {
    "start": 0.1,
    "end": 6.8375,
    "text": "C 和 C++ 是编译型：源码事先整个翻译成机器码，CPU 直接执行。"
   },
   {
    "start": 6.7875,
    "end": 15.375,
    "text": "Python 是解释型：源码先编译成字节码，再由虚拟机一条一条地解释，每一条都要转去调用对应的 C 函数。"
   },
   {
    "start": 15.375,
    "end": 19.6375,
    "text": "所以同样的算法，Python 常常慢十到一百倍。"
   },
   {
    "start": 19.6375,
    "end": 27.25,
    "text": "C++ 能过的平方级做法，Python 可能超时；对策不是抠常数，而是换更好的算法。"
   }
  ]
 },
 {
  "id": "bytecode",
  "wav": "audio/bytecode-c868f930b54b.wav",
  "seconds": 28.512,
  "cues": [
   {
    "start": 0.1,
    "end": 2.7375,
    "text": "用 dis 模块看那个循环。"
   },
   {
    "start": 2.6875,
    "end": 12.3125,
    "text": "每转一圈，要执行七条字节码：取下一个数，存进 i，读出 s 和 i，相加，存回 s，跳回开头。"
   },
   {
    "start": 12.3125,
    "end": 17.8,
    "text": "三百万圈，就是两千一百万条，每一条都是解释器里的一次分派。"
   },
   {
    "start": 17.8,
    "end": 19.4875,
    "text": "sum 那一行呢？"
   },
   {
    "start": 19.4875,
    "end": 23.8125,
    "text": "不管 n 多大，只执行十来条，循环在 C 里面完成。"
   },
   {
    "start": 23.8125,
    "end": 28.45,
    "text": "所以能交给内建函数的，就别自己写循环。"
   }
  ]
 },
 {
  "id": "ladder",
  "wav": "audio/ladder-58b8b5b9e638.wav",
  "seconds": 25.992,
  "cues": [
   {
    "start": 0.1,
    "end": 2.125,
    "text": "再看数据放在哪里。"
   },
   {
    "start": 2.075,
    "end": 20.925,
    "text": "把一纳秒放大成一秒：读一级缓存，一秒；二级缓存，四秒；内存，一百秒，将近两分钟，比一级缓存慢一百倍；固态硬盘随机读，一天多；同城网络往返一次，十一天多；机械硬盘寻道，将近四个月。"
   },
   {
    "start": 20.925,
    "end": 25.925,
    "text": "所以少读一次磁盘，比少算一万次加法重要得多。"
   }
  ]
 },
 {
  "id": "cache",
  "wav": "audio/cache-337a779f02b1.wav",
  "seconds": 31.968,
  "cues": [
   {
    "start": 0.1,
    "end": 5.8625,
    "text": "内存到缓存，不是一个数一个数地搬，而是一次搬一整个缓存行。"
   },
   {
    "start": 5.8125,
    "end": 14.625,
    "text": "真实的缓存行是六十四字节；这里示意一下：一个缓存行装四个数，缓存一共只放得下四个缓存行。"
   },
   {
    "start": 14.625,
    "end": 20.5875,
    "text": "按行遍历，第一次缺失，相邻四个数一起搬进来，后面三次都命中。"
   },
   {
    "start": 20.5875,
    "end": 24.0,
    "text": "六十四次访问，只缺失十六次。"
   },
   {
    "start": 24.0,
    "end": 31.9,
    "text": "按列遍历，每次跳过一整行，搬进来的邻居还没用上就被挤掉，六十四次全部缺失。"
   }
  ]
 },
 {
  "id": "python",
  "wav": "audio/python-b933ab6954c7.wav",
  "seconds": 25.68,
  "cues": [
   {
    "start": 0.1,
    "end": 4.1875,
    "text": "这就是空间局部性：顺序访问连续的内存。"
   },
   {
    "start": 4.1375,
    "end": 10.2125,
    "text": "讲义里一千二百乘一千二百的实测，典型结果是按行明显更快。"
   },
   {
    "start": 10.2125,
    "end": 20.8125,
    "text": "Python 的列表存的是指针，元素散在堆上，差距没有 C 那么大；但把取出一整行提到内层循环外面，内层每圈就少两条字节码。"
   },
   {
    "start": 20.8125,
    "end": 25.6125,
    "text": "在 Python 里，省下的字节码往往比缓存更要紧。"
   }
  ]
 },
 {
  "id": "buffer",
  "wav": "audio/buffer-69cf3eb25796.wav",
  "seconds": 27.528,
  "cues": [
   {
    "start": 0.1,
    "end": 1.5875,
    "text": "最后是输出。"
   },
   {
    "start": 1.5375,
    "end": 9.2125,
    "text": "一万次 print，输出到终端时按行刷新，每一行都是一次系统调用，要进出内核一万次。"
   },
   {
    "start": 9.2125,
    "end": 14.225,
    "text": "先把字符串攒进列表，用换行 join 成一个，只写一次。"
   },
   {
    "start": 14.225,
