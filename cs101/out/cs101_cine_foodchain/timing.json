[
 {
  "id": "title",
  "wav": "audio/title-fa1388e8371c.wav",
  "seconds": 18.96,
  "cues": [
   {
    "start": 0.1,
    "end": 5.7375,
    "text": "三类动物围成一个环：A 吃 B，B 吃 C，C 吃 A。"
   },
   {
    "start": 5.6875,
    "end": 10.475,
    "text": "有人一句一句地告诉你：谁和谁是同类，谁吃谁。"
   },
   {
    "start": 10.475,
    "end": 16.7375,
    "text": "和前面的真话矛盾的、编号超出范围的、说自己吃自己的，都是假话。"
   },
   {
    "start": 16.7375,
    "end": 18.9,
    "text": "一共有几句假话？"
   }
  ]
 },
 {
  "id": "why",
  "wav": "audio/why-bfaa39c90b41.wav",
  "seconds": 16.248,
  "cues": [
   {
    "start": 0.1,
    "end": 4.8,
    "text": "并查集擅长记同类：在同一个集合，就是同一伙。"
   },
   {
    "start": 4.75,
    "end": 9.05,
    "text": "可是「x 吃 y」不是同一伙，没法直接合并。"
   },
   {
    "start": 9.05,
    "end": 16.2,
    "text": "好在一共只有三类，知道了 x 是哪一类，它吃哪一类、被哪一类吃，也就跟着定了。"
   }
  ]
 },
 {
  "id": "domains",
  "wav": "audio/domains-0a5ab3212db4.wav",
  "seconds": 22.968,
  "cues": [
   {
    "start": 0.1,
    "end": 3.2,
    "text": "于是把每个动物拆成三个结点。"
   },
   {
    "start": 3.15,
    "end": 6.625,
    "text": "x 是同类域，代表 x 自己那一类。"
   },
   {
    "start": 6.625,
    "end": 10.6875,
    "text": "x 加 n 是猎物域，代表 x 吃的那一类。"
   },
   {
    "start": 10.6875,
    "end": 14.75,
    "text": "x 加二 n 是天敌域，代表吃 x 的那一类。"
   },
   {
    "start": 14.75,
    "end": 19.7875,
    "text": "两个结点在同一个集合里，意思是：它们说的是同一类动物。"
   },
   {
    "start": 19.7875,
    "end": 22.9,
    "text": "n 个动物，一共三 n 个结点。"
   }
  ]
 },
 {
  "id": "same",
  "wav": "audio/same-279ac5cb4f64.wav",
  "seconds": 15.696,
  "cues": [
   {
    "start": 0.1,
    "end": 2.4,
    "text": "先看「x 和 y 同类」。"
   },
   {
    "start": 2.35,
    "end": 8.95,
    "text": "自己相同，猎物相同，天敌也相同，三个域一一对应，合并三对。"
   },
   {
    "start": 8.95,
    "end": 10.7875,
    "text": "什么时候是假话？"
   },
   {
    "start": 10.7875,
    "end": 15.625,
    "text": "x 已经落在 y 的猎物域里，或者已经落在 y 的天敌域里。"
   }
  ]
 },
 {
  "id": "eat",
  "wav": "audio/eat-29e97652775f.wav",
  "seconds": 20.688,
  "cues": [
   {
    "start": 0.1,
    "end": 2.825,
    "text": "再看「x 吃 y」，也要连三对。"
   },
   {
    "start": 2.775,
    "end": 7.0375,
    "text": "y 是 x 的猎物：合并 x 的猎物域和 y。"
   },
   {
    "start": 7.0375,
    "end": 11.35,
    "text": "x 是 y 的天敌：合并 x 和 y 的天敌域。"
   },
   {
    "start": 11.35,
    "end": 15.675,
    "text": "第三对最容易漏：x 的天敌，就是 y 的猎物。"
   },
   {
    "start": 15.675,
    "end": 20.625,
    "text": "三类成环，y 吃的那一类，正好反过来吃 x。"
   }
  ]
 },
 {
  "id": "check",
  "wav": "audio/check-cc8061e2b14b.wav",
  "seconds": 18.504,
  "cues": [
   {
    "start": 0.1,
    "end": 2.0875,
    "text": "判假话也查两对。"
   },
   {
    "start": 2.0375,
    "end": 10.175,
    "text": "x 和 y 已经是同类，就不能再吃；x 已经落在 y 的猎物域，说明 y 吃 x，也不能反过来。"
   },
   {
    "start": 10.175,
    "end": 13.55,
    "text": "判断只查不改，只有真话才去合并。"
   },
   {
    "start": 13.55,
    "end": 18.45,
    "text": "再加上越界和自己吃自己，这就是讲义里的全部代码。"
   }
  ]
 },
 {
  "id": "run1",
  "wav": "audio/run1-dc42f72c5f7e.wav",
  "seconds": 27.768,
  "cues": [
   {
    "start": 0.1,
    "end": 4.8,
    "text": "拿讲义的样例走一遍，n 是一百，一共七句话。"
   },
   {
    "start": 4.75,
    "end": 8.475,
    "text": "第一句，一百零一超出范围，假话。"
   },
   {
    "start": 8.475,
    "end": 11.5375,
    "text": "第二句，一吃二，连三对。"
   },
   {
    "start": 11.5375,
    "end": 14.9375,
    "text": "第三句，二吃三，再连三对。"
   },
   {
    "start": 14.9375,
    "end": 24.5,
    "text": "现在九个结点只剩三个集合，每个集合正好是一类：一号、二号的天敌、三号的猎物，在同一个集合里。"
   },
   {
    "start": 24.5,
    "end": 27.7,
    "text": "另外两种颜色，也各是一类。"
   }
  ]
 },
 {
  "id": "run2",
  "wav": "audio/run2-88b43308f956.wav",
  "seconds": 25.488,
  "cues": [
   {
    "start": 0.1,
    "end": 4.35,
    "text": "第四句，三吃三，自己吃自己，假话。"
   },
   {
    "start": 4.3,
    "end": 6.8125,
    "text": "第五句，一和三同类？"
   },
   {
    "start": 6.8125,
    "end": 12.075,
    "text": "一号已经和三号的猎物域连在一起，说明三吃一，假话。"
   },
   {
    "start": 12.075,
    "end": 19.9375,
    "text": "第六句，三吃一，两对都不连通，是真话；要连的三对，其实早就在同一个集合里了。"
   },
   {
    "start": 19.9375,
    "end": 23.3,
    "text": "第七句，五和五同类，真话。"
   },
   {
    "start": 23.3,
    "end": 25.425,
    "text": "一共三句假话。"
   }
  ]
 },
 {
  "id": "missing",
  "wav": "audio/missing-c64173beb5ca.wav",
  "seconds": 22.68,
  "cues": [
   {
    "start": 0.1,
    "end": 2.5,
    "text": "第三对真的不能省吗？"
   },
   {
    "start": 2.45,
    "end": 4.3875,
    "text": "删掉它再跑一遍。"
   },
   {
    "start": 4.3875,
    "end": 12.15,
    "text": "到第五句，三号的猎物域还是孤零零一个点，一和三同类查不出矛盾，被当成了真话。"
   },
   {
    "start": 12.15,
    "end": 16.0125,
    "text": "接下来第六句三吃一，反倒判成假话。"
   },
   {
    "start": 16.0125,
    "end": 19.1125,
    "text": "总数碰巧还是三，可抓错了句子。"
   },
   {
    "start": 19.1125,
    "end": 22.625,
    "text": "环上的那一圈，就靠第三对接上。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-822a12366faa.wav",
  "seconds": 10.608,
  "cues": [
   {
    "start": 0.1,
    "end": 5.1875,
    "text": "一个动物，三个结点：自己、猎物、天敌。"
   },
   {
