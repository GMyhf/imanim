[
 {
  "id": "title",
  "wav": "audio/title-6ab991761985.wav",
  "seconds": 13.92,
  "cues": [
   {
    "start": 0.1,
    "end": 10.65,
    "text": "爬楼梯和数字三角形，一个数方法，一个找最大和，写法却是同一个套路：先写递归，再加记忆化，最后倒过来填表。"
   },
   {
    "start": 10.6,
    "end": 13.8625,
    "text": "这支片子把这三步走两遍。"
   }
  ]
 },
 {
  "id": "stairs",
  "wav": "audio/stairs-d55eb41d0848.wav",
  "seconds": 21.096,
  "cues": [
   {
    "start": 0.1,
    "end": 5.0375,
    "text": "楼梯有七级，每次爬一级或两级，有几种爬法？"
   },
   {
    "start": 4.9875,
    "end": 10.6125,
    "text": "只看最后一步：要么从下面一级迈上来，要么从下面两级跨上来。"
   },
   {
    "start": 10.6125,
    "end": 15.075,
    "text": "所以爬到第 i 级的方法数，等于前两级相加。"
   },
   {
    "start": 15.075,
    "end": 21.0375,
    "text": "地面算一种，第一级也是一种，一路加上去，第七级是二十一种。"
   }
  ]
 },
 {
  "id": "rec",
  "wav": "audio/rec-33f9367a912a.wav",
  "seconds": 16.872,
  "cues": [
   {
    "start": 0.1,
    "end": 3.6625,
    "text": "第一步，照着式子直接写递归。"
   },
   {
    "start": 3.6125,
    "end": 8.0125,
    "text": "n 小于等于一就返回一，否则返回前两级之和。"
   },
   {
    "start": 8.0125,
    "end": 11.1375,
    "text": "它是对的，可一共调用了四十一次。"
   },
   {
    "start": 11.1375,
    "end": 16.8125,
    "text": "第一级被问了十三次，地面被问了八次，同一级楼梯被反复地问。"
   }
  ]
 },
 {
  "id": "memo",
  "wav": "audio/memo-0579b564341a.wav",
  "seconds": 13.728,
  "cues": [
   {
    "start": 0.1,
    "end": 2.0125,
    "text": "第二步，记忆化。"
   },
   {
    "start": 1.9625,
    "end": 6.175,
    "text": "加一个字典，算完就存进去，下次先查表。"
   },
   {
    "start": 6.175,
    "end": 13.675,
    "text": "调用从四十一次降到十三次，每一级只真正算一次，其余都是查表，立刻返回。"
   }
  ]
 },
 {
  "id": "table",
  "wav": "audio/table-03db8651bc06.wav",
  "seconds": 18.24,
  "cues": [
   {
    "start": 0.1,
    "end": 2.575,
    "text": "第三步，把方向倒过来。"
   },
   {
    "start": 2.525,
    "end": 12.5625,
    "text": "递归从第七级往下问，问到地面才开始返回；填表从地面往上算，算到每一级时，它要的前两级早就填好了。"
   },
   {
    "start": 12.5625,
    "end": 18.1875,
    "text": "一个循环，七次加法，没有递归，也就不怕栈太深。"
   }
  ]
 },
 {
  "id": "tri",
  "wav": "audio/tri-e97b91f2e349.wav",
  "seconds": 16.08,
  "cues": [
   {
    "start": 0.1,
    "end": 2.125,
    "text": "再看数字三角形。"
   },
   {
    "start": 2.075,
    "end": 8.425,
    "text": "从顶上的七出发，每步走到左下或右下，五行一共十六条路径。"
   },
   {
    "start": 8.425,
    "end": 16.025,
    "text": "路径和最大是三十，只有一条路径拿得到：七、三、八、七、五。"
   }
  ]
 },
 {
  "id": "trimemo",
  "wav": "audio/trimemo-198b2f1488f0.wav",
  "seconds": 22.968,
  "cues": [
   {
    "start": 0.1,
    "end": 1.5,
    "text": "还是三步。"
   },
   {
    "start": 1.45,
    "end": 8.15,
    "text": "从一个格子往下能拿到的最大和，等于它自己，加上下面两格里较大的那个。"
   },
   {
    "start": 8.15,
    "end": 12.65,
    "text": "直接递归，调用三十一次，每条路径走一遍。"
   },
   {
    "start": 12.65,
    "end": 16.0,
    "text": "加上记忆化，十五个格子各算一次。"
   },
   {
    "start": 16.0,
    "end": 22.9125,
    "text": "看它填表的顺序：先沿左边扎到底，再一格一格往回收，顶上最后填。"
   }
  ]
 },
 {
  "id": "triup",
  "wav": "audio/triup-36188f44769a.wav",
  "seconds": 20.088,
  "cues": [
   {
    "start": 0.1,
    "end": 5.775,
    "text": "同一张表，换一种填法：从底行开始，一行一行往上推。"
   },
   {
    "start": 5.725,
    "end": 11.725,
    "text": "底行就是它自己，往上每一格，取下面两格较大的，加上自己。"
   },
   {
    "start": 11.725,
    "end": 16.2625,
    "text": "十五个数和记忆化填的完全一样，顶上是三十。"
   },
   {
    "start": 16.2625,
    "end": 20.025,
    "text": "沿着较大的一边往下走，就找回了路径。"
   }
  ]
 },
 {
  "id": "forward",
  "wav": "audio/forward-9b9a5157dd07.wav",
  "seconds": 25.296,
  "cues": [
   {
    "start": 0.1,
    "end": 4.425,
    "text": "也可以从上往下推，记从顶走到这一格的最大和。"
   },
   {
    "start": 4.375,
    "end": 11.8125,
    "text": "可这样，每行两端的格子只有一个来源，要单独处理，答案还得在底行再挑最大。"
   },
   {
    "start": 11.8125,
    "end": 21.05,
    "text": "两种定义都得到三十，可从终点倒推时，每格下面都有两格可选，没有特例，答案就在顶上一格。"
   },
   {
    "start": 21.05,
    "end": 25.2375,
    "text": "所以遇到路径题，先试从终点倒推。"
   }
  ]
 },
 {
  "id": "roll",
  "wav": "audio/roll-67ef446f2118.wav",
  "seconds": 22.848,
  "cues": [
   {
    "start": 0.1,
    "end": 2.7125,
    "text": "这张表还能压成一行。"
   },
   {
    "start": 2.6625,
    "end": 12.175,
    "text": "先把底行抄进数组，往上每一行从左到右，每格改成三角形里的数，加上数组里本位和右边一位中较大的。"
   },
   {
    "start": 12.175,
    "end": 17.65,
    "text": "从左往右改不会出错：要读的右边那一位，本轮还没被改过。"
   },
   {
    "start": 17.65,
    "end": 22.7875,
    "text": "每推一行，数组用到的就少一格，最后剩下三十。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-0a0a57b4e6cf.wav",
  "seconds": 16.032,
  "cues": [
   {
    "start": 0.1,
    "end": 8.6375,
    "text": "两道题走的是同一条路：递归想清转移，记忆化去掉重复，倒过来填表，需要的话再滚成一行。"
   },
   {
    "start": 8.5875,
    "end": 13.7,
    "text": "下一支，给三角形加一条限制：路径和必须是奇数。"
   },
   {
    "start": 13.7,
    "end": 15.975,
    "text": "这张表还够用吗？"
   }
  ]
 }
]