[
 {
  "id": "title",
  "wav": "audio/title-7aff0f14f18e.wav",
  "seconds": 15.24,
  "cues": [
   {
    "start": 0.1,
    "end": 5.5625,
    "text": "八个皇后，放在八乘八的棋盘上，任意两个都不能互相攻击。"
   },
   {
    "start": 5.5125,
    "end": 8.0,
    "text": "这样的摆法有多少种？"
   },
   {
    "start": 8.0,
    "end": 11.45,
    "text": "靠蛮力一格格试，要走上千万步。"
   },
   {
    "start": 11.45,
    "end": 15.1875,
    "text": "靠回溯加剪枝，只需要两千来步。"
   }
  ]
 },
 {
  "id": "rules",
  "wav": "audio/rules-280420fa5d13.wav",
  "seconds": 19.8,
  "cues": [
   {
    "start": 0.1,
    "end": 4.0125,
    "text": "皇后能横着、竖着、斜着走任意格。"
   },
   {
    "start": 3.9625,
    "end": 10.15,
    "text": "所以任意两个皇后，不能同行、同列，也不能在同一条对角线上。"
   },
   {
    "start": 10.15,
    "end": 14.425,
    "text": "第一个设计决定，是一行放一个，逐行往下放。"
   },
   {
    "start": 14.425,
    "end": 19.75,
    "text": "这样不同行自动满足，只需要检查列和两条对角线。"
   }
  ]
 },
 {
  "id": "sets",
  "wav": "audio/sets-8bf2714394fc.wav",
  "seconds": 21.384,
  "cues": [
   {
    "start": 0.1,
    "end": 6.2,
    "text": "用三个集合，分别记录已占用的列、主对角线和副对角线。"
   },
   {
    "start": 6.15,
    "end": 12.3,
    "text": "放一个皇后之前，做三次判断，有冲突就跳过，这是可行性剪枝。"
   },
   {
    "start": 12.3,
    "end": 15.3125,
    "text": "放下去，三个集合各加一个。"
   },
   {
    "start": 15.3125,
    "end": 18.325,
    "text": "递归回来，三个集合各删一个。"
   },
   {
    "start": 18.325,
    "end": 21.325,
    "text": "前后对称，一个都不能漏。"
   }
  ]
 },
 {
  "id": "diag",
  "wav": "audio/diag-7b41fbd7d463.wav",
  "seconds": 21.048,
  "cues": [
   {
    "start": 0.1,
    "end": 1.9,
    "text": "对角线怎么表示？"
   },
   {
    "start": 1.85,
    "end": 4.7375,
    "text": "给每个格子标上行号减列号。"
   },
   {
    "start": 4.7375,
    "end": 9.275,
    "text": "同一条从左上到右下的斜线上，这个数是常数。"
   },
   {
    "start": 9.275,
    "end": 11.5625,
    "text": "再标上行号加列号。"
   },
   {
    "start": 11.5625,
    "end": 15.9125,
    "text": "同一条从右上到左下的斜线上，它也是常数。"
   },
   {
    "start": 15.9125,
    "end": 21.0,
    "text": "把这两个数丢进集合，就完成了对角线的冲突检测。"
   }
  ]
 },
 {
  "id": "walk",
  "wav": "audio/walk-f1aea785e74a.wav",
  "seconds": 27.936,
  "cues": [
   {
    "start": 0.1,
    "end": 3.3875,
    "text": "先在四乘四的棋盘上完整走一遍。"
   },
   {
    "start": 3.3375,
    "end": 5.2875,
    "text": "第一行放在第一列。"
   },
   {
    "start": 5.2875,
    "end": 9.4875,
    "text": "第二行试过去，前两格冲突，放在第三列。"
   },
   {
    "start": 9.4875,
    "end": 14.0625,
    "text": "第三行无处可放，只好撤销，回到上一行换一格。"
   },
   {
    "start": 14.0625,
    "end": 20.6625,
    "text": "每次撤销，三个集合各删掉一个，path 也弹出一格，棋盘回到上一步的样子。"
   },
   {
    "start": 20.6625,
    "end": 27.8875,
    "text": "后面快进播放：放下、冲突、撤销，一共放下十六次，找到两个解。"
   }
  ]
 },
 {
  "id": "tree",
  "wav": "audio/tree-9b0c725b3898.wav",
  "seconds": 16.776,
  "cues": [
   {
    "start": 0.1,
    "end": 3.9375,
    "text": "把这次搜索画成树，就是第八周的决策树。"
   },
   {
    "start": 3.8875,
    "end": 7.7125,
    "text": "每个节点是一次递归调用，一共十七个。"
   },
   {
    "start": 7.7125,
    "end": 12.9875,
    "text": "每个红叉是一次冲突，那一整棵子树被剪掉，根本不会生长。"
   },
   {
    "start": 12.9875,
    "end": 16.7125,
    "text": "只有两条路走到了底，就是两个解。"
   }
  ]
 },
 {
  "id": "count",
  "wav": "audio/count-e85ab870382c.wav",
  "seconds": 16.512,
  "cues": [
   {
    "start": 0.1,
    "end": 3.4375,
    "text": "换成八皇后，剪枝的威力更明显。"
   },
   {
    "start": 3.3875,
    "end": 8.925,
    "text": "如果每行随便放、走到底才检查，要走一千九百多万个节点。"
   },
   {
    "start": 8.925,
    "end": 12.1375,
    "text": "只保证不同列，也还要十万多个。"
   },
   {
    "start": 12.1375,
    "end": 16.45,
    "text": "用三个集合剪枝之后，只需要两千零五十七个。"
   }
  ]
 },
 {
  "id": "all",
  "wav": "audio/all-51b629d1ede5.wav",
  "seconds": 8.904,
  "cues": [
   {
    "start": 0.1,
    "end": 2.2625,
    "text": "最后得到九十二个解。"
   },
   {
    "start": 2.2125,
    "end": 8.85,
    "text": "按字典序，第一个是一五八六三七二四，最后一个是八四一三六二七五。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-8c0019466687.wav",
  "seconds": 14.736,
  "cues": [
   {
    "start": 0.1,
    "end": 5.425,
    "text": "回溯，就是在决策树上深度优先地走，再加上撤销。"
   },
   {
    "start": 5.375,
    "end": 9.1,
    "text": "剪枝，就是剪掉注定走不通的整棵子树。"
   },
   {
    "start": 9.1,
    "end": 14.675,
    "text": "记住两个必犯错误：收答案忘了拷贝，回溯时忘了还原。"
   }
  ]
 }
]