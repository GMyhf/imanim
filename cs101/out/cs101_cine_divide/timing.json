[
 {
  "id": "title",
  "wav": "audio/title-68f6b880630e.wav",
  "seconds": 16.512,
  "cues": [
   {
    "start": 0.1,
    "end": 7.1125,
    "text": "汉诺塔每次调用分出两个子问题，全排列分出好几个，调用树越长越宽。"
   },
   {
    "start": 7.0625,
    "end": 11.675,
    "text": "今天这两个递归只调用自己一次，调用树是一条链。"
   },
   {
    "start": 11.675,
    "end": 16.45,
    "text": "这也是分治：分小，递归解决，再合起来。"
   }
  ]
 },
 {
  "id": "naive",
  "wav": "audio/naive-5e106aaa1449.wav",
  "seconds": 21.12,
  "cues": [
   {
    "start": 0.1,
    "end": 2.0625,
    "text": "先算二的十次方。"
   },
   {
    "start": 2.0125,
    "end": 8.075,
    "text": "最直接的是连乘，乘十次二；指数到十亿，就要十亿次乘法。"
   },
   {
    "start": 8.075,
    "end": 12.7625,
    "text": "换个分法：二的十次方，是二的五次方的平方。"
   },
   {
    "start": 12.7625,
    "end": 17.0625,
    "text": "二的五次方，是二的二次方的平方，再乘一个二。"
   },
   {
    "start": 17.0625,
    "end": 21.05,
    "text": "指数每次减半，奇数就多乘一个底数。"
   }
  ]
 },
 {
  "id": "code",
  "wav": "audio/code-96a414f0cd41.wav",
  "seconds": 16.848,
  "cues": [
   {
    "start": 0.1,
    "end": 2.0,
    "text": "讲义的代码就是这样。"
   },
   {
    "start": 1.95,
    "end": 4.575,
    "text": "指数为零，返回一。"
   },
   {
    "start": 4.575,
    "end": 11.175,
    "text": "否则先递归算出一半的结果 half，把它平方；指数是奇数，再乘一个 a。"
   },
   {
    "start": 11.175,
    "end": 16.8,
    "text": "参数 mod 用来取模；Python 内建的三参数 pow 就是快速幂。"
   }
  ]
 },
 {
  "id": "chain",
  "wav": "audio/chain-3ccdeeaf3c30.wav",
  "seconds": 21.264,
  "cues": [
   {
    "start": 0.1,
    "end": 6.675,
    "text": "跟着调用链走一遍：指数十、五、二、一、零，零返回一。"
   },
   {
    "start": 6.625,
    "end": 17.675,
    "text": "再往回走：一的平方乘二，得二；二的平方，得四；四的平方乘二，得三十二；三十二的平方，得一千零二十四。"
   },
   {
    "start": 17.675,
    "end": 21.2125,
    "text": "一共六次乘法，连乘要十次。"
   }
  ]
 },
 {
  "id": "binary",
  "wav": "audio/binary-935e2be56eb2.wav",
  "seconds": 19.896,
  "cues": [
   {
    "start": 0.1,
    "end": 4.0,
    "text": "把指数写成二进制，十是一零一零。"
   },
   {
    "start": 3.95,
    "end": 9.5625,
    "text": "往下走一层，就是去掉最低位；最低位是一，就多乘一次。"
   },
   {
    "start": 9.5625,
    "end": 15.4,
    "text": "所以层数等于二进制的位数，乘法次数不超过位数的两倍。"
   },
   {
    "start": 15.4,
    "end": 19.825,
    "text": "十亿只有三十位，四十三次乘法就够了。"
   }
  ]
 },
 {
  "id": "twice",
  "wav": "audio/twice-796a7961977c.wav",
  "seconds": 14.4,
  "cues": [
   {
    "start": 0.1,
    "end": 2.7125,
    "text": "注意 half 这个变量不能省。"
   },
   {
    "start": 2.6625,
    "end": 8.7,
    "text": "如果写成两次调用相乘，每层又分出两个孩子，链变回了二叉树。"
   },
   {
    "start": 8.7,
    "end": 14.3375,
    "text": "算二的十次方要调用三十一次，乘二十五次，比连乘还慢。"
   }
  ]
 },
 {
  "id": "gcd",
  "wav": "audio/gcd-f8817e4e6d72.wav",
  "seconds": 18.48,
  "cues": [
   {
    "start": 0.1,
    "end": 2.05,
    "text": "再看最大公约数。"
   },
   {
    "start": 2.0,
    "end": 10.3375,
    "text": "辗转相除：a 和 b 的最大公约数，等于 b 和 a 模 b 的最大公约数；余数为零，答案就是 a。"
   },
   {
    "start": 10.3375,
    "end": 18.425,
    "text": "讲义的例子：十二和十八，换成十八和十二，再到十二和六、六和零，答案是六。"
   }
  ]
 },
 {
  "id": "rect",
  "wav": "audio/rect-2dcbde2e6d71.wav",
  "seconds": 21.048,
  "cues": [
   {
    "start": 0.1,
    "end": 1.9875,
    "text": "画成图更直观。"
   },
   {
    "start": 1.9375,
    "end": 8.6,
    "text": "七十五乘二十七，先切下两个边长二十七的正方形，剩下二十七乘二十一。"
   },
   {
    "start": 8.6,
    "end": 11.9,
    "text": "切一个二十一的，剩下二十一乘六。"
   },
   {
    "start": 11.9,
    "end": 14.775,
    "text": "切三个六的，剩下六乘三。"
   },
   {
    "start": 14.775,
    "end": 17.4375,
    "text": "再切两个三的，正好切完。"
   },
   {
    "start": 17.4375,
    "end": 20.9875,
    "text": "最后的边长三，就是最大公约数。"
   }
  ]
 },
 {
  "id": "why",
  "wav": "audio/why-a96aa2d61b5e.wav",
  "seconds": 16.992,
  "cues": [
   {
    "start": 0.1,
    "end": 1.4,
    "text": "为什么对？"
   },
   {
    "start": 1.35,
    "end": 10.35,
    "text": "a 等于 k 倍的 b 加 r，同时整除 b 和 r 的数也整除 a，反过来也一样，两对数的公约数完全相同。"
   },
   {
    "start": 10.35,
    "end": 16.9375,
    "text": "在图上，边长三的小方块铺满每个正方形，也就铺满了整个长方形。"
   }
  ]
 },
 {
  "id": "halving",
  "wav": "audio/halving-f0bc5a81b7ec.wav",
  "seconds": 17.208,
  "cues": [
   {
    "start": 0.1,
    "end": 1.5625,
    "text": "它为什么快？"
   },
   {
    "start": 1.5125,
    "end": 8.05,
    "text": "b 不超过 a 的一半时，余数比 b 小；b 超过一半时，余数就是 a 减 b。"
   },
   {
    "start": 8.05,
    "end": 10.975,
    "text": "两种情况余数都小于 a 的一半。"
   },
   {
    "start": 10.975,
    "end": 17.1375,
    "text": "所以每走两步，第一个数至少减半：七十五、二十一、三。"
   }
  ]
 },
 {
  "id": "contrast",
  "wav": "audio/contrast-5cf0069e4128.wav",
  "seconds": 16.032,
  "cues": [
   {
    "start": 0.1,
    "end": 7.225,
    "text": "汉诺塔每层分出两支，节点数是二的 n 次方；全排列是 n 的阶乘量级。"
   },
   {
