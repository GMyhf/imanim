[
 {
  "id": "title",
  "wav": "audio/title-550e28aa4906.wav",
  "seconds": 18.576,
  "cues": [
   {
    "start": 0.1,
    "end": 6.375,
    "text": "马走日和数湖泊，都是在网格上做深度优先搜索，代码几乎一模一样。"
   },
   {
    "start": 6.325,
    "end": 10.975,
    "text": "区别只在一行：递归回来以后，要不要把标记撤销。"
   },
   {
    "start": 10.975,
    "end": 15.0,
    "text": "马走日必须撤销，数湖泊绝不能撤销。"
   },
   {
    "start": 15.0,
    "end": 16.6125,
    "text": "写反了会怎样？"
   },
   {
    "start": 16.6125,
    "end": 18.525,
    "text": "今天都跑给你看。"
   }
  ]
 },
 {
  "id": "knight",
  "wav": "audio/knight-1c9c2eba5f9f.wav",
  "seconds": 13.392,
  "cues": [
   {
    "start": 0.1,
    "end": 1.8,
    "text": "先看马走日。"
   },
   {
    "start": 1.75,
    "end": 8.1625,
    "text": "五行四列的棋盘，马从左上角出发，每步走一个日字，最多八个方向。"
   },
   {
    "start": 8.1625,
    "end": 13.325,
    "text": "要求不重复地走遍全部二十格，问一共有多少种走法。"
   }
  ]
 },
 {
  "id": "kcode",
  "wav": "audio/kcode-34a75f1c59b0.wav",
  "seconds": 18.168,
  "cues": [
   {
    "start": 0.1,
    "end": 2.05,
    "text": "代码是标准的回溯。"
   },
   {
    "start": 2.0,
    "end": 4.3875,
    "text": "visited 记下走过的格子。"
   },
   {
    "start": 4.3875,
    "end": 11.7375,
    "text": "八个方向挨个试，没出界、没走过，就标记，递归，回来以后再把标记清掉。"
   },
   {
    "start": 11.7375,
    "end": 14.375,
    "text": "走满二十步，计数加一。"
   },
   {
    "start": 14.375,
    "end": 18.1,
    "text": "最后清掉标记的这一行，就是回溯。"
   }
  ]
 },
 {
  "id": "ktour",
  "wav": "audio/ktour-672b52a7ed5f.wav",
  "seconds": 23.712,
  "cues": [
   {
    "start": 0.1,
    "end": 1.5625,
    "text": "跟着走一遍。"
   },
   {
    "start": 1.5125,
    "end": 8.8,
    "text": "马一路往前，走到第十四步，无路可走，只好退一步，撤销标记，换个方向。"
   },
   {
    "start": 8.8,
    "end": 12.6125,
    "text": "撤销之后，这一格还能被别的路线再经过。"
   },
   {
    "start": 12.6125,
    "end": 17.7125,
    "text": "到第一千四百一十一次调用，第一条走法终于走满二十格。"
   },
   {
    "start": 17.7125,
    "end": 23.6625,
    "text": "全部搜完，一共调用三万五千六百六十一次，找到三十二种走法。"
   }
  ]
 },
 {
  "id": "kforget",
  "wav": "audio/kforget-8a1524981968.wav",
  "seconds": 25.416,
  "cues": [
   {
    "start": 0.1,
    "end": 1.8,
    "text": "如果忘了撤销呢？"
   },
   {
    "start": 1.75,
    "end": 4.2125,
    "text": "同样走到第十四步卡住。"
   },
   {
    "start": 4.2125,
    "end": 9.9,
    "text": "退回来时，格子还标着走过，别的路线想再经过，就被挡在外面。"
   },
   {
    "start": 9.9,
    "end": 17.8125,
    "text": "结果每格最多只进一次，二十次调用就把整个棋盘涂满，一条走法也没找到，答案是零。"
   },
   {
    "start": 17.8125,
    "end": 25.3625,
    "text": "讲义说，忘了这一行，答案只能是零或一：每格只进一次，最多只有一条路能走满。"
   }
  ]
 },
 {
  "id": "lake",
  "wav": "audio/lake-90ee72ffe1cd.wav",
  "seconds": 17.424,
  "cues": [
   {
    "start": 0.1,
    "end": 1.65,
    "text": "再看数湖泊。"
   },
   {
    "start": 1.6,
    "end": 6.375,
    "text": "蓝色的格子是水，八个方向相连的水，算同一个湖。"
   },
   {
    "start": 6.375,
    "end": 8.55,
    "text": "还是五行四列的网格。"
   },
   {
    "start": 8.55,
    "end": 17.3625,
    "text": "逐格扫描，碰到一格水，湖数加一，再从这里出发，把整个湖都标记掉，后面就不会重复数。"
   }
  ]
 },
 {
  "id": "lwalk",
  "wav": "audio/lwalk-bafd9a0c9f78.wav",
  "seconds": 18.864,
  "cues": [
   {
    "start": 0.1,
    "end": 7.0,
    "text": "灌水的代码和马走日几乎一样：八个方向挨个试，是水，就标记，递归。"
   },
   {
    "start": 6.95,
    "end": 9.8875,
    "text": "唯一的区别是，回来以后不撤销。"
   },
   {
    "start": 9.8875,
    "end": 13.4875,
    "text": "左上角的湖有八格，每格只进一次。"
   },
   {
    "start": 13.4875,
    "end": 18.8125,
    "text": "扫描完毕，三个湖，十一格水，正好十一次调用。"
   }
  ]
 },
 {
  "id": "lwrong",
  "wav": "audio/lwrong-602e8d619894.wav",
  "seconds": 32.976,
  "cues": [
   {
    "start": 0.1,
    "end": 2.7625,
    "text": "要是在这里也加上撤销呢？"
   },
   {
    "start": 2.7125,
    "end": 5.6875,
    "text": "递归一回来，格子又变回了水。"
   },
   {
    "start": 5.6875,
    "end": 13.825,
    "text": "同一个湖里，每一条不重复的路线都要走一遍，只从左上角这一格出发，就要调用六百零八次。"
   },
   {
    "start": 13.825,
    "end": 18.4125,
    "text": "外层扫描到下一格，它还是水，湖数再加一。"
   },
   {
    "start": 18.4125,
    "end": 22.3,
    "text": "最后数出十一个湖，调用九百七十九次。"
   },
   {
    "start": 22.3,
    "end": 32.9125,
    "text": "换成讲义的样例，正确答案是三个湖、三十一次调用；加上撤销，数出三十一个湖，调用一万八千八百一十一次。"
   }
  ]
 },
 {
  "id": "why",
  "wav": "audio/why-60a44c093fb1.wav",
  "seconds": 25.008,
  "cues": [
   {
    "start": 0.1,
    "end": 3.4625,
    "text": "为什么一个必须撤销，一个绝不能撤销？"
   },
   {
    "start": 3.4125,
    "end": 5.25,
    "text": "看题目问的是什么。"
   },
   {
    "start": 5.25,
    "end": 11.9875,
    "text": "马走日问的是路线，同一格要在不同路线里被反复经过，离开时必须还回去。"
   },
   {
    "start": 11.9875,
    "end": 18.375,
    "text": "数湖泊问的是哪些格子连在一起，每格碰一次就够，标记本身就是答案的一部分。"
   },
   {
    "start": 18.375,
    "end": 24.9375,
    "text": "讲义用显式栈灌水，先标记再入栈，道理完全一样，还不怕爆栈。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-775909ace9f3.wav",
  "seconds": 9.984,
  "cues": [
   {
    "start": 0.1,
    "end": 4.2375,
    "text": "数路线，要撤销；数格子，不撤销。"
   },
   {
    "start": 4.1875,
    "end": 9.925,
    "text": "连通块还有一种更灵活的数法，就是下一支要讲的并查集。"
   }
  ]
 }
]