[
 {
  "id": "title",
  "wav": "audio/title-4978729b336a.wav",
  "seconds": 16.008,
  "cues": [
   {
    "start": 0.1,
    "end": 1.6875,
    "text": "双重回文。"
   },
   {
    "start": 1.6375,
    "end": 9.325,
    "text": "一个正整数，十进制写出来是回文，二进制写出来也是回文，就叫双重回文数。"
   },
   {
    "start": 9.325,
    "end": 15.95,
    "text": "给定 n，最大一百万，要输出一到 n 里一共有几个，以及最大的那个。"
   }
  ]
 },
 {
  "id": "sample1",
  "wav": "audio/sample1-4d8e192a7676.wav",
  "seconds": 26.88,
  "cues": [
   {
    "start": 0.1,
    "end": 2.8125,
    "text": "先看样例一，n 等于五。"
   },
   {
    "start": 2.7625,
    "end": 7.55,
    "text": "一到五在十进制下都只有一位，一位数一定是回文。"
   },
   {
    "start": 7.55,
    "end": 9.375,
    "text": "关键在二进制。"
   },
   {
    "start": 9.375,
    "end": 11.7375,
    "text": "一就是一，回文。"
   },
   {
    "start": 11.7375,
    "end": 15.15,
    "text": "二是一零，倒过来是零一，不是。"
   },
   {
    "start": 15.15,
    "end": 17.375,
    "text": "三是一一，回文。"
   },
   {
    "start": 17.375,
    "end": 19.8625,
    "text": "四是一零零，不是。"
   },
   {
    "start": 19.8625,
    "end": 22.3875,
    "text": "五是一零一，回文。"
   },
   {
    "start": 22.3875,
    "end": 26.8125,
    "text": "所以一共三个，最大是五，输出三和五。"
   }
  ]
 },
 {
  "id": "strrev",
  "wav": "audio/strrev-7b4f62e1e7ba.wav",
  "seconds": 30.144,
  "cues": [
   {
    "start": 0.1,
    "end": 5.7875,
    "text": "判回文最省事的写法：转成字符串，和它倒过来的样子比较。"
   },
   {
    "start": 5.7375,
    "end": 8.975,
    "text": "十进制用 str，二进制用 bin。"
   },
   {
    "start": 8.975,
    "end": 14.6875,
    "text": "注意 bin 返回的字符串带着零 b 前缀，五会变成零 b 一零一。"
   },
   {
    "start": 14.6875,
    "end": 19.6625,
    "text": "忘了切掉前两个字符，倒过来是一零一 b 零，永远不相等。"
   },
   {
    "start": 19.6625,
    "end": 24.425,
    "text": "这样写，样例一会输出零个，最大的还是初值一。"
   },
   {
    "start": 24.425,
    "end": 30.0875,
    "text": "从小到大枚举，最后一个满足的就是最大的，best 直接覆盖。"
   }
  ]
 },
 {
  "id": "even",
  "wav": "audio/even-cfae957b2635.wav",
  "seconds": 23.376,
  "cues": [
   {
    "start": 0.1,
    "end": 3.65,
    "text": "再想一步：偶数可能是二进制回文吗？"
   },
   {
    "start": 3.6,
    "end": 7.6375,
    "text": "没有前导零，二进制的最高位一定是一。"
   },
   {
    "start": 7.6375,
    "end": 11.0,
    "text": "偶数能被二整除，末位一定是零。"
   },
   {
    "start": 11.0,
    "end": 14.825,
    "text": "一头是一，一头是零，首尾对不上。"
   },
   {
    "start": 14.825,
    "end": 18.55,
    "text": "比如六是一一零，十是一零一零。"
   },
   {
    "start": 18.55,
    "end": 23.325,
    "text": "所以只枚举奇数，range 的步长写二，工作量减半。"
   }
  ]
 },
 {
  "id": "revnum",
  "wav": "audio/revnum-809163d4a337.wav",
  "seconds": 41.232,
  "cues": [
   {
    "start": 0.1,
    "end": 5.7,
    "text": "讲义的 C++ 版不转字符串，而是把数按进制倒过来。"
   },
   {
    "start": 5.65,
    "end": 16.8875,
    "text": "t 从 x 开始，每次取 t 除以进制的余数，接到 y 的末尾，也就是 y 乘进制再加余数，然后 t 整除进制，t 变成零就停。"
   },
   {
    "start": 16.8875,
    "end": 26.7,
    "text": "看三十三按二进制：余数依次是一零零零零一，y 依次长成一、二、四、八、十六、三十三。"
   },
   {
    "start": 26.7,
    "end": 30.0875,
    "text": "最后 y 等于 x，是回文。"
   },
   {
    "start": 30.0875,
    "end": 35.9625,
    "text": "换成三十七：y 最后是四十一，不等于三十七，不是回文。"
   },
   {
    "start": 35.9625,
    "end": 41.1625,
    "text": "十进制也一样，五八五五八五倒过来，还是它自己。"
   }
  ]
 },
 {
  "id": "sample2",
  "wav": "audio/sample2-7ae6b9f42a62.wav",
  "seconds": 29.952,
  "cues": [
   {
    "start": 0.1,
    "end": 2.6625,
    "text": "样例二，n 等于一百。"
   },
   {
    "start": 2.6125,
    "end": 9.6125,
    "text": "一百以内的十进制回文，是一到九，加上十一、二十二，一直到九十九。"
   },
   {
    "start": 9.6125,
    "end": 12.225,
    "text": "只留奇数，剩下十个。"
   },
   {
    "start": 12.225,
    "end": 14.0,
    "text": "再查二进制。"
   },
   {
    "start": 14.0,
    "end": 16.5125,
    "text": "十一是一零一一，不是。"
   },
   {
    "start": 16.5125,
    "end": 19.675,
    "text": "三十三是一零零零零一，是。"
   },
   {
    "start": 19.675,
    "end": 22.3125,
    "text": "五十五、七十七都不是。"
   },
   {
    "start": 22.3125,
    "end": 25.3875,
    "text": "九十九是一一零零零一一，是。"
   },
   {
    "start": 25.3875,
    "end": 29.9,
    "text": "一共七个，最大九十九，输出七和九十九。"
   }
  ]
 },
 {
  "id": "cost",
  "wav": "audio/cost-ddcaa645a883.wav",
  "seconds": 27.024,
  "cues": [
   {
    "start": 0.1,
    "end": 1.8,
    "text": "复杂度够不够？"
   },
   {
    "start": 1.75,
    "end": 6.25,
    "text": "n 最大一百万，只枚举奇数，是五十万个。"
   },
   {
    "start": 6.25,
    "end": 14.55,
    "text": "每个数转成两个字符串，十进制最多六位，二进制最多二十位，加起来大约一千二百万个字符。"
   },
   {
    "start": 14.55,
    "end": 17.575,
    "text": "这是线性的，Python 也来得及。"
   },
   {
    "start": 17.575,
    "end": 22.9,
    "text": "跑满一百万，答案是十九个，最大的是五十八万五千五百八十五。"
   },
   {
    "start": 22.9,
    "end": 26.9625,
    "text": "它的二进制有二十位，首尾逐位对称。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-8bf5adf6defb.wav",
  "seconds": 22.968,
  "cues": [
   {
    "start": 0.1,
    "end": 1.3125,
    "text": "回顾。"
   },
   {
    "start": 1.2625,
    "end": 5.125,
    "text": "双重回文就是枚举，加上两次判回文。"
   },
   {
    "start": 5.125,
    "end": 8.3125,
    "text": "字符串写法记得切掉零 b 前缀。"
   },
   {
    "start": 8.3125,
    "end": 11.9,
    "text": "偶数的二进制末位是零，只枚举奇数。"
   },
   {
    "start": 11.9,
    "end": 18.1375,
    "text": "不转字符串时，用 y 等于 y 乘进制加余数，把数倒过来再比较。"
   },
   {
    "start": 18.1375,
    "end": 22.9125,
    "text": "最后拿边界试一遍：n 等于一，输出一和一。"
   }
  ]
 }
]