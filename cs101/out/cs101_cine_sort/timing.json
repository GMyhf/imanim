[
 {
  "id": "title",
  "wav": "audio/title-2fec4489244b.wav",
  "seconds": 12.048,
  "cues": [
   {
    "start": 0.1,
    "end": 2.4125,
    "text": "八个数，乱序排着。"
   },
   {
    "start": 2.3625,
    "end": 5.1125,
    "text": "把它们排好，要比较多少次？"
   },
   {
    "start": 5.1125,
    "end": 7.7375,
    "text": "答案取决于你用哪种排序。"
   },
   {
    "start": 7.7375,
    "end": 12.0,
    "text": "有的要比较 n 平方次，有的只要 n log n 次。"
   }
  ]
 },
 {
  "id": "table",
  "wav": "audio/table-ae41e16c1670.wav",
  "seconds": 18.624,
  "cues": [
   {
    "start": 0.1,
    "end": 1.7625,
    "text": "先看一张表。"
   },
   {
    "start": 1.7125,
    "end": 5.8875,
    "text": "冒泡、选择、插入，都是 n 平方。"
   },
   {
    "start": 5.8875,
    "end": 9.4625,
    "text": "归并稳定在 n log n，但要额外的空间。"
   },
   {
    "start": 9.4625,
    "end": 13.4625,
    "text": "快排平均 n log n，最坏会退化到 n 平方。"
   },
   {
    "start": 13.4625,
    "end": 18.5625,
    "text": "考试里一般直接调用 sort，但归并的合并过程要会写。"
   }
  ]
 },
 {
  "id": "bubble",
  "wav": "audio/bubble-7316d4a8b485.wav",
  "seconds": 13.872,
  "cues": [
   {
    "start": 0.1,
    "end": 4.025,
    "text": "冒泡排序：相邻两个比较，逆序就交换。"
   },
   {
    "start": 3.975,
    "end": 8.7375,
    "text": "一趟下来，最大的数冒到末尾，下一趟就少比一个。"
   },
   {
    "start": 8.7375,
    "end": 13.8125,
    "text": "如果某一趟一次都没交换，说明已经有序，提前退出。"
   }
  ]
 },
 {
  "id": "insertion",
  "wav": "audio/insertion-281e3335f76b.wav",
  "seconds": 13.032,
  "cues": [
   {
    "start": 0.1,
    "end": 5.225,
    "text": "插入排序像理牌：把当前这张牌拿在手里，往前找位置。"
   },
   {
    "start": 5.175,
    "end": 9.3875,
    "text": "比它大的依次往后挪，空出位置再插进去。"
   },
   {
    "start": 9.3875,
    "end": 12.975,
    "text": "数据近乎有序时，它接近线性。"
   }
  ]
 },
 {
  "id": "merge",
  "wav": "audio/merge-614ba706f56c.wav",
  "seconds": 16.416,
  "cues": [
   {
    "start": 0.1,
    "end": 5.25,
    "text": "归并排序换个思路：从中间切开，一直切到只剩一个数。"
   },
   {
    "start": 5.2,
    "end": 9.6125,
    "text": "再两两合并：两个指针各指一边，小的先出来。"
   },
   {
    "start": 9.6125,
    "end": 16.35,
    "text": "左边小于等于右边，就先取左边，这个小于等于，就是归并稳定的原因。"
   }
  ]
 },
 {
  "id": "growth",
  "wav": "audio/growth-80b0e7d2ea93.wav",
  "seconds": 10.656,
  "cues": [
   {
    "start": 0.1,
    "end": 1.7125,
    "text": "差距有多大？"
   },
   {
    "start": 1.6625,
    "end": 7.4875,
    "text": "n 等于一千时，n 平方是一百万，n log n 只有大约一万。"
   },
   {
    "start": 7.4875,
    "end": 10.5875,
    "text": "数据越大，差距越悬殊。"
   }
  ]
 },
 {
  "id": "stable",
  "wav": "audio/stable-de1aa2b65e9b.wav",
  "seconds": 16.152,
  "cues": [
   {
    "start": 0.1,
    "end": 5.4,
    "text": "Python 的 sort 是稳定的：相等的元素保持原来的相对顺序。"
   },
   {
    "start": 5.35,
    "end": 10.475,
    "text": "于是可以排两次：先按次关键字排，再按主关键字排。"
   },
   {
    "start": 10.475,
    "end": 16.0875,
    "text": "a 和 c 的数字都是二，第二次排序后，它们仍然保持字母顺序。"
   }
  ]
 },
 {
  "id": "inversion",
  "wav": "audio/inversion-1cf57f601fd2.wav",
  "seconds": 28.584,
  "cues": [
   {
    "start": 0.1,
    "end": 6.075,
    "text": "归并还能顺手数逆序对，也就是位置靠前、数值却更大的数对。"
   },
   {
    "start": 6.025,
    "end": 9.7625,
    "text": "左半二五七，右半一三六，各自已经排好。"
   },
   {
    "start": 9.7625,
    "end": 15.1125,
    "text": "右边的一先出来，左边剩下的三个数都比它大，一次加三。"
   },
   {
    "start": 15.1125,
    "end": 19.2625,
    "text": "三出来时，左边还剩五和七，加二。"
   },
   {
    "start": 19.2625,
    "end": 21.55,
    "text": "六出来时，加一。"
   },
   {
    "start": 21.55,
    "end": 24.4375,
    "text": "跨越两半的逆序对一共六个。"
   },
   {
    "start": 24.4375,
    "end": 28.5125,
    "text": "这就是为什么是 len left 减 i，而不是加一。"
   }
  ]
 },
 {
