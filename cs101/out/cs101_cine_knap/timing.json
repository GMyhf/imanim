[
 {
  "id": "title",
  "wav": "audio/title-03640c0c0db7.wav",
  "seconds": 14.712,
  "cues": [
   {
    "start": 0.1,
    "end": 2.7375,
    "text": "一个小偷，背包容量是四。"
   },
   {
    "start": 2.6875,
    "end": 11.075,
    "text": "面前有三件东西：体积一、价值一千五；体积四、价值三千；体积三、价值两千。"
   },
   {
    "start": 11.075,
    "end": 14.6625,
    "text": "每件最多拿一次，怎么拿最值钱？"
   }
  ]
 },
 {
  "id": "kinds",
  "wav": "audio/kinds-f0657ca7ec20.wav",
  "seconds": 19.776,
  "cues": [
   {
    "start": 0.1,
    "end": 1.95,
    "text": "这就是零一背包。"
   },
   {
    "start": 1.9,
    "end": 7.575,
    "text": "背包有三兄弟：零一背包，每种最多拿一个，容量倒序遍历。"
   },
   {
    "start": 7.575,
    "end": 12.0,
    "text": "完全背包，每种无限个，容量正序遍历。"
   },
   {
    "start": 12.0,
    "end": 16.1625,
    "text": "多重背包，先二进制拆分，再当零一背包做。"
   },
   {
    "start": 16.1625,
    "end": 19.725,
    "text": "前两种的差别，只有倒序和正序。"
   }
  ]
 },
 {
  "id": "state",
  "wav": "audio/state-678364e5ffdf.wav",
  "seconds": 21.72,
  "cues": [
   {
    "start": 0.1,
    "end": 2.0625,
    "text": "先看二维写法。"
   },
   {
    "start": 2.0125,
    "end": 7.7875,
    "text": "dp i c 表示只考虑前 i 个物品、容量为 c 时的最大价值。"
   },
   {
    "start": 7.7875,
    "end": 9.8,
    "text": "第零行全是零。"
   },
   {
    "start": 9.8,
    "end": 19.7625,
    "text": "每一格只有两个选择：不拿第 i 个，抄上一行同一列；拿，就看上一行、往左退它的体积那一格，再加上它的价值。"
   },
   {
    "start": 19.7625,
    "end": 21.6625,
    "text": "两者取大。"
   }
  ]
 },
 {
  "id": "fill",
  "wav": "audio/fill-14f88c21cd95.wav",
  "seconds": 18.864,
  "cues": [
   {
    "start": 0.1,
    "end": 2.0125,
    "text": "一行一行地填。"
   },
   {
    "start": 1.9625,
    "end": 5.9,
    "text": "第一行只有一千五的物品，容量够一就能拿。"
   },
   {
    "start": 5.9,
    "end": 11.6,
    "text": "第二行的物品体积是四，只有容量四才装得下，三千比一千五大。"
   },
   {
    "start": 11.6,
    "end": 18.8,
    "text": "第三行，容量四的那一格：不拿是三千，拿是一千五加两千，等于三千五。"
   }
  ]
 },
 {
  "id": "back",
  "wav": "audio/back-609176fd6f80.wav",
  "seconds": 17.112,
  "cues": [
   {
    "start": 0.1,
    "end": 2.7875,
    "text": "右下角就是答案，三千五。"
   },
   {
    "start": 2.7375,
    "end": 5.1,
    "text": "怎么知道拿了哪几件？"
   },
   {
    "start": 5.1,
    "end": 14.1,
    "text": "从右下角往回看：和上一行一样，说明没拿；不一样，说明拿了，容量减去它的体积，再往上看。"
   },
   {
    "start": 14.1,
    "end": 17.0625,
    "text": "最后拿的是第一件和第三件。"
   }
  ]
 },
 {
  "id": "roll",
  "wav": "audio/roll-526051fe0b87.wav",
  "seconds": 17.52,
  "cues": [
   {
    "start": 0.1,
    "end": 6.5125,
    "text": "实战都写一维版：只留一行，每来一件物品，就把这一行原地更新一遍。"
   },
   {
    "start": 6.4625,
    "end": 9.6125,
    "text": "关键是容量必须从大到小倒序。"
   },
   {
    "start": 9.6125,
    "end": 17.4625,
    "text": "倒序时，左边那格还没被本轮改过，仍然是上一行的值，正好对应二维式子里的上一行。"
   }
  ]
 },
 {
  "id": "wrong",
  "wav": "audio/wrong-2ac675fe2a43.wav",
  "seconds": 18.408,
  "cues": [
   {
    "start": 0.1,
    "end": 1.825,
    "text": "如果正序会怎样？"
   },
   {
    "start": 1.775,
    "end": 3.8375,
    "text": "拿第一件物品试试。"
   },
   {
    "start": 3.8375,
    "end": 6.3875,
    "text": "容量一，变成一千五。"
   },
   {
    "start": 6.3875,
    "end": 14.35,
    "text": "容量二读到的左边那格，已经是本轮刚更新过的一千五，于是变成三千，同一件物品被拿了两次。"
   },
   {
    "start": 14.35,
    "end": 18.3375,
    "text": "一路正序下去，容量四变成六千。"
   }
  ]
 },
 {
  "id": "full",
  "wav": "audio/full-cc71316f7515.wav",
  "seconds": 19.848,
  "cues": [
   {
    "start": 0.1,
    "end": 3.3,
    "text": "这个错误，恰好就是完全背包。"
   },
   {
    "start": 3.25,
    "end": 10.1,
    "text": "每种物品无限个，正序时左边那格已经装过当前物品，允许重复拿。"
   },
   {
    "start": 10.1,
    "end": 16.75,
    "text": "同样的物品和容量，零一背包是三千五，完全背包是六千，拿四个体积为一的。"
   },
   {
    "start": 16.75,
    "end": 19.8,
    "text": "两段代码只差 range 的方向。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-6745e553579c.wav",
  "seconds": 10.128,
  "cues": [
   {
    "start": 0.1,
    "end": 4.9375,
    "text": "一张表，两个分支：不拿抄上面，拿就看左上。"
   },
   {
    "start": 4.8875,
    "end": 10.075,
    "text": "滚成一行之后，倒序是零一背包，正序是完全背包。"
   }
  ]
 }
]