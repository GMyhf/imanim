[
 {
  "id": "title",
  "wav": "audio/title-dd2436c017db.wav",
  "seconds": 14.256,
  "cues": [
   {
    "start": 0.1,
    "end": 5.25,
    "text": "子集、组合、排列，是回溯最常见的三种题。"
   },
   {
    "start": 5.2,
    "end": 8.9125,
    "text": "看起来各不相同，代码却几乎一模一样。"
   },
   {
    "start": 8.9125,
    "end": 14.2,
    "text": "这支片把三棵决策树摆在一起，看看它们到底差在哪。"
   }
  ]
 },
 {
  "id": "template",
  "wav": "audio/template-c062ab1ba7b0.wav",
  "seconds": 21.168,
  "cues": [
   {
    "start": 0.1,
    "end": 2.6125,
    "text": "先看讲义的通用模板。"
   },
   {
    "start": 2.5625,
    "end": 12.3625,
    "text": "路径是已经做过的选择，结束条件决定什么时候收答案，中间的循环枚举当前还能做的选择，也就是当前节点有哪些孩子。"
   },
   {
    "start": 12.3625,
    "end": 17.8625,
    "text": "选择、递归、撤销这三步，三种形态里一字不改。"
   },
   {
    "start": 17.8625,
    "end": 21.1,
    "text": "要变的，只有循环这一行。"
   }
  ]
 },
 {
  "id": "pick",
  "wav": "audio/pick-44898922341e.wav",
  "seconds": 14.016,
  "cues": [
   {
    "start": 0.1,
    "end": 1.5625,
    "text": "先看子集。"
   },
   {
    "start": 1.5125,
    "end": 8.5125,
    "text": "上一支片里，子集是一棵二叉树：每层决定一个元素，左边不选，右边选。"
   },
   {
    "start": 8.5125,
    "end": 13.9625,
    "text": "三个元素，十五个节点，只有最底层的八个叶子是答案。"
   }
  ]
 },
 {
  "id": "start",
  "wav": "audio/start-ed4d65278066.wav",
  "seconds": 25.2,
  "cues": [
   {
    "start": 0.1,
    "end": 4.05,
    "text": "第九周换一种看法：从起始下标往后挑。"
   },
   {
    "start": 4.0,
    "end": 7.6625,
    "text": "根是空集，可以挑一、二、三。"
   },
   {
    "start": 7.6625,
    "end": 11.6875,
    "text": "挑了一之后，只能往后挑二或三，不回头。"
   },
   {
    "start": 11.6875,
    "end": 17.1875,
    "text": "这样每个节点都是一个不同的子集，所以每个节点都收答案。"
   },
   {
    "start": 17.1875,
    "end": 22.2875,
    "text": "八个节点，正好八个子集，比二叉树少了七个节点。"
   },
   {
    "start": 22.2875,
    "end": 25.1375,
    "text": "同一个问题，换了一棵树。"
   }
  ]
 },
 {
  "id": "three",
  "wav": "audio/three-80911c696b00.wav",
  "seconds": 33.816,
  "cues": [
   {
    "start": 0.1,
    "end": 2.4125,
    "text": "现在把三棵树并排。"
   },
   {
    "start": 2.3625,
    "end": 7.9875,
    "text": "左边是子集，中间是从一二三里选两个的组合，右边是排列。"
   },
   {
    "start": 7.9875,
    "end": 10.9375,
    "text": "看同一个节点：第一步选了二。"
   },
   {
    "start": 10.9375,
    "end": 15.8625,
    "text": "子集和组合，下一层只能挑三，因为起始下标不回头。"
   },
   {
    "start": 15.8625,
    "end": 22.3125,
    "text": "排列不讲先后，没用过的一和三都能选，所以要靠 used 数组记住谁用过。"
   },
   {
    "start": 22.3125,
    "end": 29.75,
    "text": "收答案的条件也跟着题目走：子集每个节点都收，组合凑够两个才收，排列要选满三个。"
   },
   {
    "start": 29.75,
    "end": 33.7625,
    "text": "三者的差别，只在下一层能选哪些数。"
   }
  ]
 },
 {
  "id": "csum",
  "wav": "audio/csum-13b555786a79.wav",
  "seconds": 25.992,
  "cues": [
   {
    "start": 0.1,
    "end": 3.5125,
    "text": "组合还有一种变形：组合总和。"
   },
   {
    "start": 3.4625,
    "end": 10.8875,
    "text": "候选数二、三、六、七，每个数可以重复用，找出和为七的所有组合。"
   },
   {
    "start": 10.8875,
    "end": 18.5875,
    "text": "能重复，递归时就传 i，而不是 i 加一：下一层还能再选自己，但仍然不回头。"
   },
   {
    "start": 18.5875,
    "end": 22.2625,
    "text": "节点里写的是还差多少，差零就收下。"
   },
   {
    "start": 22.2625,
    "end": 25.9375,
    "text": "答案只有两个：二二三，和七。"
   }
  ]
 },
 {
  "id": "prune",
  "wav": "audio/prune-cede18fa2976.wav",
  "seconds": 29.856,
  "cues": [
   {
    "start": 0.1,
    "end": 4.475,
    "text": "如果不剪枝，每条边都先走进去，超了再退回来。"
   },
   {
    "start": 4.425,
    "end": 8.9625,
    "text": "这棵树有二十八个节点，其中十八个是红色的死路。"
   },
   {
    "start": 8.9625,
    "end": 16.65,
    "text": "讲义先把候选数排好序：一旦当前的数大于还差的额度，后面的只会更大，直接 break。"
   },
   {
    "start": 16.65,
    "end": 20.45,
    "text": "十八条死路全部剪掉，只剩十个节点。"
   },
   {
    "start": 20.45,
    "end": 22.3125,
    "text": "换成 continue 呢？"
   },
   {
    "start": 22.3125,
    "end": 29.7875,
    "text": "节点也是十个，但每个候选数都要比较一遍，一共二十七次；break 只比较十六次。"
   }
  ]
 },
 {
  "id": "kinds",
  "wav": "audio/kinds-79cd835646b9.wav",
  "seconds": 19.992,
  "cues": [
   {
    "start": 0.1,
    "end": 2.9875,
    "text": "这就是三类剪枝里的顺序剪枝。"
   },
   {
    "start": 2.9375,
    "end": 8.875,
    "text": "可行性剪枝，是一个选择违反约束就跳过，八皇后的冲突检查就是。"
   },
   {
    "start": 8.875,
    "end": 14.35,
    "text": "最优性剪枝，是部分解已经比已知最好的还差，就放弃。"
   },
   {
    "start": 14.35,
    "end": 19.925,
    "text": "顺序剪枝，是排好序之后，一个不行，后面全都不行。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-c6c02310a912.wav",
  "seconds": 17.352,
  "cues": [
   {
    "start": 0.1,
    "end": 2.925,
    "text": "回溯三形态，共用一个模板。"
   },
   {
    "start": 2.875,
    "end": 9.775,
    "text": "子集和组合从起始下标往后挑，组合总和可以再选自己，排列用 used 数组。"
   },
   {
    "start": 9.775,
    "end": 12.6375,
    "text": "差别只在下一层能选哪些数。"
   },
   {
    "start": 12.6375,
    "end": 17.2875,
    "text": "再配上合适的剪枝，指数级的搜索也能跑完。"
   }
  ]
 }
]