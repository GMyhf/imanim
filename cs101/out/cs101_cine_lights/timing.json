[
 {
  "id": "title",
  "wav": "audio/title-8a9ebef223e6.wav",
  "seconds": 16.488,
  "cues": [
   {
    "start": 0.1,
    "end": 1.725,
    "text": "例题精讲。"
   },
   {
    "start": 1.675,
    "end": 8.025,
    "text": "今天这道是 OpenJudge 上的熄灯问题，题号二八一一，也是往年机考出过的老题。"
   },
   {
    "start": 8.025,
    "end": 11.8875,
    "text": "五行六列，三十盏灯，三十个按钮。"
   },
   {
    "start": 11.8875,
    "end": 16.4375,
    "text": "看上去要试十亿种按法，其实只要试六十四种。"
   }
  ]
 },
 {
  "id": "read",
  "wav": "audio/read-384293b86b42.wav",
  "seconds": 22.488,
  "cues": [
   {
    "start": 0.1,
    "end": 1.5625,
    "text": "先读题。"
   },
   {
    "start": 1.5125,
    "end": 5.4375,
    "text": "五行六列的灯，一表示亮，零表示灭。"
   },
   {
    "start": 5.4375,
    "end": 7.4625,
    "text": "每盏灯配一个按钮。"
   },
   {
    "start": 7.4625,
    "end": 14.0625,
    "text": "按一下，这盏灯和它上下左右的灯都会翻转，亮的变灭，灭的变亮。"
   },
   {
    "start": 14.0625,
    "end": 18.2875,
    "text": "角上的按钮只影响三盏，边上的影响四盏。"
   },
   {
    "start": 18.2875,
    "end": 22.4375,
    "text": "要求输出一张按法表，让所有的灯都熄灭。"
   }
  ]
 },
 {
  "id": "model",
  "wav": "audio/model-9a5c70b01e14.wav",
  "seconds": 30.576,
  "cues": [
   {
    "start": 0.1,
    "end": 2.6875,
    "text": "再建模，先做两个观察。"
   },
   {
    "start": 2.6375,
    "end": 9.275,
    "text": "第一，同一个按钮按两次，等于没按，所以每个按钮只有按与不按两种。"
   },
   {
    "start": 9.275,
    "end": 16.975,
    "text": "第二，按的先后顺序不影响结果，每盏灯最后亮不亮，只看它和邻居里一共按了几个。"
   },
   {
    "start": 16.975,
    "end": 20.25,
    "text": "所以答案就是一张五乘六的零一表。"
   },
   {
    "start": 20.25,
    "end": 25.1375,
    "text": "直接枚举整张表，要试二的三十次方，十亿多种。"
   },
   {
    "start": 25.1375,
    "end": 30.5125,
    "text": "第四周那张表说过，二的 n 次方，只适合 n 不超过二十。"
   }
  ]
 },
 {
  "id": "key",
  "wav": "audio/key-0daf7f379498.wav",
  "seconds": 31.08,
  "cues": [
   {
    "start": 0.1,
    "end": 2.35,
    "text": "关键观察在第一行。"
   },
   {
    "start": 2.3,
    "end": 5.0,
    "text": "假设第一行的按法已经定了。"
   },
   {
    "start": 5.0,
    "end": 9.1375,
    "text": "这时第一行还亮着的灯，谁还能把它关掉？"
   },
   {
    "start": 9.1375,
    "end": 13.6625,
    "text": "第一行的按钮不能再动，只剩正下方第二行的那个按钮。"
   },
   {
    "start": 13.6625,
    "end": 20.0875,
    "text": "所以第一行哪盏灯还亮，第二行同一列就必须按；不亮，就必须不按。"
   },
   {
    "start": 20.0875,
    "end": 22.275,
    "text": "第二行就这样被逼了出来。"
   },
   {
    "start": 22.275,
    "end": 27.4875,
    "text": "同样的道理一行一行往下推，整张表都由第一行决定。"
   },
   {
    "start": 27.4875,
    "end": 31.0125,
    "text": "最后只要检查第五行是不是全灭。"
   }
  ]
 },
 {
  "id": "walk",
  "wav": "audio/walk-1d1e8e36be42.wav",
  "seconds": 26.712,
  "cues": [
   {
    "start": 0.1,
    "end": 2.6125,
    "text": "用题目的第一组样例走一遍。"
   },
   {
    "start": 2.5625,
    "end": 4.625,
    "text": "先试第一行全不按。"
   },
   {
    "start": 4.625,
    "end": 12.6125,
    "text": "第二行照着第一行剩下的灯去按，一路推到底，第五行还剩四盏亮着，失败，换下一种。"
   },
   {
    "start": 12.6125,
    "end": 16.8125,
    "text": "第一行的按法像二进制数一样加一，一种一种地试。"
   },
   {
    "start": 16.8125,
    "end": 23.025,
    "text": "试到第四十二种，第一行按一零一零零一，推到第五行，全部熄灭。"
   },
   {
    "start": 23.025,
    "end": 26.6625,
    "text": "这就是答案，和样例输出一模一样。"
   }
  ]
 },
 {
  "id": "code",
  "wav": "audio/code-fc3c2e884b7f.wav",
  "seconds": 20.712,
  "cues": [
   {
    "start": 0.1,
    "end": 1.9125,
    "text": "代码只有十几行。"
   },
   {
    "start": 1.8625,
    "end": 5.4,
    "text": "外层循环枚举第一行的六十四种按法。"
   },
   {
    "start": 5.4,
    "end": 12.8625,
    "text": "里面逐行逐列地决定按不按：第一行看枚举出来的那一位，后面各行看正上方的灯还亮不亮。"
   },
   {
    "start": 12.8625,
    "end": 17.125,
    "text": "要按，就记下来，再把自己和上下左右翻转。"
   },
   {
    "start": 17.125,
    "end": 20.65,
    "text": "最后一行全灭，就返回这张表。"
   }
  ]
 },
 {
  "id": "cost",
  "wav": "audio/cost-0ba6e688c469.wav",
  "seconds": 19.488,
  "cues": [
   {
    "start": 0.1,
    "end": 1.6125,
    "text": "算一下代价。"
   },
   {
    "start": 1.5625,
    "end": 10.725,
    "text": "第一行六十四种，每种推一遍三十个格子，一共不到两千次操作，瞬间出结果，比直接枚举快了一千六百多万倍。"
   },
   {
    "start": 10.725,
    "end": 19.4375,
    "text": "还可以验证，五乘六的盘面上，六十四种第一行里恰好只有一种能成功，所以答案是唯一的。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-e5f698d3c537.wav",
  "seconds": 28.368,
  "cues": [
   {
    "start": 0.1,
    "end": 1.9125,
    "text": "回顾解题的三步。"
   },
   {
    "start": 1.8625,
    "end": 6.3625,
    "text": "读题，抓住按一下会翻转自己和四个邻居。"
   },
   {
    "start": 6.3625,
    "end": 11.8625,
    "text": "建模，按两次等于不按，顺序无关，答案是一张零一表。"
   },
   {
    "start": 11.8625,
    "end": 19.8125,
    "text": "关键观察，第一行定了，后面每一行都被逼出来，枚举量从二的三十次方降到二的六次方。"
   },
   {
    "start": 19.8125,
    "end": 28.3125,
    "text": "同类题可以试试画家问题，题号二八一三，思路一模一样，只是要求按的次数最少，还可能无解。"
   }
  ]
 }
]