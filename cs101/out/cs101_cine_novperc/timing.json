[
 {
  "id": "title",
  "wav": "audio/title-df2ce0156ef4.wav",
  "seconds": 13.2,
  "cues": [
   {
    "start": 0.1,
    "end": 3.175,
    "text": "月考第五题，渗透实验。"
   },
   {
    "start": 3.125,
    "end": 7.6875,
    "text": "格子一个一个打开，问第一行什么时候和最后一行连通。"
   },
   {
    "start": 7.6875,
    "end": 13.15,
    "text": "两件事：为什么用并查集，怎样把一整行变成一个点。"
   }
  ]
 },
 {
  "id": "problem",
  "wav": "audio/problem-d5d47d80c53a.wav",
  "seconds": 34.128,
  "cues": [
   {
    "start": 0.1,
    "end": 6.8625,
    "text": "题意：n 行 m 列的网格，格子总数不超过二十万，一开始全部封闭。"
   },
   {
    "start": 6.8125,
    "end": 8.9875,
    "text": "依次打开 q 个格子。"
   },
   {
    "start": 8.9875,
    "end": 15.625,
    "text": "只走打开的格子，上下左右相邻，能从第一行走到最后一行，就叫渗透。"
   },
   {
    "start": 15.625,
    "end": 20.9125,
    "text": "输出第一次渗透是第几次操作，始终不渗透输出负一。"
   },
   {
    "start": 20.9125,
    "end": 27.225,
    "text": "样例一，三乘三，打开第一列三格，第三次连成竖线，答案是三。"
   },
   {
    "start": 27.225,
    "end": 34.075,
    "text": "样例二，打开整个第一行，再开正中一格，还到不了第三行，答案是负一。"
   }
  ]
 },
 {
  "id": "naive",
  "wav": "audio/naive-139fa33bcae8.wav",
  "seconds": 20.76,
  "cues": [
   {
    "start": 0.1,
    "end": 5.65,
    "text": "最直接的想法：每开一格，就从第一行出发做一次 BFS。"
   },
   {
    "start": 5.6,
    "end": 8.9375,
    "text": "一次 BFS 最多走遍全部格子。"
   },
   {
    "start": 8.9375,
    "end": 15.9625,
    "text": "格子全部打开要二十万次，每次走二十万格，就是四百亿步，必然超时。"
   },
   {
    "start": 15.9625,
    "end": 20.7,
    "text": "可每次都从零开始，前面算过的连通关系全扔了。"
   }
  ]
 },
 {
  "id": "dsu",
  "wav": "audio/dsu-37fe1e917b69.wav",
  "seconds": 32.592,
  "cues": [
   {
    "start": 0.1,
    "end": 6.4125,
    "text": "格子只开不关，连通块只会合并，不会拆开，这正是并查集的场景。"
   },
   {
    "start": 6.3625,
    "end": 9.1,
    "text": "每块是一棵树，根当代表。"
   },
   {
    "start": 9.1,
    "end": 11.5875,
    "text": "find 顺着父指针找根。"
   },
   {
    "start": 11.5875,
    "end": 16.3875,
    "text": "讲义的写法边走边把父亲改成爷爷，叫路径减半。"
   },
   {
    "start": 16.3875,
    "end": 22.0125,
    "text": "看这条链：五指四，四指三，三指二，二指一。"
   },
   {
    "start": 22.0125,
    "end": 29.1625,
    "text": "从五查一次，五改挂到三，三改挂到一，五到根的距离从四步变成两步。"
   },
   {
    "start": 29.1625,
    "end": 32.5375,
    "text": "union 只要把一个根挂到另一个根下面。"
   }
  ]
 },
 {
  "id": "virtual",
  "wav": "audio/virtual-514b91f3b1c9.wav",
  "seconds": 26.496,
  "cues": [
   {
    "start": 0.1,
    "end": 4.925,
    "text": "难点在判定：第一行任意一格通到最后一行任意一格。"
   },
   {
    "start": 4.875,
    "end": 11.625,
    "text": "直接判，要拿两行打开的格子两两比根，一行 m 格，最坏比 m 的平方次。"
   },
   {
    "start": 11.625,
    "end": 17.3125,
    "text": "技巧是加两个虚拟结点：TOP 代表第一行，BOT 代表最后一行。"
   },
   {
    "start": 17.3125,
    "end": 21.85,
    "text": "第一行的格子一打开就并进 TOP，最后一行的并进 BOT。"
   },
   {
    "start": 21.85,
    "end": 26.425,
    "text": "渗透就等价于 TOP 和 BOT 同根，只比一次。"
   }
  ]
 },
 {
  "id": "walk",
  "wav": "audio/walk-9063648b125d.wav",
  "seconds": 34.68,
  "cues": [
   {
    "start": 0.1,
    "end": 2.7375,
    "text": "用一个四行五列的网格走一遍。"
   },
   {
    "start": 2.6875,
    "end": 10.5875,
    "text": "每开一格做三件事：在第一行就连 TOP，在最后一行就连 BOT，再和上下左右已打开的格子合并。"
   },
   {
    "start": 10.5875,
    "end": 16.5875,
    "text": "前五步，顶上长出蓝块，底下长出橙块，中间孤零零一个紫格。"
   },
   {
    "start": 16.5875,
    "end": 22.225,
    "text": "第六步打开的格子，下接紫格，左接蓝块，两块并成一块。"
   },
   {
    "start": 22.225,
    "end": 28.4125,
    "text": "第七步在第一行最右边，和蓝块并不相邻，却经过 TOP 进了同一块。"
   },
   {
    "start": 28.4125,
    "end": 34.625,
    "text": "第八步，下接橙块，左接蓝块，TOP 和 BOT 同根，答案是八。"
   }
  ]
 },
 {
  "id": "code",
  "wav": "audio/code-886bcf69d809.wav",
  "seconds": 22.128,
  "cues": [
   {
    "start": 0.1,
    "end": 1.9875,
    "text": "对照讲义代码。"
   },
   {
    "start": 1.9375,
    "end": 12.6625,
    "text": "格子 r 行 c 列从零数起，编号是 r 乘 m 加 c，占满零到 n m 减一，两个虚拟结点排在后面，所以 fa 开 n m 加二个。"
   },
   {
    "start": 12.6625,
    "end": 22.0625,
    "text": "主循环四段：标记打开；两个 if 连顶连底；四个方向合并打开的邻格；同根就记下 k 加一，跳出。"
   }
  ]
 },
 {
  "id": "pitfall",
  "wav": "audio/pitfall-14165bd49924.wav",
  "seconds": 19.032,
  "cues": [
   {
    "start": 0.1,
    "end": 2.125,
    "text": "注意那两个 if。"
   },
   {
    "start": 2.075,
    "end": 9.7,
    "text": "只有一行时，第一行就是最后一行，打开任何一格都该同时连上 TOP 和 BOT，答案是一。"
   },
   {
    "start": 9.7,
    "end": 15.5875,
    "text": "把第二个 if 改成 elif，再跑一遍：它只连了 TOP，输出负一。"
   },
   {
    "start": 15.5875,
    "end": 18.9625,
    "text": "讲义的两个 if 各自判断，不会漏。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-525f54f2a4ae.wav",
  "seconds": 17.64,
  "cues": [
   {
    "start": 0.1,
    "end": 1.3125,
    "text": "回顾。"
   },
   {
    "start": 1.2625,
    "end": 6.2875,
    "text": "只开不关，用并查集增量合并，不再每次从头 BFS。"
   },
   {
    "start": 6.2875,
    "end": 11.3125,
    "text": "整行对整行，加两个虚拟结点，渗透就是同根。"
   },
   {
    "start": 11.3125,
    "end": 14.675,
    "text": "坐标按 r 乘 m 加 c 编号。"
   },
   {
    "start": 14.675,
    "end": 17.575,
    "text": "n 等于一，一定要测。"
   }
  ]
 }
]