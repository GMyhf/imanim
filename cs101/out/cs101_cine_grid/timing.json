[
 {
  "id": "title",
  "wav": "audio/title-ea806f218de9.wav",
  "seconds": 17.04,
  "cues": [
   {
    "start": 0.1,
    "end": 6.175,
    "text": "两道题长得几乎一样：在网格上从左上走到右下，让路过的数加起来最小。"
   },
   {
    "start": 6.125,
    "end": 10.8125,
    "text": "一道只许往右、往下走，另一道四个方向都能走。"
   },
   {
    "start": 10.8125,
    "end": 15.0,
    "text": "前一道用动态规划，后一道却要用搜索。"
   },
   {
    "start": 15.0,
    "end": 16.975,
    "text": "分界线在哪？"
   }
  ]
 },
 {
  "id": "table",
  "wav": "audio/table-78467e4f2656.wav",
  "seconds": 22.584,
  "cues": [
   {
    "start": 0.1,
    "end": 2.575,
    "text": "讲义里有一张判断表。"
   },
   {
    "start": 2.525,
    "end": 9.3125,
    "text": "只能向右、向下，用动态规划；四个方向都能走，用广搜或 Dijkstra。"
   },
   {
    "start": 9.3125,
    "end": 19.3625,
    "text": "求方案数、最大路径和，移动方向单调，用动态规划；求最短步数、最少代价，方向任意，用搜索。"
   },
   {
    "start": 19.3625,
    "end": 22.5125,
    "text": "判据只有一条：有没有环。"
   }
  ]
 },
 {
  "id": "dp",
  "wav": "audio/dp-1bcdbf512828.wav",
  "seconds": 23.688,
  "cues": [
   {
    "start": 0.1,
    "end": 5.2375,
    "text": "先看讲义的例子，三乘三的网格，只能右、下走。"
   },
   {
    "start": 5.1875,
    "end": 8.5375,
    "text": "dp 表示走到这一格的最小路径和。"
   },
   {
    "start": 8.5375,
    "end": 13.4125,
    "text": "第一行只能从左边来，第一列只能从上面来，先累加。"
   },
   {
    "start": 13.4125,
    "end": 18.05,
    "text": "其余格子取上面和左边较小的那个，再加上自己。"
   },
   {
    "start": 18.05,
    "end": 23.6375,
    "text": "填到右下角，答案是七：一、三、一、一、一。"
   }
  ]
 },
 {
  "id": "order",
  "wav": "audio/order-9bf295c147d4.wav",
  "seconds": 22.008,
  "cues": [
   {
    "start": 0.1,
    "end": 8.1875,
    "text": "把依赖画成箭头：每个格子只依赖上面和左边，所有箭头都朝右或朝下，没有一条往回指。"
   },
   {
    "start": 8.1375,
    "end": 15.2125,
    "text": "按行从上到下、每行从左到右去填，轮到谁，它要的格子一定已经算好。"
   },
   {
    "start": 15.2125,
    "end": 18.15,
    "text": "这样的计算顺序叫拓扑序。"
   },
   {
    "start": 18.15,
    "end": 21.95,
    "text": "动态规划能成立，靠的就是它。"
   }
  ]
 },
 {
  "id": "four",
  "wav": "audio/four-d8180565ccc9.wav",
  "seconds": 22.968,
  "cues": [
   {
    "start": 0.1,
    "end": 6.525,
    "text": "换一张四行五列的网格：九是高地，一是平路，现在四个方向都能走。"
   },
   {
    "start": 6.475,
    "end": 13.9625,
    "text": "把转移照搬过来：取上下左右四个邻居里最小的，再加上自己，仍然按行填。"
   },
   {
    "start": 13.9625,
    "end": 17.0125,
    "text": "还没算到的格子，当成无穷大。"
   },
   {
    "start": 17.0125,
    "end": 22.9125,
    "text": "填完，右下角是十六，和只许右、下走的答案一模一样。"
   }
  ]
 },
 {
  "id": "cycle",
  "wav": "audio/cycle-6eafa472b656.wav",
  "seconds": 25.752,
  "cues": [
   {
    "start": 0.1,
    "end": 1.925,
    "text": "问题出在这一格。"
   },
   {
    "start": 1.875,
    "end": 9.3,
    "text": "算它的时候，下面那一格还没算，是无穷大，只好从上面或左边来，得到十三。"
   },
   {
    "start": 9.3,
    "end": 14.9875,
    "text": "可下面那一格反过来也要用它：两格互相等对方，依赖成环。"
   },
   {
    "start": 14.9875,
    "end": 19.5375,
    "text": "不管按什么顺序填，总有一格要用到还没算好的值。"
   },
   {
    "start": 19.5375,
    "end": 25.6875,
    "text": "而最好的路恰恰从下面绕上来：走到下面是六，往上一步只要七。"
   }
  ]
 },
 {
  "id": "dijkstra",
  "wav": "audio/dijkstra-cff6642517cb.wav",
  "seconds": 33.312,
  "cues": [
   {
    "start": 0.1,
    "end": 3.0375,
    "text": "同一张图，换成 Dijkstra。"
   },
   {
    "start": 2.9875,
    "end": 8.0625,
    "text": "每次从堆里取出路径和最小的格子，再更新它的四个邻居。"
   },
   {
    "start": 8.0625,
    "end": 19.5625,
    "text": "一、二、三、四，沿左边一列下来；五、六，拐进底行；七，在第三列往上一步；八、九，再往右。"
   },
   {
    "start": 19.5625,
    "end": 24.6625,
    "text": "最后右下角出堆，答案是十，比照搬的动态规划少了六。"
   },
   {
    "start": 24.6625,
    "end": 33.2625,
    "text": "每个格子出堆时，它所依赖的那一格早已出堆：Dijkstra 是按距离从小到大，现场造出了一个拓扑序。"
   }
  ]
 },
 {
  "id": "count",
  "wav": "audio/count-400a890d53f5.wav",
  "seconds": 29.952,
  "cues": [
   {
    "start": 0.1,
    "end": 3.325,
    "text": "方案数也是动态规划的典型。"
   },
   {
    "start": 3.275,
    "end": 10.0125,
    "text": "只能右、下走，到一个格子的走法，等于从上面来的加上从左边来的。"
   },
   {
    "start": 10.0125,
    "end": 15.7375,
    "text": "第一行、第一列都是一，四行五列的网格，右下角是三十五。"
   },
   {
    "start": 15.7375,
    "end": 20.4875,
    "text": "换成四个方向，可以来回兜圈，方案数是无穷大。"
   },
   {
    "start": 20.4875,
    "end": 29.8875,
    "text": "就算规定不许重复经过同一格，也有九百七十六条，而且状态里得记住走过哪些格，只能回溯一条条去数。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-ccb095053b59.wav",
  "seconds": 14.544,
  "cues": [
   {
    "start": 0.1,
    "end": 3.1,
    "text": "先问一句：能不能走回头路？"
   },
   {
    "start": 3.05,
    "end": 8.425,
    "text": "走不回去，就有拓扑序，按顺序填表，用动态规划。"
   },
   {
    "start": 8.425,
    "end": 14.475,
    "text": "走得回去，依赖成环，要最短，就交给广搜或 Dijkstra。"
   }
  ]
 }
]