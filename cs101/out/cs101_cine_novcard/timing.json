[
 {
  "id": "title",
  "wav": "audio/title-3f95ccdaf086.wav",
  "seconds": 16.488,
  "cues": [
   {
    "start": 0.1,
    "end": 1.575,
    "text": "牌堆魔术。"
   },
   {
    "start": 1.525,
    "end": 7.975,
    "text": "魔术师手里一摞牌，一张一张翻开，正好是一、二、三、四。"
   },
   {
    "start": 7.975,
    "end": 10.4625,
    "text": "开头这摞牌该怎么叠？"
   },
   {
    "start": 10.4625,
    "end": 16.425,
    "text": "已知结果求开头，有一个通用办法：倒着做，把每一步撤销。"
   }
  ]
 },
 {
  "id": "rule",
  "wav": "audio/rule-d4e24e2bc5ce.wav",
  "seconds": 28.488,
  "cues": [
   {
    "start": 0.1,
    "end": 1.6,
    "text": "先看题意。"
   },
   {
    "start": 1.55,
    "end": 7.6625,
    "text": "n 张牌叠成一摞，重复 n 轮：先把顶牌移到底，再翻开顶牌拿走。"
   },
   {
    "start": 7.6625,
    "end": 10.775,
    "text": "要求翻出的顺序恰好是一到 n。"
   },
   {
    "start": 10.775,
    "end": 14.8625,
    "text": "样例一，n 等于四，答案是四一三二。"
   },
   {
    "start": 14.8625,
    "end": 16.525,
    "text": "正着表演一遍。"
   },
   {
    "start": 16.525,
    "end": 19.025,
    "text": "四移到底，翻开一。"
   },
   {
    "start": 19.025,
    "end": 21.4875,
    "text": "三移到底，翻开二。"
   },
   {
    "start": 21.4875,
    "end": 24.0,
    "text": "四移到底，翻开三。"
   },
   {
    "start": 24.0,
    "end": 28.4375,
    "text": "只剩一张四，移到底还是它，翻开四。"
   }
  ]
 },
 {
  "id": "undo",
  "wav": "audio/undo-0a08cd34fde2.wav",
  "seconds": 29.616,
  "cues": [
   {
    "start": 0.1,
    "end": 3.6125,
    "text": "现在反过来，从最后一轮往前撤销。"
   },
   {
    "start": 3.5625,
    "end": 8.7,
    "text": "每轮做了两件事，撤销时顺序要反过来，后做的先撤。"
   },
   {
    "start": 8.7,
    "end": 12.7,
    "text": "就像先穿袜子再穿鞋，脱的时候先脱鞋。"
   },
   {
    "start": 12.7,
    "end": 17.9375,
    "text": "翻开是从牌顶拿走一张，撤销它，就把这张牌放回牌顶。"
   },
   {
    "start": 17.9375,
    "end": 23.2625,
    "text": "移到底是顶牌跑到最下面，撤销它，就把底牌拿回牌顶。"
   },
   {
    "start": 23.2625,
    "end": 29.55,
    "text": "从空牌堆开始，i 从 n 倒数到一，每轮先放牌，再移底牌。"
   }
  ]
 },
 {
  "id": "sample2",
  "wav": "audio/sample2-90512d3b4106.wav",
  "seconds": 28.728,
  "cues": [
   {
    "start": 0.1,
    "end": 3.55,
    "text": "用样例二完整走一遍，n 等于五。"
   },
   {
    "start": 3.5,
    "end": 9.7875,
    "text": "放五，牌堆只有一张，底牌就是顶牌，移回去不变，所以不用特判。"
   },
   {
    "start": 9.7875,
    "end": 14.6625,
    "text": "放四，得到四五，底牌五回到顶，变成五四。"
   },
   {
    "start": 14.6625,
    "end": 18.325,
    "text": "放三，三五四，变成四三五。"
   },
   {
    "start": 18.325,
    "end": 22.225,
    "text": "放二，二四三五，变成五二四三。"
   },
   {
    "start": 22.225,
    "end": 26.3375,
    "text": "放一，一五二四三，变成三一五二四。"
   },
   {
    "start": 26.3375,
    "end": 28.675,
    "text": "和样例输出一致。"
   }
  ]
 },
 {
  "id": "pos",
  "wav": "audio/pos-0266a61e66e6.wav",
  "seconds": 29.616,
  "cues": [
   {
    "start": 0.1,
    "end": 3.925,
    "text": "还有一种思路，不倒推，正着模拟位置。"
   },
   {
    "start": 3.875,
    "end": 10.6625,
    "text": "移牌和翻牌只看位置，不看牌面是几，所以先追踪位置，最后再填牌。"
   },
   {
    "start": 10.6625,
    "end": 16.3125,
    "text": "把零到四号位置排成队列，先把队首移到队尾，再弹出队首。"
   },
   {
    "start": 16.3125,
    "end": 19.35,
    "text": "第一次弹出一号位，填牌一。"
   },
   {
    "start": 19.35,
    "end": 22.25,
    "text": "接着弹出三号位，填二。"
   },
   {
    "start": 22.25,
    "end": 26.6125,
    "text": "然后零号位填三，四号位填四，二号位填五。"
   },
   {
    "start": 26.6125,
    "end": 29.55,
    "text": "拼起来还是三一五二四。"
   }
  ]
 },
 {
  "id": "code",
  "wav": "audio/code-34ed34cd04ab.wav",
  "seconds": 18.912,
  "cues": [
   {
    "start": 0.1,
    "end": 1.9875,
    "text": "对照讲义代码。"
   },
   {
    "start": 1.9375,
    "end": 4.275,
    "text": "循环从 n 倒数到一。"
   },
   {
    "start": 4.275,
    "end": 8.025,
    "text": "第一行在左端加入牌 i，就是放回牌顶。"
   },
   {
    "start": 8.025,
    "end": 13.6125,
    "text": "第二行从右端弹出底牌，再从左端加入，就是底牌回到牌顶。"
   },
   {
    "start": 13.6125,
    "end": 18.8625,
    "text": "最后把整个双端队列打印出来，就是从上到下的初始顺序。"
   }
  ]
 },
 {
  "id": "bug",
  "wav": "audio/bug-16f86b3470ca.wav",
  "seconds": 26.592,
  "cues": [
   {
    "start": 0.1,
    "end": 5.325,
    "text": "典型错误：两步撤销写反了，先移底牌，再放回牌 i。"
   },
   {
    "start": 5.275,
    "end": 9.625,
    "text": "第一轮牌堆是空的，从右端弹出直接报错。"
   },
   {
    "start": 9.625,
    "end": 14.5,
    "text": "加个判空，程序能跑了，n 等于四却输出一三二四。"
   },
   {
    "start": 14.5,
    "end": 18.7375,
    "text": "正着验一遍，翻出来是三四二一，不对。"
   },
   {
    "start": 18.7375,
    "end": 26.5375,
    "text": "牌 i 本该排在第二张，等第一张移到底，正好被翻开；写反了，它排到了第一张。"
   }
  ]
 },
 {
  "id": "cost",
  "wav": "audio/cost-c043696532ea.wav",
  "seconds": 22.848,
  "cues": [
   {
    "start": 0.1,
    "end": 1.6375,
    "text": "再看复杂度。"
   },
   {
    "start": 1.5875,
    "end": 6.5875,
    "text": "两端都要进出，双端队列两端操作都是常数时间。"
   },
   {
    "start": 6.5875,
    "end": 13.8375,
    "text": "换成列表，往开头插入要把后面的元素全部挪一位，列表越长挪得越多。"
   },
   {
    "start": 13.8375,
    "end": 22.7875,
    "text": "n 是二十万时，双端队列一共六十万次操作；列表光挪元素就要大约四百亿次，必然超时。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-9edc81631ee4.wav",
  "seconds": 17.712,
  "cues": [
   {
    "start": 0.1,
    "end": 1.3125,
    "text": "回顾。"
   },
   {
    "start": 1.2625,
    "end": 5.475,
    "text": "已知结果求开头，就倒着撤销，后做的先撤。"
   },
   {
    "start": 5.475,
    "end": 10.0125,
    "text": "每一轮的撤销是：牌放回牌顶，底牌移回牌顶。"
   },
   {
    "start": 10.0125,
    "end": 13.9625,
    "text": "两端进出用双端队列，整体线性。"
   },
   {
    "start": 13.9625,
    "end": 17.6625,
    "text": "写完别忘了正着模拟一遍，验算答案。"
   }
  ]
 }
]