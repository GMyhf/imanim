[
 {
  "id": "title",
  "wav": "audio/title-5c06ad97ace7.wav",
  "seconds": 20.784,
  "cues": [
   {
    "start": 0.1,
    "end": 5.925,
    "text": "七个数：一、七、三、五、九、四、八。"
   },
   {
    "start": 5.875,
    "end": 11.7125,
    "text": "挑出其中一些，保持原来的顺序，并且越来越大，最多能挑几个？"
   },
   {
    "start": 11.7125,
    "end": 16.4125,
    "text": "答案是四个，比如一、三、五、九。"
   },
   {
    "start": 16.4125,
    "end": 20.725,
    "text": "这就是最长上升子序列，它有两种写法。"
   }
  ]
 },
 {
  "id": "state",
  "wav": "audio/state-6352b6f8bee0.wav",
  "seconds": 17.112,
  "cues": [
   {
    "start": 0.1,
    "end": 5.925,
    "text": "第一种，dp i 表示以第 i 个数结尾的最长上升子序列长度。"
   },
   {
    "start": 5.875,
    "end": 10.7625,
    "text": "每个数自己就是一个序列，所以初值全是一。"
   },
   {
    "start": 10.7625,
    "end": 17.05,
    "text": "转移时往前看，所有比它小的数里，接在 dp 最大的那个后面，再加一。"
   }
  ]
 },
 {
  "id": "fill",
  "wav": "audio/fill-763d421e49b4.wav",
  "seconds": 26.328,
  "cues": [
   {
    "start": 0.1,
    "end": 1.975,
    "text": "从左往右填。"
   },
   {
    "start": 1.925,
    "end": 4.5125,
    "text": "一前面没有数，是一。"
   },
   {
    "start": 4.5125,
    "end": 7.05,
    "text": "七接在一后面，是二。"
   },
   {
    "start": 7.05,
    "end": 10.075,
    "text": "三也只能接在一后面，是二。"
   },
   {
    "start": 10.075,
    "end": 12.7625,
    "text": "五接在三后面，是三。"
   },
   {
    "start": 12.7625,
    "end": 17.05,
    "text": "九前面的数都比它小，接在五后面，是四。"
   },
   {
    "start": 17.05,
    "end": 19.825,
    "text": "四接在三后面，是三。"
   },
   {
    "start": 19.825,
    "end": 22.375,
    "text": "八接在五后面，又是四。"
   },
   {
    "start": 22.375,
    "end": 26.2625,
    "text": "答案是整个数组的最大值：四。"
   }
  ]
 },
 {
  "id": "cost",
  "wav": "audio/cost-2b24b4429f6f.wav",
  "seconds": 19.344,
  "cues": [
   {
    "start": 0.1,
    "end": 3.7125,
    "text": "两层循环，复杂度是 n 的平方。"
   },
   {
    "start": 3.6625,
    "end": 7.2375,
    "text": "n 到十万，要比较将近五十亿次。"
   },
   {
    "start": 7.2375,
    "end": 16.2,
    "text": "换个问法：不再问以谁结尾，而是问长度为一、为二、为三的上升子序列，结尾最小能是多少？"
   },
   {
    "start": 16.2,
    "end": 19.275,
    "text": "结尾越小，后面越容易接上。"
   }
  ]
 },
 {
  "id": "piles",
  "wav": "audio/piles-1c1b772aa8f9.wav",
  "seconds": 31.032,
  "cues": [
   {
    "start": 0.1,
    "end": 3.4375,
    "text": "把这些最小结尾画成几摞牌。"
   },
   {
    "start": 3.3875,
    "end": 10.1125,
    "text": "第一摞的牌顶，是长度为一的最小结尾；第二摞的牌顶，是长度为二的最小结尾。"
   },
   {
    "start": 10.1125,
    "end": 17.6,
    "text": "规则只有一条：新数放到第一个牌顶不小于它的那一摞；牌顶都比它小，就新开一摞。"
   },
   {
    "start": 17.6,
    "end": 19.2125,
    "text": "一开第一摞。"
   },
   {
    "start": 19.2125,
    "end": 20.85,
    "text": "七新开一摞。"
   },
   {
    "start": 20.85,
    "end": 22.525,
    "text": "三压在七上。"
   },
   {
    "start": 22.525,
    "end": 25.5625,
    "text": "五开第三摞，九开第四摞。"
   },
   {
    "start": 25.5625,
    "end": 28.3,
    "text": "四压在五上，八压在九上。"
   },
   {
    "start": 28.3,
    "end": 30.9625,
    "text": "一共四摞，答案是四。"
   }
  ]
 },
 {
  "id": "bisect",
  "wav": "audio/bisect-0cb81a1cb0e7.wav",
  "seconds": 17.472,
  "cues": [
   {
    "start": 0.1,
    "end": 7.0,
    "text": "牌顶从左到右总是递增的，所以找那一摞可以二分，正好是 bisect_left。"
   },
   {
    "start": 6.95,
    "end": 13.6875,
    "text": "位置等于长度，就追加；否则把那个位置换成更小的值，给后面留空间。"
   },
   {
    "start": 13.6875,
    "end": 17.4125,
    "text": "每个数二分一次，总共是 n log n。"
   }
  ]
 },
 {
  "id": "trap",
  "wav": "audio/trap-901a6e37ea6d.wav",
  "seconds": 24.888,
  "cues": [
   {
    "start": 0.1,
    "end": 3.85,
    "text": "常见的错误，是把 tails 当成答案输出。"
   },
   {
    "start": 3.8,
    "end": 10.7875,
    "text": "回到处理完四的那一刻：牌顶是一、三、四、九，长度四没错。"
   },
   {
    "start": 10.7875,
    "end": 15.925,
    "text": "可四在原数组里排在九的后面，这根本不是上升子序列。"
   },
   {
    "start": 15.925,
    "end": 19.6125,
    "text": "真正的是一、三、五、九。"
   },
   {
    "start": 19.6125,
    "end": 24.825,
    "text": "要输出序列，回到 dp 数组，从最大值往前倒着找。"
   }
  ]
 },
 {
  "id": "strict",
  "wav": "audio/strict-9b35ff17d6c0.wav",
  "seconds": 17.736,
  "cues": [
   {
    "start": 0.1,
    "end": 6.3125,
    "text": "严格上升用 bisect_left，相等的数落在同一摞，互相替换。"
   },
   {
    "start": 6.2625,
    "end": 12.35,
    "text": "允许相等的非降序列，用 bisect_right，相等的数会新开一摞。"
   },
   {
    "start": 12.35,
    "end": 17.675,
    "text": "三个二，严格上升长度是一，非降长度是三。"
   }
  ]
 },
 {
  "id": "homework",
  "wav": "audio/homework-0813ee1105f8.wav",
  "seconds": 23.136,
  "cues": [
   {
    "start": 0.1,
    "end": 2.425,
    "text": "作业里有两个变形。"
   },
   {
    "start": 2.375,
    "end": 10.0125,
    "text": "拦截导弹求最长不上升子序列：把数组反过来，就变成最长不降，用 bisect_right。"
   },
   {
    "start": 10.0125,
    "end": 13.15,
    "text": "样例八枚导弹，最多拦下六枚。"
   },
   {
    "start": 13.15,
    "end": 23.0875,
    "text": "最大上升子序列和，在 n 平方写法里把加一换成加上这个数，开头那七个数的答案是十八，等于一加三加五加九。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-7bf01b2f9011.wav",
  "seconds": 10.488,
  "cues": [
   {
    "start": 0.1,
    "end": 2.65,
    "text": "两种写法，两个问题。"
   },
   {
    "start": 2.6,
    "end": 7.175,
    "text": "dp 问以谁结尾，tails 问每个长度最小的结尾。"
   },
   {
    "start": 7.175,
    "end": 10.4375,
    "text": "tails 的长度是答案，它本身不是。"
   }
  ]
 }
]