[
 {
  "id": "title",
  "wav": "audio/title-82687c51411a.wav",
  "seconds": 11.808,
  "cues": [
   {
    "start": 0.1,
    "end": 3.5,
    "text": "上一支讲了零一背包和完全背包。"
   },
   {
    "start": 3.45,
    "end": 8.9125,
    "text": "这一支看三个变形：数量有限，必须装满，费用两种。"
   },
   {
    "start": 8.9125,
    "end": 11.75,
    "text": "最后看能切开的背包。"
   }
  ]
 },
 {
  "id": "split",
  "wav": "audio/split-a742d219d09d.wav",
  "seconds": 26.616,
  "cues": [
   {
    "start": 0.1,
    "end": 5.8375,
    "text": "第一个变形，多重背包：每种物品有限定的个数，比如十三个。"
   },
   {
    "start": 5.7875,
    "end": 9.55,
    "text": "朴素做法拆成十三件单品，太慢。"
   },
   {
    "start": 9.55,
    "end": 15.4125,
    "text": "二进制拆分按一、二、四翻倍打包，剩下的单独成一捆。"
   },
   {
    "start": 15.4125,
    "end": 20.5,
    "text": "十三拆成一、二、四、六，四捆就够。"
   },
   {
    "start": 20.5,
    "end": 26.5625,
    "text": "五拆成一、二、二，十拆成一、二、四、三。"
   }
  ]
 },
 {
  "id": "why",
  "wav": "audio/why-8c3bf2374a5e.wav",
  "seconds": 24.384,
  "cues": [
   {
    "start": 0.1,
    "end": 3.4375,
    "text": "为什么四捆能凑出零到十三的每个数？"
   },
   {
    "start": 3.3875,
    "end": 6.875,
    "text": "每捆只有拿和不拿，像二进制的一位。"
   },
   {
    "start": 6.875,
    "end": 15.05,
    "text": "先加上一，能凑出零到一；加上二，零到三；加上四，零到七，范围每次翻倍。"
   },
   {
    "start": 15.05,
    "end": 20.55,
    "text": "最后一捆六，把零到七右移六格，得到六到十三，正好接上。"
   },
   {
    "start": 20.55,
    "end": 24.3125,
    "text": "余数不超过前面总和加一，不会断档。"
   }
  ]
 },
 {
  "id": "exact",
  "wav": "audio/exact-9572f165f317.wav",
  "seconds": 28.944,
  "cues": [
   {
    "start": 0.1,
    "end": 2.475,
    "text": "第二个变形，恰好装满。"
   },
   {
    "start": 2.425,
    "end": 8.475,
    "text": "同一组数据跑两遍：体积二价值十，体积四价值二十，容量五。"
   },
   {
    "start": 8.475,
    "end": 11.0125,
    "text": "代码一样，只差初值。"
   },
   {
    "start": 11.0125,
    "end": 17.7625,
    "text": "不超过型全填零；恰好型只有容量零是零，其余负无穷，表示到不了。"
   },
   {
    "start": 17.7625,
    "end": 23.275,
    "text": "两件放完，不超过型的容量五是二十，其实只装了四。"
   },
   {
    "start": 23.275,
    "end": 28.875,
    "text": "恰好型的容量五仍是负无穷，凑不出五，输出负一。"
   }
  ]
 },
 {
  "id": "trap",
  "wav": "audio/trap-81aeca894b1e.wav",
  "seconds": 12.408,
  "cues": [
   {
    "start": 0.1,
    "end": 6.075,
    "text": "忘了改初值，恰好型就退化成不超过型，答案偏大还不报错。"
   },
   {
    "start": 6.025,
    "end": 12.3375,
    "text": "要恰好装满的最小代价，比如 NBA 门票，初值换成正无穷。"
   }
  ]
 },
 {
  "id": "coins",
  "wav": "audio/coins-5786a565db27.wav",
  "seconds": 21.408,
  "cues": [
   {
    "start": 0.1,
    "end": 8.225,
    "text": "作业 Coins 把前两个变形合在一起：几种硬币各有几枚，问一到十里有多少个金额能凑出。"
   },
   {
    "start": 8.175,
    "end": 11.7125,
    "text": "面值一的有两枚，二和四各一枚。"
   },
   {
    "start": 11.7125,
    "end": 17.0625,
    "text": "拆成一、一、二、四四捆，表里只记能不能到。"
   },
   {
    "start": 17.0625,
    "end": 21.3375,
    "text": "零到八都能到，九和十不行，答案是八。"
   }
  ]
 },
 {
  "id": "twodim",
  "wav": "audio/twodim-958bb6b4b86c.wav",
  "seconds": 27.432,
  "cues": [
   {
    "start": 0.1,
    "end": 2.7875,
    "text": "第三个变形，二维费用。"
   },
   {
    "start": 2.7375,
    "end": 9.85,
    "text": "宠物小精灵之收服：收服一只，既花精灵球又花体力，两样都有上限。"
   },
   {
    "start": 9.85,
    "end": 15.925,
    "text": "状态多一维：一维是球数，一维是体力，格子存最多收服几只。"
   },
   {
    "start": 15.925,
    "end": 20.5125,
    "text": "两层都倒序，两个费用一起往回退，再加一。"
   },
   {
    "start": 20.5125,
    "end": 27.3625,
    "text": "十个球、一百点体力，最多收服三只，最省的还剩三十点体力。"
   }
  ]
 },
 {
  "id": "frac",
  "wav": "audio/frac-51f0362466f1.wav",
  "seconds": 24.0,
  "cues": [
   {
    "start": 0.1,
    "end": 5.0,
    "text": "最后是分数背包，比如圣诞老人的礼物：物品能切开。"
   },
   {
    "start": 4.95,
    "end": 8.6625,
    "text": "这时按单价从高到低贪心就是最优。"
   },
   {
    "start": 8.6625,
    "end": 16.175,
    "text": "容量十，重六价值三十，单价五；还有两件重五价值二十，单价四。"
   },
   {
    "start": 16.175,
    "end": 23.9375,
    "text": "先整件装单价五的，剩四，再从下一件切下五分之四，得十六，一共四十六。"
   }
  ]
 },
 {
  "id": "greedy",
  "wav": "audio/greedy-5f02c5213b1d.wav",
  "seconds": 21.48,
  "cues": [
   {
    "start": 0.1,
    "end": 2.9,
    "text": "不能切，还按单价贪心呢？"
   },
   {
    "start": 2.85,
    "end": 7.825,
    "text": "先装单价五的，剩下四装不下任何一件，只得三十。"
   },
   {
    "start": 7.825,
    "end": 11.625,
    "text": "可两件重五的正好装满，得四十。"
   },
   {
    "start": 11.625,
    "end": 17.1375,
    "text": "能切时，空隙能用碎片补满；不能切，空间就浪费了。"
   },
   {
    "start": 17.1375,
    "end": 21.4125,
    "text": "所以可分割就贪心，不可分割就做背包。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-e621fea9f9c8.wav",
  "seconds": 12.72,
  "cues": [
   {
