[
 {
  "id": "title",
  "wav": "audio/title-93322f05ad43.wav",
  "seconds": 15.504,
  "cues": [
   {
    "start": 0.1,
    "end": 4.2625,
    "text": "一道题，n 最大到十万，时限一秒。"
   },
   {
    "start": 4.2125,
    "end": 7.625,
    "text": "你想到了两重循环，能过吗？"
   },
   {
    "start": 7.625,
    "end": 15.45,
    "text": "不用提交也能判断：数出它要做多少次基本操作，再和机器每秒能做的次数比一比。"
   }
  ]
 },
 {
  "id": "count",
  "wav": "audio/count-a6e17fd93929.wav",
  "seconds": 29.568,
  "cues": [
   {
    "start": 0.1,
    "end": 2.15,
    "text": "先数两重循环。"
   },
   {
    "start": 2.1,
    "end": 7.3125,
    "text": "外层 i 从零走到 n 减一，内层 j 从 i 走到 n 减一。"
   },
   {
    "start": 7.3125,
    "end": 17.2125,
    "text": "n 等于六时，第一行六次，下一行五次，一直到最后一行一次，一共二十一次，也就是 n 乘 n 加一再除以二。"
   },
   {
    "start": 17.2125,
    "end": 21.275,
    "text": "只占正方形的一半多，仍然是 n 平方级。"
   },
   {
    "start": 21.275,
    "end": 29.5125,
    "text": "大 O 只看增长的量级，忽略常数和低阶项：三 n 平方加一百 n 加五百，也记作 n 平方。"
   }
  ]
 },
 {
  "id": "levels",
  "wav": "audio/levels-5bb741400879.wav",
  "seconds": 19.968,
  "cues": [
   {
    "start": 0.1,
    "end": 3.975,
    "text": "把常见的级别摆在一起，取 n 等于一百万。"
   },
   {
    "start": 3.925,
    "end": 13.1875,
    "text": "log n 大约二十；n 是一百万；n log n 约两千万；n 平方是一万亿；二的 n 次方是天文数字。"
   },
   {
    "start": 13.1875,
    "end": 19.9125,
    "text": "横轴每一格是十倍，n 平方比 n 高出整整六格，也就是一百万倍。"
   }
  ]
 },
 {
  "id": "budget",
  "wav": "audio/budget-5f1ac50ea941.wav",
  "seconds": 31.968,
  "cues": [
   {
    "start": 0.1,
    "end": 4.075,
    "text": "评测机每秒大约做一千万到一亿次基本操作。"
   },
   {
    "start": 4.025,
    "end": 6.9125,
    "text": "所以看到 n，就能倒推复杂度。"
   },
   {
    "start": 6.9125,
    "end": 19.4,
    "text": "n 不超过十，可以全排列；二十，枚举子集；一百，n 的立方；一千，n 平方；十万，n log n；一百万，只能线性。"
   },
   {
    "start": 19.4,
    "end": 25.8125,
    "text": "把每行的 n 代进去，次数都在一百万到四百万之间，给常数留足了余量。"
   },
   {
    "start": 25.8125,
    "end": 31.9125,
    "text": "回到开头，n 等于十万，两重循环要五十亿次，必然超时。"
   }
  ]
 },
 {
  "id": "space",
  "wav": "audio/space-014649ef2bbd.wav",
  "seconds": 19.584,
  "cues": [
   {
    "start": 0.1,
    "end": 1.775,
    "text": "空间也这样估。"
   },
   {
    "start": 1.725,
    "end": 9.0625,
    "text": "列表里一个整数，约占八字节指针加二十八字节对象，一百万个就是三十多兆。"
   },
   {
    "start": 9.0625,
    "end": 12.625,
    "text": "内存限制常见六十四到二百五十六兆。"
   },
   {
    "start": 12.625,
    "end": 19.525,
    "text": "一万乘一万的二维表有一亿个格子，光指针就要八百兆，必然超内存。"
   }
  ]
 },
 {
  "id": "hidden",
  "wav": "audio/hidden-c7cb58ada6a3.wav",
  "seconds": 28.152,
  "cues": [
   {
    "start": 0.1,
    "end": 3.5375,
    "text": "最容易漏的，是藏在一行里的复杂度。"
   },
   {
    "start": 3.4875,
    "end": 11.025,
    "text": "循环里写 x in lst，list 要从头一个个比，这一行就是 n，整个循环变成 n 平方。"
   },
   {
    "start": 11.025,
    "end": 14.825,
    "text": "set 靠哈希直接算出位置，一次是常数。"
   },
   {
    "start": 14.825,
    "end": 18.8,
    "text": "讲义的实验：二十万个数，查两百次。"
   },
   {
    "start": 18.8,
    "end": 23.475,
    "text": "list 共比较约两千万次，set 只查两百次。"
   },
   {
    "start": 23.475,
    "end": 28.1,
    "text": "实测零点六秒对万分之一秒，差了三个数量级。"
   }
  ]
 },
 {
  "id": "sieve",
  "wav": "audio/sieve-cdc85529f086.wav",
  "seconds": 28.776,
  "cues": [
   {
    "start": 0.1,
    "end": 3.3875,
    "text": "再看一个例子：找出一百以内的素数。"
   },
   {
    "start": 3.3375,
    "end": 8.675,
    "text": "朴素做法是试除，每个数用二到它的平方根逐个去除。"
   },
   {
    "start": 8.675,
    "end": 19.1,
    "text": "埃氏筛反过来：二留下，划掉二的倍数；三留下，划掉三的倍数；四已被划掉，跳过；然后是五和七。"
   },
   {
    "start": 19.1,
    "end": 24.9375,
    "text": "每次从 i 的平方开始划，更小的倍数早被更小的因子划过了。"
   },
   {
    "start": 24.9375,
    "end": 28.7125,
    "text": "剩下的二十五个，就是一百以内的素数。"
   }
  ]
 },
 {
  "id": "versus",
  "wav": "audio/versus-8c2ee360caf5.wav",
  "seconds": 22.272,
  "cues": [
   {
    "start": 0.1,
    "end": 1.775,
    "text": "数一数次数。"
   },
   {
    "start": 1.725,
    "end": 7.4375,
    "text": "一百以内，试除做了二百三十六次除法，筛法只划了一百零四次。"
   },
   {
    "start": 7.4375,
    "end": 14.6125,
    "text": "到一百万，试除要六千七百多万次，筛法约二百一十二万次，差了三十多倍。"
   },
   {
    "start": 14.6125,
    "end": 22.2125,
    "text": "筛法是 n log log n，几乎线性；筛完以后，判断任何一个数都只是查表。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-b60c5f73ff43.wav",
  "seconds": 9.768,
  "cues": [
   {
    "start": 0.1,
    "end": 6.2375,
    "text": "考场上的顺序：先看数据范围，定下复杂度的上限，再去想算法。"
   },
   {
