[
 {
  "id": "title",
  "wav": "audio/title-62e967cc51dd.wav",
  "seconds": 13.8,
  "cues": [
   {
    "start": 0.1,
    "end": 1.725,
    "text": "例题精讲。"
   },
   {
    "start": 1.675,
    "end": 7.8,
    "text": "这道是去年十一月模拟机考的真题，题号二八九零六，数的划分。"
   },
   {
    "start": 7.8,
    "end": 13.7375,
    "text": "同一道题，我们用深搜和动态规划各做一遍，再让两种写法对拍。"
   }
  ]
 },
 {
  "id": "read",
  "wav": "audio/read-c3040a365a20.wav",
  "seconds": 21.168,
  "cues": [
   {
    "start": 0.1,
    "end": 4.7125,
    "text": "把整数 n 分成 k 份，每份不能为空，不考虑顺序。"
   },
   {
    "start": 4.6625,
    "end": 7.2625,
    "text": "一一五和五一一算同一种。"
   },
   {
    "start": 7.2625,
    "end": 14.1625,
    "text": "样例一，七分三份，答案是四：一一五、一二四、一三三、二二三。"
   },
   {
    "start": 14.1625,
    "end": 17.3875,
    "text": "样例二，七分两份，答案是三。"
   },
   {
    "start": 17.3875,
    "end": 21.1125,
    "text": "n 不超过两百，k 在二到六之间。"
   }
  ]
 },
 {
  "id": "dup",
  "wav": "audio/dup-a471c5e3c826.wav",
  "seconds": 19.848,
  "cues": [
   {
    "start": 0.1,
    "end": 7.9875,
    "text": "如果一份一份随便填，七分三份会填出十五种，同一种分法换个顺序就多数一遍。"
   },
   {
    "start": 7.9375,
    "end": 16.35,
    "text": "办法是规定后一份不小于前一份，每种分法只剩排好序的那一种写法，十五种收拢成四种。"
   },
   {
    "start": 16.35,
    "end": 19.8,
    "text": "这和组合不回头是同一个想法。"
   }
  ]
 },
 {
  "id": "tree",
  "wav": "audio/tree-c1c5d85b528b.wav",
  "seconds": 24.216,
  "cues": [
   {
    "start": 0.1,
    "end": 7.2375,
    "text": "讲义的深搜有三个参数：还剩多少，还要分几份，这一份至少多大，也就是 low。"
   },
   {
    "start": 7.1875,
    "end": 10.6875,
    "text": "根节点剩七、分三份、至少一。"
   },
   {
    "start": 10.6875,
    "end": 12.975,
    "text": "第一份可以是一或二。"
   },
   {
    "start": 12.975,
    "end": 16.475,
    "text": "选了一，下一层剩六、分两份。"
   },
   {
    "start": 16.475,
    "end": 21.25,
    "text": "只剩一份时，剩下的数不小于 low，就是一种分法。"
   },
   {
    "start": 21.25,
    "end": 24.15,
    "text": "四个叶子，四种分法。"
   }
  ]
 },
 {
  "id": "prune",
  "wav": "audio/prune-84aa00199e44.wav",
  "seconds": 15.744,
  "cues": [
   {
    "start": 0.1,
    "end": 2.4125,
    "text": "第一份为什么最多到二？"
   },
   {
    "start": 2.3625,
    "end": 10.5,
    "text": "后面每份都不比它小，三份加起来至少是它的三倍，所以它最多是剩余量整除份数。"
   },
   {
    "start": 10.5,
    "end": 15.6875,
    "text": "去掉这个上界，树会长到二十个节点，十三个是死路。"
   }
  ]
 },
 {
  "id": "memo",
  "wav": "audio/memo-b3510fa5d541.wav",
  "seconds": 18.696,
  "cues": [
   {
    "start": 0.1,
    "end": 3.05,
    "text": "讲义还套了 lru_cache。"
   },
   {
    "start": 3.0,
    "end": 9.075,
    "text": "最大的数据，两百分六份，答案是四百一十三万两千零九十六。"
   },
   {
    "start": 9.075,
    "end": 14.375,
    "text": "不加缓存，答案只能一个一个加出来，要调用四百三十多万次。"
   },
   {
    "start": 14.375,
    "end": 18.6375,
    "text": "加上缓存，只有一万一千八百八十八种状态。"
   }
  ]
 },
 {
  "id": "split",
  "wav": "audio/split-2e0df0812291.wav",
  "seconds": 21.24,
  "cues": [
   {
    "start": 0.1,
    "end": 1.9375,
    "text": "再用动态规划。"
   },
   {
    "start": 1.8875,
    "end": 5.925,
    "text": "dp i j 表示把 i 分成 j 份的分法数。"
   },
   {
    "start": 5.925,
    "end": 8.175,
    "text": "四种分法分成两类。"
   },
   {
    "start": 8.175,
    "end": 13.425,
    "text": "至少有一份是一的，拿掉它，就是六分两份，三种。"
   },
   {
    "start": 13.425,
    "end": 18.725,
    "text": "每份都至少是二的，每份减一，就是四分三份，一种。"
   },
   {
    "start": 18.725,
    "end": 21.1875,
    "text": "三加一，等于四。"
   }
  ]
 },
 {
  "id": "table",
  "wav": "audio/table-6c27708d24b2.wav",
  "seconds": 19.32,
  "cues": [
   {
    "start": 0.1,
    "end": 8.875,
    "text": "所以 dp i j 等于 dp i 减一、j 减一，加上 dp i 减 j、j，边界 dp 零零等于一。"
   },
   {
    "start": 8.825,
    "end": 14.95,
    "text": "一行行填下去，七分三份是四，七分两份是三，正好是两组样例。"
   },
   {
    "start": 14.95,
    "end": 19.2625,
    "text": "两百乘六，一千二百格，每格一次加法。"
   }
  ]
 },
 {
  "id": "check",
  "wav": "audio/check-8e04c7c516aa.wav",
  "seconds": 15.984,
  "cues": [
   {
    "start": 0.1,
    "end": 2.05,
    "text": "两种写法对拍。"
   },
   {
    "start": 2.0,
    "end": 7.3375,
    "text": "n 从七到两百，k 从二到六，九百七十组全部一致。"
   },
   {
    "start": 7.3375,
    "end": 10.3,
    "text": "n 小的时候，再用穷举核对。"
   },
   {
    "start": 10.3,
    "end": 15.9125,
    "text": "思路完全不同的两种写法，一个写错，另一个马上能揪出来。"
   }
  ]
 },
 {
  "id": "choose",
  "wav": "audio/choose-aa3b6039add8.wav",
  "seconds": 21.672,
  "cues": [
   {
    "start": 0.1,
    "end": 1.9125,
    "text": "考场上怎么选？"
   },
   {
    "start": 1.8625,
    "end": 3.65,
    "text": "先估答案多大。"
   },
   {
    "start": 3.65,
    "end": 11.525,
    "text": "不加缓存的深搜一种一种地数，答案四百多万，就至少走四百多万步，用 Python 写要当心超时。"
   },
   {
    "start": 11.525,
    "end": 15.4125,
    "text": "只问方案数，动态规划或记忆化最稳。"
   },
   {
    "start": 15.4125,
    "end": 21.6125,
    "text": "如果要把每种分法都打印出来，就只能深搜，那时数据也一定小得多。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-2f54fe3a2656.wav",
  "seconds": 15.624,
  "cues": [
   {
    "start": 0.1,
    "end": 1.4875,
    "text": "回顾一下。"
   },
   {
    "start": 1.4375,
    "end": 6.2875,
    "text": "深搜靠 low 去重，靠整除份数剪枝，再加记忆化。"
   },
   {
    "start": 6.2875,
    "end": 11.4625,
    "text": "动态规划按有没有一分两类：拿掉一个一，或每份减一。"
   },
   {
    "start": 11.4625,
    "end": 15.5625,
    "text": "同类题可以试试放苹果，它允许盘子空着。"
   }
  ]
 }
]