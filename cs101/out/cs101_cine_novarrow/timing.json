[
 {
  "id": "title",
  "wav": "audio/title-f624066ab126.wav",
  "seconds": 24.384,
  "cues": [
   {
    "start": 0.1,
    "end": 1.5875,
    "text": "箭头迷阵。"
   },
   {
    "start": 1.5375,
    "end": 5.8875,
    "text": "网格里每格画着一个箭头，上下左右四选一。"
   },
   {
    "start": 5.8875,
    "end": 11.475,
    "text": "从一格出发，一直照箭头走，最后走出场地，这一格就能逃出。"
   },
   {
    "start": 11.475,
    "end": 13.325,
    "text": "问有几格能逃出。"
   },
   {
    "start": 13.325,
    "end": 14.6375,
    "text": "样例一。"
   },
   {
    "start": 14.6375,
    "end": 16.9,
    "text": "左上向上，出界。"
   },
   {
    "start": 16.9,
    "end": 19.4,
    "text": "左下向下，也出界。"
   },
   {
    "start": 19.4,
    "end": 22.625,
    "text": "右边两格上下互指，出不去。"
   },
   {
    "start": 22.625,
    "end": 24.3125,
    "text": "答案是二。"
   }
  ]
 },
 {
  "id": "graph",
  "wav": "audio/graph-c96ea8840c09.wav",
  "seconds": 25.176,
  "cues": [
   {
    "start": 0.1,
    "end": 5.025,
    "text": "每格恰好一条出边，从哪儿出发，路线都是唯一确定的。"
   },
   {
    "start": 4.975,
    "end": 9.675,
    "text": "假如走了格子数加一步还在场内，必然有一格到过两次。"
   },
   {
    "start": 9.675,
    "end": 15.1875,
    "text": "路线是确定的，回到同一格，后面就一模一样，永远绕下去。"
   },
   {
    "start": 15.1875,
    "end": 18.9375,
    "text": "所以暴力是每格最多走格子数加一步。"
   },
   {
    "start": 18.9375,
    "end": 25.125,
    "text": "可格子多达二十万，二十万乘二十万，约四百亿步，太慢。"
   }
  ]
 },
 {
  "id": "states",
  "wav": "audio/states-3cff9b102d07.wav",
  "seconds": 30.96,
  "cues": [
   {
    "start": 0.1,
    "end": 3.375,
    "text": "要每格只走一次，就得记住结论。"
   },
   {
    "start": 3.325,
    "end": 11.15,
    "text": "每格四种状态：零是还没访问，一是在当前路线上，二是能逃，三是逃不出。"
   },
   {
    "start": 11.15,
    "end": 16.025,
    "text": "从未访问的格子出发，边走边标成一，记进 path 列表。"
   },
   {
    "start": 16.025,
    "end": 18.225,
    "text": "停下只有三种情况。"
   },
   {
    "start": 18.225,
    "end": 20.525,
    "text": "走出界，能逃。"
   },
   {
    "start": 20.525,
    "end": 24.0125,
    "text": "撞上标一的格，是本条路线成环。"
   },
   {
    "start": 24.0125,
    "end": 27.2375,
    "text": "撞上二或三，直接接上那个结论。"
   },
   {
    "start": 27.2375,
    "end": 30.9,
    "text": "最后把 path 上的格子全部回填成结论。"
   }
  ]
 },
 {
  "id": "walk",
  "wav": "audio/walk-4feb866b7ec6.wav",
  "seconds": 37.2,
  "cues": [
   {
    "start": 0.1,
    "end": 3.55,
    "text": "样例二，格子按行编号零到八。"
   },
   {
    "start": 3.5,
    "end": 6.975,
    "text": "零号向上，一步出界，能逃。"
   },
   {
    "start": 6.975,
    "end": 14.05,
    "text": "一号向右到二，向下到五，再向右出界，path 是一二五，三格一起回填成能逃。"
   },
   {
    "start": 14.05,
    "end": 15.9125,
    "text": "三号向左出界。"
   },
   {
    "start": 15.9125,
    "end": 19.5125,
    "text": "四号向下到七，七号向上回到四。"
   },
   {
    "start": 19.5125,
    "end": 24.3875,
    "text": "四号正标着一，撞上本条路线，四和七都逃不出。"
   },
   {
    "start": 24.3875,
    "end": 28.8125,
    "text": "六号向右撞上七，七已经是三，接上结论。"
   },
   {
    "start": 28.8125,
    "end": 31.0875,
    "text": "八号向左也撞上七。"
   },
   {
    "start": 31.0875,
    "end": 33.9125,
    "text": "已有结论的格子直接跳过。"
   },
   {
    "start": 33.9125,
    "end": 37.1375,
    "text": "能逃的是零一二三五，答案五。"
   }
  ]
 },
 {
  "id": "wander",
  "wav": "audio/wander-dd35eeea913d.wav",
  "seconds": 23.856,
  "cues": [
   {
    "start": 0.1,
    "end": 3.625,
    "text": "题面说途中可以先绕圈，别读错。"
   },
   {
    "start": 3.575,
    "end": 11.45,
    "text": "这条路线从中心出发，绕着中心转了一整圈，九格各走一次，从左下角出去，能逃。"
   },
   {
    "start": 11.45,
    "end": 13.575,
    "text": "绕圈只是拐来拐去。"
   },
   {
    "start": 13.575,
    "end": 20.35,
    "text": "把左下角改成向上，它就回到走过的格子，从此每圈都一样，九格全都出不去。"
   },
   {
    "start": 20.35,
    "end": 23.7875,
    "text": "真回到走过的格子，才叫成环。"
   }
  ]
 },
 {
