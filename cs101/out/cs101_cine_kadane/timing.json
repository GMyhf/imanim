[
 {
  "id": "title",
  "wav": "audio/title-bb78aad518cf.wav",
  "seconds": 19.824,
  "cues": [
   {
    "start": 0.1,
    "end": 9.2,
    "text": "一排数，有正有负：负二、一、负三、四、负一、二、一、负五、四。"
   },
   {
    "start": 9.15,
    "end": 12.65,
    "text": "从里面挑连续的一段，让和最大。"
   },
   {
    "start": 12.65,
    "end": 15.35,
    "text": "枚举所有区间是平方级。"
   },
   {
    "start": 15.35,
    "end": 19.775,
    "text": "今天看只扫一遍的 Kadane 算法，再把它推到二维。"
   }
  ]
 },
 {
  "id": "state",
  "wav": "audio/state-27b6bea2a80a.wav",
  "seconds": 20.736,
  "cues": [
   {
    "start": 0.1,
    "end": 6.05,
    "text": "状态这样定义：dp i 表示以第 i 格结尾的最大子段和。"
   },
   {
    "start": 6.0,
    "end": 8.475,
    "text": "关键在以 i 结尾这个限定。"
   },
   {
    "start": 8.475,
    "end": 14.5,
    "text": "每一格只有两种选择：接在前一格那段的后面，或者自己另起一段。"
   },
   {
    "start": 14.5,
    "end": 16.1,
    "text": "两者取大。"
   },
   {
    "start": 16.1,
    "end": 20.675,
    "text": "答案是整个 dp 里的最大值，不一定在最后一格。"
   }
  ]
 },
 {
  "id": "scan",
  "wav": "audio/scan-44a14ed52970.wav",
  "seconds": 29.184,
  "cues": [
   {
    "start": 0.1,
    "end": 1.7875,
    "text": "一路往右加。"
   },
   {
    "start": 1.7375,
    "end": 3.4125,
    "text": "第一格是负二。"
   },
   {
    "start": 3.4125,
    "end": 9.3625,
    "text": "到第二格，前面是负的，接上只会拖累，扔掉，从一重新开始。"
   },
   {
    "start": 9.3625,
    "end": 12.8125,
    "text": "加上负三，又变成负二，再扔。"
   },
   {
    "start": 12.8125,
    "end": 17.0375,
    "text": "从四重新开始，接着是三、五、六。"
   },
   {
    "start": 17.0375,
    "end": 19.5625,
    "text": "第七格的六是全程最大。"
   },
   {
    "start": 19.5625,
    "end": 23.675,
    "text": "后面减五剩一，加四是五，都没超过六。"
   },
   {
    "start": 23.675,
    "end": 29.1125,
    "text": "答案六，就是四、负一、二、一这一段。"
   }
  ]
 },
 {
  "id": "why",
  "wav": "audio/why-96efd86eac41.wav",
  "seconds": 17.928,
  "cues": [
   {
    "start": 0.1,
    "end": 1.8125,
    "text": "为什么扔得放心？"
   },
   {
    "start": 1.7625,
    "end": 6.5375,
    "text": "一段和为负的前缀，接到谁前面，都只会让它变小。"
   },
   {
    "start": 6.5375,
    "end": 11.6375,
    "text": "所以前一格的 dp 一旦是负的，就从当前格重新开始。"
   },
   {
    "start": 11.6375,
    "end": 17.875,
    "text": "每个数只看一次，时间线性；只留两个变量，空间是常数。"
   }
  ]
 },
 {
  "id": "matrix",
  "wav": "audio/matrix-2b1a31717ea6.wav",
  "seconds": 14.928,
  "cues": [
   {
    "start": 0.1,
    "end": 5.3,
    "text": "升到二维：四乘四的矩阵，找元素和最大的子矩阵。"
   },
   {
    "start": 5.25,
    "end": 10.6125,
    "text": "一个子矩阵由上、下、左、右四条边决定。"
   },
   {
    "start": 10.6125,
    "end": 14.8625,
    "text": "四条边全枚举，再逐个求和，太慢了。"
   }
  ]
 },
 {
  "id": "squash",
  "wav": "audio/squash-cc792d9c5d22.wav",
  "seconds": 26.136,
  "cues": [
   {
    "start": 0.1,
    "end": 3.7625,
    "text": "降维的办法是：先固定上边和下边。"
   },
   {
    "start": 3.7125,
    "end": 6.0125,
    "text": "比如上边取第二行。"
   },
   {
    "start": 6.0125,
    "end": 10.8125,
    "text": "下边也是第二行时，压出来的一行就是它自己。"
   },
   {
    "start": 10.8125,
    "end": 15.05,
    "text": "下边扩到第三行，每一列加上第三行的数。"
   },
   {
    "start": 15.05,
    "end": 21.225,
    "text": "再扩到第四行，再加一次，得到四、十一、负十、一。"
   },
   {
    "start": 21.225,
    "end": 26.075,
    "text": "这一行的任意一段，都对应一个子矩阵，和也相等。"
   }
  ]
 },
 {
  "id": "demo",
  "wav": "audio/demo-1cf165e427e6.wav",
  "seconds": 22.368,
  "cues": [
   {
    "start": 0.1,
    "end": 7.45,
    "text": "对这一行跑 Kadane：四；加十一，十五；加负十，五；加一，六。"
   },
   {
    "start": 7.4,
    "end": 10.4,
    "text": "最大是十五，对应左边两列。"
   },
   {
    "start": 10.4,
    "end": 15.5125,
    "text": "回到矩阵上，就是第二到第四行、第一到第二列这一块。"
   },
   {
    "start": 15.5125,
    "end": 22.3125,
    "text": "九、二、负四、一、负一、八，加起来正是十五。"
   }
  ]
 },
 {
  "id": "all",
  "wav": "audio/all-900507b4aa97.wav",
  "seconds": 15.432,
  "cues": [
   {
    "start": 0.1,
    "end": 2.9,
    "text": "上下边一共有十种取法。"
   },
   {
    "start": 2.85,
    "end": 7.6625,
    "text": "固定上边，下边每扩一行，列和只要加上新的一行。"
   },
   {
    "start": 7.6625,
    "end": 11.65,
    "text": "每种取法跑一遍 Kadane，总共是立方级。"
   },
   {
    "start": 11.65,
    "end": 15.3625,
    "text": "十种里最大的，就是刚才那个十五。"
   }
  ]
 },
 {
  "id": "rob",
  "wav": "audio/rob-113e4bee48ca.wav",
  "seconds": 27.36,
  "cues": [
   {
    "start": 0.1,
    "end": 3.4375,
    "text": "同样一遍扫完的，还有打家劫舍。"
   },
   {
    "start": 3.3875,
    "end": 10.2375,
    "text": "一排房子，钱数是二、七、九、三、一，不能偷相邻的两家。"
   },
   {
    "start": 10.2375,
    "end": 18.9875,
    "text": "每到一家两种选择：不偷，沿用到前一家为止的最好结果；偷，就用前两家为止的结果加上这一家。"
   },
   {
    "start": 18.9875,
    "end": 23.2625,
    "text": "依次是二、七、十一、十一、十二。"
   },
   {
    "start": 23.2625,
    "end": 27.3,
    "text": "答案十二，偷第一、第三、第五家。"
   }
  ]
 },
 {
  "id": "recap",
