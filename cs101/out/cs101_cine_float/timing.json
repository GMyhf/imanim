[
 {
  "id": "title",
  "wav": "audio/title-58e2af288f7e.wav",
  "seconds": 16.008,
  "cues": [
   {
    "start": 0.1,
    "end": 7.8,
    "text": "在 Python 里算零点一加零点二，打印出来是零点三，后面跟着一长串零，最后还多了个四。"
   },
   {
    "start": 7.75,
    "end": 9.4375,
    "text": "再问它们相等吗？"
   },
   {
    "start": 9.4375,
    "end": 11.1875,
    "text": "回答是不相等。"
   },
   {
    "start": 11.1875,
    "end": 15.9375,
    "text": "这不是 Python 的错，问题出在计算机怎样存小数。"
   }
  ]
 },
 {
  "id": "sci",
  "wav": "audio/sci-568488efa3c2.wav",
  "seconds": 26.088,
  "cues": [
   {
    "start": 0.1,
    "end": 7.35,
    "text": "把小数点钉死在固定位置，整数部分大了放不下，小数部分小了又存不精。"
   },
   {
    "start": 7.3,
    "end": 11.8625,
    "text": "办法是让小数点浮动，这就是科学计数法。"
   },
   {
    "start": 11.8625,
    "end": 20.5125,
    "text": "二进制也一样：把这个数的小数点向左移六位，再乘上二的六次方，小数点左边就只剩一个一。"
   },
   {
    "start": 20.5125,
    "end": 26.025,
    "text": "规范化以后，打头的总是一，所以这一位不必存储。"
   }
  ]
 },
 {
  "id": "layout",
  "wav": "audio/layout-e1f2b29a5b6b.wav",
  "seconds": 25.248,
  "cues": [
   {
    "start": 0.1,
    "end": 8.275,
    "text": "浮点数的国际标准里，双精度用六十四位存一个数：一位符号，十一位指数，五十二位尾数。"
   },
   {
    "start": 8.225,
    "end": 13.8125,
    "text": "拿负六点五来看，它规范化成负一点一零一乘二的二次方。"
   },
   {
    "start": 13.8125,
    "end": 15.5375,
    "text": "符号位是一。"
   },
   {
    "start": 15.5375,
    "end": 20.475,
    "text": "指数二要加上偏移量一千零二十三，存成一千零二十五。"
   },
   {
    "start": 20.475,
    "end": 25.2,
    "text": "尾数只存小数点后面的一零一，后面全补零。"
   }
  ]
 },
 {
  "id": "tenth",
  "wav": "audio/tenth-e19bc32453cb.wav",
  "seconds": 36.6,
  "cues": [
   {
    "start": 0.1,
    "end": 2.15,
    "text": "零点一能这样存吗？"
   },
   {
    "start": 2.1,
    "end": 7.3875,
    "text": "把零点一不断乘二，依次取出整数部分，就是它的二进制。"
   },
   {
    "start": 7.3875,
    "end": 16.95,
    "text": "零点二，零点四，零点八，取零；一点六，取一，剩零点六；一点二，取一，剩零点二。"
   },
   {
    "start": 16.95,
    "end": 21.675,
    "text": "又回到零点二了，从这里开始零零一一无限循环。"
   },
   {
    "start": 21.675,
    "end": 27.875,
    "text": "就像十进制写不尽三分之一，十里有个因子五，二进制就写不尽十分之一。"
   },
   {
    "start": 27.875,
    "end": 36.55,
    "text": "尾数只有五十二位，只能截断再舍入，存进去的值比零点一大了大约五点五五乘十的负十八次方。"
   }
  ]
 },
 {
  "id": "sum",
  "wav": "audio/sum-467916a12df8.wav",
  "seconds": 29.232,
  "cues": [
   {
    "start": 0.1,
    "end": 2.225,
    "text": "零点二也存大了一点。"
   },
   {
    "start": 2.175,
    "end": 6.65,
    "text": "两个近似值相加，结果还要再舍入到某一个浮点数上。"
   },
   {
    "start": 6.65,
    "end": 14.3,
    "text": "把零点三附近放大，浮点数是一格一格的，相邻两格相差五点五五乘十的负十七次方。"
   },
   {
    "start": 14.3,
    "end": 18.4625,
    "text": "零点三本身存在左边这一格，比零点三略小。"
   },
   {
    "start": 18.4625,
    "end": 26.05,
    "text": "零点一加零点二的精确和，恰好落在两格正中间，按就近取偶的规则，归到了右边那一格。"
   },
   {
    "start": 26.05,
    "end": 29.1625,
    "text": "两个不同的格子，所以不相等。"
   }
  ]
 },
 {
  "id": "gap",
  "wav": "audio/gap-b61a57d1eeac.wav",
  "seconds": 29.136,
  "cues": [
   {
    "start": 0.1,
    "end": 3.1,
    "text": "格子还会随着数变大而变宽。"
   },
   {
    "start": 3.05,
    "end": 8.5375,
    "text": "尾数五十二位，加上隐含的那个一，一共五十三位有效数字。"
   },
   {
    "start": 8.5375,
    "end": 17.3625,
    "text": "到了二的五十三次方，相邻两格相差二，二的五十三次方加一转成浮点数，就和二的五十三次方相等了。"
   },
   {
    "start": 17.3625,
    "end": 29.075,
    "text": "大整数开方也会出错：一亿零七的平方减一，用浮点开方再取整，得到一亿零七，多了一；用整数开方函数，才得到正确的一亿零六。"
   }
  ]
 },
 {
  "id": "compare",
  "wav": "audio/compare-e99d19da7cef.wav",
  "seconds": 29.184,
  "cues": [
   {
    "start": 0.1,
    "end": 3.275,
    "text": "所以，浮点数不要用等号比较。"
   },
   {
    "start": 3.225,
    "end": 11.1625,
    "text": "看两数之差是否小于一个很小的误差，比如十的负九次方，或者用 math 模块的 isclose。"
   },
   {
    "start": 11.1625,
    "end": 15.7125,
    "text": "需要十进制精确运算，就用字符串构造 Decimal。"
   },
   {
    "start": 15.7125,
    "end": 19.875,
    "text": "能用整数就用整数，开方取整用 isqrt。"
   },
   {
    "start": 19.875,
    "end": 29.125,
    "text": "也不是所有小数都不精确：零点五加零点二五等于零点七五，结果成立，因为它们都是二的幂次分之几。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-afe4e3b594fa.wav",
  "seconds": 11.64,
  "cues": [
   {
    "start": 0.1,
    "end": 7.25,
    "text": "浮点数就是二进制的科学计数法，五十三位有效数字，一格一格地逼近实数。"
   },
   {
    "start": 7.2,
    "end": 11.575,
    "text": "比较时留一点误差，能用整数就用整数。"
   }
  ]
 }
]