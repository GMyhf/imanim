[
 {
  "id": "title",
  "wav": "audio/title-b635412ddf77.wav",
  "seconds": 13.632,
  "cues": [
   {
    "start": 0.1,
    "end": 2.9375,
    "text": "图书馆选座，月考第二题。"
   },
   {
    "start": 2.8875,
    "end": 8.7,
    "text": "题目不难，但值得多想一步：朴素模拟能过，为什么一个指针就够？"
   },
   {
    "start": 8.7,
    "end": 13.575,
    "text": "还有一处边界，写错了样例全过，提交却是错的。"
   }
  ]
 },
 {
  "id": "rule",
  "wav": "audio/rule-a6d8c98b6a0e.wav",
  "seconds": 37.176,
  "cues": [
   {
    "start": 0.1,
    "end": 1.6,
    "text": "先看题意。"
   },
   {
    "start": 1.55,
    "end": 5.4625,
    "text": "一排 n 个座位，零是空，一是有人。"
   },
   {
    "start": 5.4625,
    "end": 13.0125,
    "text": "m 位同学依次进来，每人挑编号最小、而且左右邻座都空着的空位坐下，找不到就离开。"
   },
   {
    "start": 13.0125,
    "end": 16.05,
    "text": "最后输出坐下几人和这一排的状态。"
   },
   {
    "start": 16.05,
    "end": 19.2125,
    "text": "样例一，五个空座，来两人。"
   },
   {
    "start": 19.2125,
    "end": 20.8625,
    "text": "第一人坐一号。"
   },
   {
    "start": 20.8625,
    "end": 24.6625,
    "text": "二号挨着他，不行，第二人坐三号。"
   },
   {
    "start": 24.6625,
    "end": 27.0375,
    "text": "样例二，二号有人。"
   },
   {
    "start": 27.0375,
    "end": 29.525,
    "text": "一号和三号都挨着它。"
   },
   {
    "start": 29.525,
    "end": 34.075,
    "text": "四号在最右边，只有左邻，左邻空着，坐下。"
   },
   {
    "start": 34.075,
    "end": 37.125,
    "text": "第二人没有位置，答案是一。"
   }
  ]
 },
 {
  "id": "naive",
  "wav": "audio/naive-38df171154d2.wav",
  "seconds": 25.128,
  "cues": [
   {
    "start": 0.1,
    "end": 4.8375,
    "text": "最直接的做法：每位同学都从一号开始往右找。"
   },
   {
    "start": 4.7875,
    "end": 8.825,
    "text": "这一排十个座位，四号有人，来五个人。"
   },
   {
    "start": 8.825,
    "end": 13.975,
    "text": "第一人扫一格，第二人六格，第三人八格，第四人十格。"
   },
   {
    "start": 13.975,
    "end": 16.8,
    "text": "第五人扫完十格，没有座位。"
   },
   {
    "start": 16.8,
    "end": 18.65,
    "text": "一共三十五格。"
   },
   {
    "start": 18.65,
    "end": 25.075,
    "text": "每人最多扫 n 格，总量不超过 n 乘 m，最大四百万，Python 也能过。"
   }
  ]
 },
 {
  "id": "mono",
  "wav": "audio/mono-cf27a57ea4b9.wav",
  "seconds": 23.856,
  "cues": [
   {
    "start": 0.1,
    "end": 1.7625,
    "text": "但可以再想一步。"
   },
   {
    "start": 1.7125,
    "end": 4.2,
    "text": "第一，座位只会越坐越满。"
   },
   {
    "start": 4.2,
    "end": 8.5,
    "text": "一个座位现在不能坐，后来的人只会让它更不能坐。"
   },
   {
    "start": 8.5,
    "end": 14.7,
    "text": "第二，某人坐在 i，说明 i 左边的座位当时都不能坐，以后也不能。"
   },
   {
    "start": 14.7,
    "end": 17.6875,
    "text": "而 i 加一挨着他，也不能坐了。"
   },
   {
    "start": 17.6875,
    "end": 23.8,
    "text": "所以下一位的座位一定在 i 的右边，扫过的格子不必再看。"
   }
  ]
 },
 {
  "id": "pointer",
  "wav": "audio/pointer-fe6d6c9ad3d4.wav",
  "seconds": 23.88,
  "cues": [
   {
    "start": 0.1,
    "end": 3.875,
    "text": "于是一个指针从左扫到右就够了。"
   },
   {
    "start": 3.825,
    "end": 7.7375,
    "text": "能坐就坐，人数加一，指针不回头。"
   },
   {
    "start": 7.7375,
    "end": 13.4375,
    "text": "还是这一排，指针只走十格，四人坐下，第五人没有座位。"
   },
   {
    "start": 13.4375,
    "end": 15.55,
    "text": "十格对三十五格。"
   },
   {
    "start": 15.55,
    "end": 20.4625,
    "text": "规模到两千时，全空一排，两千格对三百万格。"
   },
   {
    "start": 20.4625,
    "end": 23.8125,
    "text": "复杂度从 n 乘 m 降到 n。"
   }
  ]
 },
 {
  "id": "code",
  "wav": "audio/code-017d87587458.wav",
  "seconds": 27.48,
  "cues": [
   {
    "start": 0.1,
    "end": 1.9875,
    "text": "对照讲义代码。"
   },
   {
    "start": 1.9375,
    "end": 5.625,
    "text": "字符串不能原地改，先转成列表。"
   },
   {
    "start": 5.625,
    "end": 8.875,
    "text": "循环开头，坐满 m 人就跳出。"
   },
   {
    "start": 8.875,
    "end": 14.775,
    "text": "左边可坐有两种情况：i 等于零，没有左邻；或者左邻是零。"
   },
   {
    "start": 14.775,
    "end": 19.2,
    "text": "右边同理：i 等于 n 减一，或者右邻是零。"
   },
   {
    "start": 19.2,
    "end": 22.375,
    "text": "本座空、左右都行，才坐下。"
   },
   {
    "start": 22.375,
    "end": 27.4125,
    "text": "注意 or 会短路，i 等于零时，根本不去读左邻。"
   }
  ]
 },
 {
  "id": "bug",
  "wav": "audio/bug-3afa5957f786.wav",
  "seconds": 38.64,
  "cues": [
   {
    "start": 0.1,
    "end": 2.35,
    "text": "这个短路正是失分点。"
   },
   {
    "start": 2.3,
    "end": 7.2875,
    "text": "把 i 等于零这半句删掉，i 等于零时就会读 s 负一。"
   },
   {
    "start": 7.2875,
    "end": 10.8125,
    "text": "Python 不报错，悄悄读到最后一个座位。"
   },
   {
    "start": 10.8125,
    "end": 12.6625,
    "text": "两个样例都能过。"
   },
   {
    "start": 12.6625,
    "end": 16.35,
    "text": "换五个座位，最右边有人，来两人。"
   },
   {
    "start": 16.35,
    "end": 18.325,
    "text": "正确答案坐下两人。"
   },
   {
    "start": 18.325,
    "end": 22.8375,
    "text": "错误写法以为一号左邻有人，只坐下一人。"
   },
   {
    "start": 22.8375,
    "end": 30.35,
    "text": "右边删掉判断，读 s 的 n 会直接报下标越界，样例二就过不去，反而好查。"
   },
   {
    "start": 30.35,
    "end": 38.575,
    "text": "C++ 里 s 负一是越界访问；s 的 n 读到结尾的空字符，最后一个座位永远坐不下。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-cfea26ca3c77.wav",
  "seconds": 16.728,
  "cues": [
   {
    "start": 0.1,
    "end": 1.3125,
    "text": "回顾。"
   },
   {
    "start": 1.2625,
    "end": 4.7375,
    "text": "朴素模拟每人从头扫，n 乘 m。"
   },
   {
    "start": 4.7375,
    "end": 11.775,
    "text": "座位只会越坐越满，下一位一定坐在右边，所以一个指针扫一遍，线性时间。"
   },
   {
    "start": 11.775,
    "end": 16.675,
    "text": "边界座位先判下标再读邻座，n 等于一要测。"
   }
  ]
 }
]