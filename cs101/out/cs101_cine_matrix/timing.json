[
 {
  "id": "title",
  "wav": "audio/title-fa4f88e822fb.wav",
  "seconds": 14.232,
  "cues": [
   {
    "start": 0.1,
    "end": 6.375,
    "text": "矩阵在 Python 里就是二维列表：外层列表装着每一行，下标先行后列。"
   },
   {
    "start": 6.325,
    "end": 14.1625,
    "text": "这支片讲四个小技巧：建表、保护圈、旋转，最后把它们合起来，螺旋填数。"
   }
  ]
 },
 {
  "id": "trap",
  "wav": "audio/trap-1a1c376f6e82.wav",
  "seconds": 26.208,
  "cues": [
   {
    "start": 0.1,
    "end": 3.1375,
    "text": "先建一个三行四列的全零矩阵。"
   },
   {
    "start": 3.0875,
    "end": 7.375,
    "text": "很多人会这样写：一行零乘四，再整个乘三。"
   },
   {
    "start": 7.375,
    "end": 9.0,
    "text": "看起来没问题。"
   },
   {
    "start": 9.0,
    "end": 14.075,
    "text": "可是把左上角改成九，三行的第一个数一起变成了九。"
   },
   {
    "start": 14.075,
    "end": 19.0125,
    "text": "因为乘号复制的是引用，三个位置指向同一个内层列表。"
   },
   {
    "start": 19.0125,
    "end": 23.8875,
    "text": "正确写法是列表推导式，每一行都新建一个列表。"
   },
   {
    "start": 23.8875,
    "end": 26.1375,
    "text": "这次只有第一行变了。"
   }
  ]
 },
 {
  "id": "pad",
  "wav": "audio/pad-e997ea26d831.wav",
  "seconds": 36.648,
  "cues": [
   {
    "start": 0.1,
    "end": 2.2625,
    "text": "第二个技巧，保护圈。"
   },
   {
    "start": 2.2125,
    "end": 7.625,
    "text": "三乘三的矩阵，一到九，求每个格子上下左右邻居之和。"
   },
   {
    "start": 7.625,
    "end": 12.8875,
    "text": "角上的格子只有两个邻居，每次都要判断越界，很啰嗦。"
   },
   {
    "start": 12.8875,
    "end": 16.4125,
    "text": "在四周补一圈零，矩阵变成五乘五。"
   },
   {
    "start": 16.4125,
    "end": 21.975,
    "text": "现在每个格子都有四个邻居，圈外的正好是零，不影响求和。"
   },
   {
    "start": 21.975,
    "end": 27.4625,
    "text": "角上的一，邻居是零、四、零、二，和是六。"
   },
   {
    "start": 27.4625,
    "end": 32.775,
    "text": "中心的五，邻居是二、八、四、六，和是二十。"
   },
   {
    "start": 32.775,
    "end": 36.6,
    "text": "四个方向写成一张表，一个循环走完。"
   }
  ]
 },
 {
  "id": "life",
  "wav": "audio/life-498c8b9d69ed.wav",
  "seconds": 30.792,
  "cues": [
   {
    "start": 0.1,
    "end": 1.725,
    "text": "八个方向也一样。"
   },
   {
    "start": 1.675,
    "end": 5.0875,
    "text": "生存游戏，OpenJudge 一二五六零。"
   },
   {
    "start": 5.0875,
    "end": 11.5875,
    "text": "活细胞有两个或三个活邻居就继续活，死细胞恰有三个活邻居就复活。"
   },
   {
    "start": 11.5875,
    "end": 16.6375,
    "text": "第二行第二列的活细胞，有四个活邻居，太挤，死去。"
   },
   {
    "start": 16.6375,
    "end": 21.025,
    "text": "第一行第二列的空格，恰有三个活邻居，复活。"
   },
   {
    "start": 21.025,
    "end": 24.175,
    "text": "注意，结果必须写进新矩阵。"
   },
   {
    "start": 24.175,
    "end": 30.7375,
    "text": "边算边改原矩阵，后面的格子会数到已经更新过的邻居，答案就错了。"
   }
  ]
 },
 {
  "id": "rotate",
  "wav": "audio/rotate-3af5d34a8584.wav",
  "seconds": 24.144,
  "cues": [
   {
    "start": 0.1,
    "end": 2.8875,
    "text": "第三个技巧，转置与旋转。"
   },
   {
    "start": 2.8375,
    "end": 8.05,
    "text": "zip 星号 a，把每一列打包成一行，一行代码就转置了。"
   },
   {
    "start": 8.05,
    "end": 10.3375,
    "text": "顺时针转九十度呢？"
   },
   {
    "start": 10.3375,
    "end": 19.775,
    "text": "先上下翻转，七八九到了第一行；再转置，第一行变成七、四、一，正是原来第一列从下往上读。"
   },
   {
    "start": 19.775,
    "end": 24.0875,
    "text": "逆时针反过来，先转置，再上下翻转。"
   }
  ]
 },
 {
  "id": "spiral",
  "wav": "audio/spiral-b1c5f0eea33e.wav",
  "seconds": 35.976,
  "cues": [
   {
    "start": 0.1,
    "end": 9.7625,
    "text": "最后把方向表和保护圈合起来，做螺旋矩阵，OpenJudge 一八一零六：把一到 n 平方，顺时针螺旋地填进 n 乘 n 的矩阵。"
   },
   {
    "start": 9.7125,
    "end": 15.45,
    "text": "四个方向按右、下、左、上排好，外面补一圈墙。"
   },
   {
    "start": 15.45,
    "end": 18.7625,
    "text": "往前一格不是空格，就换下一个方向。"
   },
   {
    "start": 18.7625,
    "end": 20.375,
    "text": "n 等于四。"
   },
   {
    "start": 20.375,
    "end": 27.0125,
    "text": "填到四撞墙，向下；填到七，向左；填到十，向上。"
   },
   {
    "start": 27.0125,
    "end": 32.175,
    "text": "填到十二，前面是已经填过的一，也算墙，再右转。"
   },
   {
    "start": 32.175,
    "end": 35.925,
    "text": "最后一个数十六，落在第三行第二列。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-cd8865fabcdf.wav",
  "seconds": 9.84,
  "cues": [
   {
    "start": 0.1,
    "end": 6.3,
    "text": "建表用推导式，看邻居用保护圈加方向表，旋转用翻转加转置。"
   },
   {
    "start": 6.25,
    "end": 9.775,
    "text": "螺旋填数，就是这几招合在一起。"
   }
  ]
 }
]