[
 {
  "id": "title",
  "wav": "audio/title-5de98ff8c5bb.wav",
  "seconds": 13.296,
  "cues": [
   {
    "start": 0.1,
    "end": 3.8375,
    "text": "斐波那契数列，可能是你写的第一个递归。"
   },
   {
    "start": 3.7875,
    "end": 9.8875,
    "text": "可它藏着一个秘密：一棵越长越大的树，最后会塌缩成一行数组。"
   },
   {
    "start": 9.8875,
    "end": 13.2375,
    "text": "这，就是动态规划的起点。"
   }
  ]
 },
 {
  "id": "define",
  "wav": "audio/define-556f887d641d.wav",
  "seconds": 12.744,
  "cues": [
   {
    "start": 0.1,
    "end": 1.6625,
    "text": "定义很简单。"
   },
   {
    "start": 1.6125,
    "end": 7.425,
    "text": "第一项和第二项都是一，从第三项起，每一项等于前两项之和。"
   },
   {
    "start": 7.425,
    "end": 12.6875,
    "text": "一，一，二，三，五，八，十三。"
   }
  ]
 },
 {
  "id": "code",
  "wav": "audio/code-582997f5783e.wav",
  "seconds": 17.016,
  "cues": [
   {
    "start": 0.1,
    "end": 7.7375,
    "text": "照着定义直接写，只要三行：n 小于等于二，就返回一；否则返回前两项之和。"
   },
   {
    "start": 7.6875,
    "end": 11.425,
    "text": "它完全正确，算第十项得到五十五。"
   },
   {
    "start": 11.425,
    "end": 15.5,
    "text": "可是算到第四十项，你会明显感觉它慢了下来。"
   },
   {
    "start": 15.5,
    "end": 16.9625,
    "text": "为什么？"
   }
  ]
 },
 {
  "id": "tree",
  "wav": "audio/tree-06720a9d51a3.wav",
  "seconds": 18.384,
  "cues": [
   {
    "start": 0.1,
    "end": 2.775,
    "text": "把每一次调用画成一个节点。"
   },
   {
    "start": 2.725,
    "end": 9.9375,
    "text": "算 fib 六，要先算 fib 五和 fib 四；fib 五又要先算 fib 四和 fib 三。"
   },
   {
    "start": 9.9375,
    "end": 15.175,
    "text": "程序按深度优先的顺序，一条路走到底，再退回岔路口。"
   },
   {
    "start": 15.175,
    "end": 18.325,
    "text": "数一数，一共调用了十五次。"
   }
  ]
 },
 {
  "id": "repeat",
  "wav": "audio/repeat-8d30405db43a.wav",
  "seconds": 15.864,
  "cues": [
   {
    "start": 0.1,
    "end": 4.4625,
    "text": "现在，给参数相同的节点涂上相同的颜色。"
   },
   {
    "start": 4.4125,
    "end": 10.5875,
    "text": "fib 四被算了两次，fib 三被算了三次，fib 二被算了五次。"
   },
   {
    "start": 10.5875,
    "end": 15.8125,
    "text": "同一个问题被一遍又一遍地重算，这就叫重叠子问题。"
   }
  ]
 },
 {
  "id": "growth",
  "wav": "audio/growth-a6022086d999.wav",
  "seconds": 12.696,
  "cues": [
   {
    "start": 0.1,
    "end": 3.8125,
    "text": "更糟的是，调用次数随 n 指数增长。"
   },
   {
    "start": 3.7625,
    "end": 8.975,
    "text": "n 每加一，次数大约乘上一点六一八，正好是黄金比例。"
   },
   {
    "start": 8.975,
    "end": 12.625,
    "text": "到了 fib 四十，要调用两亿多次。"
   }
  ]
 },
 {
  "id": "memo",
  "wav": "audio/memo-dd73e52ecd04.wav",
  "seconds": 20.04,
  "cues": [
   {
    "start": 0.1,
    "end": 3.8125,
    "text": "修法很直接：算过的，就记下来。"
   },
   {
    "start": 3.7625,
    "end": 11.6375,
    "text": "第一次算完 fib 三，把结果写进表里；以后再遇到 fib 三，直接查表返回，整棵子树都不用再长。"
   },
   {
    "start": 11.6375,
    "end": 17.0125,
    "text": "剪完之后，只剩最左边一条链，加上几个查表就返回的叶子。"
   },
   {
    "start": 17.0125,
    "end": 19.9875,
    "text": "十五次调用变成九次。"
   }
  ]
 },
 {
  "id": "collapse",
  "wav": "audio/collapse-99e72be0721e.wav",
  "seconds": 12.648,
  "cues": [
   {
    "start": 0.1,
    "end": 4.325,
    "text": "再往前走一步，把参数相同的节点合并成一个。"
   },
   {
    "start": 4.275,
    "end": 9.0625,
    "text": "整棵树塌缩成一条链，每个节点只依赖它前面的两个。"
   },
   {
    "start": 9.0625,
    "end": 12.5875,
    "text": "把这条链摊平，就是一个数组。"
   }
  ]
 },
 {
  "id": "table",
  "wav": "audio/table-233fcf482aa4.wav",
  "seconds": 16.632,
  "cues": [
   {
    "start": 0.1,
    "end": 4.2875,
    "text": "既然如此，不如反过来，从小到大填表。"
   },
   {
    "start": 4.2375,
    "end": 8.9125,
    "text": "先写下前两项，之后每一格都等于左边两格之和。"
   },
   {
    "start": 8.9125,
    "end": 13.35,
    "text": "一个循环，线性时间，第十格正好是五十五。"
   },
   {
    "start": 13.35,
    "end": 16.575,
    "text": "这就是自底向上的动态规划。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-410183fe932f.wav",
  "seconds": 12.84,
  "cues": [
   {
    "start": 0.1,
    "end": 9.225,
    "text": "回头看：递归树暴露了重叠子问题；记忆化让每棵子树只算一次；把依赖关系摊平，就得到了动态规划。"
   },
   {
    "start": 9.175,
    "end": 12.7875,
    "text": "从指数到线性，只差一张表。"
   }
  ]
 }
]