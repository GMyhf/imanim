[
 {
  "id": "title",
  "wav": "audio/title-8ad9a843403e.wav",
  "seconds": 10.44,
  "cues": [
   {
    "start": 0.1,
    "end": 5.1625,
    "text": "上一集，波纹一圈一圈往外推，每走一步的代价都一样。"
   },
   {
    "start": 5.1125,
    "end": 7.2,
    "text": "可如果路有长有短呢？"
   },
   {
    "start": 7.2,
    "end": 10.3875,
    "text": "这一集，让波纹带上权重。"
   }
  ]
 },
 {
  "id": "bfswrong",
  "wav": "audio/bfswrong-fa7a486a61d1.wav",
  "seconds": 19.272,
  "cues": [
   {
    "start": 0.1,
    "end": 1.8125,
    "text": "看这张有向图。"
   },
   {
    "start": 1.7625,
    "end": 7.3,
    "text": "从零出发，零到一的边长四，零到二长一，二到一长二。"
   },
   {
    "start": 7.3,
    "end": 12.6625,
    "text": "广搜按步数一层一层推，第一层就碰到一号点，记下代价四。"
   },
   {
    "start": 12.6625,
    "end": 15.8625,
    "text": "可绕道二号点，一加二只要三。"
   },
   {
    "start": 15.8625,
    "end": 19.2125,
    "text": "边权不同，广搜就会算错。"
   }
  ]
 },
 {
  "id": "idea",
  "wav": "audio/idea-7e7637bf51b5.wav",
  "seconds": 17.928,
  "cues": [
   {
    "start": 0.1,
    "end": 3.475,
    "text": "Dijkstra 的办法是：把队列换成小根堆。"
   },
   {
    "start": 3.425,
    "end": 7.7875,
    "text": "每次取出当前距离最小的点，再用它去松弛邻居。"
   },
   {
    "start": 7.7875,
    "end": 12.7625,
    "text": "所谓松弛，就是看看经过它走过去，会不会更近。"
   },
   {
    "start": 12.7625,
    "end": 17.875,
    "text": "更近，就更新距离，并把新的距离压进堆里。"
   }
  ]
 },
 {
  "id": "code",
  "wav": "audio/code-bebc9a335a34.wav",
  "seconds": 20.136,
  "cues": [
   {
    "start": 0.1,
    "end": 2.375,
    "text": "代码和广搜几乎一样。"
   },
   {
    "start": 2.325,
    "end": 8.2,
    "text": "dist 初始化成无穷大，源点为零，堆里放距离和节点。"
   },
   {
    "start": 8.2,
    "end": 15.175,
    "text": "弹出一个点，如果它的距离已经比 dist 里记录的大，说明是过期条目，直接跳过。"
   },
   {
    "start": 15.175,
    "end": 20.0875,
    "text": "否则遍历邻居，新距离更小，就更新并压入堆。"
   }
  ]
 },
 {
  "id": "run",
  "wav": "audio/run-6f3367412fc0.wav",
  "seconds": 33.792,
  "cues": [
   {
    "start": 0.1,
    "end": 1.5625,
    "text": "跟着跑一遍。"
   },
   {
    "start": 1.5125,
    "end": 6.7,
    "text": "弹出零号点，把一号点更新成四，二号点更新成一。"
   },
   {
    "start": 6.7,
    "end": 14.2125,
    "text": "弹出距离最小的二号点：一号点经过它只要三，比四小，更新；三号点更新成六。"
   },
   {
    "start": 14.2125,
    "end": 19.2625,
    "text": "弹出一号点，距离三：三号点经过它只要四，更新。"
   },
   {
    "start": 19.2625,
    "end": 26.25,
    "text": "下一个弹出的是距离四的一号点，可 dist 里已经是三了，这是过期条目，跳过。"
   },
   {
    "start": 26.25,
    "end": 28.8875,
    "text": "弹出三号点，距离四。"
   },
   {
    "start": 28.8875,
    "end": 33.725,
    "text": "最后那个距离六的三号点也过期了，跳过。"
   }
  ]
 },
 {
  "id": "result",
  "wav": "audio/result-15bc9fab64c3.wav",
  "seconds": 15.264,
  "cues": [
   {
    "start": 0.1,
    "end": 3.7875,
    "text": "最短距离是零、三、一、四。"
   },
   {
    "start": 3.7375,
    "end": 10.8875,
    "text": "一号点第一次出堆时，距离三就已经确定，以后不会再变：第一次出堆，才是最短。"
   },
   {
    "start": 10.8875,
    "end": 15.2,
    "text": "广搜，其实就是所有边权都为一的 Dijkstra。"
   }
  ]
 },
 {
  "id": "mountain",
  "wav": "audio/mountain-e6838c795dc1.wav",
  "seconds": 21.768,
  "cues": [
   {
    "start": 0.1,
    "end": 2.2375,
    "text": "应用：走山路。"
   },
   {
    "start": 2.1875,
    "end": 7.0125,
    "text": "网格上每走一步的代价，是相邻两格高度差的绝对值。"
   },
   {
    "start": 7.0125,
    "end": 14.475,
    "text": "结构和迷宫那道题几乎一样，只是把 deque 换成 heapq，把步数加一换成加上高度差。"
   },
   {
    "start": 14.475,
    "end": 18.35,
    "text": "从左上到右下，波纹按代价往外扩。"
   },
   {
    "start": 18.35,
    "end": 21.7,
    "text": "终点出堆时，最小代价是六。"
   }
  ]
 },
 {
  "id": "traps",
  "wav": "audio/traps-9df507fc272f.wav",
  "seconds": 11.184,
  "cues": [
   {
    "start": 0.1,
    "end": 1.425,
    "text": "两个坑。"
   },
   {
    "start": 1.375,
    "end": 6.5375,
    "text": "第一，必须跳过过期条目，漏了这一句，复杂度会退化。"
   },
   {
    "start": 6.5375,
    "end": 11.1125,
    "text": "第二，不能有负权边，负权要用 Bellman Ford。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-6c7a54389b9e.wav",
  "seconds": 9.768,
  "cues": [
   {
    "start": 0.1,
    "end": 3.375,
    "text": "队列换成堆，步数换成距离。"
   },
   {
    "start": 3.325,
    "end": 6.775,
    "text": "每次取出最近的点，松弛它的邻居。"
   },
   {
    "start": 6.775,
    "end": 9.7,
    "text": "第一次出堆，就是最短。"
   }
  ]
 }
]