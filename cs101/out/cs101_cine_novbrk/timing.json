[
 {
  "id": "title",
  "wav": "audio/title-4331b3a92cdb.wav",
  "seconds": 15.96,
  "cues": [
   {
    "start": 0.1,
    "end": 3.3125,
    "text": "月考最后一题，括号区间审计。"
   },
   {
    "start": 3.2625,
    "end": 9.7625,
    "text": "一个括号串，二十万次询问，每次问一段子串是不是合法的括号序列。"
   },
   {
    "start": 9.7625,
    "end": 15.9,
    "text": "思路：前缀和画成山，单调栈扫一遍，每问常数时间。"
   }
  ]
 },
 {
  "id": "task",
  "wav": "audio/task-5ad5ccf68a64.wav",
  "seconds": 25.032,
  "cues": [
   {
    "start": 0.1,
    "end": 1.95,
    "text": "先看什么叫合法。"
   },
   {
    "start": 1.9,
    "end": 9.2,
    "text": "空串合法；合法串外面套一对括号，还合法；两个合法串接起来，也合法。"
   },
   {
    "start": 9.2,
    "end": 18.1375,
    "text": "换成能检查的说法：从左往右数，左括号减右括号，差任何时候都不能是负的，最后恰好是零。"
   },
   {
    "start": 18.1375,
    "end": 24.975,
    "text": "每问现扫，最坏二十万步，二十万次询问就是四百亿步，必然超时。"
   }
  ]
 },
 {
  "id": "mountain",
  "wav": "audio/mountain-62b448664dec.wav",
  "seconds": 35.112,
  "cues": [
   {
    "start": 0.1,
    "end": 6.4875,
    "text": "先算前缀和：左括号加一，右括号减一，画成折线就是一座山。"
   },
   {
    "start": 6.4375,
    "end": 13.2625,
    "text": "用样例二，高度依次是零、一、零、负一、零、一、零。"
   },
   {
    "start": 13.2625,
    "end": 17.825,
    "text": "子串 l 到 r，就是山上从 l 减一走到 r 的一段。"
   },
   {
    "start": 17.825,
    "end": 19.7625,
    "text": "合法要两条。"
   },
   {
    "start": 19.7625,
    "end": 21.975,
    "text": "第一，两端同高。"
   },
   {
    "start": 21.975,
    "end": 24.6,
    "text": "第二，中间不跌破起点。"
   },
   {
    "start": 24.6,
    "end": 26.5375,
    "text": "两条缺一不可。"
   },
   {
    "start": 26.5375,
    "end": 31.2375,
    "text": "四到五是两个左括号，没跌破，可两端不一样高。"
   },
   {
    "start": 31.2375,
    "end": 35.05,
    "text": "二到五两端同高，可第一步就往下跌。"
   }
  ]
 },
 {
  "id": "nxt",
  "wav": "audio/nxt-e5fd104b1806.wav",
  "seconds": 19.872,
  "cues": [
   {
    "start": 0.1,
    "end": 4.15,
    "text": "第二条在问：这一段的最低点，比起点低吗？"
   },
   {
    "start": 4.1,
    "end": 8.5625,
    "text": "换个问法：从起点往右，第一个比它低的位置在哪儿？"
   },
   {
    "start": 8.5625,
    "end": 10.0375,
    "text": "记作 next。"
   },
   {
    "start": 10.0375,
    "end": 14.2,
    "text": "第一次跌破发生在 r 的后面，区间里就没有跌破。"
   },
   {
    "start": 14.2,
    "end": 19.8125,
    "text": "判定只剩一行：两端高度相等，并且 next 大于 r。"
   }
  ]
 },
 {
  "id": "stack",
  "wav": "audio/stack-69ec0c8ed31d.wav",
  "seconds": 37.608,
  "cues": [
   {
    "start": 0.1,
    "end": 2.95,
    "text": "next 用单调栈一遍算出来。"
   },
   {
    "start": 2.9,
    "end": 8.85,
    "text": "从左往右扫，栈里存还没找到更低处的位置，高度从底到顶不降。"
   },
   {
    "start": 8.85,
    "end": 14.175,
    "text": "新位置比栈顶低，栈顶的答案就是它：弹出，填上。"
   },
   {
    "start": 14.175,
    "end": 17.8,
    "text": "一直弹到栈顶不比它高，再把它压进去。"
   },
   {
    "start": 17.8,
    "end": 20.0,
    "text": "零、一先入栈。"
   },
   {
    "start": 20.0,
    "end": 22.0,
    "text": "到二，弹出一。"
   },
   {
    "start": 22.0,
    "end": 26.9625,
    "text": "到三，跌到负一，二和零都被弹出，答案都是三。"
   },
   {
    "start": 26.9625,
    "end": 29.1875,
    "text": "到六，弹出五。"
   },
   {
    "start": 29.1875,
    "end": 33.2625,
    "text": "最后还在栈里的，右边没有更低处，填七。"
   },
   {
    "start": 33.2625,
    "end": 37.5375,
    "text": "每个位置进栈出栈各一次，总共线性。"
   }
  ]
 },
 {
  "id": "judge",
  "wav": "audio/judge-2eda2a3a0545.wav",
  "seconds": 24.6,
  "cues": [
   {
    "start": 0.1,
    "end": 2.55,
    "text": "逐个回答样例二的四问。"
   },
   {
    "start": 2.5,
    "end": 8.075,
    "text": "一到二：两端都是零，next 是三，大于二，合法。"
   },
   {
    "start": 8.075,
    "end": 13.35,
    "text": "二到五：两端都是一，可 next 是二，刚出发就跌破。"
   },
   {
    "start": 13.35,
    "end": 18.675,
    "text": "一到六：两端都是零，没走到六，在三就跌破了。"
   },
   {
    "start": 18.675,
    "end": 21.3625,
    "text": "三到六：同样在三跌破。"
   },
   {
    "start": 21.3625,
    "end": 24.55,
    "text": "输出一个 YES，三个 NO。"
   }
  ]
 },
 {
  "id": "pitfall",
  "wav": "audio/pitfall-cb1c1531c3a6.wav",
  "seconds": 24.456,
  "cues": [
   {
    "start": 0.1,
    "end": 3.4875,
    "text": "注意这三个 NO 都是两端同高。"
   },
   {
    "start": 3.4375,
    "end": 7.7125,
    "text": "只数括号个数，样例二会输出四个 YES。"
   },
   {
    "start": 7.7125,
    "end": 10.7,
    "text": "另一个坑：弹栈要严格大于。"
   },
   {
    "start": 10.7,
    "end": 16.8875,
    "text": "写成大于等于，回到同高也算跌破，一到二就被判错，四问全是 NO。"
   },
   {
    "start": 16.8875,
    "end": 24.4,
    "text": "还有输入输出：读入一次读完；二十万行逐行打印太慢，先收集，再一次输出。"
   }
  ]
 },
 {
  "id": "code",
  "wav": "audio/code-2e7e0fd31e3e.wav",
  "seconds": 19.944,
  "cues": [
   {
    "start": 0.1,
    "end": 1.9875,
    "text": "对照讲义代码。"
   },
   {
    "start": 1.9375,
    "end": 3.9625,
    "text": "第一段算前缀和。"
   },
   {
    "start": 3.9625,
    "end": 9.9625,
    "text": "第二段是单调栈，while 比较栈顶和当前高度，弹出时填 next。"
   },
   {
    "start": 9.9625,
    "end": 13.75,
    "text": "第三段每问一行判定，结果攒进列表。"
   },
   {
    "start": 13.75,
    "end": 19.875,
    "text": "也可以用 ST 表求区间最小值，但预处理多一个 log，代码更长。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-3d40c0675b55.wav",
  "seconds": 17.928,
  "cues": [
   {
    "start": 0.1,
    "end": 1.3125,
    "text": "回顾。"
   },
   {
    "start": 1.2625,
    "end": 7.375,
    "text": "合法括号序列翻成前缀和，就是两端同高、中间不跌破。"
   },
   {
    "start": 7.375,
    "end": 13.6,
    "text": "不跌破是区间最小值，单调栈一遍预处理出右边第一个更低的位置。"
   },
   {
    "start": 13.6,
    "end": 17.8625,
    "text": "预处理线性，每问常数，答案一次输出。"
   }
  ]
 }
]