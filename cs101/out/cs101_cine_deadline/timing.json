[
 {
  "id": "title",
  "wav": "audio/title-a9368bf78f31.wav",
  "seconds": 14.784,
  "cues": [
   {
    "start": 0.1,
    "end": 1.725,
    "text": "例题精讲。"
   },
   {
    "start": 1.675,
    "end": 6.95,
    "text": "这一支照考场上的流程，从读题到对拍，完整做一道题。"
   },
   {
    "start": 6.95,
    "end": 12.1875,
    "text": "一批任务，各有耗时和截止时间，一次做一个，不能中断。"
   },
   {
    "start": 12.1875,
    "end": 14.7125,
    "text": "最多能按时完成几个？"
   }
  ]
 },
 {
  "id": "read",
  "wav": "audio/read-87db150282f2.wav",
  "seconds": 18.312,
  "cues": [
   {
    "start": 0.1,
    "end": 2.35,
    "text": "第一步，看数据范围。"
   },
   {
    "start": 2.3,
    "end": 10.0125,
    "text": "任务最多十万个，平方级要算一百亿次，超时；只能是 n log n，不到两百万次。"
   },
   {
    "start": 10.0125,
    "end": 12.075,
    "text": "第二步，认题型。"
   },
   {
    "start": 12.075,
    "end": 18.2625,
    "text": "题面问最多能选几个，速查表说这是贪心，先想按什么排序。"
   }
  ]
 },
 {
  "id": "sortkey",
  "wav": "audio/sortkey-ae582970f4d0.wav",
  "seconds": 19.728,
  "cues": [
   {
    "start": 0.1,
    "end": 2.275,
    "text": "第三步，定排序键。"
   },
   {
    "start": 2.225,
    "end": 7.7875,
    "text": "先想小问题：选好的几个任务，怎么判断能不能全部按时？"
   },
   {
    "start": 7.7875,
    "end": 10.7875,
    "text": "按截止时间从早到晚做。"
   },
   {
    "start": 10.7875,
    "end": 16.8375,
    "text": "画在时间轴上，每段的右端都不越过自己的截止线，就全部按时。"
   },
   {
    "start": 16.8375,
    "end": 19.6625,
    "text": "所以按截止时间排序。"
   }
  ]
 },
 {
  "id": "walk",
  "wav": "audio/walk-5950dbb356bd.wav",
  "seconds": 39.744,
  "cues": [
   {
    "start": 0.1,
    "end": 2.1875,
    "text": "第四步，处理冲突。"
   },
   {
    "start": 2.1375,
    "end": 7.95,
    "text": "按截止时间一个一个加进来，已选的放进大根堆，堆顶是最长的。"
   },
   {
    "start": 7.95,
    "end": 10.7875,
    "text": "耗时一，截止二，放下。"
   },
   {
    "start": 10.7875,
    "end": 14.9375,
    "text": "耗时五，总时长六，正好赶上截止六。"
   },
   {
    "start": 14.9375,
    "end": 18.25,
    "text": "耗时二，总时长八，超过了七。"
   },
   {
    "start": 18.25,
    "end": 23.5625,
    "text": "不扔新来的，扔掉堆顶，耗时五的那个，总时长降到三。"
   },
   {
    "start": 23.5625,
    "end": 27.05,
    "text": "耗时六，总时长九，正好赶上。"
   },
   {
    "start": 27.05,
    "end": 32.875,
    "text": "耗时四，总时长十三，超过十，再扔堆顶的六，降到七。"
   },
   {
    "start": 32.875,
    "end": 36.8125,
    "text": "最后耗时三，总时长十，赶上十一。"
   },
   {
    "start": 36.8125,
    "end": 39.675,
    "text": "堆里剩四个，答案是四。"
   }
  ]
 },
 {
  "id": "why",
  "wav": "audio/why-98d5fcfb57a8.wav",
  "seconds": 25.464,
  "cues": [
   {
    "start": 0.1,
    "end": 3.025,
    "text": "为什么扔最长的不会更差？"
   },
   {
    "start": 2.975,
    "end": 4.8375,
    "text": "回到第一次超时。"
   },
   {
    "start": 4.8375,
    "end": 13.425,
    "text": "一、五、二这三个任务，截止都不晚于七，总时长却是八，至少要扔一个，扔一个也就够了。"
   },
   {
    "start": 13.425,
    "end": 20.6875,
    "text": "扔谁都剩两个，区别只在总时长：扔一剩七，扔二剩六，扔五只剩三。"
   },
   {
    "start": 20.6875,
    "end": 25.4125,
    "text": "数量一样，占的时间最少，给后面留的空间就最多。"
   }
  ]
 },
 {
  "id": "code",
  "wav": "audio/code-cc98b6766c77.wav",
  "seconds": 23.544,
  "cues": [
   {
    "start": 0.1,
    "end": 1.725,
    "text": "代码不到十行。"
   },
   {
    "start": 1.675,
    "end": 3.6875,
    "text": "按截止时间排序。"
   },
   {
    "start": 3.6875,
    "end": 6.825,
    "text": "耗时压进堆，总时长加上它。"
   },
   {
    "start": 6.825,
    "end": 8.8875,
    "text": "超时就弹出堆顶。"
   },
   {
    "start": 8.8875,
    "end": 11.775,
    "text": "最后堆里有几个，答案就是几。"
   },
   {
    "start": 11.775,
    "end": 14.05,
    "text": "为什么一个 if 就够？"
   },
   {
    "start": 14.05,
    "end": 21.025,
    "text": "扔掉的堆顶不比新任务短，扔完总时长不超过上一步，而上一步是按时的。"
   },
   {
    "start": 21.025,
    "end": 23.475,
    "text": "总复杂度 n log n。"
   }
  ]
 },
 {
  "id": "trap",
  "wav": "audio/trap-90871fc0d3cc.wav",
  "seconds": 28.896,
  "cues": [
   {
    "start": 0.1,
    "end": 1.95,
    "text": "易错点有三个。"
   },
   {
    "start": 1.9,
    "end": 12.1625,
    "text": "第一，heapq 是小根堆，存的是相反数，弹出来是负数，所以总时长要加上它；写成减号，这组数据只剩两个。"
   },
   {
    "start": 12.1625,
    "end": 17.5625,
    "text": "第二，比较用大于号，正好在截止时刻完成也算按时。"
   },
   {
    "start": 17.5625,
    "end": 22.2875,
    "text": "第三，超时就跳过新任务、不反悔，是错的。"
   },
   {
    "start": 22.2875,
    "end": 28.8375,
    "text": "它一直留着耗时五，后面二、六、三都放不进去，只完成三个。"
   }
  ]
 },
 {
  "id": "check",
  "wav": "audio/check-3268861c77f3.wav",
  "seconds": 20.832,
  "cues": [
   {
    "start": 0.1,
    "end": 2.0,
    "text": "第五步，对拍。"
   },
   {
    "start": 1.95,
    "end": 7.4125,
    "text": "暴力枚举每个子集、每种顺序，一定对，但只能跑小数据。"
   },
   {
    "start": 7.4125,
    "end": 13.0125,
    "text": "讲义随机两百组，每组最多六个任务，逐组比较，全部一致。"
   },
   {
    "start": 13.0125,
    "end": 18.1375,
    "text": "换成不反悔的贪心来对拍，两百组里只有一组会报错。"
   },
   {
    "start": 18.1375,
    "end": 20.775,
    "text": "所以对拍要跑够组数。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-9aac179c5773.wav",
  "seconds": 18.264,
  "cues": [
   {
    "start": 0.1,
    "end": 1.5375,
    "text": "回顾五步。"
   },
   {
    "start": 1.4875,
    "end": 4.625,
    "text": "看范围，十万只能 n log n。"
   },
   {
    "start": 4.625,
    "end": 8.025,
    "text": "认题型，最多选几个，想贪心。"
   },
   {
    "start": 8.025,
    "end": 10.9,
    "text": "定排序键，按截止时间。"
   },
   {
    "start": 10.9,
    "end": 13.7625,
    "text": "处理冲突，超时扔最长的。"
   },
   {
    "start": 13.7625,
    "end": 15.1375,
    "text": "对拍验证。"
   },
   {
    "start": 15.1375,
    "end": 18.2125,
    "text": "这就是考场上每一道题的流程。"
   }
  ]
 }
]