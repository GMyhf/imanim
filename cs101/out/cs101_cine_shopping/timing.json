[
 {
  "id": "title",
  "wav": "audio/title-825a66431f7d.wav",
  "seconds": 17.568,
  "cues": [
   {
    "start": 0.1,
    "end": 1.725,
    "text": "例题精讲。"
   },
   {
    "start": 1.675,
    "end": 8.2625,
    "text": "今天是二〇二五年十一月六日模拟机考的第五题，购物，题号二九八九六。"
   },
   {
    "start": 8.2625,
    "end": 17.5,
    "text": "每种面值的硬币都有无限多，要带尽量少的硬币，让一到上限的每个金额都能凑出来，做不到就输出负一。"
   }
  ]
 },
 {
  "id": "read",
  "wav": "audio/read-f17f0fcf673f.wav",
  "seconds": 18.552,
  "cues": [
   {
    "start": 0.1,
    "end": 1.4875,
    "text": "先看样例。"
   },
   {
    "start": 1.4375,
    "end": 7.0625,
    "text": "上限二十，面值一、二、五、十，答案是五枚。"
   },
   {
    "start": 7.0625,
    "end": 11.6125,
    "text": "注意这不是找零：只凑二十，两枚十就够了。"
   },
   {
    "start": 11.6125,
    "end": 18.5,
    "text": "这里一到二十每个金额都要能凑出，而且只能用带着的这几枚，每枚最多用一次。"
   }
  ]
 },
 {
  "id": "reach",
  "wav": "audio/reach-f75898e368da.wav",
  "seconds": 26.808,
  "cues": [
   {
    "start": 0.1,
    "end": 4.8875,
    "text": "关键是一个量 reach：手上的硬币能凑出一到 reach 的每个数。"
   },
   {
    "start": 4.8375,
    "end": 6.925,
    "text": "一开始 reach 是零。"
   },
   {
    "start": 6.925,
    "end": 13.1125,
    "text": "再带一枚硬币，能凑的每个数都加上它的面值，整段向右平移。"
   },
   {
    "start": 13.1125,
    "end": 20.075,
    "text": "面值不超过 reach 加一，新的一段和原来那段首尾相接，reach 就加上这个面值。"
   },
   {
    "start": 20.075,
    "end": 26.75,
    "text": "面值一旦大于 reach 加一，中间就裂开一道缝，reach 加一谁也凑不出。"
   }
  ]
 },
 {
  "id": "walk",
  "wav": "audio/walk-c43c1c2eea07.wav",
  "seconds": 29.28,
  "cues": [
   {
    "start": 0.1,
    "end": 5.7,
    "text": "用样例走一遍，每一步都在不超过 reach 加一的面值里挑最大的。"
   },
   {
    "start": 5.65,
    "end": 9.0,
    "text": "reach 是零，只能带一，变成一。"
   },
   {
    "start": 9.0,
    "end": 12.225,
    "text": "上限是二，挑二，变成三。"
   },
   {
    "start": 12.225,
    "end": 16.7625,
    "text": "上限是四，五太大，再带一枚二，变成五。"
   },
   {
    "start": 16.7625,
    "end": 20.175,
    "text": "上限是六，挑五，变成十。"
   },
   {
    "start": 20.175,
    "end": 24.4375,
    "text": "上限十一，挑十，变成二十，够了。"
   },
   {
    "start": 24.4375,
    "end": 29.225,
    "text": "一共五枚：一、二、二、五、十。"
   }
  ]
 },
 {
  "id": "why",
  "wav": "audio/why-b350c7f453cc.wav",
  "seconds": 25.776,
  "cues": [
   {
    "start": 0.1,
    "end": 2.1125,
    "text": "为什么挑最大的就对？"
   },
   {
    "start": 2.0625,
    "end": 9.5375,
    "text": "换一种不断档的带法，比如一、一、二、五、十，逐枚和贪心比。"
   },
   {
    "start": 9.5375,
    "end": 17.225,
    "text": "每一步，贪心的 reach 都不比它小：它能带的面值，贪心也能带，而且贪心带得更大。"
   },
   {
    "start": 17.225,
    "end": 21.35,
    "text": "它五枚只到十九，贪心五枚已经到了二十。"
   },
   {
    "start": 21.35,
    "end": 25.725,
    "text": "所以贪心最早到达上限，枚数最少。"
   }
  ]
 },
 {
  "id": "echo",
  "wav": "audio/echo-5f0d676a9621.wav",
  "seconds": 22.008,
  "cues": [
   {
    "start": 0.1,
    "end": 11.475,
    "text": "这个条件在背包那一支见过：十三拆成一、二、四、六，最后一捆六不超过前面的总和七再加一，所以零到十三没有断档。"
   },
   {
    "start": 11.425,
    "end": 16.0125,
    "text": "那里拆数量，这里挑面值，靠的是同一条不变量。"
   },
   {
    "start": 16.0125,
    "end": 21.95,
    "text": "无解只有一种情况：没有面值一，第一步就卡住，输出负一。"
   }
  ]
 },
 {
  "id": "code",
  "wav": "audio/code-18e8ec6149cf.wav",
  "seconds": 21.288,
  "cues": [
   {
    "start": 0.1,
    "end": 1.95,
    "text": "讲义代码十行。"
   },
   {
    "start": 1.9,
    "end": 3.65,
    "text": "面值排好序。"
   },
   {
    "start": 3.65,
    "end": 11.4625,
    "text": "循环里取出不超过 reach 加一的面值，一个都没有就输出负一，否则加上最大的那个，计数加一。"
   },
   {
    "start": 11.4625,
    "end": 15.75,
    "text": "while 后面的 else 只在循环正常结束时打印答案。"
   },
   {
    "start": 15.75,
    "end": 21.225,
    "text": "循环次数就是答案；讲义另一版用 bisect 二分找这枚硬币。"
   }
  ]
 },
 {
  "id": "brute",
  "wav": "audio/brute-b196459f1752.wav",
  "seconds": 24.744,
  "cues": [
   {
    "start": 0.1,
    "end": 1.8,
    "text": "再用暴力对拍。"
   },
   {
    "start": 1.75,
    "end": 7.675,
    "text": "暴力从一枚开始，枚举所有硬币组合，检查能否凑出一到二十。"
   },
   {
    "start": 7.675,
    "end": 17.7375,
    "text": "四枚的三十五种组合，一种都不行；五枚的五十六种里只有一种行，正是一、二、二、五、十。"
   },
   {
    "start": 17.7375,
    "end": 24.6875,
    "text": "再随机生成一千组小数据，贪心和暴力全部一致，其中二百二十组无解。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-5fcf6e1d3f21.wav",
  "seconds": 15.144,
  "cues": [
   {
    "start": 0.1,
    "end": 1.4875,
    "text": "回顾一下。"
   },
   {
    "start": 1.4375,
    "end": 4.775,
    "text": "维护能连续凑出的范围，一到 reach。"
   },
   {
    "start": 4.775,
    "end": 10.6625,
    "text": "下一枚面值不超过 reach 加一，范围就接上、变长；超过就断档。"
   },
   {
    "start": 10.6625,
    "end": 15.075,
    "text": "每一步挑能接上的最大面值，带的枚数最少。"
   }
  ]
 }
]