[
 {
  "id": "title",
  "wav": "audio/title-92cf3f038bc1.wav",
  "seconds": 15.912,
  "cues": [
   {
    "start": 0.1,
    "end": 2.55,
    "text": "计算机里只有零和一。"
   },
   {
    "start": 2.5,
    "end": 9.7125,
    "text": "同样八个位，当成无符号数读是二百三十三，当成有符号数读却是负二十三。"
   },
   {
    "start": 9.7125,
    "end": 11.7375,
    "text": "负数在机器里怎么存？"
   },
   {
    "start": 11.7375,
    "end": 14.025,
    "text": "为什么减法能变成加法？"
   },
   {
    "start": 14.025,
    "end": 15.8625,
    "text": "答案都是补码。"
   }
  ]
 },
 {
  "id": "bases",
  "wav": "audio/bases-f7d35ebe07e0.wav",
  "seconds": 31.824,
  "cues": [
   {
    "start": 0.1,
    "end": 4.275,
    "text": "先把十进制变成二进制：除基取余。"
   },
   {
    "start": 4.225,
    "end": 10.75,
    "text": "二百三十三除以二，商一百一十六，余一；接着除，一直除到商为零。"
   },
   {
    "start": 10.75,
    "end": 13.925,
    "text": "余数倒过来读，就是它的二进制。"
   },
   {
    "start": 13.925,
    "end": 15.6375,
    "text": "为什么倒着读？"
   },
   {
    "start": 15.6375,
    "end": 18.35,
    "text": "第一次得到的余数是最低位。"
   },
   {
    "start": 18.35,
    "end": 24.8625,
    "text": "反过来按权展开，一百二十八加六十四加三十二加八加一，正好二百三十三。"
   },
   {
    "start": 24.8625,
    "end": 31.7625,
    "text": "从最低位起四位一组，每组就是一位十六进制数，一个字节只要写两位。"
   }
  ]
 },
 {
  "id": "sign",
  "wav": "audio/sign-6b9101e95014.wav",
  "seconds": 20.832,
  "cues": [
   {
    "start": 0.1,
    "end": 1.75,
    "text": "负数怎么存？"
   },
   {
    "start": 1.7,
    "end": 6.2375,
    "text": "最直接的想法，是拿最高位当符号，这叫原码。"
   },
   {
    "start": 6.2375,
    "end": 9.5875,
    "text": "负五写成符号位一，后面跟着五。"
   },
   {
    "start": 9.5875,
    "end": 15.175,
    "text": "可这样就有正零和负零两个零，做加减法还得先看符号。"
   },
   {
    "start": 15.175,
    "end": 20.7625,
    "text": "反码把负数除符号位以外的位全部取反，零仍然有两个。"
   }
  ]
 },
 {
  "id": "twos",
  "wav": "audio/twos-8bff80a12543.wav",
  "seconds": 30.456,
  "cues": [
   {
    "start": 0.1,
    "end": 4.8,
    "text": "补码的规则是：正数不变，负数取反再加一。"
   },
   {
    "start": 4.75,
    "end": 8.5,
    "text": "五取反，再加一，就是负五的补码。"
   },
   {
    "start": 8.5,
    "end": 19.4125,
    "text": "把八位能表示的二百五十六种位模式排成一圈，就看得清楚了：从零往回退一格，是八个一，也就是负一；退五格，正是负五。"
   },
   {
    "start": 19.4125,
    "end": 23.4125,
    "text": "同一串位当无符号数读，是二百五十一。"
   },
   {
    "start": 23.4125,
    "end": 30.4,
    "text": "最高位是一的都是负数，范围从负一百二十八到一百二十七，负数比正数多一个。"
   }
  ]
 },
 {
  "id": "sub",
  "wav": "audio/sub-5294ec5c1172.wav",
  "seconds": 30.864,
  "cues": [
   {
    "start": 0.1,
    "end": 1.975,
    "text": "这样存有什么好处？"
   },
   {
    "start": 1.925,
    "end": 4.8,
    "text": "算五减七，就是五加负七。"
   },
   {
    "start": 4.8,
    "end": 15.4875,
    "text": "加法器只管逐位相加、逢二进一，得到的结果最高位是一，是个负数；再取一次补码，绝对值是二，所以结果是负二。"
   },
   {
    "start": 15.4875,
    "end": 20.475,
    "text": "在圈上看，加负七就是顺着圈走二百四十九格。"
   },
   {
    "start": 20.475,
    "end": 27.0125,
    "text": "再算二十四加负十七：最高位进出一个一，直接丢掉，剩下的正好是七。"
   },
   {
    "start": 27.0125,
    "end": 30.8125,
    "text": "同一套加法电路，加法减法全包了。"
   }
  ]
 },
 {
  "id": "overflow",
  "wav": "audio/overflow-5ad66af025c0.wav",
  "seconds": 25.2,
  "cues": [
   {
    "start": 0.1,
    "end": 2.4625,
    "text": "可圈只有二百五十六格。"
   },
   {
    "start": 2.4125,
    "end": 9.2,
    "text": "一百二十七加一，正数加正数，跨过了圈的顶端，变成负一百二十八，这就是溢出。"
   },
   {
    "start": 9.2,
    "end": 16.0375,
    "text": "三十二位的整数也一样：二十一亿四千七百四十八万三千六百四十七加一，变成了负数。"
   },
   {
    "start": 16.0375,
    "end": 25.1375,
    "text": "Python 的整数是任意精度的，不会溢出；用 C++ 做题，中间结果超过二十亿左右，就要换成 long long。"
   }
  ]
 },
 {
  "id": "bitops",
  "wav": "audio/bitops-0635cd2f3103.wav",
  "seconds": 26.328,
  "cues": [
   {
    "start": 0.1,
    "end": 2.6125,
    "text": "补码也解释了位运算里的怪事。"
   },
   {
    "start": 2.5625,
    "end": 9.9,
    "text": "六按位取反，得到负七：取反再加一是相反数，只取反，就是相反数减一。"
   },
   {
    "start": 9.9,
    "end": 12.2375,
    "text": "再看十二和十一按位与。"
   },
   {
    "start": 12.2375,
    "end": 21.3375,
    "text": "减一时，最低位的一变成零，它右边的零全变成一；相与之后，正好清掉最低位的那个一，得到八。"
   },
   {
    "start": 21.3375,
    "end": 26.275,
    "text": "如果结果是零，说明原数只有一个一，它就是二的幂。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-206bfde37a26.wav",
  "seconds": 13.632,
  "cues": [
   {
    "start": 0.1,
    "end": 6.025,
    "text": "回顾一下：除基取余，倒着读；按权展开，再加回去。"
   },
   {
    "start": 5.975,
    "end": 13.575,
    "text": "负数取反加一，八位排成一圈；减法就是加上补码，跨过圈的顶端，就是溢出。"
   }
  ]
 }
]