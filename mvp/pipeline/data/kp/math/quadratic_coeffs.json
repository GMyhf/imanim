  "sequence": [
    {
      "title": "先看 a：开口方向与大小",
      "seconds": 19,
      "narration": "形如 y = ax² + bx + c，前提是 a 不等于零，否则退化成一次函数。抛物线的形状看 a：正数开口向上，负数向下，|a| 越大越窄。",
      "emphasis": "a 定开口：正向上、负向下，|a| 越大越窄",
      "visuals": [
        {
          "kind": "title",
          "props": {
            "main": "a、b、c 与抛物线",
            "sub": "y = ax² + bx + c（a ≠ 0）"
          }
        },
        {
          "kind": "compare",
          "props": {
            "left": {
              "h": "y = x²",
              "items": [
                "a = 1 > 0，开口向上",
                "|a| = 1，开口不宽不窄"
              ]
            },
            "right": {
              "h": "y = −0.25x²",
              "items": [
                "a = −0.25 < 0，开口向下",
                "|a| 小，开口更宽"
              ]
            }
          }
        },
        {
          "kind": "callout",
          "props": {
            "text": "a ≠ 0，否则退化成一次函数",
            "tone": "warn"
          }
        }
      ]
    },
    {
      "title": "再看 b：和 a 合管对称轴",
      "seconds": 17.5,
      "narration": "b 不能单独决定位置，要和 a 搭配：对称轴 x = −b/(2a)。a 与 b 同号，对称轴在 y 轴左侧；异号在右侧；b 等于零时与 y 轴重合。",
      "emphasis": "对称轴 x = −b/(2a)，符号决定左右",
      "visuals": [
        {
          "kind": "formula",
          "props": {
            "expr": "x = −b / (2a)",
            "note": "对称轴；顶点也在这条直线上"
          }
        },
        {
          "kind": "callout",
          "props": {
            "text": "口诀：同左异右（指对称轴相对 y 轴的位置）",
            "tone": "key"
          }
        }
      ]
    },
    {
      "title": "最后看 c：y 轴上的截距",
      "seconds": 15,
      "narration": "c 最好找：x 等于零代入只剩 c，所以抛物线与 y 轴交于 (0, c)。c 变大时交点上移，形状不变。",
      "emphasis": "c 决定与 y 轴的交点 (0, c)",
      "visuals": [
        {
          "kind": "graph_vt",
          "props": {
            "points": [
              [
                -2,
                6
              ],
              [
                -1,
                3
              ],
              [
                0,
                2
              ],
              [
                1,
                3
              ],
              [
                2,
                6
              ]
            ],
            "label": "y = x² + 2（c = 2）",
            "slope_note": "与 y 轴交于 (0, 2)，即 (0, c)",
            "x_label": "x",
            "y_label": "y"
          }
        },
        {
          "kind": "callout",
          "props": {
            "text": "改 c 只平移图像，不改形状",
            "tone": "key"
          }
        }
      ]
    },
    {
      "title": "例题：五个关键点",
      "seconds": 21.5,
      "narration": "画 y = x² − 2x − 3：a = 1 > 0，开口向上；对称轴 x = 1，顶点 (1, −4)；c = −3，过 (0, −3)；解方程得 x 轴交点 −1、3。",
      "emphasis": "先定开口与对称轴，再找顶点与交点",
      "visuals": [
        {
          "kind": "steps",
          "props": {
            "lines": [
              "a = 1 > 0，开口向上",
              "对称轴 x = −(−2) / (2×1) = 1",
              "顶点 (1, 1 − 2 − 3)，即 (1, −4)",
              "与 y 轴交点 (0, −3)",
              "x² − 2x − 3 = 0 → x = −1 或 3"
            ]
          }
        }
      ]
    },
    {
      "title": "连点成线",
      "seconds": 11,
      "narration": "把关键点连成平滑曲线：最低点是顶点，两端穿过 x 轴，整条曲线关于对称轴对称。",
      "emphasis": "图像关于对称轴左右对称",
      "visuals": [
        {
          "kind": "graph_vt",
          "props": {
            "points": [
              [
                -1,
                0
              ],
              [
                0,
                -3
              ],
              [
                1,
                -4
              ],
              [
                2,
                -3
              ],
              [
                3,
                0
              ]
            ],
            "label": "y = x² − 2x − 3",
            "slope_note": "对称轴 x = 1，顶点 (1, −4)",
            "x_label": "x",
            "y_label": "y",
            "dots": true
          }
        }
      ]
    },
    {
      "title": "一句话记住",
      "seconds": 14,
      "narration": "a 定方向与宽窄，a、b 合定对称轴，c 定与 y 轴的交点；先画对称轴，再标顶点与交点。",
      "emphasis": "a 管形状，b 随 a 管左右，c 管上下",
      "visuals": [
