    "函数的概念与描点画图",
    "一次函数的图像与性质",
    "抛物线 y = ax² 的对称性与顶点"
  ],
  "forbidden": [
    "b 单独决定对称轴的位置",
    "c 是与 x 轴的交点",
    "a 可以等于 0",
    "a 越大开口越宽"
  ],
  "must_say": [
    "a不等于零",
    "退化成一次函数",
    "与y轴交于(0,c)"
