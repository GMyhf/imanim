  "prior": [
    "洛伦兹力 F = qvB sinθ",
    "带电粒子在匀强磁场中的匀速圆周运动",
    "半径公式 r = mv/(qB) 与周期公式 T = 2πm/(qB)",
    "运动的分解",
    "动量定理"
  ],
  "forbidden": [
    "两个分运动都是匀速圆周运动",
    "带电粒子在匀强磁场中的周期随速度变化",
    "配速法只能用于初速度为零的情形",
    "配出来的速度可以随便取，不需要满足受力平衡"
  ],
  "must_say": [
    "qvB = mg",
    "匀速直线运动与匀速圆周运动",
    "周期与速度无关",
    "摆线"
  ],
  "sequence": [
    {
      "title": "叠加场里的难题",
      "seconds": 12,
      "narration": "带电粒子同时受重力和洛伦兹力，从静止释放，轨迹弯弯曲曲。配速法的思路是：把一个难的运动，拆成两个会算的运动。",
      "emphasis": "配速法：拆成两个会算的运动",
      "visuals": [
        {
          "kind": "title",
          "props": {
            "main": "配速法",
            "sub": "叠加场中的运动分解"
          }
        },
        {
          "kind": "field",
          "props": {
            "mode": "region",
            "symbols": "cross",
            "label": "垂直纸面向里的匀强磁场 B"
          }
        }
      ]
    },
    {
      "title": "零速度拆成一对速度",
      "seconds": 20,
      "narration": "初速度 v_0 = 0。把它看成一个向右的速度 v 和一个向左的速度 v 之和。v 怎么取？让向右的 v 产生的洛伦兹力恰好与重力平衡，也就是 qvB = mg。",
      "emphasis": "0 = 向右 v + 向左 v，且 qvB = mg",
      "visuals": [
        {
          "kind": "force_diagram",
          "props": {
            "object": "point",
            "label_in": "q",
            "forces": [
              {
                "name": "F",
                "dir": "up",
                "label": "洛伦兹力 qvB"
              },
              {
                "name": "G",
                "dir": "down",
                "label": "重力 mg"
              }
            ],
            "label": "向右的 v：qvB 与 mg 平衡"
          }
        },
        {
          "kind": "formula",
          "props": {
            "expr": "qvB = mg  ⇒  v = mg/(qB)",
            "note": "配出的速度由受力平衡决定"
          }
        }
      ]
    },
    {
      "title": "两个分运动",
      "seconds": 20,
      "narration": "单看向右的速度：洛伦兹力与重力平衡，做匀速直线运动。单看向左的速度：只剩洛伦兹力，做匀速圆周运动，半径 r = mv/(qB)，周期 T = 2πm/(qB)，周期与速度无关。合起来，就是匀速直线运动与匀速圆周运动的叠加。",
      "emphasis": "向右：匀直；向左：匀圆周",
      "visuals": [
        {
          "kind": "trajectory",
          "props": {
            "mode": "circle",
            "n": 8,
            "v_label": "v",
            "label": "单看向左的 v：匀速圆周"
          }
        },
        {
          "kind": "formula",
          "props": {
            "expr": "r = mv/(qB)    T = 2πm/(qB)",
            "note": "周期与速度无关"
          }
        }
      ]
    },
    {
      "title": "合成：摆线",
      "seconds": 20,
      "narration": "圆心匀速平移，粒子绕圆心转圈，合成的轨迹叫摆线，也叫滚轮线。两个分速度同向时合速度最大，v_m = 2v = 2mg/(qB)；下落的最大高度等于直径，h_m = 2r = 2m²g/(q²B²)。",
      "emphasis": "v_m = 2v，h_m = 2r",
      "visuals": [
        {
          "kind": "trajectory",
          "props": {
            "mode": "cycloid",
            "arches": 2,
            "n": 9,
            "label": "合成轨迹：摆线 / 滚轮线"
          }
        },
        {
          "kind": "formula",
          "props": {
            "expr": "v_m = 2v = 2mg/(qB)    h_m = 2r = 2m²g/(q²B²)",
            "note": "最大速度、最大高度差"
          }
        }
      ]
    },
    {
      "title": "最低点与竖直方向",
      "seconds": 14,
      "narration": "笔记里还记了两点：最低点加速度为负 g，方向竖直；竖直方向的分运动是简谐运动。",
      "emphasis": "最低点 a = −g（竖直）；竖直方向为简谐运动",
      "visuals": [
        {
          "kind": "trajectory",
          "props": {
            "mode": "cycloid",
            "arches": 1,
            "n": 5,
            "show_velocity": true,
            "label": "最低点：速度最大，a = −g"
          }
        },
        {
          "kind": "formula",
          "props": {
            "expr": "y = r(1 − cosθ)",
            "note": "竖直方向：简谐运动"
          }
        }
      ]
    },
    {
      "title": "有初速度也能配",
      "seconds": 14,
      "narration": "初速度不为零时，同样先配出满足 qvB = mg 的 v，剩下的速度做圆周运动。笔记按 v_0 = v/4、v_0 = 2v、v_0 = v、v_0 = 0 四种情形分别画了轨迹。",
      "emphasis": "先配 v，再看剩余速度",
      "visuals": [
        {
          "kind": "trajectory",
          "props": {
            "mode": "cycloid",
            "arches": 2,
            "n": 7,
            "label": "情形④ v_0 = 0：摆线"
          }
        },
        {
          "kind": "compare",
          "props": {
            "left": {
              "h": "情形 ① ②",
              "items": [
                "v_0 = v/4",
                "v_0 = 2v"
              ]
            },
            "right": {
              "h": "情形 ③ ④",
              "items": [
                "v_0 = v",
                "v_0 = 0"
              ]
            }
          }
        }
      ]
    },
    {
      "title": "阻力场景里的配速",
      "seconds": 20,
      "narration": "配速不只用在磁场里。小球质量 2 kg，以 10 m/s 水平抛出，阻力 f = kv，k = 2 kg/s，g 取 10 m/s²。竖直方向配一个 v_1，让 kv_1 与 mg 平衡，v_1 = 10 m/s。再对水平方向用动量定理，求得水平射程 x = 5 m，与微积分解法的结果相同。",
      "emphasis": "kv_1 = mg，v_1 = 10 m/s，x = 5 m",
      "visuals": [
        {
          "kind": "force_diagram",
          "props": {
            "object": "point",
            "label_in": "m",
            "forces": [
              {
                "name": "f",
                "dir": "up",
                "label": "阻力 kv_1"
              },
              {
                "name": "G",
                "dir": "down",
                "label": "重力 mg"
              }
            ],
            "label": "竖直配 v_1：kv_1 = mg"
          }
        },
        {
          "kind": "formula",
          "props": {
            "expr": "mv_0 − Σkv_0Δt = (1/2)mv_0  ⇒  x = 5 m",
            "note": "微积分解法：v_x = 10e^{−t}，由 v_x = −v_y 得 t = ln2 s，x = 5 m"
          }
        }
      ]
    }
  ]
}
