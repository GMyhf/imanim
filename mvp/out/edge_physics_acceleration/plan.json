    {
      "index": 2,
      "title": "定义与公式",
      "seconds": 19.74,
      "spoken": 18.24,
      "narration": "加速度是速度的变化率，等于速度变化量 Δv 除以 Δt，单位米每二次方秒。它是矢量，方向与 Δv 相同，而不是与速度同向。加速度恒定，就是匀变速运动。",
      "voiceover": "加速度是速度的变化率，等于速度变化量 德尔塔v 除以 德尔塔t，单位米每二次方秒。它是矢量，方向与 德尔塔v 相同，而不是与速度同向。加速度恒定，就是匀变速运动。",
      "emphasis": "a = Δv / Δt，矢量，方向沿 Δv",
      "kp_refs": [
        "人教版高中物理必修第一册 第一章 1.4 速度变化快慢的描述——加速度",
        "普通高中物理课程标准（2017年版2020年修订） 内容要求 1.1.3：理解位移、速度和加速度"
      ],
      "visuals": [
        {
          "kind": "formula",
          "props": {
            "expr": "a = Δv / Δt = (v_t − v_0) / Δt",
            "note": "单位：m/s²（米每二次方秒）"
          }
        },
        {
          "kind": "callout",
          "props": {
            "text": "矢量：方向与 Δv 相同，与 v 无关",
            "tone": "warn"
          }
        }
      ],
      "subtitles": [
        {
          "i": 0,
