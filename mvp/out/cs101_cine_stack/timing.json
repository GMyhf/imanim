[
 {
  "id": "title",
  "wav": "audio/title-698f0ea9f9c3.wav",
  "seconds": 14.64,
  "cues": [
   {
    "start": 0.1,
    "end": 4.7625,
    "text": "一摞盘子，只能从最上面放，也只能从最上面拿。"
   },
   {
    "start": 4.7125,
    "end": 10.0375,
    "text": "先放的压在下面，后放的先拿走，这就是栈，后进先出。"
   },
   {
    "start": 10.0375,
    "end": 14.5875,
    "text": "往栈里压入四，再弹出，出来的还是四。"
   }
  ]
 },
 {
  "id": "ops",
  "wav": "audio/ops-20d83829cfb7.wav",
  "seconds": 15.0,
  "cues": [
   {
    "start": 0.1,
    "end": 3.15,
    "text": "在 Python 里，栈就是一个列表。"
   },
   {
    "start": 3.1,
    "end": 8.875,
    "text": "append 压入，pop 弹出，方括号负一看栈顶，都是常数时间。"
   },
   {
    "start": 8.875,
    "end": 10.5625,
    "text": "但一定要用尾部。"
   },
   {
    "start": 10.5625,
    "end": 14.95,
    "text": "pop 零和 insert 零都是线性的，那就不是栈了。"
   }
  ]
 },
 {
  "id": "paren",
  "wav": "audio/paren-ce6c93080a94.wav",
  "seconds": 14.04,
  "cues": [
   {
    "start": 0.1,
    "end": 2.6375,
    "text": "第一种用法，括号匹配。"
   },
   {
    "start": 2.5875,
    "end": 4.875,
    "text": "遇到左括号就压栈。"
   },
   {
    "start": 4.875,
    "end": 9.7875,
    "text": "遇到右括号，就弹出栈顶，看是不是配对的左括号。"
   },
   {
    "start": 9.7875,
    "end": 13.9875,
    "text": "一层套一层的括号，正好是后进先出的形状。"
   }
  ]
 },
 {
  "id": "fail",
  "wav": "audio/fail-51970fc3d7f1.wav",
  "seconds": 17.832,
  "cues": [
   {
    "start": 0.1,
    "end": 1.6625,
    "text": "三个易错点。"
   },
   {
    "start": 1.6125,
    "end": 4.2625,
    "text": "第一，弹出的括号不配对。"
   },
   {
    "start": 4.2625,
    "end": 7.8875,
    "text": "第二，遇到右括号时，栈已经空了。"
   },
   {
    "start": 7.8875,
    "end": 11.7125,
    "text": "第三，扫描结束时栈里还有剩余。"
   },
   {
    "start": 11.7125,
    "end": 17.775,
    "text": "第三个最常被漏，只判前两条，两个左括号也会被判成合法。"
   }
  ]
 },
 {
  "id": "postfix",
  "wav": "audio/postfix-8fb192819d23.wav",
  "seconds": 15.216,
  "cues": [
   {
    "start": 0.1,
    "end": 2.8875,
    "text": "第二种用法，表达式求值。"
   },
   {
    "start": 2.8375,
    "end": 10.4875,
    "text": "一加二的和乘三，写成后缀表达式，就是一、二、加、三、乘。"
   },
   {
    "start": 10.4875,
    "end": 15.15,
    "text": "运算符写在后面，不需要括号，也不用比较优先级。"
   }
  ]
 },
 {
  "id": "evaluate",
  "wav": "audio/evaluate-23e044d0eeca.wav",
  "seconds": 20.928,
  "cues": [
   {
    "start": 0.1,
    "end": 2.1375,
    "text": "从左往右扫描。"
   },
   {
    "start": 2.0875,
    "end": 3.875,
    "text": "碰到数字就压栈。"
   },
   {
    "start": 3.875,
    "end": 8.2,
    "text": "碰到运算符，就弹出两个数，算完再压回去。"
   },
   {
    "start": 8.2,
    "end": 10.8625,
    "text": "注意先弹出的是右操作数。"
   },
   {
    "start": 10.8625,
    "end": 13.675,
    "text": "最后栈顶就是结果，九。"
   },
   {
    "start": 13.675,
    "end": 20.8625,
    "text": "减法弄反就会出错，十、三、减、二、减，结果是五。"
   }
  ]
 },
 {
  "id": "mono",
  "wav": "audio/mono-cef5a8d9bd9e.wav",
  "seconds": 18.48,
  "cues": [
   {
    "start": 0.1,
    "end": 4.0,
    "text": "第三种用法，单调栈，看接雨水。"
   },
   {
    "start": 3.95,
    "end": 8.825,
    "text": "栈里存下标，对应的柱子从栈底到栈顶越来越矮。"
   },
   {
    "start": 8.825,
    "end": 12.675,
    "text": "来了一根更高的柱子，就把比它矮的弹出来。"
   },
   {
    "start": 12.675,
    "end": 18.425,
    "text": "弹出的是坑底，新的栈顶是左挡板，当前柱子是右挡板。"
   }
  ]
 },
 {
  "id": "rain",
  "wav": "audio/rain-da5cfc516b06.wav",
  "seconds": 18.504,
  "cues": [
   {
    "start": 0.1,
    "end": 2.475,
    "text": "水量等于宽度乘深度。"
   },
   {
    "start": 2.425,
    "end": 7.6875,
    "text": "宽度是两块挡板之间的距离，深度是较矮的挡板减去坑底。"
   },
   {
    "start": 7.6875,
    "end": 11.9125,
    "text": "一块一块累加，这组柱子一共能接六格雨水。"
   },
   {
    "start": 11.9125,
    "end": 18.45,
    "text": "每个下标最多入栈一次、出栈一次，总共两 n 次操作，所以是线性时间。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-24520e00a939.wav",
  "seconds": 13.656,
  "cues": [
   {
    "start": 0.1,
    "end": 3.1875,
    "text": "栈只有一条规则，后进先出。"
   },
   {
    "start": 3.1375,
    "end": 8.0625,
    "text": "括号匹配、表达式求值、单调栈，都在利用这一条。"
   },
   {
    "start": 8.0625,
    "end": 13.5875,
    "text": "队列正好相反，先进先出，那是广度优先搜索的形状。"
   }
  ]
 }
]