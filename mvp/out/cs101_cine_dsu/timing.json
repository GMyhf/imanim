[
 {
  "id": "title",
  "wav": "audio/title-a8eb00234606.wav",
  "seconds": 13.776,
  "cues": [
   {
    "start": 0.1,
    "end": 4.7,
    "text": "一群人，一条一条地告诉你：谁和谁是一伙的。"
   },
   {
    "start": 4.65,
    "end": 8.65,
    "text": "随时会有人问：这两个人，在不在同一组？"
   },
   {
    "start": 8.65,
    "end": 13.725,
    "text": "要答得又快又准，你需要一片会自己变矮的森林。"
   }
  ]
 },
 {
  "id": "ops",
  "wav": "audio/ops-939b3c083374.wav",
  "seconds": 18.12,
  "cues": [
   {
    "start": 0.1,
    "end": 2.5875,
    "text": "并查集只支持两个操作。"
   },
   {
    "start": 2.5375,
    "end": 7.65,
    "text": "find x，查 x 属于哪个集合，返回这个集合的代表元。"
   },
   {
    "start": 7.65,
    "end": 12.0,
    "text": "union x y，把 x 和 y 所在的两个集合合并。"
   },
   {
    "start": 12.0,
    "end": 18.05,
    "text": "判连通、判环、划分等价类，靠的都是这两个操作。"
   }
  ]
 },
 {
  "id": "forest",
  "wav": "audio/forest-80ad36f18b41.wav",
  "seconds": 19.68,
  "cues": [
   {
    "start": 0.1,
    "end": 1.3375,
    "text": "怎么存？"
   },
   {
    "start": 1.2875,
    "end": 4.3625,
    "text": "每个结点只存它父结点的下标。"
   },
   {
    "start": 4.3625,
    "end": 9.875,
    "text": "每个集合是一棵树，树根就是代表元，它的父亲就是它自己。"
   },
   {
    "start": 9.875,
    "end": 16.1125,
    "text": "union 先找到两边的根，再把一个根挂到另一个根下面，其他元素一个都不用动。"
   },
   {
    "start": 16.1125,
    "end": 19.625,
    "text": "find 沿着父指针一路走到根。"
   }
  ]
 },
 {
  "id": "chain",
  "wav": "audio/chain-e610d8443284.wav",
  "seconds": 17.904,
  "cues": [
   {
    "start": 0.1,
    "end": 2.625,
    "text": "最朴素的合并有个隐患。"
   },
   {
    "start": 2.575,
    "end": 12.4125,
    "text": "连续合并零和一、一和二、二和三，每次都把大树挂到小树下面，树就越长越高，最后退化成一条长链。"
   },
   {
    "start": 12.4125,
    "end": 17.8375,
    "text": "查最底下那个结点，要沿着父链一路走到根，find 变成 O n。"
   }
  ]
 },
 {
  "id": "weight",
  "wav": "audio/weight-7cf9f75a5e94.wav",
  "seconds": 25.584,
  "cues": [
   {
    "start": 0.1,
    "end": 6.6875,
    "text": "改进一：按大小合并，让元素少的那棵树，挂到元素多的那棵树下面。"
   },
   {
    "start": 6.6375,
    "end": 9.875,
    "text": "同样这一串合并，树只有一层高。"
   },
   {
    "start": 9.875,
    "end": 19.6125,
    "text": "一个结点的深度要加一，只有在它所在的树作为较小的一方被挂过去的时候，而这时它所在集合的元素个数至少翻一倍。"
   },
   {
    "start": 19.6125,
    "end": 25.5125,
    "text": "n 个元素最多翻 log 二 n 次，所以树高不超过 log 二 n。"
   }
  ]
 },
 {
  "id": "compress",
  "wav": "audio/compress-4ce1e5423023.wav",
  "seconds": 21.624,
  "cues": [
   {
    "start": 0.1,
    "end": 2.475,
    "text": "改进二：路径压缩。"
   },
   {
    "start": 2.425,
    "end": 8.2875,
    "text": "find 在返回根之前，顺手把沿途每个结点的父指针都直接改成根。"
   },
   {
    "start": 8.2875,
    "end": 13.3625,
    "text": "对结点七调用一次 find，路径是七、五、二、一。"
   },
   {
    "start": 13.3625,
    "end": 21.575,
    "text": "七和五被改挂到根一下面；二本来就是根的孩子；九和十不在路径上，仍然留在七的下面。"
   }
  ]
 },
 {
  "id": "code",
  "wav": "audio/code-8e4440ea8d22.wav",
  "seconds": 23.568,
  "cues": [
   {
    "start": 0.1,
    "end": 1.9,
    "text": "这是标准实现。"
   },
   {
    "start": 1.85,
    "end": 10.4875,
    "text": "find 写成迭代两趟：第一趟找到根，第二趟把路上每个结点直接指向根，n 很大时也不会爆栈。"
   },
   {
    "start": 10.4875,
    "end": 18.7375,
    "text": "union 先各自找根，根相同就返回 False；否则把小的挂到大的下面，更新大小，集合个数减一。"
   },
   {
    "start": 18.7375,
    "end": 23.5125,
    "text": "两条改进合起来，每次操作接近常数时间。"
   }
  ]
 },
 {
  "id": "exam",
  "wav": "audio/exam-698f96173285.wav",
  "seconds": 32.328,
  "cues": [
   {
    "start": 0.1,
    "end": 2.125,
    "text": "拿一道期中题手算。"
   },
   {
    "start": 2.075,
    "end": 6.025,
    "text": "根存负的集合大小，非根存父结点下标。"
   },
   {
    "start": 6.025,
    "end": 12.125,
    "text": "初始数组里，零、四、七、九是根，一共四个集合。"
   },
   {
    "start": 12.125,
    "end": 17.7375,
    "text": "union 二和六，先 find 二，压缩后二直接挂到零。"
   },
   {
    "start": 17.7375,
    "end": 20.4875,
    "text": "再 find 六，六改挂到四。"
   },
   {
    "start": 20.4875,
    "end": 28.275,
    "text": "根零的集合大小是四，根四是三，小的挂到大的下面，四指向零，零变成负七。"
   },
   {
    "start": 28.275,
    "end": 32.275,
    "text": "最后再 find 六，六也直接挂到零。"
   }
  ]
 },
 {
  "id": "apps",
  "wav": "audio/apps-478554ce6f4c.wav",
  "seconds": 18.768,
  "cues": [
   {
    "start": 0.1,
    "end": 3.7,
    "text": "有了这个类，数连通块只要几行。"
   },
   {
    "start": 3.65,
    "end": 10.3625,
    "text": "十个学生、三对关系，每次成功合并，集合数减一，最后剩七组。"
   },
   {
    "start": 10.3625,
    "end": 18.7125,
    "text": "判环也一样：加入边二零的时候，union 返回 False，说明两端本来就连通，这条边构成了环。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-e6120a9d05e8.wav",
  "seconds": 9.552,
  "cues": [
   {
    "start": 0.1,
    "end": 9.5375,
    "text": "一片森林，两个操作，两条改进：按大小合并，让树长不高；路径压缩，让树越查越矮。"
   }
  ]
 }
]