[
 {
  "id": "title",
  "wav": "audio/title-7ab6792fd670.wav",
  "seconds": 11.28,
  "cues": [
   {
    "start": 0.1,
    "end": 6.8125,
    "text": "往平静的水面丢一颗石子，波纹一圈一圈往外推：先到近处，再到远处。"
   },
   {
    "start": 6.7625,
    "end": 11.225,
    "text": "广度优先搜索，就是这样在图上找最短路的。"
   }
  ]
 },
 {
  "id": "idea",
  "wav": "audio/idea-a7eefeca5a0b.wav",
  "seconds": 24.216,
  "cues": [
   {
    "start": 0.1,
    "end": 7.5,
    "text": "从起点出发，先访问所有距离一步的点，再访问所有距离两步的点，一层一层往外推。"
   },
   {
    "start": 7.45,
    "end": 14.575,
    "text": "关键性质是：在无权图里，第一次访问到某个点时，走过的步数就是最短距离。"
   },
   {
    "start": 14.575,
    "end": 18.7,
    "text": "因为是按层推进的，先到的层一定更近。"
   },
   {
    "start": 18.7,
    "end": 24.1625,
    "text": "注意前提是边权相同；边权不同，要用 Dijkstra。"
   }
  ]
 },
 {
  "id": "code",
  "wav": "audio/code-4e6d6babb6d7.wav",
  "seconds": 23.88,
  "cues": [
   {
    "start": 0.1,
    "end": 1.75,
    "text": "模板请背下来。"
   },
   {
    "start": 1.7,
    "end": 9.9875,
    "text": "用 deque 当队列，每次从队首取出一个点，遍历它的邻居：访问过的跳过，没访问过的标记、入队。"
   },
   {
    "start": 9.9875,
    "end": 11.6375,
    "text": "三条铁律。"
   },
   {
    "start": 11.6375,
    "end": 16.9875,
    "text": "第一，用 deque，不用 list，列表的 pop 零是线性的。"
   },
   {
    "start": 16.9875,
    "end": 20.9375,
    "text": "第二，入队时就标记，不是出队时。"
   },
   {
    "start": 20.9375,
    "end": 23.8125,
    "text": "第三，步数跟着节点走。"
   }
  ]
 },
 {
  "id": "maze",
  "wav": "audio/maze-5b7e450d93be.wav",
  "seconds": 19.296,
  "cues": [
   {
    "start": 0.1,
    "end": 3.7875,
    "text": "看一个迷宫：点可以走，井号是墙。"
   },
   {
    "start": 3.7375,
    "end": 5.6375,
    "text": "从左上角出发。"
   },
   {
    "start": 5.6375,
    "end": 12.175,
    "text": "dist 数组初始都是负一，一旦被赋值，就既记下了距离，又表示已经访问过。"
   },
   {
    "start": 12.175,
    "end": 19.225,
    "text": "队首的格子出队，四个方向上能走、又没访问过的邻居，距离加一，排到队尾。"
   }
  ]
 },
 {
  "id": "path",
  "wav": "audio/path-ec592a041a6b.wav",
  "seconds": 10.08,
  "cues": [
   {
    "start": 0.1,
    "end": 4.8625,
    "text": "终点第一次出队时，距离是八，这就是最短步数。"
   },
   {
    "start": 4.8125,
    "end": 10.0125,
    "text": "沿着距离递减的方向倒着走回去，就是一条最短路径。"
   }
  ]
 },
 {
  "id": "mark",
  "wav": "audio/mark-34783cf84b9c.wav",
  "seconds": 15.768,
  "cues": [
   {
    "start": 0.1,
    "end": 2.5375,
    "text": "为什么必须入队时就标记？"
   },
   {
    "start": 2.4875,
    "end": 5.7125,
    "text": "看这个小图：a 和 b 都连向 c。"
   },
   {
    "start": 5.7125,
    "end": 11.7875,
    "text": "如果等到出队才标记，c 会被 a 放进队列一次，又被 b 放进队列一次。"
   },
   {
    "start": 11.7875,
    "end": 15.7,
    "text": "图一大，重复入队会让队列爆炸。"
   }
  ]
 },
 {
  "id": "multi",
  "wav": "audio/multi-c916f129731e.wav",
  "seconds": 17.4,
  "cues": [
   {
    "start": 0.1,
    "end": 4.3125,
    "text": "多源广搜：求每个格子到最近的零的距离。"
   },
   {
    "start": 4.2625,
    "end": 11.475,
    "text": "不用对每个格子各跑一次，而是把所有的零一次性放进队列，作为第零层，再正常推进。"
   },
   {
    "start": 11.475,
    "end": 17.35,
    "text": "几股波纹同时扩散、彼此相遇，一次搜索就得到全部答案。"
   }
  ]
 },
 {
  "id": "choose",
  "wav": "audio/choose-0c1df3e18ce2.wav",
  "seconds": 16.176,
  "cues": [
   {
    "start": 0.1,
    "end": 5.2125,
    "text": "同一块空地，深搜一条路走到底，广搜一圈一圈往外推。"
   },
   {
    "start": 5.1625,
    "end": 11.45,
    "text": "要最短步数，用广搜；要找出所有方案，用深搜，也就是回溯。"
   },
   {
    "start": 11.45,
    "end": 16.125,
    "text": "一句话：要最短就广搜，要所有就深搜。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-093110d391b2.wav",
  "seconds": 6.984,
  "cues": [
   {
    "start": 0.1,
    "end": 4.1125,
    "text": "一个队列，一个 visited，一圈一圈往外推。"
   },
   {
    "start": 4.0625,
    "end": 6.925,
    "text": "第一次到达，就是最短。"
   }
  ]
 }
]