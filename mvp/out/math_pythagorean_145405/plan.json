    {
      "index": 4,
      "title": "把面积写成等式",
      "seconds": 20.34,
      "spoken": 18.84,
      "narration": "四个三角形共 2ab，加小正方形 (b−a)² 等于大正方形 c²。把它展开成 b² − 2ab + a²，代入后 2ab 抵消，得 a² + b² = c²。",
      "emphasis": "展开 (b−a)²，一步步化到 a² + b² = c²",
      "kp_refs": [
        "人教版数学八年级下册 第十七章 勾股定理（17.1 勾股定理）",
        "义务教育数学课程标准（2022年版） 第四学段内容要求：探索勾股定理"
      ],
      "visuals": [
        {
          "kind": "steps",
          "props": {
            "heading": "面积等式",
            "lines": [
              "四个三角形面积：4 × (1/2)ab = 2ab",
              "小正方形面积：(b−a)²",
              "面积和等于大正方形：2ab + (b−a)² = c²",
              "展开：(b−a)² = b² − 2ab + a²",
              "代入：2ab + b² − 2ab + a² = c²",
              "抵消整理，得 a² + b² = c²"
            ]
          }
        }
      ],
      "subtitles": [
        {
          "i": 0,
          "start": 0.45,
          "end": 2.89,
          "text": "四个三角形共 2ab"
        },
        {
          "i": 1,
          "start": 2.89,
          "end": 8.69,
          "text": "加小正方形 (b−a)² 等于大正方形 c²。"
        },
        {
          "i": 2,
          "start": 8.69,
          "end": 12.81,
          "text": "把它展开成 b² − 2ab + a²"
        },
        {
          "i": 3,
          "start": 12.81,
          "end": 15.1,
          "text": "代入后 2ab 抵消"
        },
        {
          "i": 4,
          "start": 15.1,
          "end": 18.14,
          "text": "得 a² + b² = c²。"
        }
      ]
    },
