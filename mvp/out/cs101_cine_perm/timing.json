[
 {
  "id": "title",
  "wav": "audio/title-b07d275238e2.wav",
  "seconds": 12.816,
  "cues": [
   {
    "start": 0.1,
    "end": 5.4125,
    "text": "一、二、三，三张卡片，能排出几种顺序？"
   },
   {
    "start": 5.3625,
    "end": 6.7,
    "text": "六种。"
   },
   {
    "start": 6.7,
    "end": 12.75,
    "text": "可要让程序一个不重、一个不漏地把它们全找出来，你需要的是一棵树。"
   }
  ]
 },
 {
  "id": "choose",
  "wav": "audio/choose-caec60359c83.wav",
  "seconds": 25.848,
  "cues": [
   {
    "start": 0.1,
    "end": 4.5875,
    "text": "斐波那契和汉诺塔的调用树，形状由公式决定。"
   },
   {
    "start": 4.5375,
    "end": 8.8375,
    "text": "全排列不一样：每往下一层，都要做一次选择。"
   },
   {
    "start": 8.8375,
    "end": 11.75,
    "text": "这样的调用树，叫决策树。"
   },
   {
    "start": 11.75,
    "end": 17.225,
    "text": "比如出门穿衣，先选上衣，再选裤子，一共四种穿法。"
   },
   {
    "start": 17.225,
    "end": 25.7875,
    "text": "节点是做到一半的状态，边是一次选择，叶子是全部选完，从根到叶子的一条路径，就是一个完整方案。"
   }
  ]
 },
 {
  "id": "tree",
  "wav": "audio/tree-81b62e6451da.wav",
  "seconds": 19.296,
  "cues": [
   {
    "start": 0.1,
    "end": 4.4,
    "text": "一二三的决策树：根是空列表，什么都还没选。"
   },
   {
    "start": 4.35,
    "end": 7.1375,
    "text": "第一层选第一个数，有三种。"
   },
   {
    "start": 7.1375,
    "end": 11.4625,
    "text": "第二层在剩下的数里再选一个，三乘二等于六种。"
   },
   {
    "start": 11.4625,
    "end": 14.5375,
    "text": "第三层只剩一个数，还是六种。"
   },
   {
    "start": 14.5375,
    "end": 19.225,
    "text": "最底层的六个叶子，从左到右，恰好就是六个排列。"
   }
  ]
 },
 {
  "id": "code",
  "wav": "audio/code-1dfb95048020.wav",
  "seconds": 19.416,
  "cues": [
   {
    "start": 0.1,
    "end": 3.7625,
    "text": "代码就是在这棵树上做深度优先搜索。"
   },
   {
    "start": 3.7125,
    "end": 9.05,
    "text": "path 是从根到当前节点的路径，used 记下哪些数已经用过。"
   },
   {
    "start": 9.05,
    "end": 12.2,
    "text": "路径长度等于 n，就收下一个答案。"
   },
   {
    "start": 12.2,
    "end": 19.35,
    "text": "否则枚举每个还没用过的数：标记，加入路径，递归，回来之后再撤销。"
   }
  ]
 },
 {
  "id": "walk",
  "wav": "audio/walk-fdf18c5b76d5.wav",
  "seconds": 22.584,
  "cues": [
   {
    "start": 0.1,
    "end": 1.5625,
    "text": "跟着走一遍。"
   },
   {
    "start": 1.5125,
    "end": 6.05,
    "text": "往下走，选一个数放进 path，并把它标记为已用。"
   },
   {
    "start": 6.05,
    "end": 9.4875,
    "text": "走到叶子，把 path 拷贝一份存进结果。"
   },
   {
    "start": 9.4875,
    "end": 15.2875,
    "text": "往回退，就把刚才的选择弹出、清掉标记，再换一条路接着走。"
   },
   {
    "start": 15.2875,
    "end": 18.7875,
    "text": "这个退回时撤销的动作，就叫回溯。"
   },
   {
    "start": 18.7875,
    "end": 22.525,
    "text": "一共走遍十六个节点，收下六个排列。"
   }
  ]
 },
 {
  "id": "copy",
  "wav": "audio/copy-1b1f868c6021.wav",
  "seconds": 14.592,
  "cues": [
   {
    "start": 0.1,
    "end": 4.1875,
    "text": "收答案时，一定要写 path 加切片，拷贝一份。"
   },
   {
    "start": 4.1375,
    "end": 9.1875,
    "text": "如果直接存 path，存进去的六个答案，其实都是同一个列表的引用。"
   },
   {
    "start": 9.1875,
    "end": 14.525,
    "text": "等搜索结束、路径全部弹空，你会得到六个空列表。"
   }
  ]
 },
 {
  "id": "count",
  "wav": "audio/count-d9299ffc88d6.wav",
  "seconds": 32.904,
  "cues": [
   {
    "start": 0.1,
    "end": 3.15,
    "text": "为什么复杂度是 n 乘 n 的阶乘？"
   },
   {
    "start": 3.1,
    "end": 10.4625,
    "text": "数一数节点：n 等于三时，从下往上是六、六、三、一，一共十六个。"
   },
   {
    "start": 10.4625,
    "end": 20.1375,
    "text": "一般地，节点总数等于 n 的阶乘，乘以一个和：零的阶乘分之一，加一的阶乘分之一，一直加到 n 的阶乘分之一。"
   },
   {
    "start": 20.1375,
    "end": 25.5125,
    "text": "这个和小于自然常数 e，所以节点数小于 e 乘 n 的阶乘。"
   },
   {
    "start": 25.5125,
    "end": 32.85,
    "text": "每个节点做 O n 的工作，总时间就是 n 乘 n 的阶乘，所以 n 不超过十才可行。"
   }
  ]
 },
 {
  "id": "implicit",
  "wav": "audio/implicit-8bc076129754.wav",
  "seconds": 24.696,
  "cues": [
   {
    "start": 0.1,
    "end": 6.3875,
    "text": "还有一种不写 pop 的写法：每层把 p 加上 x，生成一个新列表传下去。"
   },
   {
    "start": 6.3375,
    "end": 16.35,
    "text": "这并不是没有回溯，只是撤销不用自己写：下一层返回时，它的栈帧连同那个新列表一起丢掉，状态自然恢复。"
   },
   {
    "start": 16.35,
    "end": 24.625,
    "text": "规律是：传值的状态，返回后自动恢复；共享且原地修改的状态，必须手动撤销。"
   }
  ]
 },
 {
  "id": "subsets",
  "wav": "audio/subsets-3111496067c5.wav",
  "seconds": 19.104,
  "cues": [
   {
    "start": 0.1,
    "end": 3.9625,
    "text": "同一个模板，换一种选择，就是子集。"
   },
   {
    "start": 3.9125,
    "end": 8.55,
    "text": "对每个元素只有两种决定：不选，或者选。"
   },
   {
    "start": 8.55,
    "end": 14.1875,
    "text": "三个元素，二的三次方，八个叶子，正好是全部八个子集。"
   },
   {
    "start": 14.1875,
    "end": 19.0375,
    "text": "注意只在叶子收答案，中间节点不收，否则会重复。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-2b0e3b383191.wav",
  "seconds": 15.792,
  "cues": [
   {
    "start": 0.1,
    "end": 6.825,
    "text": "回溯，就是在决策树上做深度优先搜索，再加上退回时撤销选择。"
   },
   {
    "start": 6.775,
    "end": 10.4625,
    "text": "选择，递归，撤销，三步。"
   },
   {
    "start": 10.4625,
    "end": 15.7375,
    "text": "下一周的八皇后、组合、子集，都建立在这个模板上。"
   }
  ]
 }
]