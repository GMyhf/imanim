[
 {
  "id": "title",
  "wav": "audio/title-022c1d91706e.wav",
  "seconds": 14.088,
  "cues": [
   {
    "start": 0.1,
    "end": 3.375,
    "text": "一条二十五米宽的河里，有五块石头。"
   },
   {
    "start": 3.325,
    "end": 9.3125,
    "text": "最多移走两块，怎样让剩下的石头里，相邻两块的最小距离尽量大？"
   },
   {
    "start": 9.3125,
    "end": 11.0875,
    "text": "直接求很难。"
   },
   {
    "start": 11.0875,
    "end": 14.025,
    "text": "但换个问法，就容易了。"
   }
  ]
 },
 {
  "id": "pattern",
  "wav": "audio/pattern-f078401ed7d2.wav",
  "seconds": 21.888,
  "cues": [
   {
    "start": 0.1,
    "end": 4.6625,
    "text": "这类题求的是最小的最大值，或者最大的最小值。"
   },
   {
    "start": 4.6125,
    "end": 9.025,
    "text": "给你一个候选答案，判断它行不行，往往只要扫一遍。"
   },
   {
    "start": 9.025,
    "end": 14.5625,
    "text": "关键是单调：如果间距四可行，比四更小的间距也都可行。"
   },
   {
    "start": 14.5625,
    "end": 18.9625,
    "text": "答案轴上，可行和不可行之间只有一条分界线。"
   },
   {
    "start": 18.9625,
    "end": 21.8375,
    "text": "二分，就是去找这条线。"
   }
  ]
 },
 {
  "id": "check",
  "wav": "audio/check-2e26971569c0.wav",
  "seconds": 25.08,
  "cues": [
   {
    "start": 0.1,
    "end": 8.525,
    "text": "判定函数这样写：给定间距 gap，从左往右走，当前石头离上一块保留的石头太近，就移走它。"
   },
   {
    "start": 8.475,
    "end": 9.9625,
    "text": "看间距四。"
   },
   {
    "start": 9.9625,
    "end": 12.45,
    "text": "二离起点只有二，移走。"
   },
   {
    "start": 12.45,
    "end": 13.9,
    "text": "十一保留。"
   },
   {
    "start": 13.9,
    "end": 16.7625,
    "text": "十四离十一只有三，移走。"
   },
   {
    "start": 16.7625,
    "end": 20.5625,
    "text": "十七、二十一、终点二十五都保留。"
   },
   {
    "start": 20.5625,
    "end": 25.0125,
    "text": "只移走两块，不超过两块，所以四可行。"
   }
  ]
 },
 {
  "id": "binary",
  "wav": "audio/binary-78ea36d35893.wav",
  "seconds": 28.632,
  "cues": [
   {
    "start": 0.1,
    "end": 2.3125,
    "text": "在零到二十五上二分。"
   },
   {
    "start": 2.2625,
    "end": 7.2,
    "text": "第一轮，mid 等于十三，不可行，hi 变成十二。"
   },
   {
    "start": 7.2,
    "end": 11.725,
    "text": "第二轮，mid 等于六，不可行，hi 变成五。"
   },
   {
    "start": 11.725,
    "end": 16.2,
    "text": "第三轮，mid 等于三，可行，lo 变成三。"
   },
   {
    "start": 16.2,
    "end": 20.7875,
    "text": "第四轮，mid 等于四，可行，lo 变成四。"
   },
   {
    "start": 20.7875,
    "end": 25.35,
    "text": "第五轮，mid 等于五，不可行，hi 变成四。"
   },
   {
    "start": 25.35,
    "end": 28.5625,
    "text": "lo 和 hi 相遇，答案是四。"
   }
  ]
 },
 {
  "id": "plusone",
  "wav": "audio/plusone-490e00fac27d.wav",
  "seconds": 24.288,
  "cues": [
   {
    "start": 0.1,
    "end": 6.1625,
    "text": "注意 mid 的写法：lo 加 hi 加一，再整除二，这个加一不能少。"
   },
   {
    "start": 6.1125,
    "end": 12.1375,
    "text": "如果用下取整，当 lo 是四、hi 是五时，mid 永远等于四。"
   },
   {
    "start": 12.1375,
    "end": 17.6,
    "text": "四可行，lo 又被赋成四，区间纹丝不动，就死循环了。"
   },
   {
    "start": 17.6,
    "end": 24.225,
    "text": "记住一句话：lo 等于 mid，就要上取整；hi 等于 mid，就用下取整。"
   }
  ]
 },
 {
  "id": "monthly",
  "wav": "audio/monthly-54b5d4dc3a9c.wav",
  "seconds": 26.928,
  "cues": [
   {
    "start": 0.1,
    "end": 8.375,
    "text": "对称的另一半是月度开销：把七天的开销分成最多五段连续区间，让每段和的最大值尽量小。"
   },
   {
    "start": 8.325,
    "end": 14.3,
    "text": "判定函数给定上限，往当前段里一直加，超了就新开一段。"
   },
   {
    "start": 14.3,
    "end": 20.175,
    "text": "下界是最大的单日开销五百，上界是全部之和一千九百零一。"
   },
   {
    "start": 20.175,
    "end": 23.9875,
    "text": "这次可行时 hi 等于 mid，用下取整。"
   },
   {
    "start": 23.9875,
    "end": 26.8625,
    "text": "十一轮之后，答案是五百。"
   }
  ]
 },
 {
  "id": "template",
  "wav": "audio/template-81d2c08440a8.wav",
  "seconds": 17.328,
  "cues": [
   {
    "start": 0.1,
    "end": 2.3625,
    "text": "二分答案的三步模板。"
   },
   {
    "start": 2.3125,
    "end": 5.275,
    "text": "第一，确定答案的取值范围。"
   },
   {
    "start": 5.275,
    "end": 9.2375,
    "text": "第二，写出判定函数，并确认它单调。"
   },
   {
    "start": 9.2375,
    "end": 17.275,
    "text": "第三，二分：求最小用 hi 等于 mid，求最大用 lo 等于 mid，再配上取整。"
   }
  ]
 },
 {
  "id": "recap",
  "wav": "audio/recap-6be7d9d75e02.wav",
  "seconds": 6.048,
  "cues": [
   {
    "start": 0.1,
    "end": 3.2625,
    "text": "把求解变成验证，在答案上二分。"
   },
   {
    "start": 3.2125,
    "end": 6.0,
    "text": "会判断，就会求最优。"
   }
  ]
 }
]