  "sequence": [
    {
      "title": "从「跑得快」到「提速快」",
      "seconds": 14,
      "narration": "飞机加速，一秒过去速度只涨几米每秒；摩托车起步，一秒就能涨好几米每秒。这种差别由加速度刻画。",
      "emphasis": "加速度刻画的是速度变化的快慢",
      "visuals": [
        {
          "kind": "title",
          "props": {
            "main": "加速度",
            "sub": "描述速度变化的快慢"
          }
        },
        {
          "kind": "compare",
          "props": {
            "left": {
              "h": "飞机起飞",
              "items": [
                "末速度约 80 m/s",
                "每秒约增加 3 m/s"
              ]
            },
            "right": {
              "h": "摩托车起步",
              "items": [
                "末速度约 20 m/s",
                "每秒约增加 8 m/s"
              ]
            }
          }
        }
      ]
    },
    {
      "title": "定义与公式",
      "seconds": 20,
      "narration": "加速度是速度的变化率，等于速度变化量 Δv 除以 Δt，单位米每二次方秒。它是矢量，方向与 Δv 相同，而不是与速度同向。加速度恒定，就是匀变速运动。",
      "emphasis": "a = Δv / Δt，矢量，方向沿 Δv",
      "visuals": [
        {
          "kind": "formula",
          "props": {
            "expr": "a = Δv / Δt = (v_t − v_0) / Δt",
            "note": "单位：m/s²（米每二次方秒）"
          }
        },
        {
          "kind": "callout",
          "props": {
            "text": "矢量：方向与 Δv 相同，与 v 无关",
            "tone": "warn"
          }
        }
      ]
    },
    {
      "title": "两个最容易混的情形",
      "seconds": 18,
      "narration": "速度大，加速度不一定大；速度变化量大，加速度也不一定大。关键在变化量与时间的比值。匀速飞行的飞机速度很大，加速度却为零。",
      "emphasis": "v 大 ≠ a 大；Δv 大 ≠ a 大",
      "visuals": [
        {
          "kind": "compare",
          "props": {
            "left": {
              "h": "高速匀速巡航",
              "items": [
                "v 约 250 m/s",
                "Δv = 0",
                "a = 0"
              ]
            },
            "right": {
              "h": "起跑瞬间",
              "items": [
                "v = 0",
                "每秒约 Δv = 8 m/s",
                "a 约 8 m/s²"
              ]
            }
          }
        },
        {
          "kind": "callout",
          "props": {
            "text": "加速度与速度没有必然的大小关系",
            "tone": "key"
          }
        }
      ]
    },
    {
      "title": "v-t 图像上它就是斜率",
      "seconds": 27,
      "narration": "在 v-t 图像里，图线的斜率表示加速度。取初速度方向为正方向：图线更陡，a 更大；图线水平，a = 0；图线下斜，a 为负，方向与 v 相反。只有加速度恒定时，图线才是一条直线，斜率才处处等于加速度。",
      "emphasis": "v-t 图斜率 = 加速度",
      "visuals": [
        {
          "kind": "graph_vt",
          "props": {
            "points": [
              [
                0,
                0
              ],
              [
                10,
                20
              ]
            ],
            "label": "匀加速直线运动",
            "slope_note": "斜率 = Δv / Δt = 20 / 10 = 2\n斜率的数值就是 a 的数值：a = 2 m/s²",
            "cases": [
              {
                "points": [
                  [
                    0,
                    0
                  ],
                  [
                    7,
                    20
                  ]
                ],
                "label": "更陡 → a 更大",
                "at": "更陡",
                "tone": "accent"
              },
              {
                "points": [
                  [
                    0,
                    10
                  ],
                  [
                    14,
                    10
                  ]
                ],
                "label": "水平 → a = 0",
                "at": "水平",
                "tone": "dim"
              },
              {
                "points": [
                  [
                    6,
                    20
                  ],
                  [
                    13,
                    6
                  ]
                ],
                "label": "下斜 → a 与 v 反向",
                "at": "下斜",
                "tone": "warn"
              }
            ]
          }
        }
      ]
    },
    {
      "title": "例题：汽车起步",
      "seconds": 17,
      "narration": "汽车从静止出发，十秒后速度达到二十米每秒。取初速度方向为正方向，二十减零除以十，加速度为二米每二次方秒，方向与速度同向。",
      "emphasis": "规范解题：先定正方向，再代公式",
      "visuals": [
        {
          "kind": "steps",
          "props": {
            "lines": [
              "已知：v_0 = 0，v_t = 20 m/s，t = 10 s",
              "取初速度方向为正方向",
              "a = (v_t − v_0) / t",
              "a = (20 − 0) / 10 = 2 m/s²",
              "方向与速度同向"
            ]
          }
        }
      ]
    },
    {
      "title": "一句话记住",
      "seconds": 10,
      "narration": "速度告诉你跑多快，加速度告诉你速度改得多快。看 v-t 图，斜率就是它。",
      "emphasis": "速度看高低，加速度看陡缓",
      "visuals": [
        {
          "kind": "summary",
          "props": {
            "points": [
              "a = Δv / Δt，单位 m/s²",
              "矢量，方向沿 Δv",
              "v 大、Δv 大都不代表 a 大",
              "v-t 图斜率即加速度"
            ]
          }
        }
      ]
    }
  ]
